<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Mix de Produtos — Estúdio Criativo IA</title>
<style>
:root {
  --azul:#0874e8;
  --verde:#12b76a;
  --fundo:#f5f8fc;
  --painel:#ffffff;
  --texto:#172b4d;
  --borda:#dce5ef;
}
* { box-sizing:border-box; }
body {
  margin:0;
  font-family:Arial,sans-serif;
  background:var(--fundo);
  color:var(--texto);
}
header {
  background:#fff;
  padding:20px 30px;
  border-bottom:1px solid var(--borda);
}
header h1 { margin:0;color:var(--azul); }
header p { margin:6px 0 0;color:#64748b; }
.container {
  display:grid;
  grid-template-columns:1fr 1.4fr 1fr;
  gap:18px;
  padding:20px;
}
.panel {
  background:var(--painel);
  border:1px solid var(--borda);
  border-radius:14px;
  padding:20px;
  margin-bottom:16px;
}
h2 { font-size:18px;margin:0 0 16px; }
input {
  width:100%;
  padding:13px;
  border:1px solid var(--borda);
  border-radius:8px;
}
button {
  background:var(--azul);
  color:white;
  border:0;
  border-radius:8px;
  padding:13px 18px;
  cursor:pointer;
}
.green { background:var(--verde); }
.preview {
  width:min(100%,320px);
  aspect-ratio:9/16;
  margin:auto;
  background:linear-gradient(145deg,#096be0,#053b73);
  border-radius:16px;
  display:flex;
  align-items:center;
  justify-content:center;
  color:white;
  text-align:center;
  padding:25px;
}
@media(max-width:950px) {
  .container { grid-template-columns:1fr; }
}
</style>

<style>
