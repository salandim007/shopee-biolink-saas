<style>
.product-tabs {display:flex;gap:8px;margin-bottom:15px}
.product-tabs button {flex:1;background:#eaf2fc;color:#174779}
.product-tabs button.active-tab {background:#0874e8;color:#fff}
</style>
<script>
function selectProductSource(source) {
  document.getElementById('linkSource').hidden = source !== 'link';
  document.getElementById('catalogSource').hidden = source !== 'catalog';
  document.querySelectorAll('.product-tabs button').forEach((button, i) => {
    button.classList.toggle('active-tab', i === (source === 'link' ? 0 : 1));
  });
}
</script>


<script>
document.querySelectorAll(".cover-template").forEach(button => {
  button.addEventListener("click", () => {
    document.querySelectorAll(".cover-template")
      .forEach(item => item.classList.remove("selected"));
    button.classList.add("selected");
    document.getElementById("selectedCoverTemplate")
      .textContent = "Modelo selecionado: " +
        button.querySelector("small").textContent;
  });
});
</script>


<script>
document.querySelectorAll(".cover-template").forEach(button => {
  button.addEventListener("click", () => {
    const preview = document.querySelector(".preview");
    if (!preview) return;

    preview.classList.remove(
      "preview-impacto",
      "preview-premium",
      "preview-tecnologico"
    );

    preview.classList.add(
      "preview-" + button.dataset.template
    );
  });
});
</script>


<script>
/* MIX_GALLERY_INTERACTIVE_V1 */
document.querySelectorAll(".media-gallery [data-image]")
  .forEach(button => {
    button.addEventListener("click", () => {
      const imageUrl = button.dataset.image;
      const previewImage = document.querySelector(".preview-product");

      if (!imageUrl || !previewImage) return;

      previewImage.src = imageUrl;

      const thumbnail = button.querySelector("img");
      if (thumbnail) {
        previewImage.alt = thumbnail.alt || "Foto selecionada";
      }

      document.querySelectorAll(".media-gallery .media-photo")
        .forEach(item => {
          item.classList.remove("selected-photo");
          item.setAttribute("aria-pressed", "false");
        });

      button.classList.add("selected-photo");
      button.setAttribute("aria-pressed", "true");
    });
  });
</script>



<style>
/* MIX_CATALOG_AUTOCOMPLETE_V2 */
#catalogSearchResults {
  max-height:340px;
  overflow-y:auto;
  border-radius:10px;
}
.catalog-option {
  display:flex;
  align-items:center;
  gap:10px;
  width:100%;
  padding:8px;
  text-align:left;
  border:0;
  border-bottom:1px solid #e5edf2;
  background:#fff;
  cursor:pointer;
}
.catalog-option.active {
  background:#e7f4ff;
}
.catalog-option img {
  width:48px;
  height:48px;
  flex-shrink:0;
  object-fit:contain;
  border-radius:7px;
}
.catalog-option span {
  flex:1;
  min-width:0;
  font-size:12px;
  line-height:1.4;
}
.catalog-option small {
  display:block;
  color:#637587;
}
</style>

<script>
/* MIX_CATALOG_AUTOCOMPLETE_V2 */
(() => {
  const input = document.getElementById("catalogSearchInput");
  const form = document.getElementById("catalogSearchForm");
  const results = document.getElementById("catalogSearchResults");
  const status = document.getElementById("catalogSearchStatus");

  const button = form.querySelector('[type="submit"]');
  button.hidden = true;
  input.required = false;
  input.setAttribute("autocomplete", "off");
  input.setAttribute("role", "combobox");
  input.setAttribute("aria-autocomplete", "list");
  input.setAttribute("aria-expanded", "false");
  results.id = "catalogSearchResults";
  results.setAttribute("role", "listbox");
  input.setAttribute("aria-controls", results.id);

  let timer = null;
  let controller = null;
  let options = [];
  let active = -1;
  let generation = 0;

  function highlight(index) {
    active = index;
    results.querySelectorAll(".catalog-option")
      .forEach((button, i) => {
        const selected = i === active;
        button.classList.toggle("active", selected);
        button.setAttribute("aria-selected", String(selected));
        if (selected) button.scrollIntoView({block:"nearest"});
      });
  }

  function choose(product) {
    clearTimeout(timer);
    generation++;
    if (controller) controller.abort();

    input.value = product.title || String(product.itemId);
    results.replaceChildren();
    options = [];
    active = -1;
    input.setAttribute("aria-expanded", "false");

    status.textContent =
      "Selecionado: " + (product.title || "Produto") +
      " | ID: " + product.itemId;

    window.mixSelectedCatalogProduct = product;
    window.mixLoadSelectedProduct(product);
  }

  async function search() {
    const term = input.value.trim();
    const requestId = ++generation;

    if (controller) controller.abort();
    controller = null;

    results.replaceChildren();
    options = [];
    active = -1;
    input.setAttribute("aria-expanded", "false");

    if (term.length < 2) {
      status.textContent = "Digite pelo menos 2 caracteres.";
      return;
    }

    status.textContent = "Pesquisando...";

    controller = new AbortController();

    try {
      const params = new URLSearchParams({
        search: term,
        limit: "5",
        offset: "0"
      });

      const response = await fetch(
        "/admin/vitrine2/marketing/creative-studio/api/search-unified?" + params,
        {
          credentials: "same-origin",
          signal: controller.signal
        }
      );

      if (!response.ok)
        throw new Error("Erro na pesquisa: HTTP " + response.status);

      const data = await response.json();
      if (requestId !== generation) return;
      if (!data.success) throw new Error("Consulta não concluída.");

      options = Array.isArray(data.products) ? data.products : [];
      status.textContent =
        Number(data.total || 0).toLocaleString("pt-BR") +
        " produto(s) encontrado(s).";

      options.forEach((product, i) => {
        const option = document.createElement("button");
        option.type = "button";
        option.className = "catalog-option";
        option.setAttribute("role", "option");
        option.setAttribute("aria-selected", "false");
        option.id = "mix-catalog-option-" + i;

        const img = document.createElement("img");
        const rawImage = product.image || product.images?.[0];

        if (typeof rawImage === "string") {
          try {
            const url = new URL(rawImage, location.origin);
            if (url.protocol === "https:" ||
                (url.origin === location.origin &&
                 url.protocol === "http:")) {
              img.src = url.href;
            }
          } catch (_) {}
        }

        img.alt = "";
        img.loading = "lazy";

        const description = document.createElement("span");
        description.textContent = product.title || "Produto sem título";

        const id = document.createElement("small");
        id.textContent = "ID: " + (product.itemId || "N/D");
        description.appendChild(id);

        option.append(img, description);
        option.addEventListener("click", () => choose(product));
        results.appendChild(option);
      });

      input.setAttribute("aria-expanded", String(options.length > 0));

      if (!options.length) status.textContent = "Nenhum produto encontrado.";
    } catch (error) {
      if (error.name === "AbortError") return;
      if (requestId !== generation) return;
      status.textContent = error.message;
    }
  }

  input.addEventListener("input", () => {
    clearTimeout(timer);
    generation++;
    if (controller) controller.abort();
    results.replaceChildren();
    input.setAttribute("aria-expanded", "false");
    status.textContent = "Aguardando pesquisa...";
    timer = setTimeout(search, 300);
  });

  input.addEventListener("keydown", event => {
    if (event.key === "ArrowDown" && options.length) {
      event.preventDefault();
      highlight((active + 1) % options.length);
    } else if (event.key === "ArrowUp" && options.length) {
      event.preventDefault();
      highlight(active <= 0 ? options.length - 1 : active - 1);
    } else if (event.key === "Enter") {
      event.preventDefault();
      if (active >= 0 && options[active]) choose(options[active]);
      else if (options.length) choose(options[0]);
      else search();
    } else if (event.key === "Escape") {
      results.replaceChildren();
      options = [];
      active = -1;
      input.setAttribute("aria-expanded", "false");
    }
  });

  form.addEventListener("submit", event => event.preventDefault());
})();
</script>


<script>
/* MIX_CATALOG_PRODUCT_SELECTION_V1 */
(() => {
  let currentRequest = 0;

  window.mixLoadSelectedProduct = async function(selected) {
    const requestId = ++currentRequest;
    const details = document.getElementById("mixProductDetails");
    const gallery = document.querySelector(".media-gallery");
    const preview = document.querySelector(".preview-product");

    const videoMode = document.getElementById("mixVideoSelectionMode");
    const videoCount = document.getElementById("mixVideoSelectionCount");
    const selectedForVideo = [];

    window.mixGetSelectedVideoImages = () =>
      requestId === currentRequest ? [...selectedForVideo] : [];

    if (videoMode) videoMode.checked = false;
    if (videoCount) {
      videoCount.textContent = "0 de 5 fotografias selecionadas";
    }


    details.textContent = "Carregando produto...";
    gallery.replaceChildren();
    preview.removeAttribute("src");
    preview.alt = "";

    try {
      const params = new URLSearchParams();

      if (selected.shopId) {
        params.set("shopId", selected.shopId);
      }

      // Reutiliza o orquestrador original de mídias.
      const productUrl = selected.shopId
        ? "/admin/vitrine2/marketing/creative-studio/api/product-media/"
          + encodeURIComponent(selected.shopId)
          + "/" + encodeURIComponent(selected.itemId)
        : "/api/products-media/"
          + encodeURIComponent(selected.itemId)
          + "?" + params.toString();

      const response = await fetch(productUrl, {
        credentials: "same-origin"
      });

      if (!response.ok) {
        throw new Error("HTTP " + response.status);
      }

      const data = await response.json();

      if (!data.success || !data.product) {
        throw new Error("Produto não encontrado.");
      }

      if (requestId !== currentRequest) return;

      const product = data.product;

      const images = [...new Set(
        [
          
          ...(Array.isArray(product.images) ? product.images : []),
          product.image
        ].filter(url =>
          typeof url === "string" &&
          url.startsWith("https://")
        )
      )].slice(0, 15);

      const title = product.title || "Produto sem título";

      details.replaceChildren();

      const heading = document.createElement("strong");
      heading.textContent = title;

      const info = document.createElement("p");
      info.textContent =
        "Item ID: " + product.itemId +
        " | Fotos: " + images.length;

      details.append(heading, info);

      const selectImage = (url, button) => {
        preview.src = url;
        preview.alt = title;

        gallery.querySelectorAll(".media-photo")
          .forEach(item => {
            const active = item === button;
            item.classList.toggle("selected-photo", active);
            item.setAttribute("aria-pressed", String(active));
          });
      };

      images.slice(0, 15).forEach((url, index) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "media-slot media-photo";
        button.setAttribute("aria-label", "Selecionar foto " + (index + 1));
        button.setAttribute("aria-pressed", "false");

        const image = document.createElement("img");
        image.src = url;
        image.alt = title + " - foto " + (index + 1);
        image.loading = "lazy";

        button.dataset.image = url;
        button.appendChild(image);
        gallery.appendChild(button);

        button.addEventListener("click", () => {
          selectImage(url, button);

          if (!videoMode || !videoMode.checked) return;

          const position = selectedForVideo.indexOf(url);

          if (position >= 0) {
            selectedForVideo.splice(position, 1);
          } else if (selectedForVideo.length < 5) {
            selectedForVideo.push(url);
          } else {
            if (videoCount) {
              videoCount.textContent =
                "Limite de 5 fotografias atingido.";
            }
            return;
          }

          gallery.querySelectorAll(".media-photo").forEach(photo => {
            photo.classList.toggle(
              "video-selected",
              selectedForVideo.includes(photo.dataset.image)
            );
          });

          if (videoCount) {
            videoCount.textContent =
              selectedForVideo.length +
              " de 5 fotografias selecionadas";
          }
        });

        if (index === 0) selectImage(url, button);
      });

      if (!images.length) {
        details.append("Nenhuma fotografia disponível.");
      }

      window.mixSelectedCatalogProduct = product;

      // MIX_STUDIO_CAPTURE_BUTTON_V1
      const captureButton = document.getElementById("mixBuscarMaisFotos");
      const captureStatus = document.getElementById("mixBuscarFotosStatus");

      if (captureButton) {
        captureButton.disabled = !selected.shopId || images.length >= 15;
        captureButton.style.opacity = captureButton.disabled ? ".6" : "1";

        captureButton.onclick = async () => {
          captureButton.disabled = true;
          captureButton.textContent = "Buscando fotografias...";
          if (captureStatus) captureStatus.textContent =
            "Consultando Shopee...";

          try {
            const res = await fetch(productUrl + "?enrich=1", {
              credentials: "same-origin"
            });

            const data = await res.json();

            if (!res.ok || !data.success) {
              throw new Error(data.error || "Falha na captura");
            }

            if (requestId !== currentRequest) return;

            await window.mixLoadSelectedProduct(selected);

          } catch (error) {
            if (requestId !== currentRequest) return;

            if (captureStatus) captureStatus.textContent =
              "Falha na captura: " + error.message;

            captureButton.disabled = false;
          } finally {
            if (requestId === currentRequest) {
              captureButton.textContent = "Buscar mais fotografias";
            }
          }
        };
      }


    } catch (error) {
      if (requestId !== currentRequest) return;
      details.textContent =
        "Falha ao carregar produto: " + error.message;
    }
  };
})();
</script>

<script>
/* MIX_VIDEO_GENERATE_CLICK_V1 */
(() => {
  const button = document.getElementById("mixGenerateVideoButton");
  if (!button) return;

  const status = document.createElement("p");
  status.id = "mixVideoGenerateStatus";
  status.setAttribute("role", "status");
  status.setAttribute("aria-live", "polite");
  button.insertAdjacentElement("afterend", status);

  button.addEventListener("click", async () => {
    const product = window.mixSelectedCatalogProduct;
    const images = typeof window.mixGetSelectedVideoImages === "function"
      ? window.mixGetSelectedVideoImages() : [];

    if (!product || !product.shopId || !product.itemId) {
      status.textContent = "Selecione um produto primeiro.";
      return;
    }

    if (images.length < 1 || images.length > 5) {
      status.textContent = "Selecione de 1 a 5 fotografias para o vídeo.";
      return;
    }

    button.disabled = true;
    status.textContent = "Preparando trabalho de vídeo...";

    try {
      const response = await fetch(
        "/admin/vitrine2/marketing/creative-studio/api/video-jobs",
        {
          method: "POST",
          credentials: "same-origin",
          headers: {"Content-Type": "application/json"},
          body: JSON.stringify({
            shopId: String(product.shopId),
            itemId: String(product.itemId),
            images
          })
        }
      );

      const responseText = await response.text();
      let result;

      try {
        result = JSON.parse(responseText);
      } catch (_) {
        throw new Error(
          "HTTP " + response.status +
          " — resposta não é JSON (" +
          (response.headers.get("content-type") || "sem tipo") +
          ")."
        );
      }

      if (!response.ok || !result.success) {
        throw new Error(result.error || "Falha ao criar trabalho.");
      }

      status.textContent =
        "Trabalho recebido: " + result.jobId +
        " — aguardando renderização HyperFrames.";

    } catch (error) {
      status.textContent = "Erro: " + error.message;
    } finally {
      button.disabled = false;
    }
  });
})();
</script>

</body>
