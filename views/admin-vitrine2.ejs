    function syncButton() {

        const categoryId =
            selectedCategoryId();


        if (
            mode.value ===
            'performance'
        ) {

            /*
             * Melhor performance geral:
             * categoria opcional.
             */

            button.disabled =
                false;

        } else {

            /*
             * Por categoria:
             * precisa ao menos da categoria principal.
             */

            button.disabled =
                !categoryId;
        }


        button.classList.toggle(
            'opacity-60',
            button.disabled
        );


        button.classList.toggle(
            'cursor-not-allowed',
            button.disabled
        );
    }


