    async function loadOpportunityDecisions(
        view
    ) {
        opportunityView =
            view;

        syncOpportunityNavigation();

        const box =
            getResultsBox();

        box.innerHTML = `
            <div class="text-sm text-slate-500">
                Carregando...
            </div>
        `;


        const response =
            await fetch(
                '/api/vitrine2/opportunities/decisions'
            );

        const data =
            await response.json();


        if (
            !response.ok ||
            !data.success
        ) {
            throw new Error(
                data.error ||
                'Não foi possível carregar.'
            );
        }


        if (view === 'saved') {

            const products =
                (data.saved || [])
                    .map(
                        entry => ({
                            ...(entry.product || {}),

                            marketplace:
                                entry.marketplace ||
                                entry.product
                                    ?.marketplace ||
                                'shopee',

                            itemId:
                                entry.itemId ||
                                entry.product
                                    ?.itemId,

                            opportunityState: {
                                ...(
                                    entry.product
                                        ?.opportunityState ||
                                    {}
                                ),

                                saved: true,
                                ignored: false
                            }
                        })
                    );


            renderProducts({
                products,
                scanned:
                    products.length,
                qualified:
                    products.length
            });


            const results =
                getResultsBox();

            const heading =
                results.querySelector(
                    '.font-extrabold'
                );

            if (heading) {
                heading.textContent =
                    'Produtos salvos';
            }


            results
                .querySelectorAll(
                    '[data-opportunity-actions]'
                )
                .forEach(
                    group => {

                        const button =
                            group.querySelector(
                                '[data-opportunity-action="save-later"]'
                            );

                        if (!button) {
                            return;
                        }

                        button.disabled =
                            false;

                        button.dataset
                            .opportunityAction =
                            'remove-saved';

                        button.textContent =
                            'Remover dos salvos';
                    }
                );

            return;
        }


        renderIgnoredProducts(
            data.ignored || []
        );
    }


