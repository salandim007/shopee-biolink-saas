    function getOpportunityNavigation() {

        let navigation =
            document.getElementById(
                'opportunityViewTabs'
            );


        if (navigation) {
            return navigation;
        }


        navigation =
            document.createElement(
                'div'
            );

        navigation.id =
            'opportunityViewTabs';

        navigation.className =
            'flex flex-wrap items-center gap-2 mb-3';

        navigation.innerHTML = `
            <button
                type="button"
                data-opportunity-view="opportunities"
                class="
                    rounded-xl
                    px-4
                    py-2
                    text-sm
                    font-bold
                    border
                "
            >
                Oportunidades
            </button>

            <button
                type="button"
                data-opportunity-view="saved"
                class="
                    rounded-xl
                    px-4
                    py-2
                    text-sm
                    font-bold
                    border
                "
            >
                Salvos
            </button>

            <button
                type="button"
                data-opportunity-view="ignored"
                class="
                    rounded-xl
                    px-4
                    py-2
                    text-sm
                    font-bold
                    border
                "
            >
                Ignorados
            </button>
        `;


        navigation.addEventListener(
            'click',
            async event => {

                const tab =
                    event.target.closest(
                        '[data-opportunity-view]'
                    );

                if (!tab) {
                    return;
                }

                const view =
                    tab.dataset.opportunityView;

                if (view === 'opportunities') {
                    opportunityView =
                        'opportunities';

                    syncOpportunityNavigation();

                    await search();

                    return;
                }

                await loadOpportunityDecisions(
                    view
                );
            }
        );


        panel.insertAdjacentElement(
            'afterend',
            navigation
        );


        return navigation;
    }


    function syncOpportunityNavigation() {

        const navigation =
            getOpportunityNavigation();


        navigation
            .querySelectorAll(
                '[data-opportunity-view]'
            )
            .forEach(
                button => {

                    const active =
                        button.dataset
                            .opportunityView ===
                        opportunityView;


                    button.classList.toggle(
                        'bg-sky-600',
                        active
                    );

                    button.classList.toggle(
                        'text-white',
                        active
                    );

                    button.classList.toggle(
                        'border-sky-600',
                        active
                    );

                    button.classList.toggle(
                        'bg-white',
                        !active
                    );

                    button.classList.toggle(
                        'text-slate-700',
                        !active
                    );

                    button.classList.toggle(
                        'border-slate-200',
                        !active
                    );
                }
            );
    }


