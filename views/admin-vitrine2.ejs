                                Publicação
                            </div>

                            <select
                                aria-label="Ação de publicação"
                                onchange="handlePublicationAction(
                                    this,
                                    '${escapeHtml(marketplace)}',
                                    '${escapeHtml(itemId)}'
                                )"
                                class="
                                    mt-1
                                    w-full
                                    rounded-xl
                                    border
                                    border-slate-200
                                    bg-white
                                    px-3
                                    py-2
                                    text-xs
