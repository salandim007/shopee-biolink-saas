    async function loadCategories() {

        category.disabled =
            true;

        subcategory.disabled =
            true;


        category.innerHTML =
            '<option value="">Carregando categorias...</option>';


        subcategory.innerHTML =
            '<option value="">Selecione a categoria</option>';


        try {

            const response =
                await fetch(
                    '/api/vitrine2/opportunities/categories'
                    + '?marketplace='
                    + encodeURIComponent(
                        marketplace.value
                    )
                );


            const data =
                await response.json();


            if (
                !response.ok ||
                !data.success
            ) {
                throw new Error(
                    data.error ||
                    'Erro ao carregar categorias.'
                );
            }


            categoryTree =
                data.categories || [];


            category.innerHTML =
                '<option value="">Todas as categorias</option>';


            for (
                const main
                of categoryTree
            ) {

                addOption(
                    category,
                    main.id,
                    main.displayName
                );
            }


            category.disabled =
                false;


            console.log(
                '[OPORTUNIDADES] Categorias principais:',
                categoryTree.length
            );


        } catch (error) {

            category.innerHTML =
                '<option value="">Erro ao carregar categorias</option>';


            category.disabled =
                false;


            console.error(
                '[OPORTUNIDADES]',
                error
            );
        }


        syncButton();
    }


    function loadSubcategories() {

        subcategory.innerHTML =
            '<option value="">Todas as subcategorias</option>';


        if (
            !category.value
        ) {

            subcategory.disabled =
                true;

            subcategory.innerHTML =
                '<option value="">Selecione a categoria</option>';

            syncButton();

            return;
        }


        const main =
            categoryTree.find(
                item =>
                    String(item.id) ===
                    String(category.value)
            );


        if (
            !main ||
            !Array.isArray(
                main.subcategories
            ) ||
            main.subcategories.length === 0
        ) {

            subcategory.disabled =
                true;

            syncButton();

            return;
        }


        for (
            const sub
            of main.subcategories
        ) {

            addOption(
                subcategory,
                sub.id,
                sub.displayName
            );
        }


        subcategory.disabled =
            false;

        syncButton();
    }


    function selectedCategoryId() {

        if (
            subcategory.value
        ) {
            return subcategory.value;
        }


        if (
            category.value
        ) {
            return category.value;
        }


        return null;
    }


