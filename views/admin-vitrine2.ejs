                        <img
                            src="${escapeHtml(product.image)}"
                            alt=""
                            class="
                                w-20
                                h-20
                                rounded-xl
                                object-cover
                                bg-slate-100
                                shrink-0
                            "
                        >

                        <div class="min-w-0">
                            <h2
                                class="
                                    font-bold
                                    text-sm
                                    line-clamp-2
                                "
                            >
