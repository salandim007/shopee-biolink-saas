                                data-position-item-id="${escapeHtml(itemId)}"
                                class="
                                    mt-1
                                    w-full
                                    rounded-xl
                                    border
                                    border-slate-200
                                    px-3
                                    py-2
                                    text-sm
                                "
                            >
