        function renderProducts() {
            const entries =
                getFilteredEntries();

            document
                .getElementById(
                    'filteredCounter'
                )
                .textContent =
                    `${entries.length} de ${catalogEntries.length} produtos exibidos`;

            const loading =
                document.getElementById(
                    'loadingState'
                );

            const desktop =
                document.getElementById(
                    'desktopTableWrapper'
                );

            const desktopBody =
                document.getElementById(
                    'desktopProducts'
                );

            const mobile =
                document.getElementById(
                    'mobileProducts'
                );

            const empty =
                document.getElementById(
                    'emptyState'
                );

            loading.classList.add(
                'hidden'
            );

            if (
                entries.length === 0
            ) {
                desktop.classList.add(
                    'hidden'
                );

                mobile.classList.add(
                    'hidden'
                );

                empty.classList.remove(
                    'hidden'
                );

                return;
            }

            empty.classList.add(
                'hidden'
            );

            desktop.classList.remove(
                'hidden'
            );

            mobile.classList.remove(
                'hidden'
            );

            desktopBody.innerHTML =
                entries
                    .map(
                        createDesktopRow
                    )
                    .join('');

            mobile.innerHTML =
                entries
                    .map(
                        createMobileCard
                    )
                    .join('');

            updateSortIndicators();
            updateStickyTableOffset();
        }


        async function loadProducts() {
            const loading =
                document.getElementById(
                    'loadingState'
                );

            loading.classList.remove(
                'hidden'
            );

            try {
                const response =
                    await fetch(
                        '/api/vitrine2/products'
                    );

                const data =
                    await response.json();

                if (
                    !response.ok ||
                    !data.success
                ) {
                    throw new Error(
                        data.error ||
                        'Falha ao carregar produtos.'
                    );
                }

                catalogEntries =
                    Array.isArray(
                        data.products
                    )
                        ? data.products
                        : [];

                updateSummary();
                populateCategoryFilter();
                renderProducts();
            } catch (error) {
                loading.classList.add(
                    'hidden'
                );

                showMessage(
                    error.message,
                    'error'
                );
            }
        }


        async function togglePublished(
            marketplace,
            itemId,
            published
        ) {
            try {
                const response =
                    await fetch(
                        `/api/vitrine2/products/${encodeURIComponent(marketplace)}/${encodeURIComponent(itemId)}/published`,
                        {
                            method:
                                'PATCH',

                            headers: {
                                'Content-Type':
                                    'application/json'
                            },

                            body:
                                JSON.stringify({
                                    published
                                })
                        }
                    );

                const data =
                    await response.json();

                if (
                    !response.ok ||
                    !data.success
                ) {
                    throw new Error(
                        data.error ||
                        'Não foi possível alterar publicação.'
                    );
                }

                showMessage(
                    published
                        ? 'Produto publicado.'
                        : 'Produto ocultado.'
                );

                await loadProducts();
            } catch (error) {
                showMessage(
                    error.message,
                    'error'
                );
            }
        }


        async function deleteProduct(
            marketplace,
            itemId
        ) {
            const confirmed =
                window.confirm(
                    'Excluir este produto do catálogo? Esta ação remove o produto da Vitrine 2.'
                );

            if (!confirmed) {
                return;
            }

            try {
                const response =
                    await fetch(
                        `/api/vitrine2/products/${encodeURIComponent(marketplace)}/${encodeURIComponent(itemId)}`,
                        {
                            method:
                                'DELETE'
                        }
                    );

                const data =
                    await response.json();

                if (
                    !response.ok ||
                    !data.success
                ) {
                    throw new Error(
                        data.error ||
                        'Não foi possível excluir o produto.'
                    );
                }

                showMessage(
                    'Produto excluído do catálogo.'
                );

                await loadProducts();
            } catch (error) {
                showMessage(
                    error.message,
                    'error'
                );
            }
        }


        async function handlePublicationAction(
            select,
            marketplace,
            itemId
        ) {
            const action =
                select.value;

            if (!action) {
                return;
            }

            select.disabled =
                true;

            try {
                if (
                    action ===
                    'publish'
                ) {
                    await togglePublished(
                        marketplace,
                        itemId,
                        true
                    );

                    return;
                }

                if (
                    action ===
                    'hide'
                ) {
                    await togglePublished(
                        marketplace,
                        itemId,
                        false
                    );

                    return;
                }

                if (
                    action ===
                    'delete'
                ) {
                    await deleteProduct(
                        marketplace,
                        itemId
                    );
                }
            } finally {
                select.disabled =
                    false;

                select.value =
                    '';
            }
        }


        async function importShopeeProduct() {
            const input =
                document.getElementById(
                    'shopeeImportUrl'
                );

            const button =
                document.getElementById(
                    'shopeeImportButton'
                );

            const url =
                input.value.trim();

            if (!url) {
                showMessage(
                    'Cole o link de um produto da Shopee.',
                    'error'
                );

                input.focus();
                return;
            }

            const originalHtml =
                button.innerHTML;

            button.disabled =
                true;

            button.innerHTML =
                `
                    <i class="fa-solid fa-spinner fa-spin"></i>
                    Buscando produto...
                `;

            try {
                const response =
                    await fetch(
                        '/api/vitrine2/import/api',
                        {
                            method:
                                'POST',

                            headers: {
                                'Content-Type':
                                    'application/json'
                            },

                            body:
                                JSON.stringify({
                                    url,
                                    published: false,
                                    featured: false,
                                    collections: []
                                })
                        }
                    );

                const data =
                    await response.json();

                if (
                    !response.ok ||
                    !data.success
                ) {
                    throw new Error(
                        data.error ||
                        'Não foi possível importar o produto.'
                    );
                }

                input.value =
                    '';

                showMessage(
                    'Produto importado da Shopee com sucesso.'
                );

                await loadProducts();
            } catch (error) {
                showMessage(
                    error.message,
                    'error'
                );
            } finally {
                button.disabled =
                    false;

                button.innerHTML =
                    originalHtml;
            }
        }

        async function syncProducts() {
            const button =
                document.getElementById(
                    'reloadButton'
                );

            const originalHtml =
                button.innerHTML;

            button.disabled =
                true;

            button.innerHTML =
                `
                    <i class="fa-solid fa-rotate fa-spin"></i>
                    Sincronizando...
                `;

            try {
                const response =
                    await fetch(
                        '/api/vitrine2/sync',
                        {
                            method:
                                'POST'
                        }
                    );

                const data =
                    await response.json();

                if (
                    !response.ok ||
                    !data.success
                ) {
                    throw new Error(
                        data.error ||
                        'Não foi possível sincronizar a Vitrine 2.'
                    );
                }

                showMessage(
                    'Sincronização concluída.'
                );

                await loadProducts();
            } catch (error) {
                showMessage(
                    error.message,
                    'error'
                );
            } finally {
                button.disabled =
                    false;

                button.innerHTML =
                    originalHtml;
            }
        }


        async function savePosition(
            marketplace,
            itemId
        ) {
            const inputs =
                document.querySelectorAll(
                    '[data-position-item-id]'
                );

            const input =
                Array.from(
                    inputs
                ).find(
                    element =>
                        element.dataset
                            .positionItemId ===
                        String(itemId) &&
                        element.dataset
                            .positionMarketplace ===
                        String(marketplace)
                );

            if (!input) {
                showMessage(
                    'Campo de posição não encontrado.',
                    'error'
                );
                return;
            }

            const raw =
                input.value.trim();

            const position =
                raw === ''
                    ? null
                    : Number(raw);

            if (
                position !== null &&
                (
                    !Number.isInteger(
                        position
                    ) ||
                    position < 1
                )
            ) {
                showMessage(
                    'A posição deve ser um número inteiro maior que zero.',
                    'error'
                );
                return;
            }

            try {
                const response =
                    await fetch(
                        `/api/vitrine2/products/${encodeURIComponent(marketplace)}/${encodeURIComponent(itemId)}/position`,
                        {
                            method:
                                'PATCH',

                            headers: {
                                'Content-Type':
                                    'application/json'
                            },

                            body:
                                JSON.stringify({
                                    position
                                })
                        }
                    );

                const data =
                    await response.json();

                if (
                    !response.ok ||
                    !data.success
                ) {
                    throw new Error(
                        data.error ||
                        'Não foi possível alterar posição.'
                    );
                }

                showMessage(
                    'Posição atualizada.'
                );

                await loadProducts();
            } catch (error) {
                showMessage(
                    error.message,
                    'error'
                );
            }
        }


        document
            .getElementById(
                'reloadButton'
            )
            .addEventListener(
                'click',
                syncProducts
            );


        document
            .getElementById(
                'searchInput'
            )
            .addEventListener(
                'input',
                renderProducts
            );


        document
            .getElementById(
                'statusFilter'
            )
            .addEventListener(
                'change',
                renderProducts
            );


        document
            .getElementById(
                'categoryFilter'
            )
            .addEventListener(
                'change',
                renderProducts
            );


        document
            .getElementById(
                'commissionFilter'
            )
            .addEventListener(
                'change',
                renderProducts
            );


        document
            .getElementById(
                'clearFiltersButton'
            )
            .addEventListener(
                'click',
                () => {
                    document
                        .getElementById(
                            'searchInput'
                        )
                        .value =
                            '';

                    document
                        .getElementById(
                            'categoryFilter'
                        )
                        .value =
                            'all';

                    document
                        .getElementById(
                            'commissionFilter'
                        )
                        .value =
                            '0';

                    document
                        .getElementById(
                            'statusFilter'
                        )
                        .value =
                            'all';

                    renderProducts();
                }
            );


        window.addEventListener(
            'resize',
            updateStickyTableOffset
        );

        window.addEventListener(
            'load',
            updateStickyTableOffset
        );

        updateStickyTableOffset();
        updateSortIndicators();
        loadProducts();
    </script>


<script id="adminCompactLayout">
(() => {

    function findLeafByText(root, wanted) {
        return Array.from(
            root.querySelectorAll('*')
        ).find(element =>
            element.children.length === 0 &&
            element.textContent.trim() === wanted
        );
    }


    /* TOTALIZADORES */

    const totalLabel =
        findLeafByText(
            document,
            'TOTAL'
        );

    if (totalLabel) {
        const card =
            totalLabel.closest(
                '.bg-white.rounded-2xl'
            );

        const grid =
            card?.parentElement;

        if (grid) {
            grid.classList.add(
                'summary-compact-grid'
            );

            Array.from(
                grid.children
            ).forEach(child => {
                child.classList.add(
                    'summary-compact-card'
                );
            });

            const section =
                grid.closest(
                    'section'
                );

            section?.classList.add(
                'admin-main-compact'
            );
        }
    }


    /* ADICIONAR PRODUTO */

    const importInput =
        document.getElementById(
            'shopeeImportUrl'
        );

    if (importInput) {
        const importCard =
            importInput.closest(
                '.bg-white.rounded-2xl'
            );

        if (importCard) {
            importCard.classList.add(
                'import-compact-card'
            );

            const title =
                findLeafByText(
                    importCard,
                    'Adicionar produto da Shopee'
                );

            const description =
                findLeafByText(
                    importCard,
                    'Cole o link de um produto encontrado na Shopee ou no painel de Afiliados.'
                );

            if (title) {
                const headingArea =
                    title.closest(
                        '.flex'
                    );

                if (
                    headingArea &&
                    !headingArea.contains(
                        importInput
                    )
                ) {
                    headingArea.style.display =
                        'none';
                } else {
                    title.style.display =
                        'none';
                }
            }

            if (description) {
                description.style.display =
                    'none';
            }
        }
    }


    /* BUSCAR MELHORES PRODUTOS */

    const opportunityPanel =
        document.getElementById(
            'opportunitySearchPanel'
        );

    if (opportunityPanel) {
        const directChildren =
            Array.from(
                opportunityPanel.children
            );

        const header =
            directChildren[0];

        const controls =
            directChildren[1];

        const note =
            directChildren[2];

        if (
            header &&
            controls
        ) {
            const titleArea =
                header.firstElementChild;

            if (titleArea) {
                const description =
                    titleArea.querySelector(
                        'p'
                    );

                if (description) {
                    description.style.display =
                        'none';
                }

                titleArea.classList.add(
                    'opportunity-title-inline'
                );

                controls.prepend(
                    titleArea
                );
            }

            header.style.display =
                'none';

            controls.classList.add(
                'opportunity-controls-compact'
            );
        }

        if (note) {
            note.classList.add(
                'opportunity-note-compact'
            );
        }
    }


    /* FILTROS */

    const catalogSearch =
        document.getElementById(
            'searchInput'
        );

    if (catalogSearch) {
        const filtersCard =
            catalogSearch.closest(
                '.bg-white.rounded-2xl'
            );

        filtersCard?.classList.add(
            'catalog-filters-compact'
        );
    }

})();
</script>











<script id="opportunityCascadeController">
(() => {

    const marketplace =
        document.getElementById(
            'opportunityMarketplace'
        );

    const mode =
        document.getElementById(
            'opportunityMode'
        );

    const category =
        document.getElementById(
            'opportunityCategory'
        );

    const button =
        document.getElementById(
            'opportunitySearchButton'
        );

    const panel =
        document.getElementById(
            'opportunitySearchPanel'
        );


    if (
        !marketplace ||
        !mode ||
        !category ||
        !button ||
        !panel
    ) {
        console.error(
            '[OPORTUNIDADES] Controles não encontrados.'
        );

        return;
    }


    /*
     * ========================================================
     * CRIA SUBCATEGORIA
     * ========================================================
     */

    const categoryControl =
        category.parentElement;


    let subcategory =
        document.getElementById(
            'opportunitySubcategory'
        );


    if (!subcategory) {

        const wrapper =
            document.createElement(
                'div'
            );

        wrapper.className =
            'opportunity-control opportunity-subcategory-control';


        const label =
            document.createElement(
                'label'
            );

        label.htmlFor =
            'opportunitySubcategory';

        label.textContent =
            'Subcategoria';


        subcategory =
            document.createElement(
                'select'
            );

        subcategory.id =
            'opportunitySubcategory';

        subcategory.disabled =
            true;

        subcategory.innerHTML =
            '<option value="">Selecione a categoria</option>';


        wrapper.appendChild(
            label
        );

        wrapper.appendChild(
            subcategory
        );


        categoryControl.insertAdjacentElement(
            'afterend',
            wrapper
        );
    }


    /*
     * ========================================================
     * ESTADO
     * ========================================================
     */

    let categoryTree =
        [];


    /*
     * ========================================================
     * UTILITÁRIOS
     * ========================================================
     */

    function escapeHtml(value) {

        return String(
            value ?? ''
        )
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#039;');
    }


    function safeUrl(value) {

        const url =
            String(
                value || ''
            ).trim();


        if (
            url.startsWith('https://') ||
            url.startsWith('http://')
        ) {
            return escapeHtml(
                url
            );
        }


        return '#';
    }


    function money(value) {

        const number =
            Number(
                value
            );


        if (
            !Number.isFinite(
                number
            )
        ) {
            return '—';
        }


        return new Intl.NumberFormat(
            'pt-BR',
            {
                style:
                    'currency',

                currency:
                    'BRL'
            }
        ).format(
            number
        );
    }


    function number(value) {

        const n =
            Number(
                value
            );


        if (
            !Number.isFinite(
                n
            )
        ) {
            return '—';
        }


        return new Intl.NumberFormat(
            'pt-BR'
        ).format(
            n
        );
    }


    function percent(value) {

        const n =
            Number(
                value
            );


        if (
            !Number.isFinite(
                n
            )
        ) {
            return '—';
        }


        return `${Math.round(n * 100)}%`;
    }


    function addOption(
        select,
        value,
        label
    ) {

        const option =
            document.createElement(
                'option'
            );

        option.value =
            String(value);

        option.textContent =
            label;

        select.appendChild(
            option
        );
    }


