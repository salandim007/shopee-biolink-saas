                                    type="button"
                                    data-restore-ignored
                                    data-marketplace="${escapeHtml(
                                        entry.marketplace
                                    )}"
                                    data-item-id="${escapeHtml(
                                        String(
                                            entry.itemId
                                        )
                                    )}"
                                    class="
                                        mt-3
                                        w-full
                                        rounded-lg
                                        bg-sky-600
                                        text-white
                                        px-3
                                        py-2
                                        text-xs
                                        font-bold
                                        hover:bg-sky-700
                                    "
                                >
                                    Restaurar produto
                                </button>

                            </div>
                        </article>
                    `;
                }
            )
            .join('');


        box.innerHTML = `
            <div
                class="
                    flex
                    items-center
                    justify-between
                    mb-3
                "
            >
                <div>
                    <div class="font-extrabold">
                        Produtos ignorados
                    </div>

                    <div
                        class="
                            text-xs
                            text-slate-500
                        "
                    >
                        ${items.length} ignorados
                    </div>
                </div>
            </div>

            <div
                class="
                    grid
                    grid-cols-2
                    lg:grid-cols-4
                    gap-3
                "
            >
                ${cards}
            </div>
        `;
    }


    async function removeSavedOpportunity(
        group
    ) {
        const marketplace =
            group.dataset.marketplace;

        const itemId =
            group.dataset.itemId;


        await requestJson(
            `/api/vitrine2/opportunities/saved/${encodeURIComponent(
                marketplace
            )}/${encodeURIComponent(
                itemId
            )}`,
            {
                method: 'DELETE'
            }
        );


        const card =
            group.closest(
                'article'
            );

        if (card) {
            card.remove();
        }
    }


    /*
     * ========================================================
     * BUSCA
     * ========================================================
     */

    async function search() {

        const categoryId =
            selectedCategoryId();


        if (
            mode.value ===
            'category' &&
            !categoryId
        ) {
            return;
        }


        const params =
            new URLSearchParams({
                marketplace:
                    marketplace.value,

                pages:
                    '2',

                limit:
                    '50',

                minimumSales:
                    '1',

                top:
                    '20'
            });


        /*
         * MELHOR PERFORMANCE
         *
         * A categoria é OPCIONAL.
         * Se escolhida, enviamos os DOIS:
         *
         * listType=2
         * categoryId=...
         */

        if (
            mode.value ===
            'performance'
        ) {

            params.set(
                'listType',
                '2'
            );


            if (
                categoryId
            ) {

                params.set(
                    'categoryId',
                    categoryId
                );
            }


        } else {

            params.set(
                'categoryId',
                categoryId
            );
        }


        const original =
            button.innerHTML;


        button.disabled =
            true;


        button.innerHTML =
            '<i class="fa-solid fa-spinner fa-spin"></i> Buscando...';


        try {

            const response =
                await fetch(
                    '/api/vitrine2/opportunities/search?'
                    + params.toString()
                );


            const data =
                await response.json();


            if (
                !response.ok ||
                !data.success
            ) {

                throw new Error(
                    data.error ||
                    'Erro ao buscar oportunidades.'
                );
            }


            renderProducts(
                data
            );


        } catch (error) {

            const box =
                getResultsBox();


            box.innerHTML = `
                <div
                    class="
                        bg-red-50
                        text-red-700
                        rounded-xl
                        p-3
                        text-sm
                        font-bold
                    "
                >
                    ${escapeHtml(error.message)}
                </div>
            `;


        } finally {

            button.innerHTML =
                original;

            syncButton();
        }
    }


    getOpportunityNavigation();
    syncOpportunityNavigation();


    /*
     * ========================================================
     * EVENTOS
     * ========================================================
     */

    category.addEventListener(
        'change',
        loadSubcategories
    );


    subcategory.addEventListener(
        'change',
        syncButton
    );


    mode.addEventListener(
        'change',
        syncButton
    );


    marketplace.addEventListener(
        'change',
        () => {

            categoryTree =
                [];

            loadCategories();
        }
    );


    button.addEventListener(
        'click',
        search
    );


    /*
     * ========================================================
     * INICIALIZAÇÃO
     * ========================================================
     */

    category.disabled =
        false;

    category.classList.remove(
        'bg-slate-50',
        'text-slate-500'
    );


    loadCategories();

})();
</script>

<script id="opportunityActionController">
(() => {

    const panel =
        document.getElementById(
            'opportunitySearchPanel'
        );

    if (!panel) {
        return;
    }


    function apiPart(value) {
        return encodeURIComponent(
            String(
                value || ''
            )
        );
    }


    async function requestJson(
        url,
        options = {}
    ) {
        const response =
            await fetch(
                url,
                {
                    credentials:
                        'same-origin',

                    ...options,

                    headers: {
                        'Content-Type':
                            'application/json',

                        ...(
                            options.headers ||
                            {}
                        )
                    }
                }
            );

        let data = {};

        try {
            data =
                await response.json();
        } catch (_) {
            data = {};
        }

        if (!response.ok) {
            throw new Error(
                data.error ||
                `Erro HTTP ${response.status}`
            );
        }

        return data;
    }


    function showFeedback(
        group,
        message,
        type = 'success'
    ) {
        let toast =
            document.getElementById(
                'opportunityToast'
            );

        if (!toast) {
            toast =
                document.createElement(
                    'div'
                );

            toast.id =
                'opportunityToast';

            toast.style.position =
                'fixed';

            toast.style.top =
                '90px';

            toast.style.right =
                '24px';

            toast.style.zIndex =
                '9999';

            toast.style.maxWidth =
                '360px';

            toast.style.padding =
                '12px 16px';

            toast.style.borderRadius =
                '12px';

            toast.style.fontSize =
                '13px';

            toast.style.fontWeight =
                '700';

            toast.style.boxShadow =
                '0 12px 30px rgba(15,23,42,.18)';

            toast.style.transition =
                'opacity .2s ease, transform .2s ease';

            document.body.appendChild(
                toast
            );
        }


        toast.textContent =
            type === 'error'
                ? `✕ ${message}`
                : `✓ ${message}`;


        if (type === 'error') {

            toast.style.background =
                '#fef2f2';

            toast.style.color =
                '#b91c1c';

            toast.style.border =
                '1px solid #fecaca';

        } else {

            toast.style.background =
                '#ecfdf5';

            toast.style.color =
                '#047857';

            toast.style.border =
                '1px solid #a7f3d0';
        }


        toast.style.display =
            'block';

        toast.style.opacity =
            '1';

        toast.style.transform =
            'translateY(0)';


        clearTimeout(
            window
                .opportunityToastTimer
        );


        window.opportunityToastTimer =
            setTimeout(
                () => {

                    toast.style.opacity =
                        '0';

                    toast.style.transform =
                        'translateY(-6px)';

                    setTimeout(
                        () => {
                            toast.style.display =
                                'none';
                        },
                        220
                    );
                },
                3200
            );
    }

    function refreshButtons(group) {

        const exists =
            group.dataset.catalogExists ===
            'true';

        const published =
            group.dataset.published ===
            'true';

        const marketingSelected =
            group.dataset.marketingSelected ===
            'true';


        const publishButton =
            group.querySelector(
                '[data-opportunity-action="publish"]'
            );

        const adminButton =
            group.querySelector(
                '[data-opportunity-action="admin"]'
            );

        const marketingButton =
            group.querySelector(
                '[data-opportunity-action="marketing"]'
            );


        if (publishButton) {

            publishButton.disabled =
                published;

            publishButton.textContent =
                published
                    ? '✓ Na Vitrine'
                    : 'Publicar na Vitrine';
        }


        if (adminButton) {

            adminButton.disabled =
                exists;

            adminButton.textContent =
                exists
                    ? '✓ No Admin'
                    : 'Adicionar ao Admin';
        }


        if (marketingButton) {

            marketingButton.disabled =
                marketingSelected;

            marketingButton.textContent =
                marketingSelected
                    ? '✓ No Marketing'
                    : 'Enviar ao Marketing';
        }
    }


    async function importProduct(
        group,
        published
    ) {

        const url =
            String(
                group.dataset.productUrl ||
                ''
            ).trim();

        if (
            !url ||
            url === '#'
        ) {
            throw new Error(
                'Produto sem URL válida para importação.'
            );
        }

        await requestJson(
            '/api/vitrine2/import/api',
            {
                method: 'POST',

                body:
                    JSON.stringify({
                        url,
                        published
                    })
            }
        );

        group.dataset.catalogExists =
            'true';

        if (published) {
            group.dataset.published =
                'true';
        }
    }


    async function publishProduct(group) {

        const marketplace =
            group.dataset.marketplace;

        const itemId =
            group.dataset.itemId;

        const exists =
            group.dataset.catalogExists ===
            'true';


        if (!exists) {

            await importProduct(
                group,
                true
            );

        } else {

            await requestJson(
                `/api/vitrine2/products/${
                    apiPart(marketplace)
                }/${
                    apiPart(itemId)
                }/published`,
                {
                    method: 'PATCH',

                    body:
                        JSON.stringify({
                            published: true
                        })
                }
            );

            group.dataset.published =
                'true';
        }


        showFeedback(
            group,
            'Publicado na Vitrine.'
        );

        refreshButtons(
            group
        );
    }


    async function addToAdmin(group) {

        if (
            group.dataset.catalogExists ===
            'true'
        ) {
            refreshButtons(
                group
            );

            return;
        }


        await importProduct(
            group,
            false
        );


        showFeedback(
            group,
            'Adicionado ao Admin.'
        );

        refreshButtons(
            group
        );
    }


    function opportunityProductFromGroup(
        group
    ) {
        let product = {};

        try {
            product =
                JSON.parse(
                    group.dataset
                        .productJson ||
                    '{}'
                );
        } catch (_) {
            product = {};
        }

        return {
            ...product,

            marketplace:
                product.marketplace ||
                group.dataset.marketplace ||
                'shopee',

            itemId:
                product.itemId ||
                group.dataset.itemId
        };
    }


    async function saveOpportunityForLater(
        group
    ) {
        const product =
            opportunityProductFromGroup(
                group
            );

        await requestJson(
            '/api/vitrine2/opportunities/saved',
            {
                method: 'POST',

                body:
                    JSON.stringify({
                        product
                    })
            }
        );

        group.dataset.saved =
            'true';

        const button =
            group.querySelector(
                '[data-opportunity-action="save-later"]'
            );

        if (button) {
            button.disabled =
                true;

            button.textContent =
                '✓ Salvo para depois';
        }

        showFeedback(
            group,
            'Produto salvo para revisar depois.'
        );
    }


    async function ignoreOpportunityProduct(
        group
    ) {
        const product =
            opportunityProductFromGroup(
                group
            );

        await requestJson(
            '/api/vitrine2/opportunities/ignored',
            {
                method: 'POST',

                body:
                    JSON.stringify({
                        product
                    })
            }
        );

        const card =
            group.closest(
                'article'
            );

        showFeedback(
            group,
            'Produto ignorado. Ele não aparecerá nas próximas buscas.'
        );

        if (card) {
            setTimeout(
                () => {
                    card.remove();
                },
                550
            );
        }
    }


    async function copyOpportunityLink(
        group
    ) {
        const url =
            String(
                group.dataset.productUrl ||
                ''
            ).trim();

        if (
            !url ||
            url === '#'
        ) {
            throw new Error(
                'Link da Shopee não disponível.'
            );
        }

        await navigator
            .clipboard
            .writeText(
                url
            );

        showFeedback(
            group,
            'Link da Shopee copiado.'
        );
    }


    async function sendToMarketing(group) {

        const marketplace =
            group.dataset.marketplace;

        const itemId =
            group.dataset.itemId;


        /*
         * Produto precisa existir no catálogo,
         * mas não precisa estar publicado na Vitrine.
         */
        if (
            group.dataset.catalogExists !==
            'true'
        ) {
            await importProduct(
                group,
                false
            );
        }


        /*
         * VISÃO GERAL É SEMPRE O DESTINO PRINCIPAL.
         * Nenhum canal é obrigatório.
         */
        await requestJson(
            `/api/vitrine2/products/${
                apiPart(marketplace)
            }/${
                apiPart(itemId)
            }/marketing/selected`,
            {
                method: 'PATCH',

                body:
                    JSON.stringify({
                        selected: true
                    })
            }
        );


        const channelInputs =
            Array.from(
                group.querySelectorAll(
                    '[data-marketing-channel]'
                )
            );


        const selectedChannels = [];


        /*
         * Os canais marcados no ⋯ são adicionais
         * à Visão Geral.
         */
        for (
            const input of channelInputs
        ) {
            const channel =
                input.dataset
                    .marketingChannel;

            const enabled =
                input.checked === true;


            await requestJson(
                `/api/vitrine2/products/${
                    apiPart(marketplace)
                }/${
                    apiPart(itemId)
                }/marketing/channel/${
                    apiPart(channel)
                }`,
                {
                    method: 'PATCH',

                    body:
                        JSON.stringify({
                            enabled
                        })
                }
            );


            if (enabled) {
                selectedChannels.push(
                    channel
                );
            }
        }


        group.dataset.marketingSelected =
            'true';


        const labels = {
            instagram: 'Instagram',
            facebook: 'Facebook',
            tiktok: 'TikTok',
            kwai: 'Kwai',
            pinterest: 'Pinterest'
        };


        let message =
            'Enviado à Visão Geral do Marketing.';


        if (
            selectedChannels.length > 0
        ) {
            const names =
                selectedChannels
                    .map(
                        channel =>
                            labels[channel] ||
                            channel
                    )
                    .join(', ');

            message =
                `Enviado à Visão Geral + ${names}.`;
        }


        showFeedback(
            group,
            message
        );

        refreshButtons(
            group
        );
    }

    document.addEventListener(
        'click',
        async event => {

            const button =
                event.target.closest(
                    '[data-opportunity-action]'
                );

            if (!button) {
                return;
            }


            const action =
                button.dataset
                    .opportunityAction;


            if (action === 'more') {

                const wrapper =
                    button.parentElement;

                const menu =
                    wrapper?.querySelector(
                        '[data-opportunity-more-menu]'
                    );

                document
                    .querySelectorAll(
                        '[data-opportunity-more-menu]'
                    )
                    .forEach(
                        otherMenu => {

                            if (
                                otherMenu !==
                                menu
                            ) {
                                otherMenu
                                    .classList
                                    .add(
                                        'hidden'
                                    );
                            }
                        }
                    );

                menu
                    ?.classList
                    .toggle(
                        'hidden'
                    );

                return;
            }


            const group =
                button.closest(
                    '[data-opportunity-actions]'
                );

            if (!group) {
                return;
            }


            const wasDisabled =
                button.disabled;

            if (wasDisabled) {
                return;
            }


            button.disabled =
                true;


            try {

                if (
                    action ===
                    'publish'
                ) {
                    await publishProduct(
                        group
                    );
                }


                if (
                    action ===
                    'admin'
                ) {
                    await addToAdmin(
                        group
                    );
                }


                if (
                    action ===
                    'marketing'
                ) {
                    await sendToMarketing(
                        group
                    );
                }


                if (
                    action ===
                    'save-later'
                ) {
                    await saveOpportunityForLater(
                        group
                    );
                }


                if (
                    action ===
                    'ignore-product'
                ) {
                    await ignoreOpportunityProduct(
                        group
                    );
                }


                if (
                    action ===
                    'copy-link'
                ) {
                    await copyOpportunityLink(
                        group
                    );
                }

            } catch (error) {

                console.error(
                    '[OPORTUNIDADES] Erro na ação:',
                    error
                );

                showFeedback(
                    group,
                    error.message ||
                    'Não foi possível concluir a ação.',
                    'error'
                );

            } finally {

                refreshButtons(
                    group
                );

                if (
                    action !== 'publish' &&
                    action !== 'admin' &&
                    action !== 'marketing' &&
                    action !== 'save-later'
                ) {
                    button.disabled =
                        false;
                }
            }
        }
    );


    document.addEventListener(
        'click',
        async event => {

            const tab =
                event.target.closest(
                    '[data-opportunity-view]'
                );


            if (tab) {

                const view =
                    tab.dataset
                        .opportunityView;


                try {

                    if (
                        view ===
                        'opportunities'
                    ) {
                        opportunityView =
                            'opportunities';

                        syncOpportunityNavigation();

                        await search();

                        return;
                    }


                    await loadOpportunityDecisions(
                        view
                    );

                } catch (error) {

                    const box =
                        getResultsBox();

                    box.innerHTML = `
                        <div
                            class="
                                bg-red-50
                                text-red-700
                                rounded-xl
                                p-3
                                text-sm
                                font-bold
                            "
                        >
                            ${escapeHtml(
                                error.message
                            )}
                        </div>
                    `;
                }

                return;
            }


            const restoreButton =
                event.target.closest(
                    '[data-restore-ignored]'
                );


            if (restoreButton) {

                restoreButton.disabled =
                    true;

                try {

                    await requestJson(
                        `/api/vitrine2/opportunities/ignored/${encodeURIComponent(
                            restoreButton.dataset
                                .marketplace
                        )}/${encodeURIComponent(
                            restoreButton.dataset
                                .itemId
                        )}`,
                        {
                            method:
                                'DELETE'
                        }
                    );


                    restoreButton
                        .closest(
                            'article'
                        )
                        ?.remove();


                    showMessage(
                        'Produto restaurado. Ele poderá voltar às pesquisas.'
                    );

                } catch (error) {

                    restoreButton.disabled =
                        false;

                    showMessage(
                        error.message ||
                        'Não foi possível restaurar.',
                        'error'
                    );
                }

                return;
            }
        }
    );


    document.addEventListener(
        'click',
        event => {

            if (
                event.target.closest(
                    '[data-opportunity-action="more"]'
                ) ||
                event.target.closest(
                    '[data-opportunity-more-menu]'
                )
            ) {
                return;
            }


            document
                .querySelectorAll(
                    '[data-opportunity-more-menu]'
                )
                .forEach(
                    menu =>
                        menu.classList.add(
                            'hidden'
                        )
                );
        }
    );

})();
</script>


</body>
