                    </div>
                </div>

                <div
                    class="
                        bg-white
                        rounded-2xl
                        border
                        border-slate-200
                        p-4
                    "
                >
                    <div
                        class="
                            text-xs
                            uppercase
                            tracking-wide
                            text-slate-400
                            font-bold
                        "
                    >
                        Publicados
                    </div>

                    <div
                        id="publishedCount"
                        class="
                            mt-1
                            text-2xl
                            font-extrabold
                            text-emerald-600
                        "
                    >
                        —
                    </div>
                </div>

                <div
                    class="
                        bg-white
                        rounded-2xl
                        border
                        border-slate-200
                        p-4
                    "
                >
                    <div
                        class="
                            text-xs
                            uppercase
                            tracking-wide
                            text-slate-400
                            font-bold
                        "
                    >
                        Ocultos
                    </div>

                    <div
                        id="hiddenCount"
                        class="
                            mt-1
                            text-2xl
                            font-extrabold
                            text-slate-600
                        "
                    >
                        —
                    </div>
                </div>

                <div
                    class="
                        bg-white
                        rounded-2xl
                        border
                        border-slate-200
                        p-4
                    "
                >
                    <div
                        class="
                            text-xs
                            uppercase
                            tracking-wide
                            text-slate-400
                            font-bold
                        "
                    >
                        Último Sync
                    </div>

                    <div
                        id="lastSyncSummary"
                        class="
                            mt-1
                            text-sm
                            font-bold
                            text-slate-700
                        "
                    >
                        —
                    </div>
                </div>
            </div>


            <!-- FILTROS -->

            <div
                class="
                    bg-white
                    rounded-2xl
                    border
                    border-slate-200
                    p-4
                    mb-6
                "
            >
                <div
                    class="
                        grid
                        grid-cols-1
                        md:grid-cols-2
                        xl:grid-cols-4
                        gap-3
                    "
                >
                    <input
                        id="searchInput"
                        type="search"
                        placeholder="Buscar produto..."
                        class="
                            rounded-xl
                            border
                            border-slate-200
                            px-4
                            py-3
                            text-sm
                            outline-none
                            focus:border-sky-400
                        "
                    >

                    <select
                        id="categoryFilter"
                        class="
                            rounded-xl
                            border
                            border-slate-200
                            px-4
                            py-3
                            text-sm
                            outline-none
                            bg-white
                        "
                    >
                        <option value="all">
                            Todas as categorias
                        </option>
                    </select>

                    <select
                        id="commissionFilter"
                        class="
                            rounded-xl
                            border
                            border-slate-200
                            px-4
                            py-3
                            text-sm
                            outline-none
                            bg-white
                        "
                    >
                        <option value="0">
                            Todas as comissões
                        </option>

                        <option value="0.03">
                            Comissão 3% ou mais
                        </option>

                        <option value="0.05">
                            Comissão 5% ou mais
                        </option>

                        <option value="0.08">
                            Comissão 8% ou mais
                        </option>

                        <option value="0.10">
                            Comissão 10% ou mais
                        </option>

                        <option value="0.15">
                            Comissão 15% ou mais
                        </option>
                    </select>

                    <select
                        id="statusFilter"
                        class="
                            rounded-xl
                            border
                            border-slate-200
                            px-4
                            py-3
                            text-sm
                            outline-none
                            bg-white
                        "
                    >
                        <option value="all">
                            Todos os status
                        </option>

                        <option value="published">
                            Publicados
                        </option>

                        <option value="hidden">
                            Ocultos
                        </option>
                    </select>
                </div>

                <div
                    class="
                        mt-3
                        flex
                        flex-col
                        sm:flex-row
                        sm:items-center
                        sm:justify-between
                        gap-2
                        text-xs
                        text-slate-500
                    "
                >
                    <div id="filteredCounter">
                        —
                    </div>

                    <button
                        id="clearFiltersButton"
                        type="button"
                        class="
                            self-start
                            sm:self-auto
                            font-bold
                            text-sky-700
                            hover:text-sky-800
                        "
                    >
                        Limpar filtros
                    </button>
                </div>
            </div>


            <!-- ESTADO -->

            <div
                id="messageBox"
                class="
                    hidden
                    rounded-2xl
                    border
                    px-4
                    py-3
                    mb-5
                    text-sm
                    font-semibold
                "
            ></div>


            <!-- CARREGANDO -->

            <div
                id="loadingState"
                class="
                    bg-white
                    rounded-2xl
                    border
                    border-slate-200
                    p-10
                    text-center
                    text-slate-500
                "
            >
                <i
                    class="
                        fa-solid
                        fa-spinner
                        fa-spin
                        text-2xl
                        text-sky-600
                    "
                ></i>

                <p class="mt-3">
                    Carregando catálogo...
                </p>
            </div>


            <!-- TABELA DESKTOP -->

            <div
                id="desktopTableWrapper"
                class="
                    hidden
                    lg:block
                    bg-white
                    rounded-2xl
                    border
                    border-slate-200
                    overflow-hidden
                "
            >
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead
                            class="
                                bg-slate-50
                                border-b
                                border-slate-200
                            "
                        >
                            <tr
                                class="
                                    text-left
                                    text-xs
                                    uppercase
                                    tracking-wide
                                    text-slate-500
                                "
                            >
                                <th class="px-3 py-3">
                                    Produto
                                </th>

                                <th class="px-3 py-3">
                                    Preço
                                </th>

                                <th class="px-3 py-3">
                                    Comissão
                                </th>

                                <th class="px-3 py-3">
                                    Estimada
                                </th>

                                <th class="px-3 py-3">
                                    Vendas
                                </th>

                                <th class="px-3 py-3">
                                    Avaliação
                                </th>

                                <th class="px-3 py-3">
                                    Status
                                </th>

                                <th class="px-3 py-3">
                                    Posição
                                </th>

                                <th class="px-3 py-3">
                                    Publicação
                                </th>

                                <th class="px-3 py-3">
                                    Ações
                                </th>
                            </tr>
                        </thead>

                        <tbody
                            id="desktopProducts"
                            class="
                                divide-y
                                divide-slate-100
                            "
                        ></tbody>
                    </table>
                </div>
            </div>


            <!-- CARDS MOBILE -->

            <div
                id="mobileProducts"
                class="
                    lg:hidden
                    space-y-3
                "
            ></div>


            <!-- VAZIO -->

            <div
                id="emptyState"
                class="
                    hidden
                    bg-white
                    rounded-2xl
                    border
                    border-slate-200
                    p-10
                    text-center
                "
            >
                <i
                    class="
                        fa-solid
                        fa-box-open
                        text-3xl
                        text-slate-300
                    "
                ></i>

                <p
                    class="
                        mt-3
                        font-bold
                    "
                >
                    Nenhum produto encontrado.
                </p>
            </div>

        </section>
    </main>


    <script>
        let catalogEntries = [];


        function escapeHtml(
            value
        ) {
            return String(
                value ?? ''
            )
                .replace(
                    /&/g,
                    '&amp;'
                )
                .replace(
                    /</g,
                    '&lt;'
                )
                .replace(
                    />/g,
                    '&gt;'
                )
                .replace(
                    /"/g,
                    '&quot;'
                )
                .replace(
                    /'/g,
                    '&#039;'
                );
        }


        function formatPrice(
            value
        ) {
            const number =
                Number(value);

            if (
                !Number.isFinite(
                    number
                )
            ) {
                return '—';
            }

            return new Intl.NumberFormat(
                'pt-BR',
                {
                    style:
                        'currency',

                    currency:
                        'BRL'
                }
            ).format(
                number
            );
        }


        function formatCommission(
            value
        ) {
            const number =
                Number(value);

            if (
                !Number.isFinite(
                    number
                )
            ) {
                return '—';
            }

            return `${(
                number *
                100
            ).toFixed(1).replace(
                '.0',
                ''
            )}%`;
        }


        function formatSales(
            value
        ) {
            const number =
                Number(value);

            if (
                !Number.isFinite(
                    number
                )
            ) {
                return '—';
            }

            return new Intl.NumberFormat(
                'pt-BR'
            ).format(
                number
            );
        }


        function formatRating(
            value
        ) {
            const number =
                Number(value);

            if (
                !Number.isFinite(
                    number
                )
            ) {
                return '—';
            }

            return `${number.toFixed(1).replace('.', ',')} ★`;
        }


        function normalizeText(
            value
        ) {
            return String(
                value || ''
            )
                .normalize(
                    'NFD'
                )
                .replace(
                    /[\u0300-\u036f]/g,
                    ''
                )
                .toLowerCase()
                .trim();
        }


        function inferCategoryFromTitle(
            title
        ) {
            const value =
                normalizeText(
                    title
                );

            const groups = [
                {
                    name: 'Moda',
                    words: [
                        'camisa',
                        'camiseta',
                        'blusa',
                        'vestido',
                        'calca',
                        'short',
                        'bermuda',
                        'cueca',
                        'calcinha',
                        'meia',
                        'roupa',
                        'tenis',
                        'sapato',
                        'sandalia',
                        'chinelo'
                    ]
                },
                {
                    name: 'Eletrônicos',
                    words: [
                        'fone',
                        'bluetooth',
                        'celular',
                        'smartphone',
                        'carregador',
                        'cabo',
                        'headset',
                        'smartwatch',
                        'caixa de som',
                        'controle',
                        'led'
                    ]
                },
                {
                    name: 'Casa e Cozinha',
                    words: [
                        'cozinha',
                        'panela',
                        'copo',
                        'garrafa',
                        'tapete',
                        'lencol',
                        'cama',
                        'toalha',
                        'organizador',
                        'decoracao',
                        'luminaria',
                        'pote'
                    ]
                },
                {
                    name: 'Beleza e Cuidados',
                    words: [
                        'perfume',
                        'maquiagem',
                        'creme',
                        'shampoo',
                        'escova',
                        'secador',
                        'beleza',
                        'hidratante'
                    ]
                },
                {
                    name: 'Acessórios',
                    words: [
                        'bolsa',
                        'mochila',
                        'relogio',
                        'oculos',
                        'carteira',
                        'colar',
                        'pulseira'
                    ]
                },
                {
                    name: 'Ferramentas',
                    words: [
                        'ferramenta',
                        'furadeira',
                        'parafusadeira',
                        'chave',
                        'alicate'
                    ]
                },
                {
                    name: 'Automotivo',
                    words: [
                        'automotivo',
                        'carro',
                        'moto',
                        'veicular'
                    ]
                },
                {
                    name: 'Infantil',
                    words: [
                        'bebe',
                        'infantil',
                        'crianca',
                        'brinquedo'
                    ]
                },
                {
                    name: 'Pet',
                    words: [
                        'pet',
                        'cachorro',
                        'gato'
                    ]
                },
                {
                    name: 'Esporte e Lazer',
                    words: [
                        'academia',
                        'fitness',
                        'esporte',
                        'bicicleta',
                        'camping'
                    ]
                }
            ];

            for (
                const group
                of groups
            ) {
                if (
                    group.words.some(
                        word =>
                            value.includes(
                                word
                            )
                    )
                ) {
                    return group.name;
                }
            }

            return 'Outros achadinhos';
        }


        function getPrimaryCategory(
            product
        ) {
            const candidates = [
                product?.category1,
                product?.metadata
                    ?.categoryDisplayName,
                product?.category2,
                product?.metadata
                    ?.subcategoryDisplayName,
                product?.category3
            ]
                .map(
                    item =>
                        String(
                            item || ''
                        ).trim()
                )
                .filter(
                    Boolean
                );

            if (
                candidates.length
            ) {
                return candidates[0];
            }

            return inferCategoryFromTitle(
                product?.title ||
                ''
            );
        }


        function getProductCategories(
            product
        ) {
            const categories = [
                product?.category1,
                product?.metadata
                    ?.categoryDisplayName,
                product?.category2,
                product?.metadata
                    ?.subcategoryDisplayName,
                product?.category3
            ]
                .map(
                    item =>
                        String(
                            item || ''
                        ).trim()
                )
                .filter(
                    Boolean
                );

            if (
                categories.length
            ) {
                return categories;
            }

            return [
                inferCategoryFromTitle(
                    product?.title ||
                    ''
                )
            ];
        }


        function populateCategoryFilter() {
            const select =
                document.getElementById(
                    'categoryFilter'
                );

            const currentValue =
                select.value;

            const categories =
                [
                    ...new Set(
                        catalogEntries
                            .map(
                                entry =>
                                    getPrimaryCategory(
                                        getProduct(
                                            entry
                                        )
                                    )
                            )
                            .filter(
                                Boolean
                            )
                    )
                ]
                    .sort(
                        (a, b) =>
                            a.localeCompare(
                                b,
                                'pt-BR'
                            )
                    );

            select.innerHTML =
                `
                    <option value="all">
                        Todas as categorias
                    </option>
                ` +
                categories
                    .map(
                        category =>
                            `
                                <option
                                    value="${escapeHtml(category)}"
                                >
                                    ${escapeHtml(category)}
                                </option>
                            `
                    )
                    .join('');

            if (
                categories.includes(
                    currentValue
                )
            ) {
                select.value =
                    currentValue;
            }
        }


        function formatDate(
            value
        ) {
            if (!value) {
                return 'Nunca';
            }

            const date =
                new Date(
                    value
                );

            if (
                Number.isNaN(
                    date.getTime()
                )
            ) {
                return '—';
            }

            return new Intl.DateTimeFormat(
                'pt-BR',
                {
                    dateStyle:
                        'short',

                    timeStyle:
                        'short'
                }
            ).format(
                date
            );
        }


        function getProduct(
            entry
        ) {
            return (
                entry?.product ||
                {}
            );
        }


        function getSyncDate(
            entry
        ) {
            return (
                getProduct(
                    entry
                )
                    ?.metadata
                    ?.lastSyncedAt ||
                null
            );
        }


        function isPublished(
            entry
        ) {
            return Boolean(
                entry
                    ?.visibility
                    ?.published
            );
        }


        function showMessage(
            text,
            type = 'success'
        ) {
            const box =
                document.getElementById(
                    'messageBox'
                );

            box.textContent =
                text;

            box.className =
                [
                    'rounded-2xl',
                    'border',
                    'px-4',
                    'py-3',
                    'mb-5',
                    'text-sm',
                    'font-semibold',
                    type ===
                    'success'
                        ? 'bg-emerald-50 border-emerald-200 text-emerald-700'
                        : 'bg-red-50 border-red-200 text-red-700'
                ].join(' ');

            window.setTimeout(
                () => {
                    box.classList.add(
                        'hidden'
                    );
                },
                3500
            );
        }


        function updateSummary() {
            const total =
                catalogEntries.length;

            const published =
                catalogEntries.filter(
                    isPublished
                ).length;

            const hidden =
                total -
                published;

            const syncDates =
                catalogEntries
                    .map(
                        getSyncDate
                    )
                    .filter(
                        Boolean
                    )
                    .map(
                        value =>
                            new Date(
                                value
                            )
                    )
                    .filter(
                        date =>
                            !Number.isNaN(
                                date.getTime()
                            )
                    )
                    .sort(
                        (a, b) =>
                            b -
                            a
                    );

            document
                .getElementById(
                    'totalCount'
                )
                .textContent =
                    total;

            document
                .getElementById(
                    'publishedCount'
                )
                .textContent =
                    published;

            document
                .getElementById(
                    'hiddenCount'
                )
                .textContent =
                    hidden;

            document
                .getElementById(
                    'lastSyncSummary'
                )
                .textContent =
                    syncDates.length
                        ? formatDate(
                            syncDates[0]
                        )
                        : 'Nunca';
        }


        function getFilteredEntries() {
            const search =
                document
                    .getElementById(
                        'searchInput'
                    )
                    .value
                    .trim()
                    .toLowerCase();

            const status =
                document
                    .getElementById(
                        'statusFilter'
                    )
                    .value;

            const selectedCategory =
                document
                    .getElementById(
                        'categoryFilter'
                    )
                    .value;

            const minimumCommission =
                Number(
                    document
                        .getElementById(
                            'commissionFilter'
                        )
                        .value ||
                    0
                );

            return catalogEntries.filter(
                entry => {
                    const product =
                        getProduct(
                            entry
                        );

                    const primaryCategory =
                        getPrimaryCategory(
                            product
                        );

                    const matchesSearch =
                        !search ||
                        String(
                            product.title ||
                            ''
                        )
                            .toLowerCase()
                            .includes(
                                search
                            ) ||
                        String(
                            product.itemId ||
                            ''
                        )
                            .includes(
                                search
                            );

                    const published =
                        isPublished(
                            entry
                        );

                    const matchesStatus =
                        status ===
                        'all' ||
                        (
                            status ===
                            'published' &&
                            published
                        ) ||
                        (
                            status ===
                            'hidden' &&
                            !published
                        );

                    const matchesCategory =
                        selectedCategory ===
                        'all' ||
                        normalizeText(
                            primaryCategory
                        ) ===
                        normalizeText(
                            selectedCategory
                        );

                    const commission =
                        Number(
                            product.commissionRate
                        );

                    const matchesCommission =
                        minimumCommission <=
                        0 ||
                        (
                            Number.isFinite(
                                commission
                            ) &&
                            commission >=
                            minimumCommission
                        );

                    return (
                        matchesSearch &&
                        matchesStatus &&
                        matchesCategory &&
                        matchesCommission
                    );
                }
            );
        }


        function createStatusBadge(
            entry
        ) {
            if (
                isPublished(
                    entry
                )
            ) {
                return `
                    <span
                        class="
                            inline-flex
                            items-center
                            gap-1.5
                            rounded-full
                            bg-emerald-50
                            text-emerald-700
                            px-2.5
                            py-1
                            text-xs
                            font-bold
                        "
                    >
                        <span
                            class="
                                w-1.5
                                h-1.5
                                rounded-full
                                bg-emerald-500
                            "
                        ></span>
                        Publicado
                    </span>
                `;
            }

