        function renderProducts() {
            const entries =
                getFilteredEntries();

            document
                .getElementById(
                    'filteredCounter'
                )
                .textContent =
                    `${entries.length} de ${catalogEntries.length} produtos exibidos`;

            const loading =
                document.getElementById(
                    'loadingState'
                );

            const desktop =
                document.getElementById(
                    'desktopTableWrapper'
                );

            const desktopBody =
                document.getElementById(
                    'desktopProducts'
                );

            const mobile =
                document.getElementById(
                    'mobileProducts'
                );

            const empty =
                document.getElementById(
                    'emptyState'
                );

            loading.classList.add(
                'hidden'
            );

            if (
                entries.length === 0
            ) {
                desktop.classList.add(
                    'hidden'
                );

                mobile.classList.add(
                    'hidden'
                );

                empty.classList.remove(
                    'hidden'
                );

                return;
            }

            empty.classList.add(
                'hidden'
            );

            desktop.classList.remove(
                'hidden'
            );

            mobile.classList.remove(
                'hidden'
            );

            desktopBody.innerHTML =
                entries
                    .map(
                        createDesktopRow
                    )
                    .join('');

            mobile.innerHTML =
                entries
                    .map(
                        createMobileCard
                    )
                    .join('');
        }


        async function loadProducts() {
            const loading =
                document.getElementById(
                    'loadingState'
                );

            loading.classList.remove(
                'hidden'
            );

            try {
                const response =
                    await fetch(
                        '/api/vitrine2/products'
                    );

                const data =
                    await response.json();

                if (
                    !response.ok ||
                    !data.success
                ) {
                    throw new Error(
                        data.error ||
                        'Falha ao carregar produtos.'
                    );
                }

                catalogEntries =
                    Array.isArray(
                        data.products
                    )
                        ? data.products
                        : [];

                updateSummary();
                populateCategoryFilter();
                renderProducts();
            } catch (error) {
                loading.classList.add(
                    'hidden'
                );

                showMessage(
                    error.message,
                    'error'
                );
            }
        }


        async function togglePublished(
            marketplace,
            itemId,
            published
        ) {
            try {
                const response =
                    await fetch(
                        `/api/vitrine2/products/${encodeURIComponent(marketplace)}/${encodeURIComponent(itemId)}/published`,
                        {
                            method:
                                'PATCH',

                            headers: {
                                'Content-Type':
                                    'application/json'
                            },

                            body:
                                JSON.stringify({
                                    published
                                })
                        }
                    );

                const data =
                    await response.json();

                if (
                    !response.ok ||
                    !data.success
                ) {
                    throw new Error(
                        data.error ||
                        'Não foi possível alterar publicação.'
                    );
                }

                showMessage(
                    published
                        ? 'Produto publicado.'
                        : 'Produto ocultado.'
                );

                await loadProducts();
            } catch (error) {
                showMessage(
                    error.message,
                    'error'
                );
            }
        }


        async function deleteProduct(
            marketplace,
            itemId
        ) {
            const confirmed =
                window.confirm(
                    'Excluir este produto do catálogo? Esta ação remove o produto da Vitrine 2.'
                );

            if (!confirmed) {
                return;
            }

            try {
                const response =
                    await fetch(
                        `/api/vitrine2/products/${encodeURIComponent(marketplace)}/${encodeURIComponent(itemId)}`,
                        {
                            method:
                                'DELETE'
                        }
                    );

                const data =
                    await response.json();

                if (
                    !response.ok ||
                    !data.success
                ) {
                    throw new Error(
                        data.error ||
                        'Não foi possível excluir o produto.'
                    );
                }

                showMessage(
                    'Produto excluído do catálogo.'
                );

                await loadProducts();
            } catch (error) {
                showMessage(
                    error.message,
                    'error'
                );
            }
        }


        async function handlePublicationAction(
            select,
            marketplace,
            itemId
        ) {
            const action =
                select.value;

            if (!action) {
                return;
            }

            select.disabled =
                true;

            try {
                if (
                    action ===
                    'publish'
                ) {
                    await togglePublished(
                        marketplace,
                        itemId,
                        true
                    );

                    return;
                }

                if (
                    action ===
                    'hide'
                ) {
                    await togglePublished(
                        marketplace,
                        itemId,
                        false
                    );

                    return;
                }

                if (
                    action ===
                    'delete'
                ) {
                    await deleteProduct(
                        marketplace,
                        itemId
                    );
                }
            } finally {
                select.disabled =
                    false;

                select.value =
                    '';
            }
        }


        async function syncProducts() {
            const button =
                document.getElementById(
                    'reloadButton'
                );

            const originalHtml =
                button.innerHTML;

            button.disabled =
                true;

            button.innerHTML =
                `
                    <i class="fa-solid fa-rotate fa-spin"></i>
                    Sincronizando...
                `;

            try {
                const response =
                    await fetch(
                        '/api/vitrine2/sync',
                        {
                            method:
                                'POST'
                        }
                    );

                const data =
                    await response.json();

                if (
                    !response.ok ||
                    !data.success
                ) {
                    throw new Error(
                        data.error ||
                        'Não foi possível sincronizar a Vitrine 2.'
                    );
                }

                showMessage(
                    'Sincronização concluída.'
                );

                await loadProducts();
            } catch (error) {
                showMessage(
                    error.message,
                    'error'
                );
            } finally {
                button.disabled =
                    false;

                button.innerHTML =
                    originalHtml;
            }
        }


        async function savePosition(
            marketplace,
            itemId
        ) {
            const inputs =
                document.querySelectorAll(
                    '[data-position-item-id]'
                );

            const input =
                Array.from(
                    inputs
                ).find(
                    element =>
                        element.dataset
                            .positionItemId ===
                        String(itemId) &&
                        element.dataset
                            .positionMarketplace ===
                        String(marketplace)
                );

            if (!input) {
                showMessage(
                    'Campo de posição não encontrado.',
                    'error'
                );
                return;
            }

            const raw =
                input.value.trim();

            const position =
                raw === ''
                    ? null
                    : Number(raw);

            if (
                position !== null &&
                (
                    !Number.isInteger(
                        position
                    ) ||
                    position < 1
                )
            ) {
                showMessage(
                    'A posição deve ser um número inteiro maior que zero.',
                    'error'
                );
                return;
            }

            try {
                const response =
                    await fetch(
                        `/api/vitrine2/products/${encodeURIComponent(marketplace)}/${encodeURIComponent(itemId)}/position`,
                        {
                            method:
                                'PATCH',

                            headers: {
                                'Content-Type':
                                    'application/json'
                            },

                            body:
                                JSON.stringify({
                                    position
                                })
                        }
                    );

                const data =
                    await response.json();

                if (
                    !response.ok ||
                    !data.success
                ) {
                    throw new Error(
                        data.error ||
                        'Não foi possível alterar posição.'
                    );
                }

                showMessage(
                    'Posição atualizada.'
                );

                await loadProducts();
            } catch (error) {
                showMessage(
                    error.message,
                    'error'
                );
            }
        }


        document
            .getElementById(
                'reloadButton'
            )
            .addEventListener(
                'click',
                syncProducts
            );


        document
            .getElementById(
                'searchInput'
            )
            .addEventListener(
                'input',
                renderProducts
            );


        document
            .getElementById(
                'statusFilter'
            )
            .addEventListener(
                'change',
                renderProducts
            );


        document
            .getElementById(
                'categoryFilter'
            )
            .addEventListener(
                'change',
                renderProducts
            );


        document
            .getElementById(
                'commissionFilter'
            )
            .addEventListener(
                'change',
                renderProducts
            );


        document
            .getElementById(
                'clearFiltersButton'
            )
            .addEventListener(
                'click',
                () => {
                    document
                        .getElementById(
                            'searchInput'
                        )
                        .value =
                            '';

                    document
                        .getElementById(
                            'categoryFilter'
                        )
                        .value =
                            'all';

                    document
                        .getElementById(
                            'commissionFilter'
                        )
                        .value =
                            '0';

                    document
                        .getElementById(
                            'statusFilter'
                        )
                        .value =
                            'all';

                    renderProducts();
                }
            );


        loadProducts();
    </script>

</body>
