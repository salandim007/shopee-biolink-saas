<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Admin Vitrine 2
    </title>

    <script
        src="https://cdn.tailwindcss.com"
    ></script>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    >

    <style>
        :root {
            --admin-header-height: 0px;
        }

        #desktopTableWrapper,
        #desktopTableWrapper > div {
            overflow: visible;
        }

        #desktopTableHead th {
            position: sticky;
            top: var(--admin-header-height);
            z-index: 15;
            background: rgb(248 250 252);
            box-shadow: 0 1px 0 rgb(226 232 240);
        }

        .sort-button {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            white-space: nowrap;
            cursor: pointer;
            user-select: none;
            transition: color 150ms ease;
        }

        .sort-button:hover,
        .sort-button.active {
            color: rgb(2 132 199);
        }

        .sort-indicator {
            min-width: 0.8rem;
            text-align: center;
            font-size: 0.7rem;
            line-height: 1;
        }
    </style>

<style id="adminCompactStyle">

    /* ÁREA PRINCIPAL */
    .admin-main-compact {
        padding-top: 16px !important;
        padding-bottom: 16px !important;
    }

    /* TOTALIZADORES */
    .summary-compact-grid {
        gap: 8px !important;
        margin-bottom: 16px !important;
    }

    .summary-compact-card {
        min-height: 48px !important;
        padding: 9px 13px !important;

        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        gap: 8px !important;
    }

    .summary-compact-card > div:first-child {
        margin: 0 !important;
        font-size: 10px !important;
        line-height: 1.1 !important;
    }

    .summary-compact-card > div:last-child {
        margin: 0 !important;
        font-size: 16px !important;
        line-height: 1.1 !important;
        text-align: right !important;
    }

    /* ADICIONAR PRODUTO */
    .import-compact-card {
        padding: 11px 16px !important;
        margin-bottom: 16px !important;
    }

    .import-compact-card form {
        margin: 0 !important;
        gap: 8px !important;
    }

    #shopeeImportUrl {
        min-height: 40px !important;
        padding-top: 8px !important;
        padding-bottom: 8px !important;
    }

    #shopeeImportButton {
        min-height: 40px !important;
        padding: 8px 14px !important;
    }

    /* BUSCAR MELHORES PRODUTOS */
    #opportunitySearchPanel {
        padding: 11px 16px !important;
        margin-bottom: 16px !important;
    }

    .opportunity-controls-compact {
        display: grid !important;

        grid-template-columns:
            auto
            minmax(100px, .65fr)
            minmax(145px, .9fr)
            minmax(190px, 1.2fr)
            auto !important;

        align-items: end !important;
        gap: 8px !important;
    }

    .opportunity-title-inline {
        min-height: 40px !important;
        display: flex !important;
        align-items: center !important;
        gap: 8px !important;
        padding-right: 8px !important;
    }

    .opportunity-title-inline > div:first-child {
        width: 36px !important;
        height: 36px !important;
        flex: 0 0 36px !important;
        border-radius: 12px !important;
    }

    .opportunity-title-inline h2 {
        font-size: 14px !important;
        white-space: nowrap !important;
        margin: 0 !important;
    }

    .opportunity-controls-compact label {
        margin-bottom: 3px !important;
        font-size: 10px !important;
        line-height: 1.1 !important;
    }

    .opportunity-controls-compact select {
        height: 40px !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        padding-left: 10px !important;
        padding-right: 10px !important;
        border-radius: 10px !important;
        font-size: 13px !important;
    }

    #opportunitySearchButton {
        width: auto !important;
        min-width: 105px !important;
        height: 40px !important;
        padding: 0 14px !important;
        border-radius: 10px !important;
        font-size: 13px !important;
        white-space: nowrap !important;
    }

    .opportunity-note-compact {
        margin-top: 7px !important;
        padding: 6px 0 0 0 !important;
        min-height: 0 !important;
        border: 0 !important;
        border-top: 1px solid rgb(241 245 249) !important;
        background: transparent !important;
        border-radius: 0 !important;
        font-size: 10px !important;
        line-height: 1.2 !important;
    }

    /* FILTROS */
    .catalog-filters-compact {
        padding: 11px !important;
        margin-bottom: 16px !important;
    }

    .catalog-filters-compact input,
    .catalog-filters-compact select {
        min-height: 40px !important;
        padding-top: 8px !important;
        padding-bottom: 8px !important;
    }

    .catalog-filters-compact .mt-3 {
        margin-top: 7px !important;
    }

    /* NOTEBOOK / TABLET */
    @media (max-width: 1100px) {
        .opportunity-controls-compact {
            grid-template-columns: 1fr 1fr 1fr 1fr !important;
        }

        .opportunity-title-inline {
            grid-column: 1 / -1;
        }

        #opportunitySearchButton {
            width: 100% !important;
        }
    }

    /* CELULAR */
    @media (max-width: 700px) {
        .opportunity-controls-compact {
            grid-template-columns: 1fr 1fr !important;
        }

        .opportunity-title-inline {
            grid-column: 1 / -1;
        }
    }

    @media (max-width: 480px) {
        .opportunity-controls-compact {
            grid-template-columns: 1fr !important;
        }
    }

</style>


<style id="opportunityCascadeStyle">

    @media (min-width: 1101px) {

        .opportunity-controls-compact {
            grid-template-columns:
                auto
                minmax(90px, .55fr)
                minmax(135px, .80fr)
                minmax(145px, .90fr)
                minmax(160px, 1fr)
                auto
                !important;
        }

    }

    .opportunity-subcategory-control select {
        width: 100%;
    }

</style>


<style id="subcategoryBorderFix">

    #opportunitySubcategory {
        width: 100%;

        height: 40px;

        padding:
            0
            10px;

        border:
            1px solid
            rgb(226 232 240);

        border-radius:
            10px;

        background-color:
            white;

        font-size:
            13px;

        outline:
            none;
    }

    #opportunitySubcategory:focus {
        border-color:
            rgb(56 189 248);
    }

    #opportunitySubcategory:disabled {
        background-color:
            rgb(248 250 252);

        color:
            rgb(100 116 139);
    }

</style>

</head>

<body class="bg-slate-50 text-slate-900">

    <main class="min-h-screen">

        <header
            id="adminHeader"
            class="
                bg-white
                border-b
                border-slate-200
                sticky
                top-0
                z-20
            "
        >
            <div
                class="
                    max-w-7xl
                    mx-auto
                    px-4
                    sm:px-6
                    py-4
                    flex
                    flex-col
                    sm:flex-row
                    sm:items-center
                    sm:justify-between
                    gap-4
                "
            >

                <div>
                    <div
                        class="
                            flex
                            items-center
                            gap-3
                        "
                    >
                        <div
                            class="
                                w-11
                                h-11
                                rounded-2xl
                                bg-sky-100
                                text-sky-700
                                flex
                                items-center
                                justify-center
                            "
                        >
                            <i
                                class="fa-solid fa-store"
                            ></i>
                        </div>

                        <div>
                            <h1
                                class="
                                    text-xl
                                    sm:text-2xl
                                    font-extrabold
                                "
                            >
                                Admin Vitrine 2
                            </h1>

                            <p
                                class="
                                    text-sm
                                    text-slate-500
                                "
                            >
                                Controle rápido do catálogo publicado.
                            </p>
                        </div>
                    </div>
                </div>

                <div
                    class="
                        flex
                        items-center
                        gap-2
                    "
                >
                    <a
                        href="/admin/vitrine2/marketing/overview"
                        class="
                            inline-flex
                            items-center
                            justify-center
                            gap-2
                            px-4
                            py-2.5
                            rounded-xl
                            bg-sky-50
                            hover:bg-sky-100
                            text-sky-700
                            font-bold
                            text-sm
                            transition
                        "
                    >
                        <i class="fa-solid fa-bullhorn"></i>
                        Central de Marketing
                    </a>

                    <a
                        href="/vitrine2"
                        target="_blank"
                        rel="noopener"
                        class="
                            inline-flex
                            items-center
                            justify-center
                            gap-2
                            px-4
                            py-2.5
                            rounded-xl
                            bg-slate-100
                            hover:bg-slate-200
                            font-bold
                            text-sm
                            transition
                        "
                    >
                        <i
                            class="fa-solid fa-arrow-up-right-from-square"
                        ></i>
                        Abrir Vitrine
                    </a>

                    <button
                        id="reloadButton"
                        type="button"
                        class="
                            inline-flex
                            items-center
                            justify-center
                            gap-2
                            px-4
                            py-2.5
                            rounded-xl
                            bg-sky-600
                            hover:bg-sky-700
                            text-white
                            font-bold
                            text-sm
                            transition
                        "
                    >
                        <i
                            class="fa-solid fa-rotate"
                        ></i>
                        Atualizar
                    </button>
                </div>

            </div>
        </header>


        <section
            class="
                max-w-7xl
                mx-auto
                px-4
                sm:px-6
                py-6
            "
        >

            <!-- RESUMO -->

            <div
                class="
                    grid
                    grid-cols-2
                    lg:grid-cols-4
                    gap-3
                    mb-6
                "
            >
                <div
                    class="
                        bg-white
                        rounded-2xl
                        border
                        border-slate-200
                        p-4
                    "
                >
                    <div
                        class="
                            text-xs
                            uppercase
                            tracking-wide
                            text-slate-400
                            font-bold
                        "
                    >
                        Total
                    </div>

                    <div
                        id="totalCount"
                        class="
                            mt-1
                            text-2xl
                            font-extrabold
                        "
                    >
                        —
                    </div>
                </div>

                <div
                    class="
                        bg-white
                        rounded-2xl
                        border
                        border-slate-200
                        p-4
                    "
                >
                    <div
                        class="
                            text-xs
                            uppercase
                            tracking-wide
                            text-slate-400
                            font-bold
                        "
                    >
                        Publicados
                    </div>

                    <div
                        id="publishedCount"
                        class="
                            mt-1
                            text-2xl
                            font-extrabold
                            text-emerald-600
                        "
                    >
                        —
                    </div>
                </div>

                <div
                    class="
                        bg-white
                        rounded-2xl
                        border
                        border-slate-200
                        p-4
                    "
                >
                    <div
                        class="
                            text-xs
                            uppercase
                            tracking-wide
                            text-slate-400
                            font-bold
                        "
                    >
                        Ocultos
                    </div>

                    <div
                        id="hiddenCount"
                        class="
                            mt-1
                            text-2xl
                            font-extrabold
                            text-slate-600
                        "
                    >
                        —
                    </div>
                </div>

                <div
                    class="
                        bg-white
                        rounded-2xl
                        border
                        border-slate-200
                        p-4
                    "
                >
                    <div
                        class="
                            text-xs
                            uppercase
                            tracking-wide
                            text-slate-400
                            font-bold
                        "
                    >
                        Último Sync
                    </div>

                    <div
                        id="lastSyncSummary"
                        class="
                            mt-1
                            text-sm
                            font-bold
                            text-slate-700
                        "
                    >
                        —
                    </div>
                </div>
            </div>


            <!-- IMPORTAR PRODUTO SHOPEE -->

            <div
                class="
                    bg-white
                    rounded-2xl
                    border
                    border-sky-200
                    p-4
                    mb-6
                "
            >
                <div class="flex items-start gap-3">
                    <div
                        class="
                            w-10
                            h-10
                            rounded-xl
                            bg-sky-100
                            text-sky-700
                            flex
                            items-center
                            justify-center
                            shrink-0
                        "
                    >
                        <i class="fa-solid fa-link"></i>
                    </div>

                    <div>
                        <h2 class="font-extrabold text-slate-800">
                            Adicionar produto da Shopee
                        </h2>

                        <p class="text-sm text-slate-500 mt-1">
                            Cole o link de um produto encontrado na Shopee ou no painel de Afiliados.
                        </p>
                    </div>
                </div>

                <form
                    class="
                        mt-4
                        flex
                        flex-col
                        sm:flex-row
                        gap-3
                    "
                    onsubmit="event.preventDefault(); importShopeeProduct();"
                >
                    <input
                        id="shopeeImportUrl"
                        type="url"
                        placeholder="https://shopee.com.br/..."
                        autocomplete="off"
                        class="
                            flex-1
                            rounded-xl
                            border
                            border-slate-200
                            px-4
                            py-3
                            text-sm
                            outline-none
                            focus:border-sky-400
                        "
                    >

                    <button
                        id="shopeeImportButton"
                        type="submit"
                        class="
                            inline-flex
                            items-center
                            justify-center
                            gap-2
                            rounded-xl
                            bg-sky-600
                            hover:bg-sky-700
                            text-white
                            px-5
                            py-3
                            text-sm
                            font-bold
                            transition
                            whitespace-nowrap
                        "
                    >
                        <i class="fa-solid fa-download"></i>
                        Buscar e adicionar
                    </button>
                </form>
            </div>

            <!-- BUSCA DE OPORTUNIDADES -->

            <div
                id="opportunitySearchPanel"
                class="
                    bg-white
                    rounded-2xl
                    border
                    border-slate-200
                    p-5
                    mb-6
                "
            >
                <div
                    class="
                        flex
                        flex-col
                        lg:flex-row
                        lg:items-center
                        lg:justify-between
                        gap-4
                        mb-5
                    "
                >
                    <div
                        class="
                            flex
                            items-start
                            gap-3
                        "
                    >
                        <div
                            class="
                                w-11
                                h-11
                                rounded-2xl
                                bg-emerald-50
                                text-emerald-700
                                flex
                                items-center
                                justify-center
                                shrink-0
                            "
                        >
                            <i class="fa-solid fa-chart-line"></i>
                        </div>

                        <div>
                            <h2
                                class="
                                    text-lg
                                    font-extrabold
                                    text-slate-900
                                "
                            >
                                Buscar melhores produtos
                            </h2>

                            <p
                                class="
                                    text-sm
                                    text-slate-500
                                    mt-1
                                "
                            >
                                Encontre novas oportunidades sem alterar
                                os produtos que já estão na Vitrine.
                            </p>
                        </div>
                    </div>

                    <div
                        class="
                            inline-flex
                            items-center
                            gap-2
                            rounded-full
                            bg-sky-50
                            text-sky-700
                            px-3
                            py-1.5
                            text-xs
                            font-bold
                            self-start
                        "
                    >
                        <i class="fa-solid fa-store"></i>
                        Shopee conectada
                    </div>
                </div>


                <div
                    class="
                        grid
                        grid-cols-1
                        md:grid-cols-2
                        xl:grid-cols-4
                        gap-3
                    "
                >
                    <div>
                        <label
                            for="opportunityMarketplace"
                            class="
                                block
                                text-xs
                                font-bold
                                text-slate-600
                                mb-1.5
                            "
                        >
                            Marketplace
                        </label>

                        <select
                            id="opportunityMarketplace"
                            class="
                                w-full
                                rounded-xl
                                border
                                border-slate-200
                                px-4
                                py-3
                                text-sm
                                bg-white
                                outline-none
                                focus:border-sky-400
                            "
                        >
                            <option value="shopee">
                                Shopee
                            </option>
                        </select>
                    </div>


                    <div>
                        <label
                            for="opportunityMode"
                            class="
                                block
                                text-xs
                                font-bold
                                text-slate-600
                                mb-1.5
                            "
                        >
                            Modo de busca
                        </label>

                        <select
                            id="opportunityMode"
                            class="
                                w-full
                                rounded-xl
                                border
                                border-slate-200
                                px-4
                                py-3
                                text-sm
                                bg-white
                                outline-none
                                focus:border-sky-400
                            "
                        >
                            <option value="performance">
                                Melhor performance
                            </option>

                            <option value="category">
                                Por categoria
                            </option>
                        </select>
                    </div>


                    <div>
                        <label
                            for="opportunityCategory"
                            class="
                                block
                                text-xs
                                font-bold
                                text-slate-600
                                mb-1.5
                            "
                        >
                            Categoria
                        </label>

                        <select
                            id="opportunityCategory"
                           
                            class="
                                w-full
                                rounded-xl
                                border
                                border-slate-200
                                px-4
                                py-3
                                text-sm
                                bg-slate-50
                                text-slate-500
                                outline-none
                            "
                        >
                            <option>
                                Selecione busca por categoria
                            </option>
                        </select>
                    </div>


                    <div
                        class="
                            flex
                            items-end
                        "
                    >
                        <button
                            id="opportunitySearchButton"
                            type="button"
                            disabled
                            class="
                                w-full
                                inline-flex
                                items-center
                                justify-center
                                gap-2
                                rounded-xl
                                bg-emerald-600
                                text-white
                                px-5
                                py-3
                                text-sm
                                font-bold
                                opacity-60
                                cursor-not-allowed
                            "
                        >
                            <i class="fa-solid fa-magnifying-glass-chart"></i>
                            Buscar oportunidades
                        </button>
                    </div>
                </div>


                <div
                    class="
                        mt-4
                        rounded-xl
                        bg-slate-50
                        border
                        border-slate-100
                        px-4
                        py-3
                        text-xs
                        text-slate-500
                    "
                >
                    Primeiro você analisa os candidatos.
                    Nenhum produto será adicionado,
                    removido ou substituído automaticamente.
                </div>
            </div>


            <!-- FILTROS -->

            <div
                class="
                    bg-white
                    rounded-2xl
                    border
                    border-slate-200
                    p-4
                    mb-6
                "
            >
                <div
                    class="
                        grid
                        grid-cols-1
                        md:grid-cols-2
                        xl:grid-cols-4
                        gap-3
                    "
                >
                    <input
                        id="searchInput"
                        type="search"
                        placeholder="Buscar produto..."
                        class="
                            rounded-xl
                            border
                            border-slate-200
                            px-4
                            py-3
                            text-sm
                            outline-none
                            focus:border-sky-400
                        "
                    >

                    <select
                        id="categoryFilter"
                        class="
                            rounded-xl
                            border
                            border-slate-200
                            px-4
                            py-3
                            text-sm
                            outline-none
                            bg-white
                        "
                    >
                        <option value="all">
                            Todas as categorias
                        </option>
                    </select>

                    <select
                        id="commissionFilter"
                        class="
                            rounded-xl
                            border
                            border-slate-200
                            px-4
                            py-3
                            text-sm
                            outline-none
                            bg-white
                        "
                    >
                        <option value="0">
                            Todas as comissões
                        </option>

                        <option value="0.03">
                            Comissão 3% ou mais
                        </option>

                        <option value="0.05">
                            Comissão 5% ou mais
                        </option>

                        <option value="0.08">
                            Comissão 8% ou mais
                        </option>

                        <option value="0.10">
                            Comissão 10% ou mais
                        </option>

                        <option value="0.15">
                            Comissão 15% ou mais
                        </option>
                    </select>

                    <select
                        id="statusFilter"
                        class="
                            rounded-xl
                            border
                            border-slate-200
                            px-4
                            py-3
                            text-sm
                            outline-none
                            bg-white
                        "
                    >
                        <option value="all">
                            Todos os status
                        </option>

                        <option value="published">
                            Publicados
                        </option>

                        <option value="hidden">
                            Ocultos
                        </option>
                    </select>
                </div>

                <div
                    class="
                        mt-3
                        flex
                        flex-col
                        sm:flex-row
                        sm:items-center
                        sm:justify-between
                        gap-2
                        text-xs
                        text-slate-500
                    "
                >
                    <div id="filteredCounter">
                        —
                    </div>

                    <button
                        id="clearFiltersButton"
                        type="button"
                        class="
                            self-start
                            sm:self-auto
                            font-bold
                            text-sky-700
                            hover:text-sky-800
                        "
                    >
                        Limpar filtros
                    </button>
                </div>
            </div>


            <!-- ESTADO -->

            <div
                id="messageBox"
                class="
                    hidden
                    rounded-2xl
                    border
                    px-4
                    py-3
                    mb-5
                    text-sm
                    font-semibold
                "
            ></div>


            <!-- CARREGANDO -->

            <div
                id="loadingState"
                class="
                    bg-white
                    rounded-2xl
                    border
                    border-slate-200
                    p-10
                    text-center
                    text-slate-500
                "
            >
                <i
                    class="
                        fa-solid
                        fa-spinner
                        fa-spin
                        text-2xl
                        text-sky-600
                    "
                ></i>

                <p class="mt-3">
                    Carregando catálogo...
                </p>
            </div>


            <!-- TABELA DESKTOP -->

            <div
                id="desktopTableWrapper"
                class="
                    hidden
                    lg:block
                    bg-white
                    rounded-2xl
                    border
                    border-slate-200
                "
            >
                <div>
                    <table class="w-full">
                        <thead
                            id="desktopTableHead"
                            class="
                                bg-slate-50
                                border-b
                                border-slate-200
                            "
                        >
                            <tr
                                class="
                                    text-left
                                    text-xs
                                    uppercase
                                    tracking-wide
                                    text-slate-500
                                "
                            >
                                <th class="px-3 py-3">
                                    <button
                                        type="button"
                                        class="sort-button"
                                        data-sort-button="title"
                                        onclick="setSort('title')"
                                    >
                                        Produto
                                        <span class="sort-indicator" data-sort-indicator="title">↕</span>
                                    </button>
                                </th>

                                <th class="px-3 py-3">
                                    <button
                                        type="button"
                                        class="sort-button"
                                        data-sort-button="price"
                                        onclick="setSort('price')"
                                    >
                                        Preço
                                        <span class="sort-indicator" data-sort-indicator="price">↕</span>
                                    </button>
                                </th>

                                <th class="px-3 py-3">
                                    <button
                                        type="button"
                                        class="sort-button"
                                        data-sort-button="commissionRate"
                                        onclick="setSort('commissionRate')"
                                    >
                                        Comissão
                                        <span class="sort-indicator" data-sort-indicator="commissionRate">↕</span>
                                    </button>
                                </th>

                                <th class="px-3 py-3">
                                    <button
                                        type="button"
                                        class="sort-button"
                                        data-sort-button="commission"
                                        onclick="setSort('commission')"
                                    >
                                        Estimada
                                        <span class="sort-indicator" data-sort-indicator="commission">↕</span>
                                    </button>
                                </th>

                                <th class="px-3 py-3">
                                    <button
                                        type="button"
                                        class="sort-button"
                                        data-sort-button="sales"
                                        onclick="setSort('sales')"
                                    >
                                        Vendas
                                        <span class="sort-indicator" data-sort-indicator="sales">↕</span>
                                    </button>
                                </th>

                                <th class="px-3 py-3">
                                    <button
                                        type="button"
                                        class="sort-button"
                                        data-sort-button="ratingStar"
                                        onclick="setSort('ratingStar')"
                                    >
                                        Avaliação
                                        <span class="sort-indicator" data-sort-indicator="ratingStar">↕</span>
                                    </button>
                                </th>

                                <th class="px-3 py-3">
                                    <button
                                        type="button"
                                        class="sort-button"
                                        data-sort-button="status"
                                        onclick="setSort('status')"
                                    >
                                        Status
                                        <span class="sort-indicator" data-sort-indicator="status">↕</span>
                                    </button>
                                </th>

                                <th class="px-3 py-3">
                                    <button
                                        type="button"
                                        class="sort-button"
                                        data-sort-button="position"
                                        onclick="setSort('position')"
                                    >
                                        Posição
                                        <span class="sort-indicator" data-sort-indicator="position">↕</span>
                                    </button>
                                </th>

                                <th class="px-3 py-3">
                                    Publicação
                                </th>

                                <th class="px-3 py-3">
                                    Ações
                                </th>
                            </tr>
                        </thead>

                        <tbody
                            id="desktopProducts"
                            class="
                                divide-y
                                divide-slate-100
                            "
                        ></tbody>
                    </table>
                </div>
            </div>


            <!-- CARDS MOBILE -->

            <div
                id="mobileProducts"
                class="
                    lg:hidden
                    space-y-3
                "
            ></div>


            <!-- VAZIO -->

            <div
                id="emptyState"
                class="
                    hidden
                    bg-white
                    rounded-2xl
                    border
                    border-slate-200
                    p-10
                    text-center
                "
            >
                <i
                    class="
                        fa-solid
                        fa-box-open
                        text-3xl
                        text-slate-300
                    "
                ></i>

                <p
                    class="
                        mt-3
                        font-bold
                    "
                >
                    Nenhum produto encontrado.
                </p>
            </div>

        </section>
    </main>


    <script>
        let catalogEntries = [];

        let sortState = {
            key: null,
            direction: null
        };


        function escapeHtml(
            value
        ) {
            return String(
                value ?? ''
            )
                .replace(
                    /&/g,
                    '&amp;'
                )
                .replace(
                    /</g,
                    '&lt;'
                )
                .replace(
                    />/g,
                    '&gt;'
                )
                .replace(
                    /"/g,
                    '&quot;'
                )
                .replace(
                    /'/g,
                    '&#039;'
                );
        }


        function formatPrice(
            value
        ) {
            const number =
                Number(value);

            if (
                !Number.isFinite(
                    number
                )
            ) {
                return '—';
            }

            return new Intl.NumberFormat(
                'pt-BR',
                {
                    style:
                        'currency',

                    currency:
                        'BRL'
                }
            ).format(
                number
            );
        }


        function formatCommission(
            value
        ) {
            const number =
                Number(value);

            if (
                !Number.isFinite(
                    number
                )
            ) {
                return '—';
            }

            return `${(
                number *
                100
            ).toFixed(1).replace(
                '.0',
                ''
            )}%`;
        }


        function formatSales(
            value
        ) {
            const number =
                Number(value);

            if (
                !Number.isFinite(
                    number
                )
            ) {
                return '—';
            }

            return new Intl.NumberFormat(
                'pt-BR'
            ).format(
                number
            );
        }


        function formatRating(
            value
        ) {
            const number =
                Number(value);

            if (
                !Number.isFinite(
                    number
                )
            ) {
                return '—';
            }

            return `${number.toFixed(1).replace('.', ',')} ★`;
        }


        function updateStickyTableOffset() {
            const header =
                document.getElementById(
                    'adminHeader'
                );

            if (!header) {
                return;
            }

            document.documentElement.style.setProperty(
                '--admin-header-height',
                `${header.offsetHeight}px`
            );
        }


        function getSortValue(
            entry,
            key
        ) {
            const product =
                getProduct(
                    entry
                );

            if (key === 'title') {
                return normalizeText(
                    product.title
                );
            }

            if (key === 'status') {
                return isPublished(
                    entry
                )
                    ? 1
                    : 0;
            }

            if (key === 'position') {
                const position =
                    Number(
                        entry?.visibility?.position
                    );

                return Number.isFinite(position)
                    ? position
                    : null;
            }

            const value =
                Number(
                    product?.[key]
                );

            return Number.isFinite(value)
                ? value
                : null;
        }


        function sortEntries(
            entries
        ) {
            if (
                !sortState.key ||
                !sortState.direction
            ) {
                return [...entries];
            }

            const direction =
                sortState.direction === 'asc'
                    ? 1
                    : -1;

            return [...entries].sort(
                (entryA, entryB) => {
                    const valueA =
                        getSortValue(
                            entryA,
                            sortState.key
                        );

                    const valueB =
                        getSortValue(
                            entryB,
                            sortState.key
                        );

                    if (valueA === null && valueB === null) {
                        return 0;
                    }

                    if (valueA === null) {
                        return 1;
                    }

                    if (valueB === null) {
                        return -1;
                    }

                    if (
                        typeof valueA === 'string' ||
                        typeof valueB === 'string'
                    ) {
                        return String(valueA)
                            .localeCompare(
                                String(valueB),
                                'pt-BR'
                            ) * direction;
                    }

                    if (valueA === valueB) {
                        return 0;
                    }

                    return (
                        valueA < valueB
                            ? -1
                            : 1
                    ) * direction;
                }
            );
        }


        function updateSortIndicators() {
            document
                .querySelectorAll(
                    '[data-sort-button]'
                )
                .forEach(
                    button => {
                        const key =
                            button.dataset.sortButton;

                        const indicator =
                            button.querySelector(
                                '[data-sort-indicator]'
                            );

                        const active =
                            sortState.key === key &&
                            Boolean(sortState.direction);

                        button.classList.toggle(
                            'active',
                            active
                        );

                        if (!indicator) {
                            return;
                        }

                        if (!active) {
                            indicator.textContent = '↕';
                            return;
                        }

                        indicator.textContent =
                            sortState.direction === 'asc'
                                ? '↑'
                                : '↓';
                    }
                );
        }


        function setSort(
            key
        ) {
            const isText =
                key === 'title';

            const firstDirection =
                isText
                    ? 'asc'
                    : 'desc';

            const secondDirection =
                isText
                    ? 'desc'
                    : 'asc';

            if (
                sortState.key !== key ||
                sortState.direction === null
            ) {
                sortState.key = key;
                sortState.direction = firstDirection;
            } else if (
                sortState.direction === firstDirection
            ) {
                sortState.direction = secondDirection;
            } else {
                sortState.key = null;
                sortState.direction = null;
            }

            renderProducts();
        }


        function normalizeText(
            value
        ) {
            return String(
                value || ''
            )
                .normalize(
                    'NFD'
                )
                .replace(
                    /[\u0300-\u036f]/g,
                    ''
                )
                .toLowerCase()
                .trim();
        }


        function inferCategoryFromTitle(
            title
        ) {
            const value =
                normalizeText(
                    title
                );

            const groups = [
                {
                    name: 'Moda',
                    words: [
                        'camisa',
                        'camiseta',
                        'blusa',
                        'vestido',
                        'calca',
                        'short',
                        'bermuda',
                        'cueca',
                        'calcinha',
                        'meia',
                        'roupa',
                        'tenis',
                        'sapato',
                        'sandalia',
                        'chinelo'
                    ]
                },
                {
                    name: 'Eletrônicos',
                    words: [
                        'fone',
                        'bluetooth',
                        'celular',
                        'smartphone',
                        'carregador',
                        'cabo',
                        'headset',
                        'smartwatch',
                        'caixa de som',
                        'controle',
                        'led'
                    ]
                },
                {
                    name: 'Casa e Cozinha',
                    words: [
                        'cozinha',
                        'panela',
                        'copo',
                        'garrafa',
                        'tapete',
                        'lencol',
                        'cama',
                        'toalha',
                        'organizador',
                        'decoracao',
                        'luminaria',
                        'pote'
                    ]
                },
                {
                    name: 'Beleza e Cuidados',
                    words: [
                        'perfume',
                        'maquiagem',
                        'creme',
                        'shampoo',
                        'escova',
                        'secador',
                        'beleza',
                        'hidratante'
                    ]
                },
                {
                    name: 'Acessórios',
                    words: [
                        'bolsa',
                        'mochila',
                        'relogio',
                        'oculos',
                        'carteira',
                        'colar',
                        'pulseira'
                    ]
                },
                {
                    name: 'Ferramentas',
                    words: [
                        'ferramenta',
                        'furadeira',
                        'parafusadeira',
                        'chave',
                        'alicate'
                    ]
                },
                {
                    name: 'Automotivo',
                    words: [
                        'automotivo',
                        'carro',
                        'moto',
                        'veicular'
                    ]
                },
                {
                    name: 'Infantil',
                    words: [
                        'bebe',
                        'infantil',
                        'crianca',
                        'brinquedo'
                    ]
                },
                {
                    name: 'Pet',
                    words: [
                        'pet',
                        'cachorro',
                        'gato'
                    ]
                },
                {
                    name: 'Esporte e Lazer',
                    words: [
                        'academia',
                        'fitness',
                        'esporte',
                        'bicicleta',
                        'camping'
                    ]
                }
            ];

            for (
                const group
                of groups
            ) {
                if (
                    group.words.some(
                        word =>
                            value.includes(
                                word
                            )
                    )
                ) {
                    return group.name;
                }
            }

            return 'Outros achadinhos';
        }


        function getPrimaryCategory(
            product
        ) {
            const candidates = [
                product?.category1,
                product?.metadata
                    ?.categoryDisplayName,
                product?.category2,
                product?.metadata
                    ?.subcategoryDisplayName,
                product?.category3
            ]
                .map(
                    item =>
                        String(
                            item || ''
                        ).trim()
                )
                .filter(
                    Boolean
                );

            if (
                candidates.length
            ) {
                return candidates[0];
            }

            return inferCategoryFromTitle(
                product?.title ||
                ''
            );
        }


        function getProductCategories(
            product
        ) {
            const categories = [
                product?.category1,
                product?.metadata
                    ?.categoryDisplayName,
                product?.category2,
                product?.metadata
                    ?.subcategoryDisplayName,
                product?.category3
            ]
                .map(
                    item =>
                        String(
                            item || ''
                        ).trim()
                )
                .filter(
                    Boolean
                );

            if (
                categories.length
            ) {
                return categories;
            }

            return [
                inferCategoryFromTitle(
                    product?.title ||
                    ''
                )
            ];
        }


        function populateCategoryFilter() {
            const select =
                document.getElementById(
                    'categoryFilter'
                );

            const currentValue =
                select.value;

            const categories =
                [
                    ...new Set(
                        catalogEntries
                            .map(
                                entry =>
                                    getPrimaryCategory(
                                        getProduct(
                                            entry
                                        )
                                    )
                            )
                            .filter(
                                Boolean
                            )
                    )
                ]
                    .sort(
                        (a, b) =>
                            a.localeCompare(
                                b,
                                'pt-BR'
                            )
                    );

            select.innerHTML =
                `
                    <option value="all">
                        Todas as categorias
                    </option>
                ` +
                categories
                    .map(
                        category =>
                            `
                                <option
                                    value="${escapeHtml(category)}"
                                >
                                    ${escapeHtml(category)}
                                </option>
                            `
                    )
                    .join('');

            if (
                categories.includes(
                    currentValue
                )
            ) {
                select.value =
                    currentValue;
            }
        }


        function formatDate(
            value
        ) {
            if (!value) {
                return 'Nunca';
            }

            const date =
                new Date(
                    value
                );

            if (
                Number.isNaN(
                    date.getTime()
                )
            ) {
                return '—';
            }

            return new Intl.DateTimeFormat(
                'pt-BR',
                {
                    dateStyle:
                        'short',

                    timeStyle:
                        'short'
                }
            ).format(
                date
            );
        }


        function getProduct(
            entry
        ) {
            return (
                entry?.product ||
                {}
            );
        }


        function getSyncDate(
            entry
        ) {
            return (
                getProduct(
                    entry
                )
                    ?.metadata
                    ?.lastSyncedAt ||
                null
            );
        }


        function isPublished(
            entry
        ) {
            return Boolean(
                entry
                    ?.visibility
                    ?.published
            );
        }


        function showMessage(
            text,
            type = 'success'
        ) {
            const box =
                document.getElementById(
                    'messageBox'
                );

            box.textContent =
                text;

            box.className =
                [
                    'rounded-2xl',
                    'border',
                    'px-4',
                    'py-3',
                    'mb-5',
                    'text-sm',
                    'font-semibold',
                    type ===
                    'success'
                        ? 'bg-emerald-50 border-emerald-200 text-emerald-700'
                        : 'bg-red-50 border-red-200 text-red-700'
                ].join(' ');

            window.setTimeout(
                () => {
                    box.classList.add(
                        'hidden'
                    );
                },
                3500
            );
        }


        function updateSummary() {
            const total =
                catalogEntries.length;

            const published =
                catalogEntries.filter(
                    isPublished
                ).length;

            const hidden =
                total -
                published;

            const syncDates =
                catalogEntries
                    .map(
                        getSyncDate
                    )
                    .filter(
                        Boolean
                    )
                    .map(
                        value =>
                            new Date(
                                value
                            )
                    )
                    .filter(
                        date =>
                            !Number.isNaN(
                                date.getTime()
                            )
                    )
                    .sort(
                        (a, b) =>
                            b -
                            a
                    );

            document
                .getElementById(
                    'totalCount'
                )
                .textContent =
                    total;

            document
                .getElementById(
                    'publishedCount'
                )
                .textContent =
                    published;

            document
                .getElementById(
                    'hiddenCount'
                )
                .textContent =
                    hidden;

            document
                .getElementById(
                    'lastSyncSummary'
                )
                .textContent =
                    syncDates.length
                        ? formatDate(
                            syncDates[0]
                        )
                        : 'Nunca';
        }


        function getFilteredEntries() {
            const search =
                document
                    .getElementById(
                        'searchInput'
                    )
                    .value
                    .trim()
                    .toLowerCase();

            const status =
                document
                    .getElementById(
                        'statusFilter'
                    )
                    .value;

            const selectedCategory =
                document
                    .getElementById(
                        'categoryFilter'
                    )
                    .value;

            const minimumCommission =
                Number(
                    document
                        .getElementById(
                            'commissionFilter'
                        )
                        .value ||
                    0
                );

            const filteredEntries =
                catalogEntries.filter(
                    entry => {
                    const product =
                        getProduct(
                            entry
                        );

                    const primaryCategory =
                        getPrimaryCategory(
                            product
                        );

                    const matchesSearch =
                        !search ||
                        String(
                            product.title ||
                            ''
                        )
                            .toLowerCase()
                            .includes(
                                search
                            ) ||
                        String(
                            product.itemId ||
                            ''
                        )
                            .includes(
                                search
                            );

                    const published =
                        isPublished(
                            entry
                        );

                    const matchesStatus =
                        status ===
                        'all' ||
                        (
                            status ===
                            'published' &&
                            published
                        ) ||
                        (
                            status ===
                            'hidden' &&
                            !published
                        );

                    const matchesCategory =
                        selectedCategory ===
                        'all' ||
                        normalizeText(
                            primaryCategory
                        ) ===
                        normalizeText(
                            selectedCategory
                        );

                    const commission =
                        Number(
                            product.commissionRate
                        );

                    const matchesCommission =
                        minimumCommission <=
                        0 ||
                        (
                            Number.isFinite(
                                commission
                            ) &&
                            commission >=
                            minimumCommission
                        );

                    return (
                        matchesSearch &&
                        matchesStatus &&
                        matchesCategory &&
                        matchesCommission
                    );
                }
            );

            return sortEntries(
                filteredEntries
            );
        }


        function createStatusBadge(
            entry
        ) {
            if (
                isPublished(
                    entry
                )
            ) {
                return `
                    <span
                        class="
                            inline-flex
                            items-center
                            gap-1.5
                            rounded-full
                            bg-emerald-50
                            text-emerald-700
                            px-2.5
                            py-1
                            text-xs
                            font-bold
                        "
                    >
                        <span
                            class="
                                w-1.5
                                h-1.5
                                rounded-full
                                bg-emerald-500
                            "
                        ></span>
                        Publicado
                    </span>
                `;
            }

            return `
                <span
                    class="
                        inline-flex
                        items-center
                        gap-1.5
                        rounded-full
                        bg-slate-100
                        text-slate-600
                        px-2.5
                        py-1
                        text-xs
                        font-bold
                    "
                >
                    <span
                        class="
                            w-1.5
                            h-1.5
                            rounded-full
                            bg-slate-400
                        "
                    ></span>
                    Oculto
                </span>
            `;
        }


        function createDesktopRow(
            entry
        ) {
            const product =
                getProduct(
                    entry
                );

            const marketplace =
                product.marketplace ||
                'shopee';

            const itemId =
                product.itemId ||
                '';

            const position =
                entry
                    ?.visibility
                    ?.position ??
                '';

            return `
                <tr class="align-middle">
                    <td class="px-3 py-4">
                        <div
                            class="
                                flex
                                items-center
                                gap-3
                                min-w-[250px]
                            "
                        >
                            <img
                                src="${escapeHtml(product.image)}"
                                alt=""
                                class="
                                    w-14
                                    h-14
                                    rounded-xl
                                    object-cover
                                    bg-slate-100
                                    shrink-0
                                "
                            >

                            <div>
                                <div
                                    class="
                                        font-bold
                                        text-sm
                                        line-clamp-2
                                    "
                                >
                                    ${
                                        product?.metadata?.productLink
                                            ? `
                                                <a
                                                    href="${escapeHtml(product.metadata.productLink)}"
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    title="Abrir produto na Shopee"
                                                    class="
                                                        hover:text-sky-700
                                                        hover:underline
                                                        cursor-pointer
                                                        transition
                                                    "
                                                >
                                                    ${escapeHtml(product.title)}
                                                </a>
                                            `
                                            : escapeHtml(product.title)
                                    }
                                </div>

                                <div
                                    class="
                                        mt-1
                                        text-xs
                                        text-slate-400
                                    "
                                >
                                    ID ${escapeHtml(itemId)}
                                </div>
                            </div>
                        </div>
                    </td>

                    <td
                        class="
                            px-3
                            py-4
                            whitespace-nowrap
                        "
                    >
                        ${formatPrice(product.price)}
                    </td>

                    <td
                        class="
                            px-3
                            py-4
                            text-sky-700
                            whitespace-nowrap
                        "
                    >
                        ${formatCommission(product.commissionRate)}
                    </td>

                    <td
                        class="
                            px-3
                            py-4
                            text-emerald-700
                            whitespace-nowrap
                        "
                    >
                        ${formatPrice(product.commission)}
                    </td>

                    <td
                        class="
                            px-3
                            py-4
                            whitespace-nowrap
                        "
                    >
                        ${formatSales(product.sales)}
                    </td>

                    <td
                        class="
                            px-3
                            py-4
                            text-amber-600
                            whitespace-nowrap
                        "
                    >
                        ${formatRating(product.ratingStar)}
                    </td>

                    <td class="px-3 py-4">
                        ${createStatusBadge(entry)}
                    </td>

                    <td class="px-3 py-4">
                        <input
                            type="number"
                            min="1"
                            value="${escapeHtml(position)}"
                            data-position-marketplace="${escapeHtml(marketplace)}"
                            data-position-item-id="${escapeHtml(itemId)}"
                            class="
                                w-16
                                rounded-lg
                                border
                                border-slate-200
                                px-2
                                py-2
                                text-sm
                            "
                        >
                    </td>

                    <td class="px-3 py-4">
                        <select
                            aria-label="Ação de publicação"
                            onchange="handlePublicationAction(
                                this,
                                '${escapeHtml(marketplace)}',
                                '${escapeHtml(itemId)}'
                            )"
                            class="
                                rounded-xl
                                border
                                border-slate-200
                                bg-white
                                px-2
                                py-2
                                text-xs
                                outline-none
