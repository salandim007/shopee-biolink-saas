<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>TikTok — Central de Marketing</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    >
</head>

<body class="bg-slate-50 text-slate-900">

    <header class="bg-white border-b border-slate-200 sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">

            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-sky-100 text-sky-700 flex items-center justify-center">
                    <i class="fa-solid fa-bullhorn"></i>
                </div>

                <div>
                    <h1 class="text-xl sm:text-2xl font-extrabold">
                        Central de Marketing
                    </h1>

                    <p class="text-sm text-slate-500">
                        Produtos e estruturas próprias para TikTok.
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <a
                    href="/admin/vitrine2"
                    class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-sm font-bold transition"
                >
                    <i class="fa-solid fa-arrow-left"></i>
                    Catálogo
                </a>

                <a
                    href="/vitrine2"
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-sm font-bold transition"
                >
                    <i class="fa-solid fa-store"></i>
                    Abrir Vitrine
                </a>
            </div>
        </div>


        <nav class="max-w-7xl mx-auto px-4 sm:px-6 pb-4">
            <div class="flex gap-2 overflow-x-auto pb-1">
                <a href="/admin/vitrine2/marketing/overview" class="inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-bold transition bg-white text-slate-600 hover:bg-slate-100 border border-slate-200">
                    <i class="fa-solid fa-chart-line"></i> Visão Geral
                </a>
                <a href="/admin/vitrine2/marketing/instagram" class="inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-bold transition bg-white text-slate-600 hover:bg-slate-100 border border-slate-200">
                    <i class="fa-brands fa-instagram"></i> Instagram
                </a>
                <a href="/admin/vitrine2/marketing/facebook" class="inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-bold transition bg-white text-slate-600 hover:bg-slate-100 border border-slate-200">
                    <i class="fa-brands fa-facebook"></i> Facebook
                </a>
                <a href="/admin/vitrine2/marketing/tiktok" class="inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-bold transition bg-sky-600 text-white">
                    <i class="fa-brands fa-tiktok"></i> TikTok
                </a>
                <a href="/admin/vitrine2/marketing/kwai" class="inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-bold transition bg-white text-slate-600 hover:bg-slate-100 border border-slate-200">
                    <i class="fa-solid fa-video"></i> Kwai
                </a>
                <a href="/admin/vitrine2/marketing/outros" class="inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-bold transition bg-white text-slate-600 hover:bg-slate-100 border border-slate-200">
                    <i class="fa-solid fa-share-nodes"></i> Outros canais
                </a>
            </div>
        </nav>

    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6">

        <section class="rounded-2xl border border-slate-200 bg-white p-5 mb-6">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                <div>
                    <div class="text-xs uppercase tracking-wide font-bold text-slate-800">
                        Estrutura preparada
                    </div>

                    <h2 class="mt-1 text-xl font-extrabold">
                        TikTok
                    </h2>

                    <p class="mt-2 text-sm text-slate-500 max-w-3xl">
                        TikTok será tratado como canal de vídeo vertical, com criativos e automações específicos em uma fase futura.
                    </p>
                </div>

                <div class="rounded-xl bg-slate-50 border border-slate-200 px-4 py-3 text-sm text-slate-500">
                    Nesta fase os produtos já ficam anexados ao canal. Publicação, criativos e automações entram depois.
                </div>
            </div>
        </section>

        <section class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3 mb-6">
            <div class="bg-white border border-slate-200 rounded-2xl p-4">
                <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-800 flex items-center justify-center mb-3">
                    <i class="fa-solid fa-film"></i>
                </div>
                <h3 class="font-extrabold">Vídeos</h3>
                <p class="mt-1 text-sm text-slate-500">Estrutura principal de conteúdo vertical.</p>
                <div class="mt-3 text-xs font-bold text-slate-400 uppercase tracking-wide">
                    Ação será definida depois
                </div>
            </div>
<div class="bg-white border border-slate-200 rounded-2xl p-4">
                <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-800 flex items-center justify-center mb-3">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                </div>
                <h3 class="font-extrabold">Criativos</h3>
                <p class="mt-1 text-sm text-slate-500">Área futura de roteiro, gancho e edição.</p>
                <div class="mt-3 text-xs font-bold text-slate-400 uppercase tracking-wide">
                    Ação será definida depois
                </div>
            </div>
<div class="bg-white border border-slate-200 rounded-2xl p-4">
                <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-800 flex items-center justify-center mb-3">
                    <i class="fa-solid fa-calendar-days"></i>
                </div>
                <h3 class="font-extrabold">Agenda</h3>
                <p class="mt-1 text-sm text-slate-500">Preparação para publicação programada.</p>
                <div class="mt-3 text-xs font-bold text-slate-400 uppercase tracking-wide">
                    Ação será definida depois
                </div>
            </div>
        </section>

        <section>
            <div class="mb-3 flex items-center justify-between gap-3">
                <div>
                    <h2 class="font-extrabold">
                        Produtos disponíveis
                    </h2>
                    <p class="text-sm text-slate-500">
                        Produtos publicados no catálogo já conectados à área de TikTok.
                    </p>
                </div>

                <div id="tiktokCounter" class="text-sm font-bold text-slate-500">
                    —
                </div>
            </div>

            <div id="tiktokProducts" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
                <div class="bg-white border border-slate-200 rounded-2xl p-8 text-center text-slate-500 md:col-span-2 xl:col-span-3">
                    Carregando produtos...
                </div>
            </div>
        </section>

    </main>

    <script>
        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function formatPrice(value) {
            const number = Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return new Intl.NumberFormat(
                'pt-BR',
                {
                    style: 'currency',
                    currency: 'BRL'
                }
            ).format(number);
        }

        function formatCommission(value) {
            const number = Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return `${(number * 100).toFixed(1).replace('.0', '')}%`;
        }

        function formatSales(value) {
            const number = Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return new Intl.NumberFormat('pt-BR').format(number);
        }

        function formatRating(value) {
            const number = Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return `${number.toFixed(1).replace('.', ',')} ★`;
        }

        function productLink(product) {
            return product?.metadata?.productLink || product?.affiliateLink || '#';
        }

        async function fetchCatalogProducts() {
            const response =
                await fetch(
                    '/api/vitrine2/products'
                );

            const data =
                await response.json();

            if (
                !response.ok ||
                !data.success
            ) {
                throw new Error(
                    data.error ||
                    'Falha ao carregar produtos.'
                );
            }

            return (
                Array.isArray(data.products)
                    ? data.products
                    : []
            )
                .filter(
                    entry =>
                        entry?.visibility?.published
                )
                .map(
                    entry => ({
                        entry,
                        product:
                            entry.product || {}
                    })
                );
        }


        function renderChannelProducts(items) {
            const container =
                document.getElementById(
                    'tiktokProducts'
                );

            document
                .getElementById(
                    'tiktokCounter'
                )
                .textContent =
                    `${items.length} produtos`;

            container.innerHTML =
                items
                    .map(
                        ({ product }) => `
                            <article class="bg-white border border-slate-200 rounded-2xl p-4">
                                <div class="flex gap-3">
                                    <img
                                        src="${escapeHtml(product.image)}"
                                        alt=""
                                        class="w-20 h-20 rounded-xl object-cover bg-slate-100 shrink-0"
                                    >

                                    <div class="min-w-0">
                                        <a
                                            href="${escapeHtml(productLink(product))}"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="font-bold text-sm line-clamp-2 hover:text-sky-700 hover:underline"
                                        >
                                            ${escapeHtml(product.title)}
                                        </a>

                                        <div class="mt-2 grid grid-cols-2 gap-x-3 gap-y-1 text-xs">
                                            <div>
                                                <span class="text-slate-400">Comissão</span>
                                                <div class="text-sky-700">${formatCommission(product.commissionRate)}</div>
                                            </div>

                                            <div>
                                                <span class="text-slate-400">Estimada</span>
                                                <div class="text-emerald-700">${formatPrice(product.commission)}</div>
                                            </div>

                                            <div>
                                                <span class="text-slate-400">Vendas</span>
                                                <div>${formatSales(product.sales)}</div>
                                            </div>

                                            <div>
                                                <span class="text-slate-400">Avaliação</span>
                                                <div class="text-amber-600">${formatRating(product.ratingStar)}</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-4 rounded-xl border border-dashed border-slate-200 bg-slate-50 px-3 py-2.5 text-center text-xs font-bold text-slate-400">
                                    Ação de TikTok: próxima fase
                                </div>
                            </article>
                        `
                    )
                    .join('');
        }


        async function loadChannelProducts() {
            try {
                const items =
                    await fetchCatalogProducts();

                renderChannelProducts(
                    items
                );
            } catch (error) {
                document
                    .getElementById(
                        'tiktokProducts'
                    )
                    .innerHTML =
                        `
                            <div class="bg-white border border-red-200 rounded-2xl p-8 text-center text-red-600 md:col-span-2 xl:col-span-3">
                                ${escapeHtml(error.message)}
                            </div>
                        `;
            }
        }


        loadChannelProducts();

    </script>
</body>
</html>
