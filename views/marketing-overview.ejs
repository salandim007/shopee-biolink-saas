    <script>
        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }


        function formatPrice(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return new Intl.NumberFormat(
                'pt-BR',
                {
                    style: 'currency',
                    currency: 'BRL'
                }
            ).format(number);
        }


        function formatCommission(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return `${(number * 100)
                .toFixed(1)
                .replace('.0', '')}%`;
        }


        function formatSales(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return new Intl.NumberFormat(
                'pt-BR'
            ).format(number);
        }


        function formatRating(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return `${number
                .toFixed(1)
                .replace('.', ',')} ★`;
        }


        function productLink(product) {
            return (
                product?.metadata?.productLink ||
                product?.affiliateLink ||
                '#'
            );
        }


        function updateStickyTableOffset() {
            const header =
                document.getElementById(
                    'adminHeader'
                );

            if (!header) {
                return;
            }

            document.documentElement.style.setProperty(
                '--admin-header-height',
                `${header.offsetHeight}px`
            );
        }


        function normalizedScore(
            value,
            maxValue
        ) {
            const number =
                Number(value);

            const max =
                Number(maxValue);

            if (
                !Number.isFinite(number) ||
                !Number.isFinite(max) ||
                max <= 0
            ) {
                return 0;
            }

            return Math.max(
                0,
                Math.min(
                    100,
                    (number / max) * 100
                )
            );
        }


        function calculateOpportunityScores(
            items
        ) {
            const maxCommissionRate =
                Math.max(
                    0,
                    ...items.map(
                        item =>
                            Number(
                                item.product?.commissionRate
                            ) || 0
                    )
                );

            const maxCommission =
                Math.max(
                    0,
                    ...items.map(
                        item =>
                            Number(
                                item.product?.commission
                            ) || 0
                    )
                );

            const maxSales =
                Math.max(
                    0,
                    ...items.map(
                        item =>
                            Number(
                                item.product?.sales
                            ) || 0
                    )
                );

            return items.map(
                item => {
                    const product =
                        item.product || {};

                    const commissionRateScore =
                        normalizedScore(
                            product.commissionRate,
                            maxCommissionRate
                        );

                    const commissionScore =
                        normalizedScore(
                            product.commission,
                            maxCommission
                        );

                    const salesScore =
                        normalizedScore(
                            product.sales,
                            maxSales
                        );

                    const ratingScore =
                        normalizedScore(
                            product.ratingStar,
                            5
                        );

                    const opportunityScore =
                        (
                            commissionRateScore * 0.30 +
                            commissionScore * 0.30 +
                            salesScore * 0.25 +
                            ratingScore * 0.15
                        );

                    let opportunityLevel =
                        'Baixa';

                    if (
                        opportunityScore >= 80
                    ) {
                        opportunityLevel =
                            'Alta';
                    }
                    else if (
                        opportunityScore >= 55
                    ) {
                        opportunityLevel =
                            'Média';
                    }

                    return {
                        ...item,

                        opportunityScore:
                            Math.round(
                                opportunityScore
                            ),

                        opportunityLevel
                    };
                }
            );
        }


        function opportunityBadge(level) {
            if (level === 'Alta') {
                return `
                    <span
                        class="
