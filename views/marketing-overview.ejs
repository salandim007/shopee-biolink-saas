                                        py-4
                                        text-slate-700
                                        whitespace-nowrap
                                    "
                                >
                                    ${formatPrice(product.commission)}
                                </td>

                                <td
                                    class="
                                        px-3
                                        py-4
                                        text-slate-700
                                        whitespace-nowrap
                                    "
                                >
                                    ${formatSales(product.sales)}
                                </td>

                                <td
                                    class="
                                        px-3
                                        py-4
                                        text-slate-700
                                        whitespace-nowrap
                                    "
                                >
                                    ${formatRating(product.ratingStar)}
                                </td>

                                <td
                                    class="
                                        px-3
                                        py-4
                                        whitespace-nowrap
                                    "
                                >
                                    ${opportunityBadge(opportunityLevel)}
                                </td>

                                <td
                                    class="
                                        px-3
                                        py-4
                                        whitespace-nowrap
                                    "
                                >
                                    <span
                                        class="
                                            font-bold
                                            text-slate-900
                                        "
                                    >
                                        ${escapeHtml(opportunityScore)}
                                    </span>

                                    <span
                                        class="
                                            text-xs
                                            text-slate-400
                                        "
                                    >
                                        /100
                                    </span>
