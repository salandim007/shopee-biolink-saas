    <script>
        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }


        function formatPrice(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return new Intl.NumberFormat(
                'pt-BR',
                {
                    style: 'currency',
                    currency: 'BRL'
                }
            ).format(number);
        }


        function formatCommission(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return `${(number * 100)
                .toFixed(1)
                .replace('.0', '')}%`;
        }


        function formatSales(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return new Intl.NumberFormat(
                'pt-BR'
            ).format(number);
        }


        function formatRating(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return `${number
                .toFixed(1)
                .replace('.', ',')} ★`;
        }


        function productLink(product) {
            return (
                product?.metadata?.productLink ||
                product?.affiliateLink ||
                '#'
            );
        }


        function updateStickyTableOffset() {
            const header =
                document.getElementById(
                    'adminHeader'
                );

            if (!header) {
                return;
            }

            document.documentElement.style.setProperty(
                '--admin-header-height',
                `${header.offsetHeight}px`
            );
        }


        function normalizedScore(
            value,
            maxValue
        ) {
            const number =
                Number(value);

            const max =
                Number(maxValue);

            if (
                !Number.isFinite(number) ||
                !Number.isFinite(max) ||
                max <= 0
            ) {
                return 0;
            }

            return Math.max(
                0,
                Math.min(
                    100,
                    (number / max) * 100
                )
            );
        }


        function calculateOpportunityScores(
            items
        ) {
            const maxCommissionRate =
                Math.max(
                    0,
                    ...items.map(
                        item =>
                            Number(
                                item.product?.commissionRate
                            ) || 0
                    )
                );

            const maxCommission =
                Math.max(
                    0,
                    ...items.map(
                        item =>
                            Number(
                                item.product?.commission
                            ) || 0
                    )
                );

            const maxSales =
                Math.max(
                    0,
                    ...items.map(
                        item =>
                            Number(
                                item.product?.sales
                            ) || 0
                    )
                );

            return items.map(
                item => {
                    const product =
                        item.product || {};

                    const commissionRateScore =
                        normalizedScore(
                            product.commissionRate,
                            maxCommissionRate
                        );

                    const commissionScore =
                        normalizedScore(
                            product.commission,
                            maxCommission
                        );

                    const salesScore =
                        normalizedScore(
                            product.sales,
                            maxSales
                        );

                    const ratingScore =
                        normalizedScore(
                            product.ratingStar,
                            5
                        );

                    const opportunityScore =
                        (
                            commissionRateScore * 0.30 +
                            commissionScore * 0.30 +
                            salesScore * 0.25 +
                            ratingScore * 0.15
                        );

                    let opportunityLevel =
                        'Baixa';

                    if (
                        opportunityScore >= 80
                    ) {
                        opportunityLevel =
                            'Alta';
                    }
                    else if (
                        opportunityScore >= 55
                    ) {
                        opportunityLevel =
                            'Média';
                    }

                    return {
                        ...item,

                        opportunityScore:
                            Math.round(
                                opportunityScore
                            ),

                        opportunityLevel
                    };
                }
            );
        }


        function opportunityBadge(level) {
            if (level === 'Alta') {
                return `
                    <span
                        class="
                            inline-flex
                            items-center
                            rounded-full
                            bg-emerald-50
                            text-emerald-700
                            px-2.5
                            py-1
                            text-xs
                            font-bold
                        "
                    >
                        Alta
                    </span>
                `;
            }

            if (level === 'Média') {
                return `
                    <span
                        class="
                            inline-flex
                            items-center
                            rounded-full
                            bg-amber-50
                            text-amber-700
                            px-2.5
                            py-1
                            text-xs
                            font-bold
                        "
                    >
                        Média
                    </span>
                `;
            }

            return `
                <span
                    class="
                        inline-flex
                        items-center
                        rounded-full
                        bg-slate-100
                        text-slate-600
                        px-2.5
                        py-1
                        text-xs
                        font-bold
                    "
                >
                    Baixa
                </span>
            `;
        }


        async function fetchCatalogProducts() {
            const response =
                await fetch(
                    '/api/vitrine2/products'
                );

            const data =
                await response.json();

            if (
                !response.ok ||
                !data.success
            ) {
                throw new Error(
                    data.error ||
                    'Falha ao carregar produtos.'
                );
            }

            return (
                Array.isArray(
                    data.products
                )
                    ? data.products
                    : []
            )
                .filter(
                    entry =>
                        entry?.visibility?.published
                )
                .map(
                    entry => ({
                        entry,
                        product:
                            entry.product || {}
                    })
                );
        }


        let overviewItems = [];


        function renderOverview() {
            const sortKey =
                document
                    .getElementById(
                        'overviewSort'
                    )
                    .value;

            const items =
                [...overviewItems]
                    .sort(
                        (a, b) => {
                            if (
                                sortKey ===
                                'opportunityScore'
                            ) {
                                return (
                                    Number(
                                        b.opportunityScore
                                    ) || 0
                                ) -
                                (
                                    Number(
                                        a.opportunityScore
                                    ) || 0
                                );
                            }

                            return (
                                Number(
                                    b.product?.[sortKey]
                                ) || 0
                            ) -
                            (
                                Number(
                                    a.product?.[sortKey]
                                ) || 0
                            );
                        }
                    );

            const body =
                document.getElementById(
                    'overviewProducts'
                );

            if (items.length === 0) {
                body.innerHTML =
                    `
                        <tr>
                            <td
                                colspan="8"
                                class="
                                    px-3
                                    py-10
                                    text-center
                                    text-slate-500
                                "
                            >
                                Nenhum produto publicado disponível para Marketing.
                            </td>
                        </tr>
                    `;

                return;
            }

            body.innerHTML =
                items
                    .map(
                        ({
                            product,
                            opportunityScore,
                            opportunityLevel
                        }) => `
                            <tr>

                                <td class="px-3 py-4">
                                    <div
                                        class="
                                            flex
                                            items-center
                                            gap-3
                                            min-w-[250px]
                                        "
                                    >
                                        <img
                                            src="${escapeHtml(product.image)}"
                                            alt=""
                                            class="
                                                w-12
                                                h-12
                                                rounded-xl
                                                object-cover
                                                bg-slate-100
                                                flex-shrink-0
                                            "
                                        >

                                        <div>
                                            <a
                                                href="${escapeHtml(productLink(product))}"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="
                                                    font-bold
                                                    text-sm
                                                    text-slate-900
                                                    hover:text-sky-700
                                                    hover:underline
                                                "
                                            >
                                                ${escapeHtml(product.title)}
                                            </a>

                                            <div
                                                class="
                                                    mt-1
                                                    text-xs
                                                    text-slate-400
                                                "
                                            >
                                                ID ${escapeHtml(product.itemId)}
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td
                                    class="
                                        px-3
                                        py-4
                                        text-slate-700
                                        whitespace-nowrap
                                    "
                                >
                                    ${formatCommission(product.commissionRate)}
                                </td>

                                <td
                                    class="
                                        px-3
                                        py-4
                                        text-slate-700
                                        whitespace-nowrap
                                    "
                                >
                                    ${formatPrice(product.commission)}
                                </td>

                                <td
                                    class="
                                        px-3
                                        py-4
                                        text-slate-700
                                        whitespace-nowrap
                                    "
                                >
                                    ${formatSales(product.sales)}
                                </td>

                                <td
                                    class="
                                        px-3
                                        py-4
                                        text-slate-700
                                        whitespace-nowrap
                                    "
                                >
                                    ${formatRating(product.ratingStar)}
                                </td>

                                <td
                                    class="
                                        px-3
                                        py-4
                                        whitespace-nowrap
                                    "
                                >
                                    ${opportunityBadge(opportunityLevel)}
                                </td>

                                <td
                                    class="
                                        px-3
                                        py-4
                                        whitespace-nowrap
                                    "
                                >
                                    <span
                                        class="
                                            font-bold
                                            text-slate-900
                                        "
                                    >
                                        ${escapeHtml(opportunityScore)}
                                    </span>

                                    <span
                                        class="
                                            text-xs
                                            text-slate-400
                                        "
                                    >
                                        /100
                                    </span>
                                </td>

                                <td class="px-3 py-4">
                                    <div
                                        class="
                                            flex
                                            flex-wrap
                                            gap-1.5
                                        "
                                    >
                                        <span
                                            class="
                                                rounded-full
                                                bg-pink-50
                                                text-pink-700
                                                px-2
                                                py-1
                                                text-xs
                                                font-bold
                                            "
                                        >
                                            Instagram
                                        </span>

                                        <span
                                            class="
                                                rounded-full
                                                bg-blue-50
                                                text-blue-700
                                                px-2
                                                py-1
                                                text-xs
                                                font-bold
                                            "
                                        >
                                            Facebook
                                        </span>

                                        <span
                                            class="
                                                rounded-full
                                                bg-slate-100
                                                text-slate-700
                                                px-2
                                                py-1
                                                text-xs
                                                font-bold
                                            "
                                        >
                                            TikTok
                                        </span>

                                        <span
                                            class="
                                                rounded-full
                                                bg-orange-50
                                                text-orange-700
                                                px-2
                                                py-1
                                                text-xs
                                                font-bold
                                            "
                                        >
                                            Kwai
                                        </span>
                                    </div>
                                </td>

                            </tr>
                        `
                    )
                    .join('');

            updateStickyTableOffset();
        }


        async function loadOverview() {
            try {
                overviewItems =
                    calculateOpportunityScores(
                        await fetchCatalogProducts()
                    );

                renderOverview();
            }
            catch (error) {
                document
                    .getElementById(
                        'overviewProducts'
                    )
                    .innerHTML =
                        `
                            <tr>
                                <td
                                    colspan="8"
                                    class="
                                        px-3
                                        py-10
                                        text-center
                                        text-red-600
                                    "
                                >
                                    ${escapeHtml(error.message)}
                                </td>
                            </tr>
                        `;
            }
        }


        document
            .getElementById(
                'overviewSort'
            )
            .addEventListener(
                'change',
                renderOverview
            );


        window.addEventListener(
            'resize',
            updateStickyTableOffset
        );

        window.addEventListener(
            'load',
            updateStickyTableOffset
        );


        updateStickyTableOffset();
        loadOverview();

    </script>

</body>
