                        rounded-full
                        bg-slate-100
                        text-slate-600
                        px-2.5
                        py-1
                        text-xs
                        font-bold
                    "
                >
                    Baixa
                </span>
            `;
        }


        async function fetchCatalogProducts() {
            const response =
                await fetch(
                    '/api/vitrine2/products'
                );

            const data =
                await response.json();

            if (
                !response.ok ||
                !data.success
            ) {
                throw new Error(
                    data.error ||
                    'Falha ao carregar produtos.'
                );
            }

            return (
                Array.isArray(
                    data.products
                )
                    ? data.products
                    : []
            )
                .filter(
                    entry =>
                        entry?.visibility?.published
                )
                .map(
                    entry => ({
                        entry,
                        product:
                            entry.product || {}
                    })
                );
        }


        let overviewItems = [];

        const marketingChannelDefinitions = [
            {
                key: 'instagram',
                label: 'Instagram',
                selectedClass:
                    'bg-pink-50 text-pink-700'
            },
            {
