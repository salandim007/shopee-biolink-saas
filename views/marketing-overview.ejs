                label: 'Pinterest',
                selectedClass:
                    'bg-violet-50 text-violet-700'
            }
        ];


        function renderMarketingChannels(
            entry,
            product
        ) {
            const channels =
                entry?.marketing?.channels ||
                {};

            const selectedChannels =
                marketingChannelDefinitions
                    .filter(
                        channel =>
                            channels[channel.key] ===
                            true
                    );

            const selectedHtml =
                selectedChannels.length
                    ? selectedChannels
                        .map(
                            channel => `
