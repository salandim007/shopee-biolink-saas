        async function setMarketingSelected(
            marketplace,
            itemId,
            selected
        ) {
            try {
                const response =
                    await fetch(
                        `/api/vitrine2/products/${encodeURIComponent(
                            marketplace
                        )}/${encodeURIComponent(
                            itemId
                        )}/marketing/selected`,
                        {
                            method: 'PATCH',

                            headers: {
                                'Content-Type':
                                    'application/json'
                            },

                            body:
                                JSON.stringify({
                                    selected
                                })
                        }
                    );

                const data =
                    await response.json();

                if (
                    !response.ok ||
                    !data.success
                ) {
                    throw new Error(
                        data.error ||
                        'Não foi possível alterar a seleção de Marketing.'
                    );
                }

                const updatedEntry =
                    data.entry;

                overviewItems =
                    overviewItems.map(
                        item => {
                            const sameMarketplace =
                                String(
                                    item.product
                                        ?.marketplace ||
                                    'shopee'
                                )
                                    .toLowerCase() ===
                                String(
                                    marketplace ||
                                    ''
                                )
                                    .toLowerCase();

                            const sameItemId =
                                String(
                                    item.product
                                        ?.itemId ||
                                    ''
                                ) ===
                                String(
                                    itemId ||
                                    ''
                                );

                            if (
                                !sameMarketplace ||
                                !sameItemId
                            ) {
                                return item;
                            }

                            return {
                                ...item,

                                entry: {
                                    ...item.entry,

                                    marketing:
                                        updatedEntry
                                            ?.marketing ||
                                        item.entry
                                            ?.marketing
                                }
                            };
                        }
                    );

                                renderOverview();
    
            }
            catch (error) {
                console.error(
                    '[MARKETING] Erro ao alterar seleção:',
                    error
                );

                window.alert(
                    error.message ||
                    'Não foi possível alterar a seleção de Marketing.'
                );
            }
        }

        async function setMarketingChannel(
            marketplace,
            itemId,
            channel,
            enabled
        ) {
            try {
                const response =
                    await fetch(
                        `/api/vitrine2/products/${encodeURIComponent(
                            marketplace
                        )}/${encodeURIComponent(
                            itemId
                        )}/marketing/channel/${encodeURIComponent(
                            channel
                        )}`,
                        {
                            method: 'PATCH',

                            headers: {
                                'Content-Type':
                                    'application/json'
                            },

                            body:
                                JSON.stringify({
                                    enabled
                                })
                        }
                    );

                const data =
                    await response.json();

                if (
                    !response.ok ||
                    !data.success
                ) {
                    throw new Error(
                        data.error ||
                        'Não foi possível alterar o canal de Marketing.'
                    );
                }

                const updatedEntry =
                    data.entry;

                overviewItems =
                    overviewItems.map(
                        item => {
                            const sameMarketplace =
                                String(
                                    item.product
                                        ?.marketplace ||
                                    'shopee'
                                )
                                    .toLowerCase() ===
                                String(
                                    marketplace ||
                                    ''
                                )
                                    .toLowerCase();

                            const sameItemId =
                                String(
                                    item.product
                                        ?.itemId ||
                                    ''
                                ) ===
                                String(
                                    itemId ||
                                    ''
                                );

                            if (
                                !sameMarketplace ||
                                !sameItemId
                            ) {
                                return item;
                            }

                            return {
                                ...item,

                                entry: {
                                    ...item.entry,

                                    marketing:
                                        updatedEntry
                                            ?.marketing ||
                                        item.entry
                                            ?.marketing
                                }
                            };
                        }
                    );

                                renderOverview();

                const channelLabelMap = {
                    instagram: 'Instagram',
                    facebook: 'Facebook',
                    tiktok: 'TikTok',
                    kwai: 'Kwai',
                    outros: 'Pinterest'
                };

                const actionText =
                    enabled
                        ? 'adicionado ao'
                        : 'removido do';

                const channelLabel =
                    channelLabelMap[channel] ||
                    channel;

                window.alert(
                    `Produto ${actionText} ${channelLabel}.`
                );
            }
            catch (error) {
                console.error(
                    '[MARKETING] Erro ao alterar canal:',
                    error
                );

                window.alert(
                    error.message ||
                    'Não foi possível alterar o canal de Marketing.'
                );
            }
        }

        async function loadOverview() {
            try {
                overviewItems =
                    calculateOpportunityScores(
                        await fetchCatalogProducts()
                    );

                renderOverview();
            }
            catch (error) {
                document
                    .getElementById(
                        'overviewProducts'
                    )
                    .innerHTML =
                        `
                            <tr>
                                <td
                                    colspan="9"
                                    class="
                                        px-3
                                        py-10
                                        text-center
                                        text-red-600
                                    "
                                >
                                    ${escapeHtml(error.message)}
                                </td>
                            </tr>
                        `;
            }
        }


        document
            .getElementById(
                'overviewSort'
            )
            .addEventListener(
                'change',
                renderOverview
            );

                    document
            .getElementById(
                'overviewChannelFilter'
            )
            .addEventListener(
                'change',
                renderOverview
            );

        window.addEventListener(
            'resize',
            updateStickyTableOffset
        );

        window.addEventListener(
            'load',
            updateStickyTableOffset
        );


        updateStickyTableOffset();
        loadOverview();

    </script>

</body>
