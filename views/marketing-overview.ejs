                                        whitespace-nowrap
                                    "
                                >
                                    ${
                                        entry?.marketing?.selected
                                            ? `
                                                <button
                                                    type="button"
                                                    onclick="setMarketingSelected(
                                                        '${escapeHtml(product.marketplace || 'shopee')}',
                                                        '${escapeHtml(product.itemId || '')}',
                                                        false
                                                    )"
                                                    class="
                                                        inline-flex
                                                        items-center
                                                        justify-center
                                                        gap-2
                                                        rounded-xl
                                                        bg-emerald-50
                                                        hover:bg-emerald-100
