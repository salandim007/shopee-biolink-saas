                                    class="
                                        inline-flex
                                        items-center
                                        rounded-full
                                        ${channel.selectedClass}
                                        px-2
                                        py-1
                                        text-xs
                                        font-bold
                                    "
                                >
                                    ${escapeHtml(channel.label)}
                                </span>
                            `
                        )
                        .join('')
                    : `
                        <span
                            class="
                                text-xs
                                text-slate-400
                            "
                        >
                            Nenhum
                        </span>
                    `;

            const optionsHtml =
                marketingChannelDefinitions
                    .map(
                        channel => {
                            const enabled =
                                channels[channel.key] ===
                                true;

                            return `
                                <button
                                    type="button"
                                    onclick="setMarketingChannel(
                                        '${escapeHtml(product.marketplace || 'shopee')}',
                                        '${escapeHtml(product.itemId || '')}',
                                        '${escapeHtml(channel.key)}',
                                        ${enabled ? 'false' : 'true'}
                                    )"
                                    class="
                                        w-full
                                        flex
                                        items-center
                                        justify-between
                                        gap-3
                                        rounded-lg
                                        px-3
                                        py-2
                                        text-left
                                        text-xs
                                        font-bold
                                        transition
                                        ${
                                            enabled
                                                ? channel.selectedClass
                                                : 'bg-white text-slate-600 hover:bg-slate-50'
                                        }
                                    "
                                >
                                    <span>
                                        ${escapeHtml(channel.label)}
                                    </span>

                                    <i
                                        class="
                                            fa-solid
                                            ${
                                                enabled
                                                    ? 'fa-check'
                                                    : 'fa-plus'
                                            }
                                        "
                                    ></i>
                                </button>
                            `;
                        }
                    )
                    .join('');

            return `
                <div
                    class="
                        flex
                        flex-wrap
                        items-center
                        gap-1.5
                    "
                >
                    ${selectedHtml}

                    <details
                        class="
                            relative
                            inline-block
                        "
                    >
                        <summary
                            class="
                                list-none
                                cursor-pointer
                                inline-flex
                                items-center
                                justify-center
                                rounded-full
                                bg-slate-50
                                hover:bg-slate-100
                                text-slate-600
                                px-2
                                py-1
                                text-xs
                                font-bold
                                transition
                            "
                            title="Selecionar canais"
                        >
                            <i class="fa-solid fa-pen"></i>
                        </summary>

                        <div
                            class="
                                absolute
                                right-0
                                z-30
                                mt-2
                                w-40
                                rounded-xl
                                border
                                border-slate-200
                                bg-white
                                p-2
                                shadow-lg
                            "
                        >
                            <div class="space-y-1">
                                ${optionsHtml}
                            </div>
                        </div>
                    </details>
                </div>
            `;
        }

        function renderOverview() {
            const sortKey =
                document
                    .getElementById(
                        'overviewSort'
                    )
                    .value;

                        const channelFilter =
                document
                    .getElementById(
                        'overviewChannelFilter'
                    )
                    .value;

            const items =
                [...overviewItems]
                    .filter(
                        item => {
                            const channels =
                                item.entry
                                    ?.marketing
                                    ?.channels ||
                                {};

                            if (
                                channelFilter ===
                                'all'
                            ) {
                                return true;
                            }

                            if (
                                channelFilter ===
                                'none'
                            ) {
                                return !Object
                                    .values(
                                        channels
                                    )
                                    .some(
                                        value =>
                                            value === true
                                    );
                            }

                            return (
                                channels[
                                    channelFilter
                                ] === true
                            );
                        }
                    )
                    .sort(

                        (a, b) => {
                            if (
                                sortKey ===
                                'opportunityScore'
                            ) {
                                return (
                                    Number(
                                        b.opportunityScore
                                    ) || 0
                                ) -
                                (
                                    Number(
                                        a.opportunityScore
                                    ) || 0
                                );
                            }

                            return (
                                Number(
                                    b.product?.[sortKey]
                                ) || 0
                            ) -
                            (
                                Number(
                                    a.product?.[sortKey]
                                ) || 0
                            );
                        }
                    );

            const body =
                document.getElementById(
                    'overviewProducts'
                );

            if (items.length === 0) {
                body.innerHTML =
                    `
                        <tr>
                            <td
                                colspan="9"
                                class="
                                    px-3
                                    py-10
                                    text-center
                                    text-slate-500
                                "
                            >
                                Nenhum produto publicado disponível para Marketing.
                            </td>
                        </tr>
                    `;

                return;
            }

            body.innerHTML =
                items
                    .map(
                        ({
                            entry,
                            product,
                            opportunityScore,
                            opportunityLevel
                        }) => `
                            <tr>

                                <td class="px-3 py-4">
                                    <div
                                        class="
                                            flex
                                            items-center
                                            gap-3
                                            min-w-[250px]
                                        "
                                    >
                                        <img
                                            src="${escapeHtml(product.image)}"
                                            alt=""
                                            class="
                                                w-12
                                                h-12
                                                rounded-xl
                                                object-cover
                                                bg-slate-100
                                                flex-shrink-0
                                            "
                                        >

                                        <div>
                                            <a
                                                href="${escapeHtml(productLink(product))}"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="
                                                    font-bold
                                                    text-sm
                                                    text-slate-900
                                                    hover:text-sky-700
                                                    hover:underline
                                                "
                                            >
                                                ${escapeHtml(product.title)}
                                            </a>

                                            <div
                                                class="
                                                    mt-1
                                                    text-xs
                                                    text-slate-400
                                                "
                                            >
                                                ID ${escapeHtml(product.itemId)}
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td
