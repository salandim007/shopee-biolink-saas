                        }

                        carouselBuildButton.disabled =
                            true;

                        carouselBuildButton.textContent =
                            '⏳ Processando Carrossel...';

                        carouselBuildButton.style.background =
                            '#e1306c';

                        carouselSelectedImageUrls =
                            selectedImages;

                        carouselPreviewIndex =
                            0;

                        renderCarouselPreview();

                        carouselStatus.textContent =
                            '✅ Carrossel pronto com ' +
                            carouselSelectedImageUrls.length +
                            ' fotos.';

                        carouselStatus.style.color =
                            '#166534';

                        const carouselApproved =
                            await prepareInstagramFormatReview(
                                carouselReview
                            );

                        if (carouselApproved) {
                            carouselBuildButton.style.display =
                                'none';

                            carouselApproveButton.style.display =
                                'block';
                        } else {
                            carouselBuildButton.textContent =
                                'Tentar processar Carrossel';

                            carouselBuildButton.style.background =
                                '#e1306c';
                        }

                        carouselBuildButton.disabled =
                            false;
                    }
                );


                const carouselReview =
                    createInstagramReviewArea();


                const carouselApproveButton =
                    document.createElement('button');

                carouselApproveButton.type =
                    'button';

                carouselApproveButton.textContent =
                    '✓ Aprovado para publicar';

                carouselApproveButton.style.cssText = `
                    display: none;
                    width: 100%;
                    margin-top: 14px;
                    padding: 13px;
                    border: 0;
                    border-radius: 12px;
                    background: #16a34a;
                    color: white;
                    font-weight: 800;
                    cursor: pointer;
                `;


                function setCarouselPublishedState(
                    publication
                ) {
                    carouselApproveButton.disabled =
                        true;

                    carouselApproveButton.textContent =
                        '✓ Publicado';

                    carouselApproveButton.style.display =
                        'block';

                    carouselApproveButton.style.background =
                        '#2563eb';

                    carouselApproveButton.style.cursor =
                        'default';

                    carouselBuildButton.style.display =
                        'none';

                    carouselReview.textarea.disabled =
                        true;

                    const publishedAt =
                        formatPublicationDate(
                            publication?.publishedAt
                        );

                    carouselStatus.textContent =
                        publishedAt
                            ? `🔵 Carrossel publicado no Instagram em ${publishedAt}.`
                            : '🔵 Carrossel já publicado no Instagram.';

                    carouselStatus.style.color =
                        '#1d4ed8';
                }


                async function loadCarouselPublicationState() {
                    if (
                        !/^\d+$/.test(
                            publicationItemId
                        )
                    ) {
                        return;
                    }

                    try {
                        const params =
                            new URLSearchParams({
                                marketplace:
                                    publicationMarketplace,

                                itemId:
                                    publicationItemId
                            });

                        const response =
                            await fetch(
                                '/admin/vitrine2/marketing/publication-history?' +
                                params.toString(),
                                {
                                    cache:
                                        'no-store'
                                }
                            );

                        if (!response.ok) {
                            return;
                        }

                        const payload =
                            await response.json();

                        const publication =
                            Array.isArray(
                                payload?.publications
                            )
                                ? payload.publications.find(
                                    entry =>
                                        entry?.channel ===
                                            'instagram' &&
                                        entry?.format ===
                                            'carousel'
                                )
                                : null;


                        if (
                            publication?.status ===
                            'PUBLISHED'
                        ) {
                            setCarouselPublishedState(
                                publication
                            );

                            return;
                        }


                        if (
                            publication?.status ===
                            'PROCESSING'
                        ) {
                            carouselApproveButton.disabled =
                                true;

                            carouselApproveButton.style.display =
                                'block';

                            carouselApproveButton.textContent =
                                '⏳ Publicação em processamento';

                            carouselApproveButton.style.background =
                                '#64748b';

                            carouselStatus.textContent =
                                '⏳ Este Carrossel já possui uma publicação em processamento.';

                            carouselStatus.style.color =
                                '#475569';
                        }
                    } catch (error) {
                        console.warn(
                            '[INSTAGRAM] Histórico do Carrossel indisponível:',
                            error
                        );
                    }
                }


                carouselApproveButton.addEventListener(
                    'click',
                    async () => {
                        const imageUrls =
                            Array.isArray(
                                carouselSelectedImageUrls
                            )
                                ? carouselSelectedImageUrls
                                    .map(
                                        value =>
                                            String(
                                                value ||
                                                ''
                                            ).trim()
                                    )
                                    .filter(Boolean)
                                : [];


                        const finalCaption =
                            String(
                                carouselReview
                                    .textarea
                                    .value ||
                                ''
                            ).trim();


                        if (
                            imageUrls.length < 2 ||
                            imageUrls.length > 5
                        ) {
                            window.alert(
                                'Selecione entre 2 e 5 fotos para publicar o Carrossel.'
                            );

                            return;
                        }


                        if (!finalCaption) {
                            window.alert(
                                'A legenda do Carrossel está vazia.'
                            );

                            return;
                        }


                        const confirmed =
                            window.confirm(
                                'Confirma a aprovação e publicação deste Carrossel no Instagram?'
                            );


                        if (!confirmed) {
                            return;
                        }


                        try {
                            carouselApproveButton.disabled =
                                true;

                            carouselApproveButton.textContent =
                                '⏳ Publicando Carrossel...';

                            carouselApproveButton.style.background =
                                '#e1306c';

                            carouselStatus.textContent =
                                '⏳ Enviando Carrossel para o Instagram...';

                            carouselStatus.style.color =
                                '#475569';


                            const publishResponse =
                                await fetch(
                                    '/admin/vitrine2/marketing/meta/publish',
                                    {
                                        method:
                                            'POST',

                                        headers: {
                                            'Content-Type':
                                                'application/json'
                                        },

                                        body:
                                            JSON.stringify({
                                                marketplace:
                                                    publicationMarketplace,

                                                itemId:
                                                    publicationItemId,

                                                format:
                                                    'carousel',

                                                imageUrls,

                                                caption:
                                                    finalCaption,

                                                channels: [
                                                    'instagram'
                                                ]
                                            })
                                    }
                                );


                            let publishPayload =
                                {};


                            try {
                                publishPayload =
                                    await publishResponse.json();
                            } catch (_) {
                                publishPayload =
                                    {};
                            }


                            /*
                             * Publicação já existente:
                             * nunca chama a Meta novamente.
                             */
                            if (
                                publishResponse.status ===
                                    409 &&
                                publishPayload
                                    ?.error
                                    ?.code ===
                                    'PUBLICATION_ALREADY_EXISTS'
                            ) {
                                const existingPublication =
                                    publishPayload
                                        ?.publication;


                                if (
                                    existingPublication
                                        ?.status ===
                                        'PUBLISHED'
                                ) {
                                    setCarouselPublishedState(
                                        existingPublication
                                    );

                                    return;
                                }


                                carouselApproveButton.disabled =
                                    true;

                                carouselApproveButton.textContent =
                                    '⏳ Publicação em processamento';

                                carouselApproveButton.style.background =
                                    '#64748b';

                                carouselStatus.textContent =
                                    '⏳ Este Carrossel já possui uma publicação em processamento.';

                                carouselStatus.style.color =
                                    '#475569';

                                return;
                            }


                            const channelResult =
                                publishPayload
                                    ?.channels
                                    ?.instagram ||
                                null;


                            if (
                                !publishResponse.ok ||
                                publishPayload?.success ===
                                    false ||
                                channelResult?.success ===
                                    false ||
                                channelResult?.error
                            ) {
                                throw new Error(
                                    channelResult
                                        ?.error
                                        ?.message ||
                                    publishPayload
                                        ?.error
                                        ?.message ||
                                    'A publicação do Carrossel não foi concluída.'
                                );
                            }


                            const savedPublication =
                                publishPayload
                                    ?.publications
                                    ?.instagram ||
                                null;


                            setCarouselPublishedState(
                                savedPublication
                            );


                            carouselStatus.textContent =
                                savedPublication?.publishedAt
                                    ? `🔵 Carrossel publicado no Instagram em ${formatPublicationDate(savedPublication.publishedAt)}.`
                                    : '🔵 Carrossel publicado no Instagram com sucesso.';

                        } catch (error) {
                            console.error(
                                '[INSTAGRAM] Erro ao publicar Carrossel:',
                                error
                            );


                            carouselStatus.textContent =
                                `❌ ${
                                    error?.message ||
                                    'Erro na publicação do Carrossel.'
                                }`;

                            carouselStatus.style.color =
                                '#b91c1c';


                            carouselApproveButton.disabled =
                                false;

                            carouselApproveButton.textContent =
                                '✓ Aprovado para publicar';

                            carouselApproveButton.style.background =
                                '#16a34a';
                        }
                    }
                );


                carouselBox.appendChild(
                    carouselTitle
                );

                carouselBox.appendChild(
                    carouselDescription
                );

                carouselBox.appendChild(
                    carouselReserved
                );

                carouselBox.appendChild(
                    carouselGrid
                );

                carouselBox.appendChild(
                    carouselStatus
                );

                carouselBox.appendChild(
                    carouselBuildButton
                );

                carouselBox.appendChild(
                    carouselPreview
                );

                carouselBox.appendChild(
                    carouselReview.status
                );

                carouselBox.appendChild(
                    carouselReview.textarea
                );

                carouselBox.appendChild(
                    carouselApproveButton
                );

                carouselPanel.appendChild(
                    carouselBox
                );


                function setInstagramFormatTab(
                    format
                ) {
                    const isPhoto =
                        format === 'photo';

                    const isCarousel =
                        format === 'carousel';

                    const isReel =
                        format === 'reel';

                    photoPanel.style.display =
                        isPhoto
                            ? 'block'
                            : 'none';

                    carouselPanel.style.display =
                        isCarousel
                            ? 'block'
                            : 'none';

                    reelPanel.style.display =
                        isReel
                            ? 'block'
                            : 'none';

                    const buttons = [
                        photoTabButton,
                        carouselTabButton,
                        reelTabButton
                    ];

                    for (
                        const button
                        of buttons
                    ) {
                        const active =
                            button.dataset.format ===
                            format;

                        button.style.background =
                            active
                                ? '#ffffff'
                                : 'transparent';

                        button.style.color =
                            active
                                ? '#0f172a'
                                : '#64748b';

                        button.style.boxShadow =
                            active
                                ? '0 1px 4px rgba(15, 23, 42, 0.12)'
                                : 'none';
                    }
                }


                photoTabButton.addEventListener(
                    'click',
                    () =>
                        setInstagramFormatTab(
                            'photo'
                        )
                );

                carouselTabButton.addEventListener(
                    'click',
                    () =>
                        setInstagramFormatTab(
                            'carousel'
                        )
                );

                reelTabButton.addEventListener(
                    'click',
                    () =>
                        setInstagramFormatTab(
                            'reel'
                        )
                );


                photoPanel.appendChild(
                    galleryBox
                );

                photoPanel.appendChild(
                    generateButton
                );

                photoPanel.appendChild(
                    statusBox
                );

                photoPanel.appendChild(
                    textarea
                );

                photoPanel.appendChild(
                    publishButton
                );


                reelPanel.appendChild(
                    reelBox
                );


                setInstagramFormatTab(
                    'photo'
                );


                generateButton.addEventListener(
                    'click',
                    async () => {
                        try {
                            generateButton.disabled =
                                true;

                            generateButton.textContent =
                                '⏳ Processando Foto...';

                            generateButton.style.background =
                                '#e1306c';

                            statusBox.textContent =
                                'Preparando conteúdo...';

                            const prepareResponse =
                                await fetch(
                                    '/admin/vitrine2/marketing/prepare',
                                    {
                                        method:
                                            'POST',

                                        headers: {
                                            'Content-Type':
                                                'application/json'
                                        },

                                        body:
                                            JSON.stringify({
                                                marketplace:
                                                    marketplace ||
                                                    'shopee',

                                                itemId:
                                                    String(
                                                        itemId ||
                                                        ''
                                                    ),

                                                channels: [
                                                    'instagram'
                                                ]
                                            })
                                    }
                                );

                            const preparePayload =
                                await prepareResponse.json();

                            const result =
                                preparePayload
                                    ?.channels
                                    ?.instagram;

                            if (
                                !prepareResponse.ok ||
                                !result
                            ) {
                                throw new Error(
                                    preparePayload
                                        ?.error
                                        ?.message ||
                                    'Falha na preparação.'
                                );
                            }

                            if (
                                result.status !==
                                'READY'
                            ) {
                                throw new Error(
                                    result.reason ||
                                    `Status: ${result.status}`
                                );
                            }

                            const caption =
                                String(
                                    result
                                        ?.content
                                        ?.caption ||
                                    ''
                                );

                            const hashtags =
                                Array.isArray(
                                    result
                                        ?.content
                                        ?.hashtags
                                )
                                    ? result
                                        .content
                                        .hashtags
                                        .join(' ')
                                    : '';

                            const constructionNotice =
                                '🔧 Nossa página de ofertas está em preparação. Em breve os links dos produtos estarão disponíveis na bio.';

                            textarea.value =
                                [
                                    caption,
                                    constructionNotice,
                                    hashtags
                                ]
                                    .filter(Boolean)
                                    .join('\n\n');

                            textarea.style.display =
                                'block';

                            const auditStatus =
                                result
                                    ?.audit
                                    ?.status ||
                                'sem status';

                            const auditStatusLabel =
                                auditStatus === 'APPROVED'
                                    ? 'APROVADA'
                                    : auditStatus;

                            statusBox.textContent =
                                `✅ Rascunho pronto • Auditoria: ${auditStatusLabel}`;

                            statusBox.style.color =
                                '#166534';

                            generateButton.textContent =
                                'Processamento concluído';

                            if (
                                result.status === 'READY' &&
                                auditStatus === 'APPROVED'
                            ) {
                                generateButton.style.display =
                                    'none';

                                publishButton.style.display =
                                    'block';

                                publishButton.disabled =
                                    false;

                                publishButton.textContent =
                                    '✓ Aprovado para publicar';

                                publishButton.style.background =
                                    '#16a34a';
                            }
                        } catch (error) {
                            console.error(
                                '[INSTAGRAM] Erro ao gerar rascunho:',
                                error
                            );

                            statusBox.textContent =
                                `❌ ${
                                    error?.message ||
                                    'Erro na preparação.'
                                }`;

                            statusBox.style.color =
                                '#b91c1c';

                            generateButton.disabled =
                                false;

                            generateButton.textContent =
                                'Tentar processar novamente';

                            generateButton.style.background =
                                '#e1306c';
                        }
                    }
                );

                const publicationMarketplace =
                    String(
                        product?.marketplace ||
                        'shopee'
                    )
                        .trim()
                        .toLowerCase();

                const publicationItemId =
                    String(
                        product?.itemId ||
                        ''
                    ).trim();


                function formatPublicationDate(
                    value
                ) {
                    if (!value) {
                        return '';
                    }

                    try {
                        const normalized =
                            String(value).includes('T')
                                ? String(value)
                                : String(value)
                                    .replace(' ', 'T') +
                                  'Z';

                        const date =
                            new Date(normalized);

                        if (
                            Number.isNaN(
                                date.getTime()
                            )
                        ) {
                            return String(value);
                        }

                        return date.toLocaleString(
                            'pt-BR'
                        );
                    } catch (_) {
                        return String(value);
                    }
                }


                function setPhotoPublishedState(
                    publication
                ) {
                    publishButton.disabled =
                        true;

                    publishButton.textContent =
                        '✓ Publicado';

                    publishButton.style.background =
                        '#2563eb';

                    publishButton.style.cursor =
                        'default';

                    textarea.disabled =
                        true;

                    generateButton.disabled =
                        true;

                    const publishedAt =
                        formatPublicationDate(
                            publication?.publishedAt
                        );

                    statusBox.textContent =
                        publishedAt
                            ? `🔵 Foto já publicada no Instagram em ${publishedAt}.`
                            : '🔵 Foto já publicada no Instagram.';

                    statusBox.style.color =
                        '#1d4ed8';
                }


                async function loadPhotoPublicationState() {
                    if (
                        !/^\d+$/.test(
                            publicationItemId
                        )
                    ) {
                        return;
                    }

                    try {
                        const params =
                            new URLSearchParams({
                                marketplace:
                                    publicationMarketplace,

                                itemId:
                                    publicationItemId
                            });

                        const response =
                            await fetch(
                                '/admin/vitrine2/marketing/publication-history?' +
                                params.toString(),
                                {
                                    cache:
                                        'no-store'
                                }
                            );

                        if (!response.ok) {
                            return;
                        }

                        const payload =
                            await response.json();

                        const publication =
                            Array.isArray(
                                payload?.publications
                            )
                                ? payload.publications.find(
                                    entry =>
                                        entry?.channel ===
                                            'instagram' &&
                                        entry?.format ===
                                            'photo'
                                )
                                : null;

                        if (
                            publication?.status ===
                            'PUBLISHED'
                        ) {
                            setPhotoPublishedState(
                                publication
                            );

                            return;
                        }

                        if (
                            publication?.status ===
                            'PROCESSING'
                        ) {
                            publishButton.disabled =
                                true;

                            publishButton.textContent =
                                '⏳ Publicação em processamento';

                            publishButton.style.background =
                                '#64748b';

                            statusBox.textContent =
                                '⏳ Esta Foto já possui uma publicação em processamento.';

                            statusBox.style.color =
                                '#475569';
                        }
                    } catch (error) {
                        console.warn(
                            '[INSTAGRAM] Histórico da Foto indisponível:',
                            error
                        );
                    }
                }


                publishButton.addEventListener(
                    'click',
                    async () => {
                        const confirmed =
                            window.confirm(
                                'Confirma a aprovação e publicação deste conteúdo no Instagram?'
                            );

                        if (!confirmed) {
                            return;
                        }

                        const imageUrl =
                            String(
                                selectedImageUrl ||
                                product.image ||
                                ''
                            ).trim();

                        const finalCaption =
                            String(
                                textarea.value ||
                                ''
                            ).trim();

                        if (!imageUrl) {
                            window.alert(
                                'O produto não possui imagem disponível para publicação.'
                            );

                            return;
                        }

                        if (!finalCaption) {
                            window.alert(
                                'A legenda está vazia.'
                            );

                            return;
                        }

                        try {
                            publishButton.disabled =
                                true;

                            publishButton.textContent =
                                '⏳ Publicando...';

                            publishButton.style.background =
                                '#e1306c';

                            statusBox.textContent =
                                '⏳ Enviando publicação para o Instagram...';

                            statusBox.style.color =
                                '#475569';

                            const publishResponse =
                                await fetch(
                                    '/admin/vitrine2/marketing/meta/publish',
                                    {
                                        method: 'POST',

                                        headers: {
                                            'Content-Type':
                                                'application/json'
                                        },

                                        body:
                                            JSON.stringify({
                                                marketplace:
                                                    publicationMarketplace,

                                                itemId:
                                                    publicationItemId,

                                                format:
                                                    'photo',

                                                imageUrl,

                                                caption:
                                                    finalCaption,

                                                channels: [
                                                    'instagram'
                                                ]
                                            })
                                    }
                                );

                            let publishPayload = {};

                            try {
                                publishPayload =
                                    await publishResponse.json();
                            } catch (_) {
                                publishPayload = {};
                            }

                            const channelResult =
                                publishPayload
                                    ?.channels
                                    ?.instagram ||
                                publishPayload
                                    ?.results
                                    ?.instagram ||
                                publishPayload
                                    ?.instagram ||
                                null;


                            if (
                                publishResponse.status === 409 &&
                                publishPayload
                                    ?.error
                                    ?.code ===
                                    'PUBLICATION_ALREADY_EXISTS'
                            ) {
                                const existingPublication =
                                    publishPayload
                                        ?.publication;

                                if (
                                    existingPublication
                                        ?.status ===
                                        'PUBLISHED'
                                ) {
                                    setPhotoPublishedState(
                                        existingPublication
                                    );

                                    return;
                                }

                                publishButton.disabled =
                                    true;

                                publishButton.textContent =
                                    '⏳ Publicação em processamento';

                                publishButton.style.background =
                                    '#64748b';

                                statusBox.textContent =
                                    '⏳ Esta Foto já possui uma publicação em processamento.';

                                statusBox.style.color =
                                    '#475569';

                                return;
                            }


                            if (
                                !publishResponse.ok ||
                                publishPayload?.success === false ||
                                channelResult?.success === false ||
                                channelResult?.status === 'ERROR' ||
                                channelResult?.error
                            ) {
                                throw new Error(
                                    channelResult
                                        ?.error
                                        ?.message ||
                                    publishPayload
                                        ?.error
                                        ?.message ||
                                    'A publicação não foi concluída.'
                                );
                            }

                            const savedPublication =
                                publishPayload
                                    ?.publications
                                    ?.instagram ||
                                null;

                            setPhotoPublishedState(
                                savedPublication
                            );

                            statusBox.textContent =
                                savedPublication?.publishedAt
                                    ? `🔵 Foto publicada no Instagram em ${formatPublicationDate(savedPublication.publishedAt)}.`
                                    : '🔵 Foto publicada no Instagram com sucesso.';
                        } catch (error) {
                            console.error(
                                '[INSTAGRAM] Erro ao publicar:',
                                error
                            );

                            statusBox.textContent =
                                `❌ ${
                                    error?.message ||
                                    'Erro na publicação.'
                                }`;

                            statusBox.style.color =
                                '#b91c1c';

                            publishButton.disabled =
                                false;

                            publishButton.textContent =
                                '✓ Aprovado para publicar';

                            publishButton.style.background =
                                '#16a34a';
                        }
                    }
                );


                closeButton.addEventListener(
                    'click',
                    () => overlay.remove()
                );

                overlay.addEventListener(
                    'click',
                    event => {
                        if (
                            event.target ===
                            overlay
                        ) {
                            overlay.remove();
                        }
                    }
                );

                modal.appendChild(channel);
                modal.appendChild(heading);
                modal.appendChild(productBox);
                modal.appendChild(policyBox);
                modal.appendChild(formatTabs);
                modal.appendChild(photoPanel);
                modal.appendChild(carouselPanel);
                modal.appendChild(reelPanel);
                modal.appendChild(closeButton);

                overlay.appendChild(modal);

                document.body.appendChild(
                    overlay
                );

                loadPhotoPublicationState();
                loadCarouselPublicationState();
                loadInstagramGallery();

                console.log(
                    '[INSTAGRAM] Degrau 4 aberto',
                    {
                        marketplace,
                        itemId
                    }
                );
            } catch (error) {
                console.error(
                    '[INSTAGRAM] Erro no Degrau 4:',
                    error
                );

                window.alert(
                    error?.message ||
                    'Erro ao abrir preparação.'
                );
            }
        }

        async function loadChannelProducts() {
            try {
                const items =
                    await fetchCatalogProducts();

                instagramItems =
                    items;

                applyPolicyFilter();
            }
            catch (error) {
                document
                    .getElementById(
                        'instagramProducts'
                    )
                    .innerHTML =
                        `
                            <div
                                class="
                                    bg-white
                                    border
                                    border-red-200
                                    rounded-2xl
                                    p-8
                                    text-center
                                    text-red-600
                                    sm:col-span-2
                                    lg:col-span-3
                                    xl:col-span-4
                                "
                            >
                                ${escapeHtml(error.message)}
                            </div>
                        `;
            }
        }


        document
            .querySelectorAll(
                '.instagram-policy-filter'
            )
            .forEach(
                button => {
                    button.addEventListener(
                        'click',
                        () => {
                            instagramPolicyFilter =
                                button.dataset
                                    .policyFilter ||
                                'all';

                            applyPolicyFilter();
                        }
                    );
                }
            );


        loadChannelProducts();

    </script>

</body>
</html>
