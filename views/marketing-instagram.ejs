    <script>
        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }


        function formatPrice(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return new Intl.NumberFormat(
                'pt-BR',
                {
                    style: 'currency',
                    currency: 'BRL'
                }
            ).format(number);
        }


        function formatCommission(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return `${(number * 100)
                .toFixed(1)
                .replace('.0', '')}%`;
        }


        function formatSales(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return new Intl.NumberFormat(
                'pt-BR'
            ).format(number);
        }


        function formatRating(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return `${number
                .toFixed(1)
                .replace('.', ',')} ★`;
        }


        function productLink(product) {
            return (
                product?.metadata?.productLink ||
                product?.affiliateLink ||
                '#'
            );
        }


        async function fetchCatalogProducts() {
            const response =
                await fetch(
                    '/api/vitrine2/marketing/channel/instagram'
                );

            const data =
                await response.json();

            if (
                !response.ok ||
                !data.success
            ) {
                throw new Error(
                    data.error ||
                    'Falha ao carregar os produtos selecionados para Instagram.'
                );
            }

            const entries =
                Array.isArray(data.products)
                    ? data.products
                    : Array.isArray(data.items)
                        ? data.items
                        : [];

            return entries.map(
                entry => ({
                    entry,
                    product:
                        entry.product || entry || {},
                    policy: (() => {
                        const persistedPolicy =
                            entry?.marketing
                                ?.policies
                                ?.instagram;

                        if (
                            !persistedPolicy ||
                            typeof persistedPolicy !==
                                'object'
                        ) {
                            return {
                                status: 'unavailable',
                                label: 'Política indisponível',
                                reason:
                                    'Produto ainda não possui validação persistida do Instagram.'
                            };
                        }

                        return {
                            ...persistedPolicy,
                            ...(
                                persistedPolicy.summary &&
                                typeof persistedPolicy.summary ===
                                    'object'
                                    ? persistedPolicy.summary
                                    : {}
                            ),
                            status:
                                normalizePolicyStatus(
                                    persistedPolicy.status ||
                                    persistedPolicy.summary
                                        ?.status
                                ),
                            policyVersion:
                                persistedPolicy
                                    .policyVersion ||
                                persistedPolicy.summary
                                    ?.policyVersion ||
                                persistedPolicy.summary
                                    ?.version ||
                                null,
                            reason:
                                persistedPolicy.reason ||
                                persistedPolicy.summary
                                    ?.reason ||
                                null
                        };
                    })()
                })
            );

        }


        let instagramItems = [];
        let instagramPolicyFilter = 'all';


        function normalizePolicyStatus(status) {
            const normalized =
                String(status || '')
                    .trim()
                    .toLowerCase();

            if (
                normalized === 'approved' ||
                normalized === 'needs_review' ||
                normalized === 'blocked' ||
                normalized === 'revalidate'
            ) {
                return normalized;
            }

            return 'unavailable';
        }


        function policyStatusMeta(status) {
            const normalized =
                normalizePolicyStatus(
                    status
                );

            const definitions = {
                approved: {
                    label: 'Aprovado',
                    icon: 'fa-circle-check',
                    badgeClass:
                        'bg-emerald-50 text-emerald-700'
                },

                blocked: {
                    label: 'Bloqueado',
                    icon: 'fa-ban',
                    badgeClass:
                        'bg-red-50 text-red-700'
                },

                needs_review: {
                    label: 'Revisão necessária',
                    icon: 'fa-triangle-exclamation',
                    badgeClass:
                        'bg-amber-50 text-amber-700'
                },

                revalidate: {
                    label: 'Revalidar',
                    icon: 'fa-rotate',
                    badgeClass:
                        'bg-sky-50 text-sky-700'
                },

                unavailable: {
                    label: 'Política indisponível',
                    icon: 'fa-circle-question',
                    badgeClass:
                        'bg-slate-100 text-slate-600'
                }
            };

            return definitions[normalized];
        }


        function updatePolicySummary() {
            const counts = {
                all: instagramItems.length,
                approved: 0,
                blocked: 0,
                needs_review: 0,
                revalidate: 0,
                unavailable: 0
            };

            instagramItems.forEach(
                item => {
                    const status =
                        normalizePolicyStatus(
                            item.policy?.status
                        );

                    counts[status] += 1;
                }
            );

            document.getElementById(
                'policyCountAll'
            ).textContent = counts.all;

            document.getElementById(
                'policyCountApproved'
            ).textContent = counts.approved;

            document.getElementById(
                'policyCountBlocked'
            ).textContent = counts.blocked;

            document.getElementById(
                'policyCountReview'
            ).textContent = counts.needs_review;

            document.getElementById(
                'policyCountRevalidate'
            ).textContent = counts.revalidate;

            document.getElementById(
                'policyCountUnavailable'
            ).textContent = counts.unavailable;

            document
                .querySelectorAll(
                    '.instagram-policy-filter'
                )
                .forEach(
                    button => {
                        const active =
                            button.dataset
                                .policyFilter ===
                            instagramPolicyFilter;

                        button.classList.toggle(
                            'ring-2',
                            active
                        );

                        button.classList.toggle(
                            'ring-sky-300',
                            active
                        );

                        button.classList.toggle(
                            'border-sky-300',
                            active
                        );
                    }
                );
        }


        function applyPolicyFilter() {
            const filteredItems =
                instagramPolicyFilter === 'all'
                    ? instagramItems
                    : instagramItems.filter(
                        item =>
                            normalizePolicyStatus(
                                item.policy?.status
                            ) ===
                            instagramPolicyFilter
                    );

            renderChannelProducts(
                filteredItems
            );

            updatePolicySummary();
        }


        function renderChannelProducts(items) {
            const container =
                document.getElementById(
                    'instagramProducts'
                );


            if (items.length === 0) {
                container.innerHTML =
                    `
                        <div
                            class="
                                bg-slate-50
                                border
                                border-slate-200
                                rounded-2xl
                                p-8
                                text-center
                                text-slate-500
                                md:col-span-2
                                xl:col-span-3
                            "
                        >
                            Nenhum produto selecionado para este filtro.
                        </div>
                    `;

                return;
            }

            container.innerHTML =
                items
                    .map(
                        ({ product, policy }) => {
                            const policyMeta =
                                policyStatusMeta(
                                    policy?.status
                                );

                            return `
                                <article
                                    class="
                                        bg-white
                                        border
                                        border-slate-200
                                        rounded-2xl
                                        p-3
                                    "
                                >
                                    <div
                                        class="
                                            flex
                                            items-start
                                            justify-between
                                            gap-3
                                            mb-3
                                        "
                                    >
                                        <span
                                            title="${escapeHtml(policyMeta.label)}"
                                            aria-label="${escapeHtml(policyMeta.label)}"
                                            class="
                                                inline-flex
                                                items-center
                                                justify-center
                                                w-8
                                                h-8
                                                rounded-full
                                                ${policyMeta.badgeClass}
                                                shrink-0
                                            "
                                        >
                                            <i class="fa-solid ${policyMeta.icon}"></i>
                                        </span>

                                        <span
                                            class="
                                                text-xs
                                                text-slate-400
                                                truncate
                                            "
                                        >
                                            ${escapeHtml(
                                                policy?.policyVersion ||
                                                ''
                                            )}
                                        </span>
                                    </div>

                                    <div class="flex gap-3">

                                        <img
                                            src="${escapeHtml(product.image)}"
                                            alt=""
                                            class="
                                                w-16
                                                h-16
                                                rounded-xl
                                                object-cover
                                                bg-slate-100
                                                shrink-0
                                            "
                                        >

                                        <div class="min-w-0">
                                            <a
                                                href="${escapeHtml(productLink(product))}"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="
                                                    font-bold
                                                    text-xs
                                                    text-slate-900
                                                    line-clamp-2
                                                    hover:text-sky-700
                                                    hover:underline
                                                "
                                            >
                                                ${escapeHtml(product.title)}
                                            </a>

                                            <div
                                                class="
                                                    mt-2
                                                    grid
                                                    grid-cols-2
                                                    gap-x-2
                                                    gap-y-1.5
                                                    text-xs
                                                "
                                            >
                                                <div>
                                                    <span class="text-slate-500 text-xs">
                                                        Comissão
                                                    </span>

                                                    <div class="text-slate-800 text-sm font-medium">
                                                        ${formatCommission(product.commissionRate)}
                                                    </div>
                                                </div>

                                                <div>
                                                    <span class="text-slate-500 text-xs">
                                                        Estimada
                                                    </span>

                                                    <div class="text-slate-800 text-sm font-medium">
                                                        ${formatPrice(product.commission)}
                                                    </div>
                                                </div>

                                                <div>
                                                    <span class="text-slate-500 text-xs">
                                                        Vendas
                                                    </span>

                                                    <div class="text-slate-800 text-sm font-medium">
                                                        ${formatSales(product.sales)}
                                                    </div>
                                                </div>

                                                <div>
                                                    <span class="text-slate-500 text-xs">
                                                        Avaliação
                                                    </span>

                                                    <div class="text-amber-600 text-sm font-medium">
                                                        ${formatRating(product.ratingStar)}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <button
                                        type="button"
                                        onclick="prepareInstagramFeedForProduct(
                                            '${escapeHtml(product.marketplace || 'shopee')}',
                                            '${escapeHtml(product.itemId || '')}'
                                        )"
                                        class="
                                            mt-4
                                            w-full
                                            inline-flex
                                            items-center
                                            justify-center
                                            gap-2
                                            rounded-xl
                                            bg-pink-50
                                            hover:bg-pink-100
                                            text-pink-700
                                            px-3
                                            py-2.5
                                            text-xs
                                            font-bold
                                            transition
                                        "
                                    >
                                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                                        Preparar Feed
                                    </button>
                                </article>
                            `;
                        }
                    )
                    .join('');
        }

                function closeInstagramFeedDraft() {
            const modal =
                document.getElementById(
                    'instagramFeedDraftModal'
                );

            if (modal) {
                modal.remove();
            }
        }


        async function prepareInstagramFeedForProduct(
            marketplace,
            itemId
        ) {
            try {
                const oldModal =
                    document.getElementById(
                        'instagram-degrau4-modal'
                    );

                if (oldModal) {
                    oldModal.remove();
                }

                const response =
                    await fetch(
                        '/api/vitrine2/marketing/channel/instagram'
                    );

                if (!response.ok) {
                    throw new Error(
                        'Falha ao carregar produto.'
                    );
                }

                const payload =
                    await response.json();

                const products =
                    Array.isArray(payload?.products)
                        ? payload.products
                        : [];

                const selectedItem =
                    products.find(
                        item =>
                            String(
                                item?.product?.itemId || ''
                            ) ===
                            String(itemId || '')
                    );

                if (!selectedItem) {
                    throw new Error(
                        'Produto não encontrado no Instagram.'
                    );
                }

                const product =
                    selectedItem.product || {};

                const policy =
                    selectedItem
                        ?.marketing
                        ?.policies
                        ?.instagram ||
                    null;

                const overlay =
                    document.createElement('div');

                overlay.id =
                    'instagram-degrau4-modal';

                overlay.style.cssText = `
                    position: fixed;
                    inset: 0;
                    z-index: 99999;
                    background: rgba(15,23,42,.55);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    padding: 20px;
                `;

                const modal =
                    document.createElement('div');

                modal.style.cssText = `
                    width: min(620px, 100%);
                    max-height: 90vh;
                    overflow-y: auto;
                    background: white;
                    border-radius: 20px;
                    padding: 28px;
                    box-shadow: 0 24px 70px rgba(0,0,0,.25);
                    font-family: Arial, sans-serif;
                `;

                const channel =
                    document.createElement('div');

                channel.textContent =
                    'INSTAGRAM';

                channel.style.cssText = `
                    color: #e1306c;
                    font-size: 13px;
                    font-weight: 800;
                    margin-bottom: 6px;
                `;

                const heading =
                    document.createElement('h2');

                heading.textContent =
                    'Preparar Feed';

                heading.style.cssText = `
                    margin: 0 0 20px;
                    color: #111827;
                    font-size: 22px;
                `;

                const productBox =
                    document.createElement('div');

                productBox.style.cssText = `
                    display: flex;
                    gap: 16px;
                    align-items: center;
                    padding: 16px;
                    border: 1px solid #e2e8f0;
                    border-radius: 16px;
                    background: #f8fafc;
                `;

                const image =
                    document.createElement('img');

                image.src =
                    product.image || '';

                image.alt =
                    product.title || 'Produto';

                image.style.cssText = `
                    width: 90px;
                    height: 90px;
                    object-fit: contain;
                    background: white;
                    border-radius: 12px;
                `;

                const title =
