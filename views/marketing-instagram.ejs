    <script>
        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }


        function formatPrice(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return new Intl.NumberFormat(
                'pt-BR',
                {
                    style: 'currency',
                    currency: 'BRL'
                }
            ).format(number);
        }


        function formatCommission(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return `${(number * 100)
                .toFixed(1)
                .replace('.0', '')}%`;
        }


        function formatSales(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return new Intl.NumberFormat(
                'pt-BR'
            ).format(number);
        }


        function formatRating(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return `${number
                .toFixed(1)
                .replace('.', ',')} ★`;
        }


        function productLink(product) {
            return (
                product?.metadata?.productLink ||
                product?.affiliateLink ||
                '#'
            );
        }


        async function fetchCatalogProducts() {
            const response =
                await fetch(
                    '/api/vitrine2/marketing/channel/instagram'
                );

            const data =
                await response.json();

            if (
                !response.ok ||
                !data.success
            ) {
                throw new Error(
                    data.error ||
                    'Falha ao carregar os produtos selecionados para Instagram.'
                );
            }

            const entries =
                Array.isArray(data.products)
                    ? data.products
                    : Array.isArray(data.items)
                        ? data.items
                        : [];

            return entries.map(
                entry => ({
                    entry,
                    product:
                        entry.product || entry || {},
                    policy: (() => {
                        const persistedPolicy =
                            entry?.marketing
                                ?.policies
                                ?.instagram;

                        if (
                            !persistedPolicy ||
                            typeof persistedPolicy !==
                                'object'
                        ) {
                            return {
                                status: 'unavailable',
                                label: 'Política indisponível',
                                reason:
                                    'Produto ainda não possui validação persistida do Instagram.'
                            };
                        }

                        return {
                            ...persistedPolicy,
                            ...(
                                persistedPolicy.summary &&
                                typeof persistedPolicy.summary ===
                                    'object'
                                    ? persistedPolicy.summary
                                    : {}
                            ),
                            status:
                                normalizePolicyStatus(
                                    persistedPolicy.status ||
                                    persistedPolicy.summary
                                        ?.status
                                ),
                            policyVersion:
                                persistedPolicy
                                    .policyVersion ||
                                persistedPolicy.summary
                                    ?.policyVersion ||
                                persistedPolicy.summary
                                    ?.version ||
                                null,
                            reason:
                                persistedPolicy.reason ||
                                persistedPolicy.summary
                                    ?.reason ||
                                null
                        };
                    })()
                })
            );

        }


        let instagramItems = [];
        let instagramPolicyFilter = 'all';


        function normalizePolicyStatus(status) {
            const normalized =
                String(status || '')
                    .trim()
                    .toLowerCase();

            if (
                normalized === 'approved' ||
                normalized === 'needs_review' ||
                normalized === 'blocked' ||
                normalized === 'revalidate'
            ) {
                return normalized;
            }

            return 'unavailable';
        }


        function policyStatusMeta(status) {
            const normalized =
                normalizePolicyStatus(
                    status
                );

            const definitions = {
                approved: {
                    label: 'Aprovado',
                    icon: 'fa-circle-check',
                    badgeClass:
                        'bg-emerald-50 text-emerald-700'
                },

                blocked: {
                    label: 'Bloqueado',
                    icon: 'fa-ban',
                    badgeClass:
                        'bg-red-50 text-red-700'
                },

                needs_review: {
                    label: 'Revisão necessária',
                    icon: 'fa-triangle-exclamation',
                    badgeClass:
                        'bg-amber-50 text-amber-700'
                },

                revalidate: {
                    label: 'Revalidar',
                    icon: 'fa-rotate',
                    badgeClass:
                        'bg-sky-50 text-sky-700'
                },

                unavailable: {
                    label: 'Política indisponível',
                    icon: 'fa-circle-question',
                    badgeClass:
                        'bg-slate-100 text-slate-600'
                }
            };

            return definitions[normalized];
        }


        function updatePolicySummary() {
            const counts = {
                all: instagramItems.length,
                approved: 0,
                blocked: 0,
                needs_review: 0,
                revalidate: 0,
                unavailable: 0
            };

            instagramItems.forEach(
                item => {
                    const status =
                        normalizePolicyStatus(
                            item.policy?.status
                        );

                    counts[status] += 1;
                }
            );

            document.getElementById(
                'policyCountAll'
            ).textContent = counts.all;

            document.getElementById(
                'policyCountApproved'
            ).textContent = counts.approved;

            document.getElementById(
                'policyCountBlocked'
            ).textContent = counts.blocked;

            document.getElementById(
                'policyCountReview'
            ).textContent = counts.needs_review;

            document.getElementById(
                'policyCountRevalidate'
            ).textContent = counts.revalidate;

            document.getElementById(
                'policyCountUnavailable'
            ).textContent = counts.unavailable;

            document
                .querySelectorAll(
                    '.instagram-policy-filter'
                )
                .forEach(
                    button => {
                        const active =
                            button.dataset
                                .policyFilter ===
                            instagramPolicyFilter;

                        button.classList.toggle(
                            'ring-2',
                            active
                        );

                        button.classList.toggle(
                            'ring-sky-300',
                            active
                        );

                        button.classList.toggle(
                            'border-sky-300',
                            active
                        );
                    }
                );
        }


        function applyPolicyFilter() {
            const filteredItems =
                instagramPolicyFilter === 'all'
                    ? instagramItems
                    : instagramItems.filter(
                        item =>
                            normalizePolicyStatus(
                                item.policy?.status
                            ) ===
                            instagramPolicyFilter
                    );

            renderChannelProducts(
                filteredItems
            );

            updatePolicySummary();
        }


        function renderChannelProducts(items) {
            const container =
                document.getElementById(
                    'instagramProducts'
                );


            if (items.length === 0) {
                container.innerHTML =
                    `
                        <div
                            class="
                                bg-slate-50
                                border
                                border-slate-200
                                rounded-2xl
                                p-8
                                text-center
                                text-slate-500
                                md:col-span-2
                                xl:col-span-3
                            "
                        >
                            Nenhum produto selecionado para este filtro.
                        </div>
                    `;

                return;
            }

            container.innerHTML =
                items
                    .map(
                        ({ product, policy }) => {
                            const policyMeta =
                                policyStatusMeta(
                                    policy?.status
                                );

                            return `
                                <article
                                    class="
                                        bg-white
                                        border
                                        border-slate-200
                                        rounded-2xl
                                        p-3
                                    "
                                >
                                    <div
                                        class="
                                            flex
                                            items-start
                                            justify-between
                                            gap-3
                                            mb-3
                                        "
                                    >
                                        <span
                                            title="${escapeHtml(policyMeta.label)}"
                                            aria-label="${escapeHtml(policyMeta.label)}"
                                            class="
                                                inline-flex
                                                items-center
                                                justify-center
                                                w-8
                                                h-8
                                                rounded-full
                                                ${policyMeta.badgeClass}
                                                shrink-0
                                            "
                                        >
                                            <i class="fa-solid ${policyMeta.icon}"></i>
                                        </span>

                                        <span
                                            class="
                                                text-xs
                                                text-slate-400
                                                truncate
                                            "
                                        >
                                            ${escapeHtml(
                                                policy?.policyVersion ||
                                                ''
                                            )}
                                        </span>
                                    </div>

                                    <div class="flex gap-3">

                                        <img
                                            src="${escapeHtml(product.image)}"
                                            alt=""
                                            class="
                                                w-16
                                                h-16
                                                rounded-xl
                                                object-cover
                                                bg-slate-100
                                                shrink-0
                                            "
                                        >

                                        <div class="min-w-0">
                                            <a
                                                href="${escapeHtml(productLink(product))}"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="
                                                    font-bold
                                                    text-xs
                                                    text-slate-900
                                                    line-clamp-2
                                                    hover:text-sky-700
                                                    hover:underline
                                                "
                                            >
                                                ${escapeHtml(product.title)}
                                            </a>

                                            <div
                                                class="
                                                    mt-2
                                                    grid
                                                    grid-cols-2
                                                    gap-x-2
                                                    gap-y-1.5
                                                    text-xs
                                                "
                                            >
                                                <div>
                                                    <span class="text-slate-500 text-xs">
                                                        Comissão
                                                    </span>

                                                    <div class="text-slate-800 text-sm font-medium">
                                                        ${formatCommission(product.commissionRate)}
                                                    </div>
                                                </div>

                                                <div>
                                                    <span class="text-slate-500 text-xs">
                                                        Estimada
                                                    </span>

                                                    <div class="text-slate-800 text-sm font-medium">
                                                        ${formatPrice(product.commission)}
                                                    </div>
                                                </div>

                                                <div>
                                                    <span class="text-slate-500 text-xs">
                                                        Vendas
                                                    </span>

                                                    <div class="text-slate-800 text-sm font-medium">
                                                        ${formatSales(product.sales)}
                                                    </div>
                                                </div>

                                                <div>
                                                    <span class="text-slate-500 text-xs">
                                                        Avaliação
                                                    </span>

                                                    <div class="text-amber-600 text-sm font-medium">
                                                        ${formatRating(product.ratingStar)}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <button
                                        type="button"
                                        onclick="prepareInstagramFeedForProduct(
                                            '${escapeHtml(product.marketplace || 'shopee')}',
                                            '${escapeHtml(product.itemId || '')}'
                                        )"
                                        class="
                                            mt-4
                                            w-full
                                            inline-flex
                                            items-center
                                            justify-center
                                            gap-2
                                            rounded-xl
                                            bg-pink-50
                                            hover:bg-pink-100
                                            text-pink-700
                                            px-3
                                            py-2.5
                                            text-xs
                                            font-bold
                                            transition
                                        "
                                    >
                                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                                        Preparar Feed
                                    </button>
                                </article>
                            `;
                        }
                    )
                    .join('');
        }

                function closeInstagramFeedDraft() {
            const modal =
                document.getElementById(
                    'instagramFeedDraftModal'
                );

            if (modal) {
                modal.remove();
            }
        }


        async function prepareInstagramFeedForProduct(
            marketplace,
            itemId
        ) {
            try {
                const oldModal =
                    document.getElementById(
                        'instagram-degrau4-modal'
                    );

                if (oldModal) {
                    oldModal.remove();
                }

                const response =
                    await fetch(
                        '/api/vitrine2/marketing/channel/instagram'
                    );

                if (!response.ok) {
                    throw new Error(
                        'Falha ao carregar produto.'
                    );
                }

                const payload =
                    await response.json();

                const products =
                    Array.isArray(payload?.products)
                        ? payload.products
                        : [];

                const selectedItem =
                    products.find(
                        item =>
                            String(
                                item?.product?.itemId || ''
                            ) ===
                            String(itemId || '')
                    );

                if (!selectedItem) {
                    throw new Error(
                        'Produto não encontrado no Instagram.'
                    );
                }

                const product =
                    selectedItem.product || {};

                const policy =
                    selectedItem
                        ?.marketing
                        ?.policies
                        ?.instagram ||
                    null;

                const overlay =
                    document.createElement('div');

                overlay.id =
                    'instagram-degrau4-modal';

                overlay.style.cssText = `
                    position: fixed;
                    inset: 0;
                    z-index: 99999;
                    background: rgba(15,23,42,.55);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    padding: 20px;
                `;

                const modal =
                    document.createElement('div');

                modal.style.cssText = `
                    width: min(620px, 100%);
                    max-height: 90vh;
                    overflow-y: auto;
                    background: white;
                    border-radius: 20px;
                    padding: 28px;
                    box-shadow: 0 24px 70px rgba(0,0,0,.25);
                    font-family: Arial, sans-serif;
                `;

                const channel =
                    document.createElement('div');

                channel.textContent =
                    'INSTAGRAM';

                channel.style.cssText = `
                    color: #e1306c;
                    font-size: 13px;
                    font-weight: 800;
                    margin-bottom: 6px;
                `;

                const heading =
                    document.createElement('h2');

                heading.textContent =
                    'Preparar Feed';

                heading.style.cssText = `
                    margin: 0 0 20px;
                    color: #111827;
                    font-size: 22px;
                `;

                const productBox =
                    document.createElement('div');

                productBox.style.cssText = `
                    display: flex;
                    gap: 16px;
                    align-items: center;
                    padding: 16px;
                    border: 1px solid #e2e8f0;
                    border-radius: 16px;
                    background: #f8fafc;
                `;

                const image =
                    document.createElement('img');

                image.src =
                    product.image || '';

                image.alt =
                    product.title || 'Produto';

                image.style.cssText = `
                    width: 90px;
                    height: 90px;
                    object-fit: contain;
                    background: white;
                    border-radius: 12px;
                `;

                const title =
                    document.createElement('div');

                title.textContent =
                    product.title ||
                    'Produto selecionado';

                title.style.cssText = `
                    font-size: 15px;
                    font-weight: 800;
                    line-height: 1.4;
                    color: #111827;
                `;

                productBox.appendChild(image);
                productBox.appendChild(title);

                const policyBox =
                    document.createElement('div');

                policyBox.textContent =
                    policy?.status === 'approved'
                        ? '✅ Política aprovada'
                        : '⚠️ Política requer atenção';

                policyBox.style.cssText = `
                    margin-top: 16px;
                    padding: 13px;
                    border-radius: 12px;
                    background: #f0fdf4;
                    color: #166534;
                    font-weight: 800;
                `;

                let selectedImageUrl =
                    String(
                        product.image ||
                        ''
                    ).trim();

                const galleryBox =
                    document.createElement('div');

                galleryBox.style.cssText = `
                    margin-top: 16px;
                    padding: 14px;
                    border: 1px solid #e2e8f0;
                    border-radius: 14px;
                    background: #f8fafc;
                `;

                const galleryTitle =
                    document.createElement('div');

                galleryTitle.textContent =
                    '📷 Fotos do produto — escolha a capa';

                galleryTitle.style.cssText = `
                    font-weight: 800;
                    font-size: 14px;
                    color: #0f172a;
                    margin-bottom: 8px;
                `;

                const galleryStatus =
                    document.createElement('div');

                galleryStatus.textContent =
                    'Carregando fotos da Shopee...';

                galleryStatus.style.cssText = `
                    font-size: 13px;
                    color: #64748b;
                `;

                const galleryGrid =
                    document.createElement('div');

                galleryGrid.style.cssText = `
                    display: grid;
                    grid-template-columns: repeat(5, minmax(0, 1fr));
                    gap: 8px;
                    margin-top: 10px;
                `;

                galleryBox.appendChild(galleryTitle);
                galleryBox.appendChild(galleryStatus);
                galleryBox.appendChild(galleryGrid);

                async function loadInstagramGallery() {
                    const shopId =
                        String(
                            product.shopId ||
                            ''
                        ).trim();

                    if (!shopId || !itemId) {
                        galleryStatus.textContent =
                            'Galeria indisponível. A imagem principal será usada.';
                        return;
                    }

                    try {
                        const response =
                            await fetch(
                                '/admin/vitrine2/marketing/media/gallery',
                                {
                                    method: 'POST',

                                    headers: {
                                        'Content-Type':
                                            'application/json'
                                    },

                                    body:
                                        JSON.stringify({
                                            shopId,
                                            itemId
                                        })
                                }
                            );

                        const payload =
                            await response.json();

                        if (
                            !response.ok ||
                            !payload.success ||
                            !Array.isArray(payload.images) ||
                            payload.images.length === 0
                        ) {
                            throw new Error(
                                payload?.error?.message ||
                                'Galeria indisponível.'
                            );
                        }

                        galleryStatus.textContent =
                            `${payload.images.length} fotos encontradas. Clique na melhor imagem para definir a capa.`;

                        galleryGrid.innerHTML =
                            '';

                        payload.images.forEach(
                            (imageUrl, index) => {
                                const button =
                                    document.createElement('button');

                                button.type =
                                    'button';

                                button.style.cssText = `
                                    position: relative;
                                    padding: 4px;
                                    border: 2px solid #cbd5e1;
                                    border-radius: 12px;
                                    background: white;
                                    cursor: pointer;
                                    overflow: hidden;
                                `;

                                const thumb =
                                    document.createElement('img');

                                thumb.src =
                                    imageUrl;

                                thumb.alt =
                                    `Foto ${index + 1}`;

                                thumb.style.cssText = `
                                    width: 100%;
                                    aspect-ratio: 1 / 1;
                                    object-fit: contain;
                                    display: block;
                                    background: white;
                                    border-radius: 8px;
                                `;

                                const badge =
                                    document.createElement('span');

                                badge.textContent =
                                    'CAPA';

                                badge.style.cssText = `
                                    display: none;
                                    position: absolute;
                                    left: 6px;
                                    bottom: 6px;
                                    padding: 3px 6px;
                                    border-radius: 999px;
                                    background: #16a34a;
                                    color: white;
                                    font-size: 10px;
                                    font-weight: 800;
                                `;

                                function selectImage() {
                                    selectedImageUrl =
                                        imageUrl;

                                    for (
                                        const other
                                        of galleryGrid.children
                                    ) {
                                        other.style.borderColor =
                                            '#cbd5e1';

                                        const otherBadge =
                                            other.querySelector('span');

                                        if (otherBadge) {
                                            otherBadge.style.display =
                                                'none';
                                        }
                                    }

                                    button.style.borderColor =
                                        '#e1306c';

                                    badge.style.display =
                                        'block';
                                }

                                button.addEventListener(
                                    'click',
                                    selectImage
                                );

                                button.appendChild(thumb);
                                button.appendChild(badge);

                                galleryGrid.appendChild(button);

                                if (index === 0) {
                                    selectImage();
                                }
                            }
                        );
                    } catch (error) {
                        console.error(
                            '[INSTAGRAM] Erro ao carregar galeria:',
                            error
                        );

                        galleryStatus.textContent =
                            'Não foi possível carregar a galeria. A imagem principal será usada.';
                    }
                }


                const generateButton =
                    document.createElement('button');

                generateButton.type =
                    'button';

                generateButton.textContent =
                    'Gerar rascunho';

                generateButton.style.cssText = `
                    width: 100%;
                    margin-top: 18px;
                    padding: 13px;
                    border: 0;
                    border-radius: 12px;
                    background: #e1306c;
                    color: white;
                    font-weight: 800;
                    cursor: pointer;
                `;

                const statusBox =
                    document.createElement('div');

                statusBox.style.cssText = `
                    margin-top: 14px;
                    font-size: 13px;
                    color: #64748b;
                `;

                const textarea =
                    document.createElement('textarea');

                textarea.placeholder =
                    'O rascunho aparecerá aqui.';

                textarea.style.cssText = `
                    display: none;
                    width: 100%;
                    min-height: 190px;
                    margin-top: 14px;
                    padding: 14px;
                    border: 1px solid #cbd5e1;
                    border-radius: 12px;
                    resize: vertical;
                    box-sizing: border-box;
                    font-family: inherit;
                    font-size: 14px;
                    line-height: 1.5;
                `;

                const publishButton =
                    document.createElement('button');

                publishButton.type =
                    'button';

                publishButton.textContent =
                    'Aprovar e publicar no Instagram';

                publishButton.style.cssText = `
                    display: none;
                    width: 100%;
                    margin-top: 14px;
                    padding: 13px;
                    border: 0;
                    border-radius: 12px;
                    background: #16a34a;
                    color: white;
                    font-weight: 800;
                    cursor: pointer;
                `;

                const closeButton =
                    document.createElement('button');

                closeButton.type =
                    'button';

                closeButton.textContent =
                    'Fechar';

                closeButton.style.cssText = `
                    width: 100%;
                    margin-top: 14px;
                    padding: 12px;
                    border: 1px solid #cbd5e1;
                    border-radius: 12px;
                    background: white;
                    color: #334155;
                    font-weight: 800;
                    cursor: pointer;
                `;

                generateButton.addEventListener(
                    'click',
                    async () => {
                        try {
                            generateButton.disabled =
                                true;

                            generateButton.textContent =
                                'Gerando...';

                            statusBox.textContent =
                                'Preparando conteúdo...';

                            const prepareResponse =
                                await fetch(
                                    '/admin/vitrine2/marketing/prepare',
                                    {
                                        method:
                                            'POST',

                                        headers: {
                                            'Content-Type':
                                                'application/json'
                                        },

                                        body:
                                            JSON.stringify({
                                                marketplace:
                                                    marketplace ||
                                                    'shopee',

                                                itemId:
                                                    String(
                                                        itemId ||
                                                        ''
                                                    ),

                                                channels: [
                                                    'instagram'
                                                ]
                                            })
                                    }
                                );

                            const preparePayload =
                                await prepareResponse.json();

                            const result =
                                preparePayload
                                    ?.channels
                                    ?.instagram;

                            if (
                                !prepareResponse.ok ||
                                !result
                            ) {
                                throw new Error(
                                    preparePayload
                                        ?.error
                                        ?.message ||
                                    'Falha na preparação.'
                                );
                            }

                            if (
                                result.status !==
                                'READY'
                            ) {
                                throw new Error(
                                    result.reason ||
                                    `Status: ${result.status}`
                                );
                            }

                            const caption =
                                String(
                                    result
                                        ?.content
                                        ?.caption ||
                                    ''
                                );

                            const hashtags =
                                Array.isArray(
                                    result
                                        ?.content
                                        ?.hashtags
                                )
                                    ? result
                                        .content
                                        .hashtags
                                        .join(' ')
                                    : '';

                            const constructionNotice =
                                '🔧 Nossa página de ofertas está em preparação. Em breve os links dos produtos estarão disponíveis na bio.';

                            textarea.value =
                                [
                                    caption,
                                    constructionNotice,
                                    hashtags
                                ]
                                    .filter(Boolean)
                                    .join('\n\n');

                            textarea.style.display =
                                'block';

                            const auditStatus =
                                result
                                    ?.audit
                                    ?.status ||
                                'sem status';

                            const auditStatusLabel =
                                auditStatus === 'APPROVED'
                                    ? 'APROVADA'
                                    : auditStatus;

                            statusBox.textContent =
                                `✅ Rascunho pronto • Auditoria: ${auditStatusLabel}`;

                            statusBox.style.color =
                                '#166534';

                            generateButton.textContent =
                                'Rascunho gerado';

                            if (
                                result.status === 'READY' &&
                                auditStatus === 'APPROVED'
                            ) {
                                publishButton.style.display =
                                    'block';

                                publishButton.disabled =
                                    false;
                            }
                        } catch (error) {
                            console.error(
                                '[INSTAGRAM] Erro ao gerar rascunho:',
                                error
                            );

                            statusBox.textContent =
                                `❌ ${
                                    error?.message ||
                                    'Erro na preparação.'
                                }`;

                            statusBox.style.color =
                                '#b91c1c';

                            generateButton.disabled =
                                false;

                            generateButton.textContent =
                                'Tentar novamente';
                        }
                    }
                );

                publishButton.addEventListener(
                    'click',
                    async () => {
                        const confirmed =
                            window.confirm(
                                'Confirma a aprovação e publicação deste conteúdo no Instagram?'
                            );

                        if (!confirmed) {
                            return;
                        }

                        const imageUrl =
                            String(
                                selectedImageUrl ||
                                product.image ||
                                ''
                            ).trim();

                        const finalCaption =
                            String(
                                textarea.value ||
                                ''
                            ).trim();

                        if (!imageUrl) {
                            window.alert(
                                'O produto não possui imagem disponível para publicação.'
                            );

                            return;
                        }

                        if (!finalCaption) {
                            window.alert(
                                'A legenda está vazia.'
                            );

                            return;
                        }

                        try {
                            publishButton.disabled =
                                true;

                            publishButton.textContent =
                                'Publicando...';

                            statusBox.textContent =
                                '⏳ Enviando publicação para o Instagram...';

                            statusBox.style.color =
                                '#475569';

                            const publishResponse =
                                await fetch(
                                    '/admin/vitrine2/marketing/meta/publish',
                                    {
                                        method: 'POST',

                                        headers: {
                                            'Content-Type':
                                                'application/json'
                                        },

                                        body:
                                            JSON.stringify({
                                                imageUrl,
                                                caption:
                                                    finalCaption,
                                                channels: [
                                                    'instagram'
                                                ]
                                            })
                                    }
                                );

                            let publishPayload = {};

                            try {
                                publishPayload =
                                    await publishResponse.json();
                            } catch (_) {
                                publishPayload = {};
                            }

                            const channelResult =
                                publishPayload
                                    ?.channels
                                    ?.instagram ||
                                publishPayload
                                    ?.results
                                    ?.instagram ||
                                publishPayload
                                    ?.instagram ||
                                null;

                            if (
                                !publishResponse.ok ||
                                publishPayload?.success === false ||
                                channelResult?.success === false ||
                                channelResult?.status === 'ERROR' ||
                                channelResult?.error
                            ) {
                                throw new Error(
                                    channelResult
                                        ?.error
                                        ?.message ||
                                    publishPayload
                                        ?.error
                                        ?.message ||
                                    'A publicação não foi concluída.'
                                );
                            }

                            statusBox.textContent =
                                '✅ Publicado no Instagram com sucesso.';

                            statusBox.style.color =
                                '#166534';

                            publishButton.textContent =
                                'Publicado';

                            publishButton.style.background =
                                '#15803d';

                            textarea.disabled =
                                true;

                            generateButton.disabled =
                                true;
                        } catch (error) {
                            console.error(
                                '[INSTAGRAM] Erro ao publicar:',
                                error
                            );

                            statusBox.textContent =
                                `❌ ${
                                    error?.message ||
                                    'Erro na publicação.'
                                }`;

                            statusBox.style.color =
                                '#b91c1c';

                            publishButton.disabled =
                                false;

                            publishButton.textContent =
                                'Tentar publicar novamente';
                        }
                    }
                );


                closeButton.addEventListener(
                    'click',
                    () => overlay.remove()
                );

                overlay.addEventListener(
                    'click',
                    event => {
                        if (
                            event.target ===
                            overlay
                        ) {
                            overlay.remove();
                        }
                    }
                );

                modal.appendChild(channel);
                modal.appendChild(heading);
                modal.appendChild(productBox);
                modal.appendChild(policyBox);
                modal.appendChild(galleryBox);
                modal.appendChild(generateButton);
                modal.appendChild(statusBox);
                modal.appendChild(textarea);
                modal.appendChild(publishButton);
                modal.appendChild(closeButton);

                overlay.appendChild(modal);

                document.body.appendChild(
                    overlay
                );

                loadInstagramGallery();

                console.log(
                    '[INSTAGRAM] Degrau 4 aberto',
                    {
                        marketplace,
                        itemId
                    }
                );
            } catch (error) {
                console.error(
                    '[INSTAGRAM] Erro no Degrau 4:',
                    error
                );

                window.alert(
                    error?.message ||
                    'Erro ao abrir preparação.'
                );
            }
        }

        async function loadChannelProducts() {
            try {
                const items =
                    await fetchCatalogProducts();

                instagramItems =
                    items;

                applyPolicyFilter();
            }
            catch (error) {
                document
                    .getElementById(
                        'instagramProducts'
                    )
                    .innerHTML =
                        `
                            <div
                                class="
                                    bg-white
                                    border
                                    border-red-200
                                    rounded-2xl
                                    p-8
                                    text-center
                                    text-red-600
                                    sm:col-span-2
                                    lg:col-span-3
                                    xl:col-span-4
                                "
                            >
                                ${escapeHtml(error.message)}
                            </div>
                        `;
            }
        }


        document
            .querySelectorAll(
                '.instagram-policy-filter'
            )
            .forEach(
                button => {
                    button.addEventListener(
                        'click',
                        () => {
                            instagramPolicyFilter =
                                button.dataset
                                    .policyFilter ||
                                'all';

                            applyPolicyFilter();
                        }
                    );
                }
            );


        loadChannelProducts();

    </script>

</body>
</html>
