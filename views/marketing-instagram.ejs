    <script>
        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }


        function formatPrice(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return new Intl.NumberFormat(
                'pt-BR',
                {
                    style: 'currency',
                    currency: 'BRL'
                }
            ).format(number);
        }


        function formatCommission(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return `${(number * 100)
                .toFixed(1)
                .replace('.0', '')}%`;
        }


        function formatSales(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return new Intl.NumberFormat(
                'pt-BR'
            ).format(number);
        }


        function formatRating(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return `${number
                .toFixed(1)
                .replace('.', ',')} ★`;
        }


        function productLink(product) {
            return (
                product?.metadata?.productLink ||
                product?.affiliateLink ||
                '#'
            );
        }


        async function fetchCatalogProducts() {
            const response =
                await fetch(
                    '/api/vitrine2/marketing/instagram/candidates'
                );

            const data =
                await response.json();

            if (
                !response.ok ||
                !data.success
            ) {
                throw new Error(
                    data.error ||
                    'Falha ao carregar candidatos automáticos do Instagram.'
                );
            }

            return (
                Array.isArray(
                    data.items
                )
                    ? data.items
                    : []
            )
                .map(
                    entry => ({
                        entry,
                        product:
                            entry.product || {},
                        policy:
                            entry?.policy?.summary
                                ? {
                                    ...entry.policy.summary,
                                    status:
                                        normalizePolicyStatus(
                                            entry.policy.summary.status
                                        )
                                }
                                : null
                    })
                );
        }


        let instagramItems = [];
        let instagramPolicyFilter = 'all';


        function normalizePolicyStatus(status) {
            const normalized =
                String(status || '')
                    .trim()
                    .toLowerCase();

            if (
                normalized === 'approved' ||
                normalized === 'needs_review' ||
                normalized === 'blocked' ||
                normalized === 'revalidate'
            ) {
                return normalized;
            }

            return 'unavailable';
        }


        async function fetchInstagramPolicy(
            product
        ) {
            const marketplace =
                product?.marketplace ||
                'shopee';

            const itemId =
                product?.itemId;

            if (!itemId) {
                return {
                    status: 'unavailable',
                    label: 'Política indisponível',
                    reason: 'Produto sem itemId.'
                };
            }

            try {
                const response =
                    await fetch(
                        `/api/vitrine2/products/${encodeURIComponent(
                            marketplace
                        )}/${encodeURIComponent(
                            itemId
                        )}/policy/instagram`
                    );

                const data =
                    await response.json();

                if (
                    !response.ok ||
                    !data.success
                ) {
                    throw new Error(
                        data.error ||
                        'Falha ao validar política.'
                    );
                }

                const summary =
                    data.summary ||
                    {};

                return {
                    ...summary,
                    status:
                        normalizePolicyStatus(
                            summary.status
                        )
                };
            }
            catch (error) {
                console.error(
                    '[INSTAGRAM] Erro ao consultar política:',
                    product?.itemId,
                    error
                );

                return {
                    status: 'unavailable',
                    label: 'Política indisponível',
                    reason:
                        error.message ||
                        'Não foi possível consultar a política.'
                };
            }
        }


        function policyStatusMeta(status) {
            const normalized =
                normalizePolicyStatus(
                    status
                );

            const definitions = {
                approved: {
                    label: 'Aprovado',
                    icon: 'fa-circle-check',
                    badgeClass:
                        'bg-emerald-50 text-emerald-700'
                },

                blocked: {
                    label: 'Bloqueado',
                    icon: 'fa-ban',
                    badgeClass:
                        'bg-red-50 text-red-700'
                },

                needs_review: {
                    label: 'Revisão necessária',
                    icon: 'fa-triangle-exclamation',
                    badgeClass:
                        'bg-amber-50 text-amber-700'
                },

                revalidate: {
                    label: 'Revalidar',
                    icon: 'fa-rotate',
                    badgeClass:
                        'bg-sky-50 text-sky-700'
                },

                unavailable: {
                    label: 'Política indisponível',
                    icon: 'fa-circle-question',
                    badgeClass:
                        'bg-slate-100 text-slate-600'
                }
            };

            return definitions[normalized];
        }


        function updatePolicySummary() {
            const counts = {
                all: instagramItems.length,
                approved: 0,
                blocked: 0,
                needs_review: 0,
                revalidate: 0,
                unavailable: 0
            };

            instagramItems.forEach(
                item => {
                    const status =
                        normalizePolicyStatus(
                            item.policy?.status
                        );

                    counts[status] += 1;
                }
            );

            document.getElementById(
                'policyCountAll'
            ).textContent = counts.all;

            document.getElementById(
                'policyCountApproved'
            ).textContent = counts.approved;

            document.getElementById(
                'policyCountBlocked'
            ).textContent = counts.blocked;

            document.getElementById(
                'policyCountReview'
            ).textContent = counts.needs_review;

            document.getElementById(
                'policyCountRevalidate'
            ).textContent = counts.revalidate;

            document.getElementById(
                'policyCountUnavailable'
            ).textContent = counts.unavailable;

            document
                .querySelectorAll(
                    '.instagram-policy-filter'
                )
                .forEach(
                    button => {
                        const active =
                            button.dataset
                                .policyFilter ===
                            instagramPolicyFilter;

                        button.classList.toggle(
                            'ring-2',
                            active
                        );

                        button.classList.toggle(
                            'ring-sky-300',
                            active
                        );

                        button.classList.toggle(
                            'border-sky-300',
                            active
                        );
                    }
                );
        }


        function applyPolicyFilter() {
            const filteredItems =
                instagramPolicyFilter === 'all'
                    ? instagramItems
                    : instagramItems.filter(
                        item =>
                            normalizePolicyStatus(
                                item.policy?.status
                            ) ===
                            instagramPolicyFilter
                    );

            renderChannelProducts(
                filteredItems
            );

            updatePolicySummary();
        }


        function renderChannelProducts(items) {
            const container =
                document.getElementById(
                    'instagramProducts'
                );

            document
                .getElementById(
                    'instagramCounter'
                )
                .textContent =
                    instagramPolicyFilter === 'all'
                        ? `${items.length} produtos`
                        : `${items.length} de ${instagramItems.length}`;

            if (items.length === 0) {
                container.innerHTML =
                    `
                        <div
                            class="
                                bg-slate-50
                                border
                                border-slate-200
                                rounded-2xl
                                p-8
                                text-center
                                text-slate-500
                                md:col-span-2
                                xl:col-span-3
                            "
                        >
                            Nenhum produto neste filtro.
                        </div>
                    `;

                return;
            }

            container.innerHTML =
                items
                    .map(
                        ({ product, policy }) => {
                            const policyMeta =
                                policyStatusMeta(
                                    policy?.status
                                );

                            return `
                                <article
                                    class="
                                        bg-white
                                        border
                                        border-slate-200
                                        rounded-2xl
                                        p-4
                                    "
                                >
                                    <div
                                        class="
                                            flex
                                            items-start
                                            justify-between
                                            gap-3
                                            mb-3
                                        "
                                    >
                                        <span
                                            title="${escapeHtml(policyMeta.label)}"
                                            aria-label="${escapeHtml(policyMeta.label)}"
                                            class="
                                                inline-flex
                                                items-center
                                                justify-center
                                                w-8
                                                h-8
                                                rounded-full
                                                ${policyMeta.badgeClass}
                                                shrink-0
                                            "
                                        >
                                            <i class="fa-solid ${policyMeta.icon}"></i>
                                        </span>

                                        <span
                                            class="
                                                text-xs
                                                text-slate-400
                                                truncate
                                            "
                                        >
                                            ${escapeHtml(
                                                policy?.policyVersion ||
                                                ''
                                            )}
                                        </span>
                                    </div>

                                    <div class="flex gap-3">

                                        <img
                                            src="${escapeHtml(product.image)}"
                                            alt=""
                                            class="
                                                w-16
                                                h-16
                                                rounded-xl
                                                object-cover
                                                bg-slate-100
                                                shrink-0
                                            "
                                        >

                                        <div class="min-w-0">
                                            <a
                                                href="${escapeHtml(productLink(product))}"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="
                                                    font-bold
                                                    text-sm
                                                    text-slate-900
                                                    line-clamp-2
                                                    hover:text-sky-700
                                                    hover:underline
                                                "
                                            >
                                                ${escapeHtml(product.title)}
                                            </a>

                                            <div
                                                class="
                                                    mt-2
                                                    grid
                                                    grid-cols-2
                                                    gap-x-3
                                                    gap-y-2
                                                    text-sm
                                                "
                                            >
                                                <div>
                                                    <span class="text-slate-500 text-sm">
                                                        Comissão
                                                    </span>

                                                    <div class="text-slate-800 text-base font-medium">
                                                        ${formatCommission(product.commissionRate)}
                                                    </div>
                                                </div>

                                                <div>
                                                    <span class="text-slate-500 text-sm">
                                                        Estimada
                                                    </span>

                                                    <div class="text-slate-800 text-base font-medium">
                                                        ${formatPrice(product.commission)}
                                                    </div>
                                                </div>

                                                <div>
                                                    <span class="text-slate-500 text-sm">
                                                        Vendas
                                                    </span>

                                                    <div class="text-slate-800 text-base font-medium">
                                                        ${formatSales(product.sales)}
                                                    </div>
                                                </div>

                                                <div>
                                                    <span class="text-slate-500 text-sm">
                                                        Avaliação
                                                    </span>

                                                    <div class="text-amber-600 text-base font-medium">
                                                        ${formatRating(product.ratingStar)}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <button
                                        type="button"
                                        onclick="prepareInstagramFeedForProduct(
                                            '${escapeHtml(product.marketplace || 'shopee')}',
                                            '${escapeHtml(product.itemId || '')}'
                                        )"
                                        class="
                                            mt-4
                                            w-full
                                            inline-flex
                                            items-center
                                            justify-center
                                            gap-2
                                            rounded-xl
                                            bg-pink-50
                                            hover:bg-pink-100
                                            text-pink-700
                                            px-3
                                            py-2.5
                                            text-xs
                                            font-bold
                                            transition
                                        "
                                    >
                                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                                        Preparar Feed
                                    </button>
                                </article>
                            `;
                        }
                    )
                    .join('');
        }


                function prepareInstagramFeed() {
            const products =
                document.getElementById(
                    'instagramProducts'
                );

            if (products) {
                products.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
            }

            window.alert(
                'Escolha abaixo o produto que deseja preparar para o Feed.'
            );
        }


        function closeInstagramFeedDraft() {
            const modal =
                document.getElementById(
                    'instagramFeedDraftModal'
                );

            if (modal) {
                modal.remove();
            }
        }


        async function prepareInstagramFeedForProduct(
            marketplace,
            itemId
        ) {
            try {
                const items =
                    await fetchCatalogProducts();

                const selectedItem =
                    items.find(
                        item =>
                            String(
                                item.product
                                    ?.marketplace ||
                                'shopee'
                            ).toLowerCase() ===
                                String(
                                    marketplace ||
                                    ''
                                ).toLowerCase() &&
                            String(
                                item.product
                                    ?.itemId ||
                                ''
                            ) ===
                                String(
                                    itemId ||
                                    ''
                                )
                    );

                if (!selectedItem) {
                    throw new Error(
                        'Produto não encontrado no canal Instagram.'
                    );
                }

                const product =
                    selectedItem.product || {};

                const title =
                    product.title ||
                    'Produto selecionado';

                const caption =
                    `✨ Olha esse achado!\n\n` +
                    `${title}\n\n` +
                    `Uma opção interessante para quem procura praticidade e bom custo-benefício.\n\n` +
                    `🔎 Confira todos os detalhes, preço atual e disponibilidade na nossa vitrine.\n\n` +
                    `👉 Acesse pelo link da bio.\n\n` +
                    `#achadinhos #shopee #ofertas #dicas`;

                const modal =
                    document.createElement(
                        'div'
                    );

                modal.id =
                    'instagramFeedDraftModal';

                modal.className =
                    'fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4';

                modal.innerHTML = `
                    <div
                        class="
                            bg-white
                            w-full
                            max-w-2xl
                            rounded-2xl
                            shadow-xl
                            overflow-hidden
                        "
                    >
                        <div
                            class="
                                px-5
                                py-4
                                border-b
                                border-slate-200
                                flex
                                items-center
                                justify-between
                                gap-3
                            "
                        >
                            <div>
                                <div
                                    class="
                                        text-xs
                                        uppercase
                                        tracking-wide
                                        font-bold
                                        text-pink-700
                                    "
                                >
                                    Instagram • Feed
                                </div>

                                <h2
                                    class="
                                        mt-1
                                        text-lg
                                        font-extrabold
                                    "
                                >
                                    Rascunho do conteúdo
                                </h2>
                            </div>

                            <button
                                type="button"
                                onclick="closeInstagramFeedDraft()"
                                class="
                                    w-9
                                    h-9
                                    rounded-full
                                    bg-slate-100
                                    hover:bg-slate-200
                                    text-slate-600
                                "
                            >
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>

                        <div
                            class="
                                p-5
                                max-h-[75vh]
                                overflow-y-auto
                            "
                        >
                            <div
                                class="
                                    flex
                                    gap-4
                                    items-start
                                "
                            >
                                <img
                                    src="${escapeHtml(product.image || '')}"
                                    alt=""
                                    class="
                                        w-28
                                        h-28
                                        rounded-2xl
                                        object-cover
                                        bg-slate-100
                                        shrink-0
                                    "
                                >

                                <div>
                                    <div
                                        class="
                                            text-xs
                                            font-bold
                                            uppercase
                                            tracking-wide
                                            text-slate-400
                                        "
                                    >
                                        Produto
                                    </div>

                                    <div
                                        class="
                                            mt-1
                                            font-extrabold
                                            text-slate-900
                                        "
                                    >
                                        ${escapeHtml(title)}
                                    </div>

                                    <div
                                        class="
                                            mt-2
                                            text-sm
                                            text-slate-500
                                        "
                                    >
                                        O preço e a disponibilidade serão conferidos na Shopee no momento da visita.
                                    </div>
                                </div>
                            </div>

                            <div class="mt-5">
                                <label
                                    class="
                                        block
                                        text-sm
                                        font-bold
                                        text-slate-700
                                        mb-2
                                    "
                                >
                                    Legenda sugerida
                                </label>

                                <textarea
                                    id="instagramFeedCaption"
                                    rows="12"
                                    class="
                                        w-full
                                        rounded-xl
                                        border
                                        border-slate-200
                                        px-4
                                        py-3
                                        text-sm
                                        resize-y
                                    "
                                >${escapeHtml(caption)}</textarea>
                            </div>

                            <div
                                class="
                                    mt-4
                                    rounded-xl
                                    bg-sky-50
                                    border
                                    border-sky-100
                                    px-4
                                    py-3
                                    text-sm
                                    text-sky-800
                                "
                            >
                                <strong>CTA atual:</strong>
                                acessar o link da bio e entrar na nossa Vitrine.
                            </div>

                            <div
                                class="
                                    mt-4
                                    rounded-xl
                                    bg-amber-50
                                    border
                                    border-amber-100
                                    px-4
                                    py-3
                                    text-sm
                                    text-amber-800
                                "
                            >
                                Este é apenas um rascunho.
                                Nada será publicado automaticamente nesta fase.
                            </div>
                        </div>

                        <div
                            class="
                                px-5
                                py-4
                                border-t
                                border-slate-200
                                flex
                                justify-end
                                gap-2
                            "
                        >
                            <button
                                type="button"
                                onclick="closeInstagramFeedDraft()"
                                class="
                                    rounded-xl
                                    bg-slate-100
                                    hover:bg-slate-200
                                    px-4
                                    py-2.5
                                    text-sm
                                    font-bold
                                "
                            >
                                Fechar
                            </button>

                            <button
                                type="button"
                                onclick="
                                    window.alert(
                                        'Próxima etapa: salvar este conteúdo como rascunho.'
                                    )
                                "
                                class="
                                    rounded-xl
                                    bg-pink-600
                                    hover:bg-pink-700
                                    text-white
                                    px-4
                                    py-2.5
                                    text-sm
                                    font-bold
                                "
                            >
                                Aprovar rascunho
                            </button>
                        </div>
                    </div>
                `;

                document.body.appendChild(
                    modal
                );
            }
            catch (error) {
                console.error(
                    '[INSTAGRAM] Erro ao preparar Feed:',
                    error
                );

                window.alert(
                    error.message ||
                    'Não foi possível preparar o conteúdo.'
                );
            }
        }

        async function loadChannelProducts() {
            try {
                const items =
                    await fetchCatalogProducts();

                instagramItems =
                    await Promise.all(
                        items.map(
                            async item => ({
                                ...item,

                                policy:
                                    item.policy ||
                                    await fetchInstagramPolicy(
                                        item.product
                                    )
                            })
                        )
                    );

                applyPolicyFilter();
            }
            catch (error) {
                document
                    .getElementById(
                        'instagramProducts'
                    )
                    .innerHTML =
                        `
                            <div
                                class="
                                    bg-white
                                    border
                                    border-red-200
                                    rounded-2xl
                                    p-8
                                    text-center
                                    text-red-600
                                    md:col-span-2
                                    xl:col-span-3
                                "
                            >
                                ${escapeHtml(error.message)}
                            </div>
                        `;
            }
        }


        document
            .querySelectorAll(
                '.instagram-policy-filter'
            )
            .forEach(
                button => {
                    button.addEventListener(
                        'click',
                        () => {
                            instagramPolicyFilter =
                                button.dataset
                                    .policyFilter ||
                                'all';

                            applyPolicyFilter();
                        }
                    );
                }
            );


        loadChannelProducts();

    </script>

</body>
</html>

