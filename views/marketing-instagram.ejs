                        return;
                    }

                    const reelImages =
                        Array.from(
                            reelGrid.querySelectorAll(
                                'input[type="checkbox"]:checked'
                            )
                        )
                            .map(
                                input =>
                                    input.dataset.imageUrl
                            )
                            .filter(Boolean)
                            .slice(0, 5);

                    if (reelImages.length === 0) {
                        reelStatus.textContent =
                            'Selecione pelo menos uma foto para o Reel.';

                        reelStatus.style.color =
                            '#b91c1c';

                        return;
                    }

                    reelSelectedImageUrls =
                        reelImages;

                    try {
                        reelButton.disabled =
                            true;

                        reelButton.textContent =
                            '⏳ Processando Reel...';

                        reelButton.style.background =
                            '#e1306c';

                        reelStatus.textContent =
