                }


                carouselBuildButton.addEventListener(
                    'click',
                    async () => {
                        const selectedImages =
                            Array.from(
                                carouselGrid.querySelectorAll(
                                    'input[type="checkbox"]:checked'
                                )
                            )
                                .map(
                                    input =>
                                        input.dataset.imageUrl
                                )
                                .filter(Boolean);

                        if (
                            selectedImages.length < 2
                        ) {
                            carouselStatus.textContent =
                                'Selecione pelo menos 2 fotos.';

                            carouselStatus.style.color =
                                '#b91c1c';

