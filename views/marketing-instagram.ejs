                async function prepareInstagramFormatReview(
                    review
                ) {
                    try {
                        review.status.style.display =
                            'block';

                        review.status.textContent =
                            '⏳ Gerando rascunho e auditando conteúdo...';

                        review.status.style.color =
                            '#64748b';

                        const response =
                            await fetch(
                                '/admin/vitrine2/marketing/prepare',
                                {
                                    method:
                                        'POST',

                                    headers: {
                                        'Content-Type':
                                            'application/json'
                                    },

                                    body:
                                        JSON.stringify({
                                            marketplace:
                                                marketplace ||
                                                'shopee',

                                            itemId:
                                                String(
                                                    itemId ||
                                                    ''
                                                ),

                                            channels: [
                                                'instagram'
                                            ]
                                        })
                                }
                            );

                        const payload =
                            await response.json();

                        const result =
                            payload
                                ?.channels
                                ?.instagram;

                        if (
                            !response.ok ||
                            !result
                        ) {
                            throw new Error(
                                payload
                                    ?.error
                                    ?.message ||
                                'Falha na preparação.'
                            );
                        }

                        if (
                            result.status !==
                            'READY'
                        ) {
                            throw new Error(
                                result.reason ||
                                `Status: ${result.status}`
                            );
                        }

                        const caption =
                            String(
                                result
                                    ?.content
                                    ?.caption ||
                                ''
                            );

                        const hashtags =
                            Array.isArray(
                                result
                                    ?.content
                                    ?.hashtags
                            )
                                ? result
                                    .content
                                    .hashtags
                                    .join(' ')
                                : '';

                        const constructionNotice =
                            '🔧 Nossa página de ofertas está em preparação. Em breve os links dos produtos estarão disponíveis na bio.';

                        review.textarea.value =
                            [
                                caption,
                                constructionNotice,
                                hashtags
                            ]
                                .filter(Boolean)
                                .join('\n\n');

                        review.textarea.style.display =
                            'block';

                        const auditStatus =
                            result
                                ?.audit
                                ?.status ||
                            'sem status';

                        const auditLabel =
                            auditStatus ===
                            'APPROVED'
                                ? 'APROVADA'
                                : auditStatus;

                        review.status.textContent =
                            `✅ Rascunho pronto • Auditoria: ${auditLabel}`;

                        review.status.style.color =
                            auditStatus === 'APPROVED'
                                ? '#166534'
                                : '#b91c1c';

                        return (
                            result.status ===
                                'READY' &&
                            auditStatus ===
                                'APPROVED'
                        );
                    } catch (error) {
                        console.error(
                            '[INSTAGRAM REVIEW] Erro:',
                            error
                        );

                        review.status.style.display =
                            'block';

                        review.status.textContent =
                            `❌ ${
                                error?.message ||
                                'Erro na preparação.'
                            }`;

                        review.status.style.color =
                            '#b91c1c';

                        return false;
                    }
                }


