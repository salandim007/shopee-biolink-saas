                                'Foto ' + (index + 1);

                            image.style.cssText = `
                                width: 100%;
                                aspect-ratio: 1 / 1;
                                object-fit: contain;
                                display: block;
                                border-radius: 8px;
                                background: white;
                            `;

                            checkbox.addEventListener(
