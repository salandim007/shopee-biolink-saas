    <script>
        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }


        function formatPrice(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return new Intl.NumberFormat(
                'pt-BR',
                {
                    style: 'currency',
                    currency: 'BRL'
                }
            ).format(number);
        }


        function formatCommission(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return `${(number * 100)
                .toFixed(1)
                .replace('.0', '')}%`;
        }


        function formatSales(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return new Intl.NumberFormat(
                'pt-BR'
            ).format(number);
        }


        function formatRating(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return `${number
                .toFixed(1)
                .replace('.', ',')} ★`;
        }


        function productLink(product) {
            return (
                product?.metadata?.productLink ||
                product?.affiliateLink ||
                '#'
            );
        }


        async function fetchCatalogProducts() {
            const response =
                await fetch(
                    '/api/vitrine2/marketing/channel/facebook'
                );

            const data =
                await response.json();

            if (
                !response.ok ||
                !data.success
            ) {
                throw new Error(
                    data.error ||
                    'Falha ao carregar produtos do Facebook.'
                );
            }

            return (
                Array.isArray(
                    data.products
                )
                    ? data.products
                    : []
            )
                .map(
                    entry => ({
                        entry,
                        product:
                            entry.product || {}
                    })
                );
        }

        function renderChannelProducts(items) {
            const container =
                document.getElementById(
                    'facebookProducts'
                );

            document
                .getElementById(
                    'facebookCounter'
                )
                .textContent =
                    items.length;


            if (items.length === 0) {
                container.innerHTML =
                    `
                        <div
                            class="
                                bg-slate-50
                                border
                                border-slate-200
                                rounded-2xl
                                p-8
                                text-center
                                text-slate-500
                                md:col-span-2
                                xl:col-span-3
                            "
                        >
                            Nenhum produto selecionado para Facebook.
                        </div>
                    `;

                return;
            }

            container.innerHTML =
                items
                    .map(
                        ({ product }) => `
                            <article
                                class="
                                    bg-white
                                    border
                                    border-slate-200
                                    rounded-2xl
                                    p-4
                                "
                            >
                                <div class="flex gap-3">

                                    <img
                                        src="${escapeHtml(product.image)}"
                                        alt=""
                                        class="
                                            w-16
                                            h-16
                                            rounded-xl
                                            object-cover
                                            bg-slate-100
                                            shrink-0
                                        "
                                    >

                                    <div class="min-w-0">
                                        <a
                                            href="${escapeHtml(productLink(product))}"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="
                                                font-bold
                                                text-sm
                                                text-slate-900
                                                line-clamp-2
                                                hover:text-sky-700
                                                hover:underline
                                            "
                                        >
                                            ${escapeHtml(product.title)}
                                        </a>

                                        <div
                                            class="
                                                mt-2
                                                grid
                                                grid-cols-2
                                                gap-x-3
                                                gap-y-2
                                                text-sm
                                            "
                                        >
                                            <div>
                                                <span class="text-slate-500 text-sm">
                                                    Comissão
                                                </span>

                                                <div class="text-slate-800 text-base font-medium">
                                                    ${formatCommission(product.commissionRate)}
                                                </div>
                                            </div>

                                            <div>
                                                <span class="text-slate-500 text-sm">
                                                    Estimada
                                                </span>

                                                <div class="text-slate-800 text-base font-medium">
                                                    ${formatPrice(product.commission)}
                                                </div>
                                            </div>

                                            <div>
                                                <span class="text-slate-500 text-sm">
                                                    Vendas
                                                </span>

                                                <div class="text-slate-800 text-base font-medium">
                                                    ${formatSales(product.sales)}
                                                </div>
                                            </div>

                                            <div>
                                                <span class="text-slate-500 text-sm">
                                                    Avaliação
                                                </span>

                                                <div class="text-amber-600 text-base font-medium">
                                                    ${formatRating(product.ratingStar)}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                
                                <button
                                    type="button"
                                    onclick="prepareFacebookContentForProduct(
                                        '${escapeHtml(product.marketplace || 'shopee')}',
                                        '${escapeHtml(product.itemId || '')}'
                                    )"
                                    class="
                                        mt-4
                                        w-full
                                        inline-flex
                                        items-center
                                        justify-center
                                        gap-2
                                        rounded-xl
                                        bg-blue-50
                                        hover:bg-blue-100
                                        text-blue-700
                                        px-3
                                        py-2.5
                                        text-xs
                                        font-bold
                                        transition
                                    "
                                >
                                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                                    Preparar conteúdo
                                </button>

                            </article>
                        `
                    )
                    .join('');
        }


        function closeFacebookContentDraft() {
            const modal =
                document.getElementById(
                    'facebookContentDraftModal'
                );

            if (modal) {
                modal.remove();
            }
        }


        function normalizeFacebookDraftImages(
            product
        ) {
            const values = [
                product?.image,
                ...(
                    Array.isArray(
                        product?.images
                    )
                        ? product.images
                        : []
                )
            ];

            return [
                ...new Set(
                    values
                        .map(value =>
                            String(
                                value || ''
                            ).trim()
                        )
                        .filter(Boolean)
                )
            ];
        }


        async function fetchFacebookProductGallery(
            product
        ) {
            const currentImages =
                normalizeFacebookDraftImages(
                    product
                );

            const shopId =
                String(
                    product?.shopId || ''
                ).trim();

            const itemId =
                String(
                    product?.itemId || ''
                ).trim();

            if (
                !shopId ||
                !itemId ||
                currentImages.length >= 3
            ) {
                return currentImages;
            }

            try {
                const response =
                    await fetch(
                        '/admin/vitrine2/marketing/media/gallery',
                        {
                            method:
                                'POST',

                            headers: {
                                'Content-Type':
                                    'application/json'
                            },

                            body:
                                JSON.stringify({
                                    shopId,
                                    itemId
                                })
                        }
                    );

                const data =
                    await response.json();

                if (
                    !response.ok ||
                    !data.success
                ) {
                    throw new Error(
                        data?.error?.message ||
                        data?.error ||
                        'Falha ao buscar galeria.'
                    );
                }

                return [
                    ...new Set([
                        ...currentImages,
                        ...(
                            Array.isArray(
                                data.images
                            )
                                ? data.images
                                : []
                        )
                    ])
                ]
                    .map(value =>
                        String(
                            value || ''
                        ).trim()
                    )
                    .filter(Boolean);
            }
            catch (error) {
                console.warn(
                    '[FACEBOOK] Galeria adicional indisponível:',
                    error
                );

                return currentImages;
            }
        }


        function applyFacebookDraftGallery(
            images,
            title
        ) {
            const normalized =
                Array.isArray(images)
                    ? [
                        ...new Set(
                            images
                                .map(value =>
                                    String(
                                        value || ''
                                    ).trim()
                                )
                                .filter(Boolean)
                        )
                    ]
                    : [];

            const mainImage =
                document.getElementById(
                    'facebookDraftMainImage'
                );

            const status =
                document.getElementById(
                    'facebookDraftGalleryStatus'
                );

            if (
                mainImage &&
                normalized[0]
            ) {
                mainImage.src =
                    normalized[0];

                mainImage.alt =
                    title || 'Produto';
            }

            for (
                let index = 0;
                index < 2;
                index += 1
            ) {
                const button =
                    document.getElementById(
                        `facebookDraftThumb${index + 1}`
                    );

                const image =
                    document.getElementById(
                        `facebookDraftThumbImage${index + 1}`
                    );

                const placeholder =
                    document.getElementById(
                        `facebookDraftThumbPlaceholder${index + 1}`
                    );

                const imageUrl =
                    normalized[index + 1] ||
                    '';

                if (!button) {
                    continue;
                }

                if (imageUrl) {
                    button.disabled =
                        false;

                    button.dataset.fullImage =
                        imageUrl;

                    if (image) {
                        image.src =
                            imageUrl;

                        image.alt =
                            `${title || 'Produto'} - imagem ${index + 2}`;

                        image.classList.remove(
                            'hidden'
                        );
                    }

                    if (placeholder) {
                        placeholder.classList.add(
                            'hidden'
                        );
                    }
                }
                else {
                    button.disabled =
                        true;

                    button.dataset.fullImage =
                        '';

                    if (image) {
                        image.classList.add(
                            'hidden'
                        );
                    }

                    if (placeholder) {
                        placeholder.classList.remove(
                            'hidden'
                        );

                        placeholder.textContent =
                            'Sem imagem extra';
                    }
                }
            }

            if (status) {
                if (
                    normalized.length >= 3
                ) {
                    status.textContent =
                        `${normalized.length} imagens encontradas. As 3 primeiras estão prontas para revisão.`;
                }
                else if (
                    normalized.length === 2
                ) {
                    status.textContent =
                        '2 imagens disponíveis para este produto.';
                }
                else {
                    status.textContent =
                        'Somente a imagem principal está disponível.';
                }
            }
        }


        function swapFacebookDraftImage(
            button
        ) {
            if (
                !button ||
                button.disabled
            ) {
                return;
            }

            const nextImage =
                String(
                    button.dataset.fullImage ||
                    ''
                ).trim();

            const mainImage =
                document.getElementById(
                    'facebookDraftMainImage'
                );

            const thumbImage =
                button.querySelector(
                    'img'
                );

            if (
                !nextImage ||
                !mainImage ||
                !thumbImage
            ) {
                return;
            }

            const currentMain =
                mainImage.src;

            const currentAlt =
                mainImage.alt;

            mainImage.src =
                nextImage;

            mainImage.alt =
                thumbImage.alt;

            thumbImage.src =
                currentMain;

            thumbImage.alt =
                currentAlt;

            button.dataset.fullImage =
                currentMain;
        }


        function formatFacebookDraftPrice(
            value
        ) {
            const number =
                Number(value);

            if (
                !Number.isFinite(number)
            ) {
                return '';
            }

            return number.toLocaleString(
                'pt-BR',
                {
                    style:
                        'currency',

                    currency:
                        'BRL'
                }
            );
        }


        async function prepareFacebookContentForProduct(
            marketplace,
            itemId
        ) {

            const params =
                new URLSearchParams({
                    channel: 'facebook',
                    marketplace:
                        String(
                            marketplace ||
                            'shopee'
                        ),
                    itemId:
                        String(
                            itemId ||
                            ''
                        )
                });

            window.location.href =
                '/admin/vitrine2/marketing/publisher?' +
                params.toString();

            return;

            try {
                const items =
                    await fetchCatalogProducts();

                const selectedItem =
                    items.find(
                        item =>
                            String(
                                item.product?.marketplace ||
                                'shopee'
                            ).toLowerCase() ===
                                String(
                                    marketplace || ''
                                ).toLowerCase() &&
                            String(
                                item.product?.itemId || ''
                            ) ===
                                String(
                                    itemId || ''
                                )
                    );

                if (!selectedItem) {
                    throw new Error(
                        'Produto não encontrado no canal Facebook.'
                    );
                }

                const product =
                    selectedItem.product || {};

                const facebookShopUrl =
                    'https://www.facebook.com/mixxdeproduto/shop/?ref_code=share_shop&ref_surface=share_shop';

                const shopeeStorefrontUrl =
                    'https://collshp.com/mix_de_produtos?view=storefront';

                const mainProductUrl =
                    productLink(
                        product
                    );

                const initialImages =
                    normalizeFacebookDraftImages(
                        product
                    );

                const priceLabel =
                    formatFacebookDraftPrice(
                        product.price
                    );

                const originalPrice =
                    Number(
                        product.originalPrice
                    );

                const currentPrice =
                    Number(
                        product.price
                    );

                const showOriginalPrice =
                    Number.isFinite(
                        originalPrice
                    ) &&
                    Number.isFinite(
                        currentPrice
                    ) &&
                    originalPrice >
                        currentPrice;

                let discount =
                    Number(
                        product.priceDiscountRate
                    );

                if (
                    Number.isFinite(discount) &&
                    discount > 0 &&
                    discount <= 1
                ) {
                    discount *= 100;
                }

                discount =
                    Number.isFinite(discount) &&
                    discount > 0
                        ? Math.round(
                            discount
                        )
                        : null;

                const rating =
                    Number(
                        product.ratingStar
                    );

                const sales =
                    Number(
                        product.sales
                    );

                const ratingLabel =
                    Number.isFinite(rating) &&
                    rating > 0
                        ? rating
                            .toFixed(1)
                            .replace(
                                '.',
                                ','
                            )
                        : '';

                const salesLabel =
                    Number.isFinite(sales) &&
                    sales > 0
                        ? `${sales} vendidos`
                        : '';

                const draftLines = [
                    '✨ Confira este achado!',
                    '',
                    product.title ||
                        'Produto selecionado',
                    '',
                    priceLabel
                        ? `💰 ${priceLabel}`
                        : '',
