        </header>


        <section
            class="
                max-w-7xl
                mx-auto
                px-4
                sm:px-6
                py-6
            "
        >




            <section class="bg-white rounded-2xl border border-slate-200 p-3 mb-4">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3">
                    <div>
                        <h2 class="font-extrabold text-sm">Produtos do Facebook</h2>
                        <p class="text-xs text-slate-500 mt-1">
                            Somente produtos marcados para Facebook na Visão Geral.
                        </p>
                    </div>

                    <div class="flex flex-wrap items-center gap-1.5">
                        <div
                            title="Todos os produtos selecionados para Facebook"
                            class="rounded-lg border border-sky-300 bg-sky-50 px-2.5 py-2 text-sky-700 text-xs font-extrabold"
                        >
                            Todos <span id="facebookCounter" class="ml-1">0</span>
                        </div>

                        <div
                            title="Será ativado quando o Policy Engine do Facebook estiver implementado"
                            class="rounded-lg border border-slate-200 bg-white px-2.5 py-2 text-emerald-700 text-xs font-extrabold"
                        >
                            <i class="fa-solid fa-circle-check"></i>
                            <span class="ml-1">—</span>
                        </div>

                        <div
                            title="Será ativado quando o Policy Engine do Facebook estiver implementado"
                            class="rounded-lg border border-slate-200 bg-white px-2.5 py-2 text-amber-700 text-xs font-extrabold"
                        >
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <span class="ml-1">—</span>
                        </div>

                        <div
                            title="Será ativado quando o Policy Engine do Facebook estiver implementado"
                            class="rounded-lg border border-slate-200 bg-white px-2.5 py-2 text-red-700 text-xs font-extrabold"
                        >
                            <i class="fa-solid fa-ban"></i>
                            <span class="ml-1">—</span>
                        </div>

                        <div
                            title="Será ativado quando o Policy Engine do Facebook estiver implementado"
                            class="rounded-lg border border-slate-200 bg-white px-2.5 py-2 text-sky-700 text-xs font-extrabold"
                        >
                            <i class="fa-solid fa-rotate"></i>
                            <span class="ml-1">—</span>
                        </div>

                        <div
                            title="Será ativado quando o Policy Engine do Facebook estiver implementado"
                            class="rounded-lg border border-slate-200 bg-white px-2.5 py-2 text-slate-500 text-xs font-extrabold"
                        >
                            <i class="fa-solid fa-circle-question"></i>
                            <span class="ml-1">—</span>
                        </div>
                    </div>
                </div>
            </section>


            <section
                class="
                    bg-white
                    rounded-2xl
                    border
                    border-slate-200
                    overflow-hidden
                "
            >
                <div
                    id="facebookProducts"
                    class="
                        grid
                        grid-cols-1
                        md:grid-cols-2
                        xl:grid-cols-3
                        gap-3
                        p-4
                    "
                >
                    <div
                        class="
                            bg-slate-50
                            border
                            border-slate-200
                            rounded-2xl
                            p-8
                            text-center
                            text-slate-500
                            md:col-span-2
                            xl:col-span-3
                        "
                    >
                        Carregando produtos...
                    </div>
                </div>
            </section>

        </section>

    </main>


    <script>
        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }


        function formatPrice(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return new Intl.NumberFormat(
                'pt-BR',
                {
                    style: 'currency',
                    currency: 'BRL'
                }
            ).format(number);
        }


        function formatCommission(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return `${(number * 100)
                .toFixed(1)
                .replace('.0', '')}%`;
        }


        function formatSales(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return new Intl.NumberFormat(
                'pt-BR'
            ).format(number);
        }


        function formatRating(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return `${number
                .toFixed(1)
                .replace('.', ',')} ★`;
        }


        function productLink(product) {
            return (
                product?.metadata?.productLink ||
                product?.affiliateLink ||
                '#'
            );
        }


        async function fetchCatalogProducts() {
            const response =
                await fetch(
                    '/api/vitrine2/marketing/channel/facebook'
                );

            const data =
                await response.json();

            if (
                !response.ok ||
                !data.success
            ) {
                throw new Error(
                    data.error ||
                    'Falha ao carregar produtos do Facebook.'
                );
            }

            return (
                Array.isArray(
                    data.products
                )
                    ? data.products
                    : []
            )
                .map(
                    entry => ({
                        entry,
                        product:
                            entry.product || {}
                    })
                );
        }

        function renderChannelProducts(items) {
            const container =
                document.getElementById(
                    'facebookProducts'
                );

            document
                .getElementById(
                    'facebookCounter'
                )
                .textContent =
                    items.length;


            if (items.length === 0) {
                container.innerHTML =
                    `
                        <div
                            class="
                                bg-slate-50
                                border
                                border-slate-200
                                rounded-2xl
                                p-8
                                text-center
                                text-slate-500
                                md:col-span-2
                                xl:col-span-3
                            "
                        >
                            Nenhum produto selecionado para Facebook.
                        </div>
                    `;

                return;
            }

            container.innerHTML =
                items
                    .map(
                        ({ product }) => `
                            <article
                                class="
                                    bg-white
                                    border
                                    border-slate-200
                                    rounded-2xl
                                    p-4
                                "
                            >
                                <div class="flex gap-3">

                                    <img
                                        src="${escapeHtml(product.image)}"
                                        alt=""
                                        class="
                                            w-16
                                            h-16
                                            rounded-xl
                                            object-cover
                                            bg-slate-100
                                            shrink-0
                                        "
                                    >

                                    <div class="min-w-0">
                                        <a
                                            href="${escapeHtml(productLink(product))}"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="
                                                font-bold
                                                text-sm
                                                text-slate-900
                                                line-clamp-2
                                                hover:text-sky-700
                                                hover:underline
                                            "
                                        >
                                            ${escapeHtml(product.title)}
                                        </a>

                                        <div
                                            class="
                                                mt-2
                                                grid
                                                grid-cols-2
                                                gap-x-3
                                                gap-y-2
                                                text-sm
                                            "
                                        >
                                            <div>
                                                <span class="text-slate-500 text-sm">
                                                    Comissão
                                                </span>

                                                <div class="text-slate-800 text-base font-medium">
                                                    ${formatCommission(product.commissionRate)}
                                                </div>
                                            </div>

                                            <div>
                                                <span class="text-slate-500 text-sm">
                                                    Estimada
                                                </span>

                                                <div class="text-slate-800 text-base font-medium">
                                                    ${formatPrice(product.commission)}
                                                </div>
                                            </div>

                                            <div>
                                                <span class="text-slate-500 text-sm">
                                                    Vendas
                                                </span>

                                                <div class="text-slate-800 text-base font-medium">
                                                    ${formatSales(product.sales)}
                                                </div>
                                            </div>

                                            <div>
                                                <span class="text-slate-500 text-sm">
                                                    Avaliação
                                                </span>

                                                <div class="text-amber-600 text-base font-medium">
                                                    ${formatRating(product.ratingStar)}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                
                                <button
                                    type="button"
                                    onclick="prepareFacebookContentForProduct(
                                        '${escapeHtml(product.marketplace || 'shopee')}',
                                        '${escapeHtml(product.itemId || '')}'
                                    )"
                                    class="
                                        mt-4
                                        w-full
                                        inline-flex
                                        items-center
                                        justify-center
                                        gap-2
                                        rounded-xl
                                        bg-blue-50
                                        hover:bg-blue-100
                                        text-blue-700
                                        px-3
                                        py-2.5
                                        text-xs
                                        font-bold
                                        transition
                                    "
                                >
                                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                                    Preparar conteúdo
                                </button>

                            </article>
                        `
                    )
                    .join('');
        }


        function closeFacebookContentDraft() {
            const modal =
                document.getElementById(
                    'facebookContentDraftModal'
                );

            if (modal) {
                modal.remove();
            }
        }


        async function prepareFacebookContentForProduct(
            marketplace,
            itemId
        ) {
            try {
                const items =
                    await fetchCatalogProducts();

                const selectedItem =
                    items.find(
                        item =>
                            String(
                                item.product?.marketplace ||
                                'shopee'
                            ).toLowerCase() ===
                                String(
                                    marketplace || ''
                                ).toLowerCase() &&
                            String(
                                item.product?.itemId || ''
                            ) ===
                                String(
                                    itemId || ''
                                )
                    );

                if (!selectedItem) {
                    throw new Error(
                        'Produto não encontrado no canal Facebook.'
                    );
                }

                const product =
                    selectedItem.product || {};

                const modal =
                    document.createElement(
                        'div'
                    );

                modal.id =
                    'facebookContentDraftModal';

                modal.className =
                    'fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4';

                modal.innerHTML = `
                    <div class="bg-white w-full max-w-xl rounded-2xl shadow-xl overflow-hidden">
                        <div class="px-4 py-3 border-b border-slate-200 flex items-center justify-between gap-3">
                            <div>
                                <div class="text-xs uppercase tracking-wide font-bold text-blue-700">
                                    Facebook
                                </div>
                                <h2 class="mt-1 text-lg font-extrabold">
                                    Preparar conteúdo
                                </h2>
                            </div>

                            <button
                                type="button"
                                onclick="closeFacebookContentDraft()"
                                class="w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600"
                                aria-label="Fechar"
                            >
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>

                        <div class="p-4 max-h-[70vh] overflow-y-auto">
                            <div class="flex gap-4 items-start">
                                <img
                                    src="${escapeHtml(product.image || '')}"
                                    alt=""
                                    class="w-20 h-20 rounded-2xl object-cover bg-slate-100 shrink-0"
                                >

                                <div class="min-w-0">
                                    <div class="text-xs font-bold uppercase tracking-wide text-slate-400">
                                        Produto
                                    </div>
                                    <div class="mt-1 font-extrabold text-slate-900">
                                        ${escapeHtml(product.title || 'Produto selecionado')}
                                    </div>
                                </div>
                            </div>

                            <div class="mt-4 grid grid-cols-3 gap-2">
                                <div class="rounded-xl border border-slate-200 p-2.5">
                                    <div class="font-bold text-sm">Feed</div>
                                    <div class="text-xs text-slate-500 mt-1">Imagem/carrossel.</div>
                                </div>

                                <div class="rounded-xl border border-slate-200 p-2.5">
                                    <div class="font-bold text-sm">Reels</div>
                                    <div class="text-xs text-slate-500 mt-1">Vídeo vertical.</div>
                                </div>

                                <div class="rounded-xl border border-slate-200 p-2.5">
                                    <div class="font-bold text-sm">Campanha</div>
                                    <div class="text-xs text-slate-500 mt-1">Anúncio.</div>
                                </div>
                            </div>

                            <div class="mt-5">
                                <label class="block text-sm font-bold text-slate-700 mb-2">
                                    Rascunho inicial
                                </label>

                                <textarea
                                    rows="6"
                                    class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm resize-y"
                                >✨ Confira este achado!

${escapeHtml(product.title || 'Produto selecionado')}

Veja os detalhes, preço atual e disponibilidade na nossa vitrine.

👉 Acesse pelo link da bio.</textarea>
                            </div>

                            <div class="mt-3 rounded-xl bg-amber-50 border border-amber-100 px-4 py-3 text-sm text-amber-800">
                                Publicação automática ainda não ativa. Fluxo: preparar → revisar → aprovar → agendar/publicar.
                            </div>
                        </div>

                        <div class="px-4 py-3 border-t border-slate-200 flex flex-wrap justify-end gap-2">
                            <button
                                type="button"
                                onclick="closeFacebookContentDraft()"
                                class="rounded-xl bg-slate-100 hover:bg-slate-200 px-4 py-2.5 text-sm font-bold"
                            >
                                Fechar
                            </button>

                            <button
                                type="button"
                                onclick="window.alert('Rascunho aprovado. Salvar/agendar/publicar será implementado na próxima etapa do Facebook.')"
                                class="rounded-xl bg-blue-600 hover:bg-blue-700 text-white px-4 py-2.5 text-sm font-bold"
                            >
                                Aprovar rascunho
                            </button>
                        </div>
                    </div>
                `;

                document.body.appendChild(
                    modal
                );
            }
            catch (error) {
                console.error(
                    '[FACEBOOK] Erro ao preparar conteúdo:',
                    error
                );

                window.alert(
                    error.message ||
                    'Não foi possível preparar o conteúdo.'
                );
            }
        }


        async function loadChannelProducts() {
            try {
                const items =
                    await fetchCatalogProducts();

                renderChannelProducts(
                    items
                );
            }
            catch (error) {
                document
                    .getElementById(
                        'facebookProducts'
                    )
                    .innerHTML =
                        `
                            <div
                                class="
                                    bg-white
                                    border
                                    border-red-200
                                    rounded-2xl
                                    p-8
                                    text-center
                                    text-red-600
                                    md:col-span-2
                                    xl:col-span-3
                                "
                            >
                                ${escapeHtml(error.message)}
                            </div>
                        `;
            }
        }


        loadChannelProducts();

    </script>

</body>
</html>
