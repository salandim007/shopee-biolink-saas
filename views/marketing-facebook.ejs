                        Instagram
                    </a>

                    <a
                        href="/admin/vitrine2/marketing/facebook"
                        class="
                            inline-flex
                            items-center
                            gap-2
                            rounded-xl
                            px-4
                            py-2.5
                            text-sm
                            font-bold
