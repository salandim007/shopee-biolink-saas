                            border-slate-200
                        "
                    >
                        <i class="fa-solid fa-chart-line"></i>
                        Visão Geral
                    </a>

                    <a
                        href="/admin/vitrine2/marketing/instagram"
                        class="
                            inline-flex
                            items-center
                            gap-2
