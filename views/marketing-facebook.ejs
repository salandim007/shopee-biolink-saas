                            justify-center
                            gap-2
                            px-4
                            py-2.5
                            rounded-xl
                            bg-slate-100
                            hover:bg-slate-200
                            font-bold
                            text-sm
                            transition
                        "
                    >
                        <i class="fa-solid fa-arrow-up-right-from-square"></i>
                        Abrir Vitrine
