window.centralGalleryCache =
  window.centralGalleryCache || {};

async function carregarGaleriaShopee(itemId, shopId){
  if(!itemId || !shopId){
    return {
      images: [],
      videos: []
    };
  }

  const cacheKey =
    `${String(shopId)}:${String(itemId)}`;

  const cached =
    window.centralGalleryCache[
      cacheKey
    ];

  if(
    cached &&
    Array.isArray(cached.images) &&
    cached.images.length > 0
  ){
    console.log(
      '[central-shopee-gallery] cache',
      cacheKey,
      cached.images.length
    );

    return cached;
  }

  try{
    const response = await fetch(
      '/admin/vitrine2/marketing/media/gallery',
      {
        method: 'POST',
        headers: {
          'Content-Type':
            'application/json'
        },
        body: JSON.stringify({
          itemId:
            String(itemId),
          shopId:
            String(shopId)
        })
      }
    );

    const payload =
      await response.json();

    if(
      !response.ok ||
      !payload.success
    ){
      throw new Error(
        payload?.error?.message ||
        'Falha ao carregar galeria.'
      );
    }

    const result = {
      images:
        Array.isArray(payload.images)
          ? payload.images
          : [],

      videos:
        Array.isArray(payload.videos)
          ? payload.videos
          : []
    };

    if(result.images.length > 0){
      window.centralGalleryCache[
        cacheKey
      ] = result;
    }

    console.log(
      '[central-shopee-gallery] capturado',
      cacheKey,
      result.images.length
    );

    return result;

  }catch(error){
    console.warn(
      '[central-shopee-gallery]',
      error
    );

    return {
      images: [],
      videos: []
    };
  }
}


function aplicarGaleriaProduto(
  produto,
  galeria
){
  produto =
    produto || {};

  galeria =
    galeria || {};

  const images = [
    ...(Array.isArray(
      produto.media?.images
    )
      ? produto.media.images
      : []),

    ...(Array.isArray(
      produto.images
    )
      ? produto.images
      : []),

    ...(Array.isArray(
      galeria.images
    )
      ? galeria.images
      : []),

    produto.image,
    produto.media?.image
  ]
  .filter(Boolean)
  .filter(
    (url, index, array) =>
      array.indexOf(url) === index
  );

  const videos = [
    ...(Array.isArray(
      produto.media?.videos
    )
      ? produto.media.videos
      : []),

    ...(Array.isArray(
      galeria.videos
    )
      ? galeria.videos
      : [])
  ]
  .filter(Boolean)
  .filter(
    (url, index, array) =>
      array.indexOf(url) === index
  );

  produto.images =
    images;

  produto.media = {
    ...(produto.media || {}),
    images,
    videos,
    imageCount:
      images.length,
    videoCount:
      videos.length
  };

  return produto;
}


async function abrirProduto(itemId, shopId){
  const painel = document.getElementById('produtoPainel');
  const conteudo = document.getElementById('painelConteudo');

  painel.classList.add('aberto');
  conteudo.innerHTML = 'Carregando dados completos...';

  try{
    const q = new URLSearchParams();

    if(shopId){
      q.set('shopId', shopId);
    }

    const r = await fetch(
      `/api/products-media/${encodeURIComponent(itemId)}?${q}`
    );

    const data = await r.json();

    if(!r.ok || !data.success){
      throw new Error(
        data.error || 'Erro ao carregar produto'
      );
    }

    const galeria =
      await carregarGaleriaShopee(
        itemId,
        shopId
      );

    const produto =
      aplicarGaleriaProduto(
        data.product,
        galeria
      );

    mostrarDetalhes(produto);

  }catch(err){
    conteudo.textContent = err.message;
  }
}


function nomeCanalTap(channel){
  const value =
    String(channel || 'facebook')
      .trim()
      .toLowerCase();

  const nomes = {
    facebook: 'Facebook',
    instagram: 'Instagram',
    pinterest: 'Pinterest',
    whatsapp: 'WhatsApp',
    tiktok: 'TikTok',
    kwai: 'Kwai'
  };

  return nomes[value] || value;
}


async function abrirTapToPost(
  itemId,
  shopId,
  channel = 'facebook'
){
  const canal =
    String(channel || 'facebook')
      .trim()
      .toLowerCase();

  const canalLabel =
    nomeCanalTap(canal);
  const painel =
    document.getElementById('produtoPainel');

  const conteudo =
    document.getElementById('painelConteudo');

  const topo =
    document.querySelector(
      '#produtoPainel .painel-topo strong'
    );

  painel.classList.add('aberto');

  if(topo){
    topo.textContent = 'Pronto para postar';
  }

  conteudo.innerHTML =
    'Carregando conteúdo preparado...';

  try{
    const q =
      new URLSearchParams();

    if(shopId){
      q.set('shopId', shopId);
    }

    const [produtoResp, filaResp] =
      await Promise.all([
        fetch(
          `/api/products-media/${
            encodeURIComponent(itemId)
          }?${q}`
        ),

        fetch(
          `/api/ai/content-queue?itemId=${
            encodeURIComponent(itemId)
          }&channel=${
            encodeURIComponent(canal)
          }`
        )
      ]);

    const produtoData =
      await produtoResp.json();

    const filaData =
      await filaResp.json();

    if(
      !produtoResp.ok ||
      !produtoData.success
    ){
      throw new Error(
        produtoData.error ||
        'Erro ao carregar produto.'
      );
    }

    if(
      !filaResp.ok ||
      !filaData.success
    ){
      throw new Error(
        filaData.error ||
        'Erro ao carregar conteúdo.'
      );
    }

    const produtoBase =
      produtoData.product || {};

    const resolvedShopId =
      String(
        shopId ||
        produtoBase.shopId ||
        ''
      ).trim();

    const galeria =
      await carregarGaleriaShopee(
        itemId,
        resolvedShopId
      );

    const produto =
      aplicarGaleriaProduto(
        produtoBase,
        galeria
      );

    const items =
      Array.isArray(filaData.items)
        ? filaData.items
        : [];

    const pronto =
      items
        .slice()
        .reverse()
        .find(
          item =>
            item.status === 'APPROVED' ||
            item.status === 'PUBLISHED'
        ) ||
      null;

    if(!pronto){
      throw new Error(
        'Aprove o conteúdo antes de continuar para ' +
        canalLabel +
        '.'
      );
    }

    const final =
      pronto?.content?.content ||
      pronto?.content ||
      {};

    const linkShopee =
      produto.links?.short ||
      produto.links?.affiliate ||
      produto.links?.product ||
      '';

    const tituloProduto =
      produto.title ||
      final.headline ||
      'Produto';

    const tituloCurto =
      tituloProduto
        .split(/\s+/)
        .slice(0, 5)
        .join(' ');

      const textoOriginal =
        String(
          final.body ||
          tituloProduto ||
          ''
        ).trim();

      const hashtagsDoTexto =
        textoOriginal.match(
          /#[\p{L}\p{N}_]+/gu
        ) || [];

      const hashtagsDaIa =
        Array.isArray(final.hashtags)
          ? final.hashtags
          : [];

      const hashtagsLista = [
        '#MixDeProdutos',
        ...hashtagsDaIa,
        ...hashtagsDoTexto
      ]
        .flatMap(value => {
          const raw =
            String(value || '').trim();

          if(!raw){
            return [];
          }

          const encontradas =
            raw.match(
              /#[\p{L}\p{N}_]+/gu
            );

          if(encontradas?.length){
            return encontradas;
          }

          return [
            raw.startsWith('#')
              ? raw
              : `#${raw}`
          ];
        })
        .filter(Boolean)
        .filter(
          (tag, index, array) =>
            array.findIndex(
              other =>
                other.toLowerCase() ===
                tag.toLowerCase()
            ) === index
        )
        .slice(0, 5);

      const hashtags =
        hashtagsLista.join(' ');

      /*
       * Limpa conteúdo antigo para evitar
       * link, CTA e hashtags duplicados.
       */
      const textoPreparado =
        textoOriginal
          .replace(
            /https?:\/\/(?:[a-z0-9-]+\.)?shopee\.com\.br\/\S+/gi,
            ''
          )
          .replace(
            /#[\p{L}\p{N}_]+/gu,
            ''
          )
          .split('\n')
          .filter(line => {
            const value =
              String(line || '').trim();

            if(!value){
              return true;
            }

            return !(
              /Confira na Shopee/i.test(value) ||
              /Acesse o produto na Shopee/i.test(value) ||
              /Quer comprar ou ver mais detalhes\?/i.test(value) ||
              /COMPRAR AQUI/i.test(value)
            );
          })
          .join('\n')
          .replace(/\n{3,}/g, '\n\n')
          .trim();

      const partesLegenda = [
        textoPreparado
      ];

      if(linkShopee){
        partesLegenda.push(
          '',
          '🛒 Confira na Shopee 👇',
          linkShopee
        );
      }

      if(hashtags){
        partesLegenda.push(
          '',
          hashtags
        );
      }

      let legenda =
        partesLegenda
          .join('\n')
          .trim();


    /*
     * ========================================================
     * ADAPTADOR DE LEGENDA - INSTAGRAM
     * ========================================================
     * Mantém o conteúdo criado pela IA.
     * Remove CTA/link direto da Shopee.
     * Usa chamada própria para Link na BIO.
     * Facebook e demais canais permanecem intactos.
