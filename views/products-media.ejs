<style>
.card{
  background:white;
  border-radius:14px;
  overflow:hidden;
  box-shadow:0 4px 12px rgba(0,0,0,.06);
  cursor:pointer;
}
.card img{
  width:100%;
  aspect-ratio:1/1;
  object-fit:cover;
  background:#eee;
}
.card-body{
  padding:12px;
}
.card-title{
  font-size:14px;
  font-weight:bold;
  line-height:1.4;
  height:40px;
  overflow:hidden;
}
.price{
  color:#ee4d2d;
  font-size:19px;
  font-weight:bold;
  margin-top:10px;
}
.old{
  color:#999;
  text-decoration:line-through;
  font-size:12px;
}
.meta{
  display:flex;
  justify-content:space-between;
  gap:8px;
  margin-top:8px;
  color:#687582;
  font-size:12px;
}
.badge{
  position:absolute;
  top:8px;
  left:8px;
  background:#ee4d2d;
  color:white;
  padding:5px 7px;
  border-radius:7px;
  font-size:12px;
  font-weight:bold;
}
.imgbox{
  position:relative;
}
</style>

<script>
const grid = document.getElementById('grid');
const statusEl = document.getElementById('status');
const totalEl = document.getElementById('total');

let offset = 0;
let buscaAtual = '';
let totalProdutos = 0;

function moeda(v){
  if(v === null || v === undefined) return '—';

  return Number(v).toLocaleString(
    'pt-BR',
    {
      style:'currency',
      currency:'BRL'
    }
  );
}

function esc(v){
  return String(v ?? '')
    .replaceAll('&','&amp;')
    .replaceAll('<','&lt;')
    .replaceAll('>','&gt;')
    .replaceAll('"','&quot;');
}

function criarCard(p){
  const desconto =
    Number(p.offer?.discountPercentage || 0);

  const preco =
    p.offer?.currentPrice;

  const antigo =
    p.offer?.price;

  return `
    <article
      class="card"
      data-item="${esc(p.itemId)}"
      data-shop="${esc(p.shopId)}"
    >
      <div class="imgbox">
        <img src="${esc(p.image || '')}" alt="">

        ${
          desconto > 0
            ? `<span class="badge">-${desconto}%</span>`
            : ''
        }
      </div>

      <div class="card-body">
        <div class="card-title">
          ${esc(p.title)}
        </div>

        <div class="price">
          ${moeda(preco)}
        </div>

        ${
          Number(antigo) > Number(preco)
            ? `<div class="old">${moeda(antigo)}</div>`
            : ''
        }

        <div class="meta">
          <span>⭐ ${p.ratings?.product ?? '—'}</span>
          <span>Loja ⭐ ${p.ratings?.shop ?? '—'}</span>
        </div>
      </div>
    </article>
  `;
}

async function carregarProdutos(){
  statusEl.textContent = 'Carregando produtos...';
  grid.innerHTML = '';

  const params =
    new URLSearchParams({
      limit:24,
      offset
    });

  if(buscaAtual){
    params.set('search', buscaAtual);
  }

  try{
    const r =
      await fetch(
        '/api/products-media?' +
        params.toString()
      );

    const data =
      await r.json();

    if(!r.ok || !data.success){
      throw new Error(
        data.error ||
        'Erro ao carregar produtos'
      );
    }

    totalProdutos = Number(data.total || 0);

    totalEl.textContent =
      totalProdutos
        .toLocaleString('pt-BR') +
      ' produtos';

    const paginaAtual =
      Math.floor(offset / 24) + 1;

    const totalPaginas =
      Math.max(
        1,
        Math.ceil(totalProdutos / 24)
      );

    const info =
      document.getElementById('paginaInfo');

    if(info){
      info.textContent =
        `Página ${paginaAtual} de ${totalPaginas.toLocaleString('pt-BR')}`;
    }

    const anterior =
      document.getElementById('anterior');

    const proxima =
      document.getElementById('proxima');

    if(anterior){
      anterior.disabled = offset === 0;
    }

    if(proxima){
      proxima.disabled =
        offset + 24 >= totalProdutos;
    }

    statusEl.textContent = '';

    if(!data.products.length){
      statusEl.textContent =
        'Nenhum produto encontrado.';
      return;
    }

    grid.innerHTML =
      data.products
        .map(criarCard)
        .join('');

  }catch(err){
    statusEl.textContent =
      err.message;
  }
}

document
  .getElementById('formBusca')
  .addEventListener(
    'submit',
    e => {
      e.preventDefault();

      buscaAtual =
        document
          .getElementById('busca')
          .value
          .trim();

      offset = 0;

      
carregarProdutos();
    }
  );


function mostrarDetalhes(p){
  const c = p.commercial || {};
  const m = p.market?.exact || {};
  const pub = p.publications || {};

  document.getElementById('painelConteudo').innerHTML = `
    <div class="report-header">
      <div class="report-kicker">Produto</div>

      <h2 class="report-title">
        ${esc(p.title)}
      </h2>

      <div class="report-sub">
        ${esc(p.shop?.name || 'Loja não informada')}
      </div>

      <div class="report-price">
        ${moeda(p.offer?.currentPrice)}
      </div>
    </div>

    <section class="report-section">
      <h3 class="report-section-title">
        Resumo comercial
      </h3>

      <div class="report-grid">
        <div class="info-card">
          <span class="info-label">Vendas</span>
          <span class="info-value">${c.sales ?? '—'}</span>
        </div>

        <div class="info-card">
          <span class="info-label">Comissão</span>
          <span class="info-value">${c.commissionPercent ?? '—'}%</span>
        </div>

        <div class="info-card">
          <span class="info-label">Ganho estimado</span>
          <span class="info-value">${moeda(c.estimatedCommission)}</span>
        </div>

        <div class="info-card">
          <span class="info-label">Avaliação do produto</span>
          <span class="info-value">${c.rating ?? p.ratings?.product ?? '—'}</span>
        </div>
      </div>
    </section>

    <section class="report-section">
      <h3 class="report-section-title">
        Loja e mercado
      </h3>

      <div class="report-grid">
        <div class="info-card">
          <span class="info-label">Loja</span>
          <span class="info-value soft">${esc(p.shop?.name || '—')}</span>
        </div>

        <div class="info-card">
          <span class="info-label">Avaliação da loja</span>
          <span class="info-value">${p.shop?.rating ?? '—'}</span>
        </div>

        <div class="info-card">
          <span class="info-label">Ofertas exatas</span>
          <span class="info-value">${m.offerCount ?? '—'}</span>
        </div>

        <div class="info-card">
          <span class="info-label">Lojas exatas</span>
          <span class="info-value">${m.storeCount ?? '—'}</span>
        </div>
      </div>
    </section>

    <section class="report-section">
      <h3 class="report-section-title">
        Mídias e histórico
      </h3>

      <div class="report-grid">
        <div class="info-card">
          <span class="info-label">Fotos</span>
          <span class="info-value">${p.media?.imageCount ?? 0}</span>
        </div>

        <div class="info-card">
          <span class="info-label">Vídeos</span>
          <span class="info-value">${p.media?.videoCount ?? 0}</span>
        </div>

        <div class="info-card">
          <span class="info-label">Publicações</span>
          <span class="info-value">${pub.total ?? 0}</span>
        </div>
      </div>
    </section>
  `;
}

async function abrirProduto(itemId, shopId){
  const painel = document.getElementById('produtoPainel');
  const conteudo = document.getElementById('painelConteudo');

  painel.classList.add('aberto');
  conteudo.innerHTML = 'Carregando dados completos...';

  try{
    const q = new URLSearchParams();

    if(shopId){
      q.set('shopId', shopId);
    }

    const r = await fetch(
      `/api/products-media/${encodeURIComponent(itemId)}?${q}`
    );

    const data = await r.json();

    if(!r.ok || !data.success){
      throw new Error(
        data.error || 'Erro ao carregar produto'
      );
    }

    mostrarDetalhes(data.product);

  }catch(err){
    conteudo.textContent = err.message;
  }
}


async function abrirTapToPost(itemId, shopId){
  const painel =
    document.getElementById('produtoPainel');

  const conteudo =
    document.getElementById('painelConteudo');

  const topo =
    document.querySelector(
      '#produtoPainel .painel-topo strong'
    );

  painel.classList.add('aberto');

  if(topo){
    topo.textContent = 'Pronto para postar';
  }

  conteudo.innerHTML =
    'Carregando conteúdo preparado...';

  try{
    const q =
      new URLSearchParams();

    if(shopId){
      q.set('shopId', shopId);
    }

    const [produtoResp, filaResp] =
      await Promise.all([
        fetch(
          `/api/products-media/${
            encodeURIComponent(itemId)
          }?${q}`
        ),

        fetch(
          `/api/ai/content-queue?itemId=${
            encodeURIComponent(itemId)
          }&channel=facebook`
        )
      ]);

    const produtoData =
      await produtoResp.json();

    const filaData =
      await filaResp.json();

    if(
      !produtoResp.ok ||
      !produtoData.success
    ){
      throw new Error(
        produtoData.error ||
        'Erro ao carregar produto.'
      );
    }

    if(
      !filaResp.ok ||
      !filaData.success
    ){
      throw new Error(
        filaData.error ||
        'Erro ao carregar conteúdo.'
      );
    }

    const produto =
      produtoData.product || {};

    const items =
      Array.isArray(filaData.items)
        ? filaData.items
        : [];

    const pronto =
      items
        .slice()
        .reverse()
        .find(
          item =>
            item.status ===
              'APPROVED'
        ) ||
      null;

