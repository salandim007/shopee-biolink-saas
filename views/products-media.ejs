document.addEventListener('click', async e => {
  if(
    e.target.id !== 'compartilharGruposTap'
  ){
    return;
  }

  const button =
    e.target;

  const share =
    window.tapChannelShare ||
    window.tapFacebookShare;

  const media =
    window.tapToPostState;

  if(
    !share ||
    !share.linkShopee ||
    !share.legenda
  ){
    alert(
      'Legenda ou link da Shopee não encontrado.'
    );
    return;
  }


  /*
   * ==========================================================
   * DESKTOP / NOTEBOOK
   * ==========================================================
   *
   * No Windows, navigator.share abre o painel nativo
   * do sistema e normalmente o Facebook não aparece.
   *
   * Por isso:
   * 1. copia a publicação;
   * 2. abre os Grupos do Facebook no navegador.
   * ==========================================================
   */

  const isMobile =
    /Android|iPhone|iPad|iPod|Mobile/i
      .test(navigator.userAgent) ||
    (
      /Macintosh/i.test(
        navigator.userAgent
      ) &&
      navigator.maxTouchPoints > 1
    );


  if(!isMobile){

    /*
     * ========================================================
     * NOTEBOOK / DESKTOP
     * ========================================================
     *
     * 1. Publica diretamente na Página Mix de Produtos.
     * 2. Usa a foto escolhida na Central.
     * 3. Usa a legenda completa preparada.
     * 4. Abre o post publicado no Facebook.
     * 5. O usuário pode compartilhar esse post nos grupos.
     * ========================================================
     */

    if(
      !media ||
      !media.coverUrl
    ){
      alert(
        'Escolha uma foto de capa.'
      );
      return;
    }

    const originalText =
      button.textContent;

    button.disabled =
      true;

    button.textContent =
      'Publicando...';


    /*
     * Abre uma aba durante o clique do usuário.
     * Depois apontamos essa aba para o post criado.
     * Isso evita bloqueio de popup após o await.
     */
    const facebookTab =
      window.open(
        'about:blank',
        '_blank'
      );

    try{

      const response =
        await fetch(
          '/admin/vitrine2/marketing/meta/publish',
          {
            method:
              'POST',

            headers:{
              'Content-Type':
                'application/json'
            },

            body:
              JSON.stringify({
                marketplace:
                  'shopee',

                itemId:
                  String(
                    share.itemId
                  ),

                channels:[
                  'facebook'
                ],

                format:
                  'photo',

                imageUrl:
                  media.coverUrl,

                caption:
                  share.legenda
              })
          }
        );


      const data =
        await response.json();


      if(
        !response.ok ||
        !data.success
      ){
        throw new Error(
          data?.channels
            ?.facebook
            ?.error
            ?.message ||
          data?.error
            ?.message ||
          'Não foi possível publicar no Facebook.'
        );
      }


      const facebookResult =
        data?.channels
          ?.facebook ||
        {};


      if(
        facebookResult.success ===
          false
      ){
        throw new Error(
          facebookResult
            ?.error
            ?.message ||
          'Não foi possível publicar no Facebook.'
        );
      }


      /*
       * Atualiza a fila da IA da mesma forma
       * que o botão Facebook normal.
       */
      let statusLocalOk =
        true;

      if(
        share.queueItemId
      ){
        try{

          const statusResponse =
            await fetch(
              `/api/ai/content/${
                encodeURIComponent(
                  share.queueItemId
                )
              }/published`,
              {
                method:
                  'POST',

                headers:{
                  'Content-Type':
                    'application/json'
                },

                body:
                  JSON.stringify({
                    channel:
                      'facebook'
                  })
              }
            );


          const statusData =
            await statusResponse
              .json();


          if(
            !statusResponse.ok ||
            !statusData.success
          ){
            throw new Error(
              statusData.error ||
              'Falha ao registrar publicação.'
            );
          }


          await carregarIa();


        }catch(statusError){

          statusLocalOk =
            false;

          console.error(
            '[groups-desktop-published-status]',
            statusError
          );
        }
      }


      /*
       * Monta o endereço do post recém-publicado.
       *
       * Normalmente postId:
       * PAGE_ID_POST_ID
       */
      const postId =
        String(
          facebookResult.postId ||
          ''
        ).trim();

      const photoId =
        String(
          facebookResult.photoId ||
          ''
        ).trim();


      let facebookUrl =
        'https://www.facebook.com/';


      if(
        postId &&
        postId.includes('_')
      ){

        const parts =
          postId.split('_');

        const pageId =
          parts[0];

        const storyId =
          parts
            .slice(1)
            .join('_');

        facebookUrl =
          'https://www.facebook.com/permalink.php' +
          '?story_fbid=' +
          encodeURIComponent(
            storyId
          ) +
          '&id=' +
          encodeURIComponent(
            pageId
          );

      }else if(postId){

        facebookUrl =
          'https://www.facebook.com/' +
          encodeURIComponent(
            postId
          );

      }else if(photoId){

        facebookUrl =
          'https://www.facebook.com/photo/?fbid=' +
          encodeURIComponent(
            photoId
          );
      }


      button.textContent =
        statusLocalOk
          ? 'Publicado ✓'
          : 'Publicado ✓';


      if(facebookTab){

        facebookTab.location.href =
          facebookUrl;

      }else{

        alert(
          'Publicado com sucesso. ' +
          'O navegador bloqueou a abertura do Facebook.'
        );
      }


      setTimeout(
        () => {
          button.disabled =
            false;

          button.textContent =
            originalText;
        },
        2000
      );


    }catch(error){

      if(
        facebookTab &&
        !facebookTab.closed
      ){
        facebookTab.close();
      }

      button.disabled =
        false;

      button.textContent =
        originalText;

      console.error(
        '[groups-desktop-publish]',
        error
      );

      alert(
        error.message
      );
    }

    return;
  }


  /*
   * ==========================================================
   * CELULAR / TABLET
   * ==========================================================
   *
   * Mantém o compartilhamento nativo.
   * ==========================================================
   */

  if(!navigator.share){
    alert(
      'Este navegador não suporta o compartilhamento nativo.'
    );
    return;
  }

  const originalText =
    button.textContent;

  button.disabled = true;

  button.textContent =
    'Preparando compartilhamento...';

  try{

    const shareData = {
      title:
        'Oferta Shopee',

      text:
        share.legenda,

      url:
        share.linkShopee
    };


    /*
     * Tenta anexar a foto escolhida.
     */
    if(
      media &&
      media.coverUrl &&
      navigator.canShare
    ){
      try{

        const imageResponse =
          await fetch(
            media.coverUrl,
            {
              mode:'cors'
            }
          );

        if(imageResponse.ok){

          const blob =
            await imageResponse.blob();

          const mime =
            blob.type ||
            'image/jpeg';

          const extension =
            mime.includes('png')
              ? 'png'
              : 'jpg';

          const file =
            new File(
              [blob],
              `produto-${share.itemId}.${extension}`,
              {
                type:mime
              }
            );

          if(
            navigator.canShare({
              files:[file]
            })
          ){
            shareData.files =
              [file];
          }
        }

      }catch(imageError){

        console.log(
          '[groups-share] Foto não anexada. ' +
          'Continuando com texto e link.',
          imageError
        );
      }
    }


    /*
     * Também deixa a legenda no clipboard.
     */
    try{

      if(
        navigator.clipboard &&
        navigator.clipboard.writeText
      ){
        await navigator.clipboard
          .writeText(
            share.legenda
          );
      }

    }catch(copyError){

      console.log(
        '[groups-share] Legenda não copiada automaticamente.',
        copyError
      );
    }


    button.textContent =
      'Abrindo compartilhamento...';

    await navigator.share(
      shareData
    );

    button.textContent =
      'Compartilhado ✓';


    setTimeout(
      () => {
        button.disabled =
          false;

        button.textContent =
          originalText;
      },
      1800
    );


  }catch(error){

    button.disabled =
      false;

    button.textContent =
      originalText;

    if(
      error &&
      error.name === 'AbortError'
    ){
      return;
    }

    console.error(
      '[groups-share]',
      error
    );

    alert(
      'Não foi possível abrir o compartilhamento.'
    );
  }
});


