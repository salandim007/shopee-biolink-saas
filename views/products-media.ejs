      return;
    }

    const item =
      (window.aiQueueItems || [])
        .find(
          value =>
            value.id ===
            button.dataset.aiView
        );

    if(!item){
      alert(
        'Conteúdo não encontrado na fila.'
      );
      return;
    }

    mostrarConteudoIa(item);
  }
);


document.addEventListener(
  'click',
  async e => {

    const approveFacebook =
      e.target.closest(
        '[data-ai-approve-facebook]'
      );

    const continueFacebook =
      e.target.closest(
        '[data-ai-continue-facebook]'
      );

    if(
      !approveFacebook &&
      !continueFacebook
    ){
      return;
    }

    const button =
      approveFacebook ||
      continueFacebook;

    const itemId =
      button.dataset.itemId;

    const queueId =
      approveFacebook
        ? approveFacebook.dataset.aiApproveFacebook
        : continueFacebook.dataset.aiContinueFacebook;

    const originalText =
      button.textContent;

    button.disabled = true;

    try{

      if(approveFacebook){

        button.textContent =
          'Aprovando...';

        const response =
          await fetch(
            `/api/ai/content/${
              encodeURIComponent(queueId)
            }/approve`,
            {
              method:'POST'
            }
          );

        const data =
          await response.json();

        if(
          !response.ok ||
          !data.success
        ){
          throw new Error(
            data.error ||
            'Não foi possível aprovar o conteúdo.'
          );
        }

        await carregarIa();
      }

      button.textContent =
        'Abrindo Facebook...';

      await abrirTapToPost(
        itemId,
        null
      );

    }catch(error){

      button.disabled = false;

      button.textContent =
        originalText;

      alert(
        error.message
      );
    }
  }
);


