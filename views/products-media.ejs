        <div class="ai-section-sub">
          Decisões comerciais preparadas pela inteligência do sistema
        </div>
      </div>
    </div>

    <div id="iaProdutos" class="ai-products">
      <div class="ai-empty">
        Carregando avaliações...
      </div>
