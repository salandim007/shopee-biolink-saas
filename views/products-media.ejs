<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Central de Produtos e Mídias</title>

<style>
body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#f4f6f8;
  color:#17202a;
}
main{
  max-width:1400px;
  margin:auto;
  padding:20px;
}
header{
  display:flex;
  justify-content:space-between;
  gap:15px;
  align-items:center;
}
h1{margin-bottom:5px}
small{color:#687582}
.toolbar{
  background:white;
  padding:14px;
  border-radius:14px;
  margin:20px 0;
}
.tabs{
  display:flex;
  gap:10px;
  margin-bottom:12px;
}
button{
  padding:10px 14px;
  border:0;
  border-radius:9px;
  cursor:pointer;
}
.active{
  background:#fff0ec;
  color:#ee4d2d;
  font-weight:bold;
}
.search{
  display:flex;
  gap:8px;
}
.search input{
  flex:1;
  padding:11px;
  border:1px solid #ddd;
  border-radius:9px;
}
#grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:14px;
}
@media(max-width:800px){
  #grid{grid-template-columns:repeat(2,1fr)}
}

.report-header{
  background:#ffffff;
  border:1px solid #edf1f4;
  border-radius:16px;
  padding:16px;
  margin-bottom:18px;
}
.report-kicker{
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:.08em;
  color:#7b8794;
  margin-bottom:8px;
}
.report-title{
  margin:0;
  font-size:18px;
  line-height:1.35;
  color:#18212b;
}
.report-sub{
  margin-top:6px;
  color:#6b7785;
  font-size:13px;
}
.report-price{
  margin-top:14px;
  color:#ee4d2d;
  font-size:28px;
  font-weight:700;
}
.report-section{
  margin-top:18px;
}
.report-section-title{
  margin:0 0 10px;
  font-size:13px;
  color:#6b7785;
  text-transform:uppercase;
  letter-spacing:.05em;
}
.report-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:10px;
}
.info-card{
  background:#fff;
  border:1px solid #edf1f4;
  border-radius:14px;
  padding:12px 13px;
}
.info-label{
  display:block;
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:.05em;
  color:#7b8794;
  margin-bottom:6px;
}
.info-value{
  display:block;
  font-size:15px;
  font-weight:600;
  color:#18212b;
}
.info-value.soft{
  font-weight:500;
}
@media(max-width:700px){
  .report-grid{
    grid-template-columns:1fr;
  }
}

</style>

<style>
#produtoPainel{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.45);
  display:none;
  justify-content:flex-end;
  z-index:1000;
}
#produtoPainel.aberto{display:flex}
.painel-box{
  width:min(600px,100%);
  height:100%;
  background:white;
  overflow:auto;
  box-shadow:-15px 0 40px rgba(0,0,0,.18);
}
.painel-topo{
  position:sticky;
  top:0;
  background:white;
  padding:16px;
  border-bottom:1px solid #eee;
  display:flex;
  justify-content:space-between;
  align-items:center;
}
.painel-conteudo{padding:18px}
#fecharPainel{
  font-size:22px;
  background:#f1f3f5;
}
</style>


<style id="ai-central-style">
:root{
  --central-blue:#2563eb;
  --central-blue-soft:#eff6ff;
  --central-green:#16a34a;
  --central-green-soft:#f0fdf4;
  --central-border:#e7edf3;
  --central-muted:#6b7785;
}

.tabs button{
  background:#f6f8fa;
  color:#66727f;
  transition:.18s ease;
}

.tabs button.active{
  background:var(--central-blue-soft);
  color:var(--central-blue);
  font-weight:700;
}

.search button{
  background:var(--central-blue);
  color:#fff;
  font-weight:600;
}

.ai-view{
  display:none;
}

.ai-view.ativo{
  display:block;
}

.ai-summary{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:12px;
  margin:0 0 18px;
}

.ai-summary-card{
  background:#fff;
  border:1px solid var(--central-border);
  border-radius:15px;
  padding:16px;
  box-shadow:0 4px 12px rgba(23,32,42,.04);
}

.ai-summary-card.blue{
  border-top:3px solid var(--central-blue);
}

.ai-summary-card.green{
  border-top:3px solid var(--central-green);
}

.ai-summary-label{
  display:block;
  color:var(--central-muted);
  font-size:12px;
  margin-bottom:7px;
}

.ai-summary-value{
  display:block;
  font-size:25px;
  font-weight:700;
  color:#17202a;
}

.ai-section{
  background:#fff;
  border:1px solid var(--central-border);
  border-radius:16px;
  padding:16px;
  margin-top:14px;
}

.ai-section-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  margin-bottom:14px;
}

.ai-section-title{
  margin:0;
  font-size:17px;
  color:#18212b;
}

.ai-section-sub{
  margin-top:4px;
  color:var(--central-muted);
  font-size:12px;
}

.ai-products{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:12px;
}

.ai-card{
  border:1px solid var(--central-border);
  border-radius:14px;
  padding:14px;
  background:#fff;
  box-shadow:0 3px 10px rgba(23,32,42,.035);
}

.ai-card-top{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:10px;
}

.ai-item{
  font-size:11px;
  color:#7b8794;
}

.ai-decision{
  display:inline-flex;
  align-items:center;
  padding:5px 8px;
  border-radius:999px;
  font-size:11px;
  font-weight:700;
}

.ai-decision.promote{
  color:#15803d;
  background:var(--central-green-soft);
}

.ai-decision.review{
  color:#1d4ed8;
  background:var(--central-blue-soft);
}

.ai-reason{
  margin:12px 0;
  min-height:38px;
  color:#354250;
  font-size:13px;
  line-height:1.45;
}

.ai-meta{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:7px;
  margin-top:10px;
}

.ai-meta-box{
  background:#f7f9fb;
  border-radius:9px;
  padding:8px;
}

.ai-meta-label{
  display:block;
  color:#85909b;
  font-size:10px;
  margin-bottom:4px;
}

.ai-meta-value{
  display:block;
  color:#26313d;
  font-size:12px;
  font-weight:600;
  overflow:hidden;
  text-overflow:ellipsis;
}

.ai-actions{
  display:flex;
  gap:8px;
  margin-top:12px;
}

.ai-btn-primary{
  flex:1;
  background:var(--central-green);
  color:#fff;
  font-weight:700;
}

.ai-btn-secondary{
  background:var(--central-blue-soft);
  color:var(--central-blue);
  font-weight:600;
}

.ai-empty{
  padding:28px 12px;
  text-align:center;
  color:#7b8794;
  font-size:13px;
}

@media(max-width:900px){
  .ai-summary{
    grid-template-columns:repeat(2,1fr);
  }

  .ai-products{
    grid-template-columns:repeat(2,1fr);
  }
}

@media(max-width:600px){
  .ai-products{
    grid-template-columns:1fr;
  }
}
</style>


<style id="ai-card-alignment">
.ai-products{
  align-items:stretch;
}

.ai-card{
  display:flex;
  flex-direction:column;
  height:100%;
  box-sizing:border-box;
}

.ai-channel-area{
  margin-top:auto;
  padding-top:14px !important;
}
</style>


<style id="ai-channel-menu-style">

.ai-channel-menu{
  border:1px solid #dce5ec;
  border-radius:10px;
  background:#f8fafc;
  overflow:hidden;
}

.ai-channel-menu summary{
  list-style:none;
  cursor:pointer;
  padding:10px 12px;
  font-size:12px;
  font-weight:700;
  color:#2563eb;
  user-select:none;
}

.ai-channel-menu summary::-webkit-details-marker{
  display:none;
}

.ai-channel-menu summary::after{
  content:"▾";
  float:right;
  color:#6b7785;
}

.ai-channel-menu[open] summary::after{
  content:"▴";
}

.ai-channel-options{
  border-top:1px solid #e6edf3;
  background:#fff;
  padding:8px;
}

.ai-channel-option{
  display:flex;
  align-items:center;
  gap:9px;
  padding:9px 8px;
  border-radius:8px;
  cursor:pointer;
  font-size:12px;
  color:#354250;
}

.ai-channel-option:hover{
  background:#f4f7fa;
}

.ai-channel-option input{
  accent-color:#16a34a;
}

.ai-channel-option strong{
  color:#15803d;
  font-size:11px;
}

</style>

</head>

<body>
<main>

<header>
  <div>
    <h1>Central de Produtos e Mídias</h1>
    <small>Catálogo e inteligência comercial</small>
  </div>

  <strong id="total">Carregando...</strong>
</header>

<section class="toolbar">

  <div class="tabs">
    <button id="tabTodos" class="active">
      Todos os Produtos
    </button>

    <button id="tabIa">
      Avaliados pela IA
    </button>
  </div>

  <form id="formBusca" class="search">
    <input
      id="busca"
      placeholder="Buscar produto, item ou loja..."
    >
    <button>Buscar</button>
  </form>

</section>

<div id="status">
  Carregando produtos...
</div>


<div id="grid"></div>

<section id="iaView" class="ai-view">

  <div class="ai-summary">

    <div class="ai-summary-card blue">
      <span class="ai-summary-label">Analisados pela IA</span>
      <strong id="iaTotal" class="ai-summary-value">—</strong>
    </div>

    <div class="ai-summary-card green">
      <span class="ai-summary-label">Alta oportunidade</span>
      <strong id="iaPromover" class="ai-summary-value">—</strong>
    </div>

    <div class="ai-summary-card blue">
      <span class="ai-summary-label">Em revisão</span>
      <strong id="iaRevisao" class="ai-summary-value">—</strong>
    </div>

    <div class="ai-summary-card green">
      <span class="ai-summary-label">Conteúdos prontos</span>
      <strong id="iaConteudos" class="ai-summary-value">—</strong>
    </div>

  </div>

  <section class="ai-section">

    <div class="ai-section-head">
      <div>
