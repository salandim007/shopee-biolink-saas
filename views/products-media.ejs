document.addEventListener('click', async e => {
  if(e.target.id !== 'abrirFacebookTap'){
    return;
  }

  const button = e.target;

  const share =
    window.tapFacebookShare;

  const media =
    window.tapToPostState;

  if(
    !share ||
    !share.itemId ||
    !share.legenda
  ){
    alert(
      'Dados da publicação não encontrados.'
    );
    return;
  }

  if(
    !media ||
    !media.coverUrl
  ){
    alert(
      'Escolha uma foto de capa.'
    );
    return;
  }

  const originalText =
    button.textContent;

  button.disabled = true;
  button.textContent =
    'Publicando...';

  try{
    const response =
      await fetch(
        '/admin/vitrine2/marketing/meta/publish',
        {
          method:'POST',

          headers:{
            'Content-Type':
              'application/json'
          },

          body:JSON.stringify({
            marketplace:
              'shopee',

            itemId:
              String(share.itemId),

            channels:[
              'facebook'
            ],

            format:
              'photo',

            imageUrl:
              media.coverUrl,

            caption:
              share.legenda
          })
        }
      );

    const data =
      await response.json();

    if(
      !response.ok ||
      !data.success
    ){
      throw new Error(
        data?.channels?.facebook?.error?.message ||
        data?.error?.message ||
        'Não foi possível publicar no Facebook.'
      );
    }

    let statusLocalOk =
      true;

    if(share.queueItemId){
      try{
        const statusResponse =
          await fetch(
            `/api/ai/content/${
              encodeURIComponent(
                share.queueItemId
              )
            }/published`,
            {
              method:'POST',

              headers:{
                'Content-Type':
                  'application/json'
              },

              body:JSON.stringify({
                channel:
                  'facebook'
              })
            }
          );

        const statusData =
          await statusResponse.json();

        if(
          !statusResponse.ok ||
          !statusData.success
        ){
          throw new Error(
            statusData.error ||
            'Falha ao registrar publicação.'
          );
        }

        await carregarIa();

      }catch(statusError){
        statusLocalOk =
          false;

        console.error(
          '[ai-published-status]',
          statusError
        );
      }
    }

    button.textContent =
      statusLocalOk
        ? 'Publicado no Facebook ✓'
        : 'Publicado ✓ · status pendente';

    alert(
      statusLocalOk
        ? 'Publicação enviada para a Página do Facebook.'
        : 'A publicação foi enviada ao Facebook, mas o status local não pôde ser atualizado.'
    );

  }catch(error){
    button.disabled = false;
    button.textContent =
      originalText;

    alert(
      error.message
    );
  }
});


document.addEventListener('click', async e => {
  if(e.target.id !== 'copiarTapLegenda'){
    return;
  }

  const elemento =
    document.getElementById(
      'tapLegenda'
    );

  if(!elemento){
    return;
  }

  try{
    await navigator.clipboard.writeText(
      elemento.innerText
    );

    const botao = e.target;

    botao.textContent =
      'Legenda copiada ✓';

    setTimeout(() => {
      botao.textContent =
        'Copiar legenda';
    }, 1800);

  }catch(error){
    alert(
      'Não foi possível copiar a legenda.'
    );
  }
});


