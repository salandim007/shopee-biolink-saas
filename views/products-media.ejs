<script id="ai-data-loader">

async function carregarIa(){
  const produtosEl =
    document.getElementById('iaProdutos');

  const filaEl =
    document.getElementById('iaFila');

  produtosEl.innerHTML =
    '<div class="ai-empty">Carregando avaliações...</div>';

  filaEl.innerHTML =
    '<div class="ai-empty">Carregando conteúdos...</div>';

  try{
    const [rResumo, rAnalises, rFila] =
      await Promise.all([
        fetch('/api/ai/summary'),
        fetch('/api/ai/analyses?limit=100&offset=0'),
        fetch('/api/ai/content-queue')
      ]);

    const resumo =
      await rResumo.json();

    const analises =
      await rAnalises.json();

    const fila =
      await rFila.json();

    if(!rResumo.ok || !resumo.success){
      throw new Error(
        resumo.error || 'Erro no resumo da IA.'
      );
    }

    if(!rAnalises.ok || !analises.success){
      throw new Error(
        analises.error || 'Erro nas análises.'
      );
    }

    if(!rFila.ok || !fila.success){
      throw new Error(
        fila.error || 'Erro na fila de conteúdos.'
      );
    }

    document.getElementById('iaTotal').textContent =
      resumo.analysis?.total ?? 0;

    document.getElementById('iaPromover').textContent =
      resumo.score?.high ?? 0;

    document.getElementById('iaRevisao').textContent =
      resumo.analysis?.needsReview ?? 0;

    document.getElementById('iaConteudos').textContent =
      resumo.queue?.readyForApproval ?? 0;

    produtosEl.innerHTML =
      analises.items.length
        ? analises.items.map(criarCardIa).join('')
        : '<div class="ai-empty">Nenhum produto avaliado ainda.</div>';

    window.aiQueueItems =
      fila.items || [];

    filaEl.innerHTML =
      fila.items.length
        ? fila.items.map(criarCardFila).join('')
        : '<div class="ai-empty">Nenhum conteúdo preparado ainda.</div>';

  }catch(err){
    produtosEl.innerHTML =
      `<div class="ai-empty">${esc(err.message)}</div>`;
  }
}

document.getElementById('tabIa')
  .addEventListener('click', carregarIa);

</script>


<script id="ai-prepare-handler">

function esperar(ms){
  return new Promise(
    resolve => setTimeout(resolve, ms)
  );
}


async function acompanharJob(
  jobId,
  painelConteudo
){
  const inicio =
    Date.now();

  const LIMITE_TOTAL =
    180000;

  const LIMITE_FILA =
    30000;

  while(
    Date.now() - inicio <
    LIMITE_TOTAL
  ){
    const response =
      await fetch(
        `/api/ai/jobs/${
          encodeURIComponent(jobId)
        }`
      );

    const data =
      await response.json();

    if(!response.ok || !data.success){
      throw new Error(
        data.error ||
        'Erro ao acompanhar a geração.'
      );
    }

    const job =
      data.job;

    if(job.status === 'DONE'){
      if(!data.queueItem){
        throw new Error(
          'Conteúdo concluído, mas não encontrado na fila.'
        );
      }

      await carregarIa();

      mostrarConteudoIa(
        data.queueItem
      );

      return;
    }

    if(job.status === 'FAILED'){
      throw new Error(
        job.error ||
        'A geração do conteúdo falhou.'
      );
    }

    if(
      job.status === 'QUEUED' &&
      Date.now() - inicio >
        LIMITE_FILA
    ){
      throw new Error(
        'O processamento não foi iniciado em 30 segundos. A tarefa foi interrompida para evitar espera indefinida.'
      );
    }

    painelConteudo.innerHTML = `
      <div class="report-header"
        style="border-top:4px solid #2563eb">

        <div class="report-kicker">
          Inteligência de conteúdo
        </div>

        <h2 class="report-title">
          ${
            job.status === 'QUEUED'
              ? 'Iniciando processamento...'
              : job.status === 'PROCESSING'
                ? 'Criando seu conteúdo...'
                : 'Finalizando...'
          }
        </h2>

        <div class="report-sub">
          ${esc(job.progress || '')}
        </div>

        <div style="
          margin-top:18px;
          padding:14px;
          border-radius:12px;
          background:#eff6ff;
          color:#1d4ed8;
          line-height:1.5;
        ">
          Canal:
          <strong>
            ${esc(job.channel || '—')}
          </strong>
          <br><br>
          O sistema está processando
          somente este produto.
        </div>

      </div>
    `;

    await esperar(3000);
  }

  throw new Error(
    'O processamento excedeu 3 minutos e foi encerrado na tela. Verifique o estado da tarefa antes de tentar novamente.'
  );
}


document.addEventListener(
  'change',
  e => {
    const checkbox =
      e.target.closest(
        '[data-ai-channel-choice]'
      );

    if(!checkbox){
      return;
    }

    const card =
      checkbox.closest('.ai-card');

    const prepare =
      card.querySelector(
        '[data-ai-prepare]'
      );

    const selected =
      card.querySelectorAll(
        '[data-ai-channel-choice]:checked'
      );

    prepare.disabled =
      selected.length === 0;
  }
);


document.addEventListener(
  'click',
  async e => {

    const button =
      e.target.closest(
        '[data-ai-prepare]'
      );

    if(!button){
      return;
    }

    const card =
      button.closest('.ai-card');

    const selected =
      [
        ...card.querySelectorAll(
          '[data-ai-channel-choice]:checked'
        )
      ];

    if(!selected.length){
      alert(
        'Escolha pelo menos um canal.'
      );
      return;
    }

    const channels =
      selected.map(
        item =>
          item.dataset.aiChannelChoice
      );

    const painel =
      document.getElementById(
        'produtoPainel'
      );

    const conteudo =
      document.getElementById(
        'painelConteudo'
      );

    const topo =
      document.querySelector(
        '#produtoPainel .painel-topo strong'
      );

    if(topo){
      topo.textContent =
        'Preparando conteúdo';
    }

    painel.classList.add('aberto');

    button.disabled = true;

    try{
      for(const channel of channels){
        conteudo.innerHTML = `
          <div class="report-header"
            style="border-top:4px solid #2563eb">

            <div class="report-kicker">
              Inteligência de conteúdo
            </div>

            <h2 class="report-title">
              Enviando para preparação...
            </h2>

            <div class="report-sub">
              Canal:
              <strong>
                ${esc(channel)}
              </strong>
            </div>

          </div>
        `;

        const params =
          new URLSearchParams();

        params.set(
          'channel',
          channel
        );

        const response =
          await fetch(
            `/api/ai/prepare/${
              encodeURIComponent(
                button.dataset.aiPrepare
              )
            }?${params.toString()}`,
            {
              method:'POST'
            }
          );

        const data =
          await response.json();

        if(!response.ok || !data.success){
          throw new Error(
            data.error ||
            'Não foi possível preparar o conteúdo.'
          );
        }

        /*
         * Conteúdo já preparado:
         * abre imediatamente.
         */
        if(data.queueItem){
          await carregarIa();

          mostrarConteudoIa(
            data.queueItem
          );

          continue;
        }

        /*
         * Sem conteúdo pronto:
         * o backend iniciou ou retomou
         * somente o job deste produto.
         */
        if(!data.job?.id){
          throw new Error(
            'O servidor não retornou conteúdo nem tarefa de processamento.'
          );
        }

        await acompanharJob(
          data.job.id,
          conteudo
        );
      }

    }catch(error){
      conteudo.innerHTML = `
        <div class="report-header"
          style="border-top:4px solid #dc2626">

          <div class="report-kicker">
            Falha no processamento
          </div>

          <h2 class="report-title">
            Não foi possível gerar o conteúdo.
          </h2>

          <div class="report-sub">
            ${esc(error.message)}
          </div>

        </div>
      `;

      button.disabled = false;
      button.textContent =
        'Preparar conteúdo';
    }
  }
);

</script>


<script id="ai-approval-handler">

document.addEventListener(
  'click',
  async e => {

    const approve =
      e.target.closest(
        '[data-ai-approve]'
      );

    const reject =
      e.target.closest(
        '[data-ai-reject]'
      );

    if(!approve && !reject){
      return;
    }

    const button =
      approve || reject;

    const id =
      approve
        ? approve.dataset.aiApprove
        : reject.dataset.aiReject;

    const action =
      approve
        ? 'approve'
        : 'reject';

    const originalText =
      button.textContent;

    button.disabled = true;

    button.textContent =
      approve
        ? 'Aprovando...'
        : 'Rejeitando...';

    try{
      const response =
        await fetch(
          `/api/ai/content/${
            encodeURIComponent(id)
          }/${action}`,
          {
            method:'POST'
          }
        );

      const data =
        await response.json();

      if(!response.ok || !data.success){
        throw new Error(
          data.error ||
          'Não foi possível atualizar o conteúdo.'
        );
      }

      await carregarIa();

    }catch(error){
      button.disabled = false;
      button.textContent =
        originalText;

      alert(error.message);
    }
  }
);

</script>


