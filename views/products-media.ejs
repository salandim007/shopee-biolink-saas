      approveChannel
        ? approveChannel.dataset.aiApproveChannel
        : continueChannel.dataset.aiContinueChannel;

    const originalText =
      button.textContent;

    button.disabled = true;

    try{

      if(approveChannel){

        button.textContent =
          'Aprovando...';

        const response =
          await fetch(
            `/api/ai/content/${
              encodeURIComponent(queueId)
            }/approve`,
            {
              method:'POST'
            }
          );

        const data =
          await response.json();

        if(
          !response.ok ||
          !data.success
        ){
          throw new Error(
            data.error ||
            'Não foi possível aprovar o conteúdo.'
          );
        }

        await carregarIa();
      }

      button.textContent =
        'Abrindo ' +
        nomeCanalTap(channel) +
        '...';

      await abrirTapToPost(
        itemId,
        null,
        channel
      );

    }catch(error){

      button.disabled = false;

      button.textContent =
        originalText;

      alert(
        error.message
      );
    }
  }
);


</script>

