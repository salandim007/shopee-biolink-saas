<style>
.card{
  background:white;
  border-radius:14px;
  overflow:hidden;
  box-shadow:0 4px 12px rgba(0,0,0,.06);
  cursor:pointer;
}
.card img{
  width:100%;
  aspect-ratio:1/1;
  object-fit:cover;
  background:#eee;
}
.card-body{
  padding:12px;
}
.card-title{
  font-size:14px;
  font-weight:bold;
  line-height:1.4;
  height:40px;
  overflow:hidden;
}
.price{
  color:#ee4d2d;
  font-size:19px;
  font-weight:bold;
  margin-top:10px;
}
.old{
  color:#999;
  text-decoration:line-through;
  font-size:12px;
}
.meta{
  display:flex;
  justify-content:space-between;
  gap:8px;
  margin-top:8px;
  color:#687582;
  font-size:12px;
}
.badge{
  position:absolute;
  top:8px;
  left:8px;
  background:#ee4d2d;
  color:white;
  padding:5px 7px;
  border-radius:7px;
  font-size:12px;
  font-weight:bold;
}
.imgbox{
  position:relative;
}

.product-filter-btn{
  border:1px solid #dce3ea;
  background:#fff;
  color:#334155;
  border-radius:999px;
  padding:8px 12px;
  font-size:12px;
  font-weight:800;
  cursor:pointer;
}

.product-filter-btn.active{
  background:#17202a;
  color:#fff;
  border-color:#17202a;
}

.product-state-badges{
  display:flex;
  gap:6px;
  flex-wrap:wrap;
  margin-top:8px;
}

.product-state-badge{
  display:inline-flex;
  align-items:center;
  padding:4px 7px;
  border-radius:999px;
  font-size:11px;
  font-weight:800;
}

.product-state-badge.ai{
  background:#ecfdf5;
  color:#15803d;
}

.product-state-badge.ready{
  background:#eff6ff;
  color:#1d4ed8;
}
</style>

<script>
const grid = document.getElementById('grid');
const statusEl = document.getElementById('status');
const totalEl = document.getElementById('total');

let offset = 0;
let buscaAtual = '';
let filtroProdutoAtual = '';
let totalProdutos = 0;

function moeda(v){
  if(v === null || v === undefined) return '—';

  return Number(v).toLocaleString(
    'pt-BR',
    {
      style:'currency',
      currency:'BRL'
    }
  );
}

function esc(v){
  return String(v ?? '')
    .replaceAll('&','&amp;')
    .replaceAll('<','&lt;')
    .replaceAll('>','&gt;')
    .replaceAll('"','&quot;');
}

function criarCard(p){
  const desconto =
    Number(p.offer?.discountPercentage || 0);

  const preco =
    p.offer?.currentPrice;

  const antigo =
    p.offer?.price;

  return `
    <article
      class="card"
      data-item="${esc(p.itemId)}"
      data-shop="${esc(p.shopId)}"
      data-ai="${p.aiProcessed ? 'true' : 'false'}"
      data-ready="${p.contentReady ? 'true' : 'false'}"
    >
      <div class="imgbox">
        <img src="${esc(p.image || '')}" alt="">

        ${
          desconto > 0
            ? `<span class="badge">-${desconto}%</span>`
            : ''
        }
      </div>

      <div class="card-body">
        <div class="card-title">
          ${esc(p.title)}
        </div>

        ${
          p.aiProcessed || p.contentReady
            ? `
                <div class="product-state-badges">
                  ${
                    p.aiProcessed
                      ? '<span class="product-state-badge ai">● IA</span>'
                      : ''
                  }

                  ${
                    p.contentReady
                      ? '<span class="product-state-badge ready">● Pronto</span>'
                      : ''
                  }
                </div>
              `
            : ''
        }

        <div class="price">
          ${moeda(preco)}
        </div>

        ${
          Number(antigo) > Number(preco)
            ? `<div class="old">${moeda(antigo)}</div>`
            : ''
        }

        <div class="meta">
          <span>⭐ ${p.ratings?.product ?? '—'}</span>
          <span>Loja ⭐ ${p.ratings?.shop ?? '—'}</span>
        </div>
        <button type="button"
          class="produce-media-btn"
          style="margin-top:12px;padding:10px;width:100%;
                 background:#087f8c;color:white;border:0;
                 border-radius:9px;cursor:pointer">
          🎬 Produzir mídia
        </button>
      </div>
    </article>
  `;
}


document.addEventListener('click', event => {
  const button = event.target.closest('.produce-media-btn');
  if (!button) return;

  const card = button.closest('[data-item]');
  if (!card) return;

  const itemId = card.dataset.item || '';
  const shopId = card.dataset.shop || '';

  if (!/^\d+$/.test(itemId)) {
    alert('Identificador do produto indisponível.');
    return;
  }

  const params = new URLSearchParams({ itemId });

  if (/^\d+$/.test(shopId)) {
    params.set('shopId', shopId);
  }

  window.location.href =
    '/admin/vitrine2/marketing/video-production?' +
    params.toString();
});


async function carregarProdutos(){
  statusEl.textContent = 'Carregando produtos...';
  grid.innerHTML = '';

  const params =
    new URLSearchParams({
      limit:24,
      offset
    });

  if(buscaAtual){
    params.set('search', buscaAtual);
  }

  if(filtroProdutoAtual){
    params.set(
      'filter',
      filtroProdutoAtual
    );
  }

  try{
    const r =
      await fetch(
        '/api/products-media?' +
        params.toString()
      );

    const data =
      await r.json();

    if(!r.ok || !data.success){
      throw new Error(
        data.error ||
        'Erro ao carregar produtos'
      );
    }

    totalProdutos = Number(data.total || 0);

    totalEl.textContent =
      totalProdutos
        .toLocaleString('pt-BR') +
      ' produtos';

    const paginaAtual =
      Math.floor(offset / 24) + 1;

    const totalPaginas =
      Math.max(
        1,
        Math.ceil(totalProdutos / 24)
      );

    const info =
      document.getElementById('paginaInfo');

    if(info){
        const primeiroProduto =
          totalProdutos > 0
            ? offset + 1
            : 0;

        const ultimoProduto =
          Math.min(
            offset + 24,
            totalProdutos
          );

        info.textContent =
          `${primeiroProduto.toLocaleString('pt-BR')}–${ultimoProduto.toLocaleString('pt-BR')} de ${totalProdutos.toLocaleString('pt-BR')} • Página ${paginaAtual.toLocaleString('pt-BR')} de ${totalPaginas.toLocaleString('pt-BR')}`;
      }

    const anterior =
      document.getElementById('anterior');

    const proxima =
      document.getElementById('proxima');

    if(anterior){
      anterior.disabled = offset === 0;
    }

    if(proxima){
      proxima.disabled =
        offset + 24 >= totalProdutos;
    }

    statusEl.textContent = '';

    if(!data.products.length){
      statusEl.textContent =
        'Nenhum produto encontrado.';
      return;
    }

    grid.innerHTML =
      data.products
        .map(criarCard)
        .join('');

  }catch(err){
    statusEl.textContent =
      err.message;
  }
}

document
  .getElementById('productStatusFilters')
  .addEventListener(
    'click',
    e => {

      const button =
        e.target.closest(
          '[data-product-filter]'
        );

      if(!button){
        return;
      }

      filtroProdutoAtual =
        button.dataset.productFilter || '';

      offset = 0;

      document
        .querySelectorAll(
          '.product-filter-btn'
        )
        .forEach(
          item =>
            item.classList.remove(
              'active'
            )
        );

      button.classList.add('active');

      carregarProdutos();
    }
  );


document
  .getElementById('formBusca')
  .addEventListener(
    'submit',
    e => {
      e.preventDefault();

      buscaAtual =
        document
          .getElementById('busca')
          .value
          .trim();

      offset = 0;

      
carregarProdutos();
    }
  );


function mostrarDetalhes(p){
  const c = p.commercial || {};
  const m = p.market?.exact || {};
  const pub = p.publications || {};

  document.getElementById('painelConteudo').innerHTML = `
    <div class="report-header">
      <div class="report-kicker">Produto</div>

      <h2 class="report-title">
        ${esc(p.title)}
      </h2>

      <div class="report-sub">
        ${esc(p.shop?.name || 'Loja não informada')}
      </div>

      <div class="report-price">
        ${moeda(p.offer?.currentPrice)}
      </div>
    </div>

    <section class="report-section">
      <h3 class="report-section-title">
        Resumo comercial
      </h3>

      <div class="report-grid">
        <div class="info-card">
          <span class="info-label">Vendas</span>
          <span class="info-value">${c.sales ?? '—'}</span>
        </div>

        <div class="info-card">
          <span class="info-label">Comissão</span>
          <span class="info-value">${c.commissionPercent ?? '—'}%</span>
        </div>

        <div class="info-card">
          <span class="info-label">Ganho estimado</span>
          <span class="info-value">${moeda(c.estimatedCommission)}</span>
        </div>

        <div class="info-card">
          <span class="info-label">Avaliação do produto</span>
          <span class="info-value">${c.rating ?? p.ratings?.product ?? '—'}</span>
        </div>
      </div>
    </section>

    <section class="report-section">
      <h3 class="report-section-title">
        Loja e mercado
      </h3>

      <div class="report-grid">
        <div class="info-card">
          <span class="info-label">Loja</span>
