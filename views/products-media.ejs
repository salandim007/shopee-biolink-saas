      iaOffset =
        Math.max(
          0,
          iaOffset - IA_PAGE_SIZE
        );

      carregarIa();
    }else{
      offset =
        Math.max(
          0,
          offset - 24
        );

      carregarProdutos();
    }

    window.scrollTo({
      top:0,
      behavior:'smooth'
    });
  }

  if(e.target.id === 'proxima'){
    if(iaAtiva){
      if(
        iaOffset + IA_PAGE_SIZE <
        iaTotal
      ){
        iaOffset += IA_PAGE_SIZE;
        carregarIa();
      }
    }else{
      if(offset + 24 < totalProdutos){
        offset += 24;
        carregarProdutos();
      }
    }

    window.scrollTo({
      top:0,
      behavior:'smooth'
    });
  }
});



