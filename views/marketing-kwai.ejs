    <script>
        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }


        function formatPrice(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return new Intl.NumberFormat(
                'pt-BR',
                {
                    style: 'currency',
                    currency: 'BRL'
                }
            ).format(number);
        }


        function formatCommission(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return `${(number * 100)
                .toFixed(1)
                .replace('.0', '')}%`;
        }


        function formatSales(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return new Intl.NumberFormat(
                'pt-BR'
            ).format(number);
        }


        function formatRating(value) {
            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return `${number
                .toFixed(1)
                .replace('.', ',')} ★`;
        }


        function productLink(product) {
            return (
                product?.metadata?.productLink ||
                product?.affiliateLink ||
                '#'
            );
        }


async function fetchCatalogProducts() {
    const response =
        await fetch(
            '/api/vitrine2/marketing/channel/kwai'
        );

    const data =
        await response.json();

    if (
        !response.ok ||
        !data.success
    ) {
        throw new Error(
            data.error ||
            'Falha ao carregar produtos do Kwai.'
        );
    }

    return (
        Array.isArray(
            data.products
        )
            ? data.products
            : []
    )
        .map(
            entry => ({
                entry,
                product:
                    entry.product || {}
            })
        );
}

        function renderChannelProducts(items) {
            const container =
                document.getElementById(
                    'kwaiProducts'
                );

            document
                .getElementById(
                    'kwaiCounter'
                )
                .textContent =
                    `${items.length} produtos`;

            if (items.length === 0) {
                container.innerHTML =
                    `
                        <div
                            class="
                                bg-slate-50
                                border
                                border-slate-200
                                rounded-2xl
                                p-8
                                text-center
                                text-slate-500
                                md:col-span-2
                                xl:col-span-3
                            "
                        >
                            Nenhum produto selecionado para Kwai.
                        </div>
                    `;

                return;
            }

            container.innerHTML =
                items
                    .map(
                        ({ product }) => `
                            <article
                                class="
                                    bg-white
                                    border
                                    border-slate-200
                                    rounded-2xl
                                    p-4
                                "
                            >
                                <div class="flex gap-3">

                                    <img
                                        src="${escapeHtml(product.image)}"
                                        alt=""
                                        class="
                                            w-16
                                            h-16
                                            rounded-xl
                                            object-cover
                                            bg-slate-100
                                            shrink-0
                                        "
                                    >

                                    <div class="min-w-0">
                                        <a
                                            href="${escapeHtml(productLink(product))}"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="
                                                font-bold
                                                text-sm
                                                text-slate-900
                                                line-clamp-2
                                                hover:text-sky-700
                                                hover:underline
                                            "
                                        >
                                            ${escapeHtml(product.title)}
                                        </a>

                                        <div
                                            class="
                                                mt-2
                                                grid
                                                grid-cols-2
                                                gap-x-3
                                                gap-y-2
                                                text-sm
                                            "
                                        >
                                            <div>
                                                <span class="text-slate-500 text-sm">
                                                    Comissão
                                                </span>

                                                <div class="text-slate-800 text-base font-medium">
                                                    ${formatCommission(product.commissionRate)}
                                                </div>
                                            </div>

                                            <div>
                                                <span class="text-slate-500 text-sm">
                                                    Estimada
                                                </span>

                                                <div class="text-slate-800 text-base font-medium">
                                                    ${formatPrice(product.commission)}
                                                </div>
                                            </div>

                                            <div>
                                                <span class="text-slate-500 text-sm">
                                                    Vendas
                                                </span>

                                                <div class="text-slate-800 text-base font-medium">
                                                    ${formatSales(product.sales)}
                                                </div>
                                            </div>

                                            <div>
                                                <span class="text-slate-500 text-sm">
                                                    Avaliação
                                                </span>

                                                <div class="text-amber-600 text-base font-medium">
                                                    ${formatRating(product.ratingStar)}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div
                                    class="
                                        mt-4
                                        rounded-xl
                                        border
                                        border-dashed
                                        border-slate-200
                                        bg-slate-50
                                        px-3
                                        py-2.5
                                        text-center
                                        text-xs
                                        font-bold
                                        text-slate-400
                                    "
                                >
                                    Ação de Kwai: próxima fase
                                </div>
                            </article>
                        `
                    )
                    .join('');
        }


        async function loadChannelProducts() {
            try {
                const items =
                    await fetchCatalogProducts();

                renderChannelProducts(
                    items
                );
            }
            catch (error) {
                document
                    .getElementById(
                        'kwaiProducts'
                    )
                    .innerHTML =
                        `
                            <div
                                class="
                                    bg-white
                                    border
                                    border-red-200
                                    rounded-2xl
                                    p-8
                                    text-center
                                    text-red-600
                                    md:col-span-2
                                    xl:col-span-3
                                "
                            >
                                ${escapeHtml(error.message)}
                            </div>
                        `;
            }
        }


        loadChannelProducts();

    </script>

