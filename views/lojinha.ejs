<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= usuario.nome %> - Achados da Shopee</title>
    <!-- Tailwind CSS para design ágil e responsivo -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome para ícones modernos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts - Inter para legibilidade moderna -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f5f5f5;
        }
        /* Ocultar barra de rolagem horizontal das categorias mantendo o scroll funcional */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="text-gray-800 antialiased selection:bg-orange-500 selection:text-white">

    <% var activeCategory = (typeof categorySelected !== 'undefined' && categorySelected) ? categorySelected : ''; %>

    <main class="max-w-md mx-auto bg-white min-h-screen shadow-lg flex flex-col pb-12">
        
        <!-- 1. TOPO DA LOJINHA: Estilo Banner com Perfil -->
        <header class="relative bg-gradient-to-b from-orange-500 to-orange-600 text-white pt-8 pb-6 px-4 rounded-b-[2rem] shadow-md">
            <!-- Efeito de fundo decorativo -->
            <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
            
            <div class="relative flex flex-col items-center text-center z-10">
                <!-- Avatar do Afiliado com borda branca e pulso de atividade -->
                <div class="relative">
                    <div class="w-20 h-20 bg-white rounded-full p-1 shadow-lg flex items-center justify-center overflow-hidden">
                        <span class="text-orange-500 font-extrabold text-3xl"><%= usuario.nome.charAt(0) %></span>
                    </div>
                    <span class="absolute bottom-1 right-1 w-4 h-4 bg-green-500 border-2 border-white rounded-full animate-ping"></span>
                    <span class="absolute bottom-1 right-1 w-4 h-4 bg-green-500 border-2 border-white rounded-full"></span>
                </div>
                
                <h1 class="font-bold text-xl mt-3 flex items-center gap-1.5">
                    <%= usuario.nome %> 
                    <i class="fa-solid fa-circle-check text-blue-400 text-base" title="Verificado"></i>
                </h1>
                <p class="text-orange-100 text-xs font-semibold mt-0.5">@<%= usuario.slug_loja %></p>
                
                <p class="text-sm text-orange-50 mt-2 max-w-xs leading-relaxed font-medium">
                    🔍 Minha curadoria com as melhores ofertas e achados da Shopee Brasil!
                </p>
                
                <!-- Badge de Afiliado Oficial -->
                <span class="mt-3 inline-flex items-center gap-1 bg-white/20 backdrop-blur-md px-3 py-1 rounded-full text-[10px] uppercase font-bold tracking-wider">
                    <i class="fa-solid fa-store"></i> Afiliado Oficial Shopee
                </span>
            </div>
        </header>

        <!-- 2. BARRA DE BUSCA -->
        <section class="px-4 -mt-4 relative z-20">
            <form action="/l/<%= usuario.slug_loja %>" method="GET" class="flex gap-2">
                <!-- Manter categoria se estiver selecionada -->
                <% if (activeCategory) { %>
                    <input type="hidden" name="category" value="<%= activeCategory %>">
                <% } %>
                <div class="relative flex-1 shadow-md rounded-xl overflow-hidden">
                    <input 
                        type="text" 
                        name="q" 
                        placeholder="Buscar achado ou palavra-chave..." 
                        value="<%= search %>"
                        class="w-full bg-white pl-10 pr-4 py-3 text-sm font-medium border border-gray-200 outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 transition-all rounded-xl"
                    >
                    <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <% if (search) { %>
                        <a href="/l/<%= usuario.slug_loja %><%= activeCategory ? '?category=' + activeCategory : '' %>" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                            <i class="fa-solid fa-circle-xmark"></i>
                        </a>
                    <% } %>
                </div>
                <button type="submit" class="bg-orange-500 hover:bg-orange-600 text-white font-bold px-4 rounded-xl shadow-md transition-all">
                    <i class="fa-solid fa-search"></i>
                </button>
            </form>
        </section>

        <!-- 3. CAROUSEL HORIZONTAL DE CATEGORIAS -->
        <section class="px-4 mt-6">
            <h2 class="text-xs uppercase font-extrabold tracking-wider text-gray-400 mb-3">Categorias</h2>
            <div class="flex gap-2 overflow-x-auto no-scrollbar pb-2">
                <!-- Botão "Todos" -->
                <a 
                    href="/l/<%= usuario.slug_loja %><%= search ? '?q=' + search : '' %>"
                    class="px-4 py-2 rounded-full text-xs font-bold whitespace-nowrap transition-all shadow-sm flex items-center gap-1.5
                    <%= !activeCategory ? 'bg-orange-500 text-white border-transparent' : 'bg-white text-gray-600 border border-gray-200 hover:border-orange-200' %>"
                >
                    <i class="fa-solid fa-border-all"></i> Todos
                </a>
                
                <% categorias.forEach(function(cat) { %>
                    <a 
                        href="/l/<%= usuario.slug_loja %>?category=<%= cat.slug %><%= search ? '&q=' + search : '' %>"
                        class="px-4 py-2 rounded-full text-xs font-bold whitespace-nowrap transition-all shadow-sm flex items-center gap-1.5
                        <%= activeCategory === cat.slug ? 'bg-orange-500 text-white border-transparent' : 'bg-white text-gray-600 border border-gray-200 hover:border-orange-200' %>"
                    >
                        <% if (cat.slug === 'casa-cozinha') { %>
                            <i class="fa-solid fa-couch"></i>
                        <% } else if (cat.slug === 'beleza-maquiagem') { %>
                            <i class="fa-solid fa-sparkles"></i>
                        <% } else if (cat.slug === 'eletronicos') { %>
                            <i class="fa-solid fa-laptop"></i>
                        <% } else { %>
                            <i class="fa-solid fa-star"></i>
                        <% } %>
                        <%= cat.nome %>
                    </a>
                <% }); %>
            </div>
        </section>

        <!-- 4. BANNER SAZONAL: ESQUENTA DATA DUPLA / CUPONS -->
        <section class="px-4 mt-4">
            <div class="bg-amber-50 border border-amber-200 rounded-2xl p-4 flex items-center gap-3.5 shadow-sm">
                <div class="w-12 h-12 rounded-xl bg-orange-100 text-orange-600 flex items-center justify-center text-xl shrink-0">
                    <i class="fa-solid fa-fire animate-bounce"></i>
                </div>
                <div class="flex-1">
                    <h3 class="font-bold text-xs text-orange-800 uppercase tracking-wider">Esquenta Datas Duplas 🚀</h3>
                    <p class="text-xs text-amber-900 leading-relaxed font-medium mt-0.5">
                        Cookies ativos por 7 dias. Resgate seus cupons de frete grátis e descontos exclusivos clicando em qualquer item!
                    </p>
                </div>
            </div>
        </section>

        <!-- 5. GRID DE PRODUTOS (ACHADOS) -->
        <section class="px-4 mt-6 flex-1">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-sm font-extrabold uppercase tracking-wider text-gray-400">
                    <%= search ? 'Resultados da Busca' : 'Ofertas do Dia' %>
                </h2>
                <span class="text-xs font-bold text-orange-500 bg-orange-50 px-2.5 py-1 rounded-full">
                    <%= produtos.length %> <%= produtos.length === 1 ? 'item' : 'itens' %> encontrado(s)
                </span>
            </div>

            <% if (produtos.length === 0) { %>
                <!-- Estado vazio (Nenhum produto cadastrado ou correspondente) -->
                <div class="text-center py-12 px-4 bg-gray-50 rounded-2xl border border-dashed border-gray-200">
                    <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto text-2xl text-gray-400 mb-3">
                        <i class="fa-solid fa-box-open"></i>
                    </div>
                    <h3 class="font-bold text-gray-700 text-base">Nenhum produto encontrado</h3>
                    <p class="text-xs text-gray-500 mt-1 max-w-xs mx-auto">
                        Tente pesquisar por outro nome ou selecione uma categoria diferente no filtro acima.
                    </p>
                </div>
            <% } else { %>
                <!-- Grid de Produtos estilo Shopee App -->
                <div class="grid grid-cols-2 gap-3.5">
                    <% produtos.forEach(function(produto) { %>
                        <article class="bg-white border border-gray-150 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 flex flex-col group">
                            
                            <!-- Imagem do Produto com Tag de Desconto -->
                            <div class="relative pt-[100%] bg-gray-50 overflow-hidden">
                                <img 
                                    src="<%= produto.imagem_url %>" 
                                    alt="<%= produto.titulo %>"
                                    class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                    loading="lazy"
                                >
                                <% if (produto.preco_original && produto.preco_original > produto.preco_oferta) { %>
                                    <% 
                                        const desconto = Math.round(((produto.preco_original - produto.preco_oferta) / produto.preco_original) * 100);
                                    %>
                                    <span class="absolute top-2 left-2 bg-red-500 text-white text-[9px] font-extrabold px-1.5 py-0.5 rounded-md shadow-sm">
                                        -<%= desconto %>% OFF
                                    </span>
                                <% } %>
                                <span class="absolute bottom-2 right-2 bg-black/50 backdrop-blur-sm text-white text-[9px] font-bold px-1.5 py-0.5 rounded-full flex items-center gap-0.5 shadow-sm">
                                    <i class="fa-solid fa-eye"></i> <%= produto.cliques %>
                                </span>
                            </div>

                            <!-- Conteúdo do Card -->
                            <div class="p-3 flex flex-col flex-1">
                                <!-- Título do Produto -->
                                <h3 class="text-xs font-semibold text-gray-800 line-clamp-2 leading-relaxed min-h-[2.5rem]">
                                    <%= produto.titulo %>
                                </h3>

                                <!-- Avaliação Simulada para Prova Social -->
                                <div class="flex items-center gap-1 mt-1.5 text-amber-500">
                                    <div class="text-[10px] flex">
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                    </div>
                                    <span class="text-[9px] text-gray-500 font-bold">4.9</span>
                                </div>

                                <!-- Preços -->
                                <div class="mt-2.5">
                                    <% 
                                        const pOrig = Number(produto.preco_original) || 0;
                                        const pOferta = Number(produto.preco_oferta) || 0;
                                    %>
                                    <% if (pOrig > pOferta && pOferta > 0) { %>
                                        <span class="text-[10px] text-gray-400 line-through font-medium block">
                                            R$ <%= pOrig.toFixed(2).replace('.', ',') %>
                                        </span>
                                    <% } %>
                                    <div class="flex items-baseline gap-0.5 text-orange-600 font-extrabold">
                                        <span class="text-[10px]">R$</span>
                                        <span class="text-lg leading-none"><%= Math.floor(pOferta) %></span>
                                        <span class="text-[11px]">,<%= pOferta.toFixed(2).split('.')[1] %></span>
                                    </div>
                                </div>

                                <!-- Botão de Compra Inteligente -->
                                <a 
                                    href="/click/<%= produto.id %>" 
                                    target="_blank"
                                    class="mt-3 bg-orange-500 hover:bg-orange-600 text-white text-[11px] font-extrabold py-2.5 px-3 rounded-xl shadow-sm text-center flex items-center justify-center gap-1.5 transition-all duration-300"
                                >
                                    <i class="fa-solid fa-shopping-bag"></i> Ver no App
                                </a>
                            </div>
                        </article>
                    <% }); %>
                </div>
            <% } %>
        </section>

        <!-- 6. RODAPÉ DE SEGURANÇA -->
        <footer class="mt-12 px-6 text-center text-[10px] text-gray-400 leading-relaxed max-w-xs mx-auto">
            <p class="font-semibold text-gray-500 flex items-center justify-center gap-1">
                <i class="fa-solid fa-shield-halved text-green-500"></i> Compra 100% Segura
            </p>
            <p class="mt-1">
                Você será redirecionado para o site ou aplicativo oficial da Shopee Brasil para concluir sua compra com total segurança.
            </p>
            <p class="mt-4 font-bold text-gray-300 tracking-wider uppercase">
                Powered by MiniApp SaaS
            </p>
        </footer>

    </main>

</body>
</html>
