<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="Vitrine de ofertas, achadinhos e produtos selecionados."
    >

    <title>Vitrine 2 | Ofertas e Achadinhos</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <!-- Google Fonts -->
    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <style>
        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            background:
                linear-gradient(
                    180deg,
                    #f7fcff 0,
                    #ffffff 220px
                );
            color: #172033;
        }

        .container-main {
            width: min(1380px, calc(100% - 32px));
            margin-inline: auto;
        }

        .hide-scrollbar {
            scrollbar-width: none;
        }

        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .topbar-gradient {
            background:
                linear-gradient(
                    90deg,
                    #7dd3fc,
                    #bae6fd
                );
        }

        .hero-gradient {
            background:
                radial-gradient(
                    circle at top right,
                    rgba(255, 255, 255, .72),
                    transparent 42%
                ),
                linear-gradient(
                    135deg,
                    #e0f2fe 0%,
                    #bae6fd 52%,
                    #dbeafe 100%
                );
        }

        .product-card {
            transition:
                transform .22s ease,
                box-shadow .22s ease,
                border-color .22s ease;
        }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow:
                0 18px 38px rgba(15, 23, 42, .10);
            border-color: #bfdbfe;
        }

        .product-image {
            transition: transform .35s ease;
        }

        .product-card:hover .product-image {
            transform: scale(1.04);
        }

        .section-title::before {
            content: "";
            width: 6px;
            height: 28px;
            border-radius: 999px;
            background: #38bdf8;
            display: inline-block;
            margin-right: 12px;
        }

        .skeleton {
            background:
                linear-gradient(
                    90deg,
                    #f1f5f9 25%,
                    #e2e8f0 37%,
                    #f1f5f9 63%
                );
            background-size: 400% 100%;
            animation: skeleton-loading 1.3s ease infinite;
        }

        @keyframes skeleton-loading {
            0% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0 50%;
            }
        }

        .category-chip {
            transition: all .2s ease;
        }

        .category-chip:hover {
            transform: translateY(-1px);
        }

        .category-chip.active {
            background: #38bdf8;
            color: white;
            border-color: #2563eb;
            box-shadow:
                0 8px 20px rgba(37, 99, 235, .20);
        }

        .hero-product-image {
            filter:
                drop-shadow(
                    0 30px 40px rgba(30, 64, 175, .20)
                );
        }

        .floating-search {
            box-shadow:
                0 12px 35px rgba(15, 23, 42, .08);
        }

        .mobile-menu {
            transform: translateX(100%);
            transition: transform .25s ease;
        }

        .mobile-menu.open {
            transform: translateX(0);
        }
    </style>
</head>

<body>

    <!-- ====================================================== -->
    <!-- TOP BAR                                                -->
    <!-- ====================================================== -->

    <div class="topbar-gradient text-sky-950">

        <div
            class="
                container-main
                min-h-[38px]
                flex
                items-center
                justify-center
                md:justify-between
                gap-4
                text-xs
                md:text-sm
                font-medium
            "
        >

            <div class="flex items-center gap-2">
                <i class="fa-solid fa-bolt"></i>

                <span>
                    Ao abrir uma oferta, você será direcionado para a Shopee para conferir preço, disponibilidade e finalizar a compra
                </span>
            </div>

            <div
                class="
                    hidden
                    md:flex
                    items-center
                    gap-6
                    opacity-95
                "
            >
                <span>
                    <i class="fa-solid fa-shield-halved mr-1"></i>
                    Compra pela Shopee
                </span>

                <span>
                    <i class="fa-solid fa-tags mr-1"></i>
                    Achadinhos todos os dias
                </span>
            </div>

        </div>

    </div>


    <!-- ====================================================== -->
    <!-- HEADER                                                 -->
    <!-- ====================================================== -->

    <header
        class="
            bg-white/95
            backdrop-blur
            sticky
            top-0
            z-40
            border-b
            border-slate-100
        "
    >

        <div
            class="
                container-main
                h-[64px]
                flex
                items-center
                gap-5
            "
        >

            <!-- LOGO -->

            <a
                href="/vitrine2"
                class="
                    flex
                    items-center
                    gap-3
                    shrink-0
                "
            >

                <div
                    class="
                        w-11
                        h-11
                        rounded-2xl
                        bg-sky-400
                        text-white
                        flex
                        items-center
                        justify-center
                        shadow-lg
                        shadow-sky-100
                    "
                >
                    <i class="fa-solid fa-bag-shopping text-xl"></i>
                </div>

                <div class="hidden sm:block">

                    <div
                        class="
                            text-lg
                            font-extrabold
                            leading-none
                            tracking-tight
                        "
                    >
                        Minha Vitrine
                    </div>

                    <div
                        class="
                            text-[11px]
                            text-slate-500
                            mt-1
                        "
                    >
                        Achadinhos e Ofertas
                    </div>

                </div>

            </a>


            <!-- SEARCH -->

            <div
                class="
                    hidden
                    md:flex
                    flex-1
                    max-w-3xl
                    mx-auto
                    relative
                "
            >

                <i
                    class="
                        fa-solid
                        fa-magnifying-glass
                        absolute
                        left-5
                        top-1/2
                        -translate-y-1/2
                        text-slate-400
                    "
                ></i>

                <input
                    id="desktopSearch"
                    type="search"
                    placeholder="Buscar produtos e categorias..."
                    autocomplete="off"
                    class="
                        floating-search
                        w-full
                        h-12
                        rounded-full
                        border
                        border-slate-200
                        bg-slate-50
                        pl-12
                        pr-5
                        outline-none
                        focus:bg-white
                        focus:border-sky-300
                        transition
                    "
                >

            </div>


            <!-- DESKTOP NAV -->

            <div
                class="
                    hidden
                    lg:flex
                    items-center
                    gap-5
                    text-sm
                    font-semibold
                    text-slate-600
                    shrink-0
                "
            >

                <button
                    onclick="scrollToSection('ofertas')"
                    class="hover:text-sky-800 transition"
                >
                    Ofertas
                </button>

                <button
                    onclick="scrollToSection('destaques')"
                    class="hover:text-sky-800 transition"
                >
                    Destaques
                </button>

                <button
                    onclick="scrollToSection('todos')"
                    class="hover:text-sky-800 transition"
                >
                    Produtos
                </button>

            </div>


            <!-- MOBILE MENU BUTTON -->

            <button
                id="mobileMenuButton"
                class="
                    lg:hidden
                    ml-auto
                    w-11
                    h-11
                    rounded-xl
                    border
                    border-slate-200
                    flex
                    items-center
                    justify-center
                    text-slate-600
                "
                aria-label="Abrir menu"
            >
                <i class="fa-solid fa-bars text-lg"></i>
            </button>

        </div>


        <!-- MOBILE SEARCH -->

        <div
            class="
                md:hidden
                container-main
                pb-4
            "
        >

            <div class="relative">

                <i
                    class="
                        fa-solid
                        fa-magnifying-glass
                        absolute
                        left-4
                        top-1/2
                        -translate-y-1/2
                        text-slate-400
                    "
                ></i>

                <input
                    id="mobileSearch"
                    type="search"
                    placeholder="O que você está procurando?"
                    autocomplete="off"
                    class="
                        w-full
                        h-11
                        rounded-full
                        border
                        border-slate-200
                        bg-slate-50
                        pl-11
                        pr-4
                        outline-none
                        focus:border-sky-300
                    "
                >

            </div>

        </div>

    </header>


    <!-- ====================================================== -->
    <!-- MOBILE MENU                                            -->
    <!-- ====================================================== -->

    <div
        id="mobileMenu"
        class="
            mobile-menu
            fixed
            inset-y-0
            right-0
            z-50
            w-[82%]
            max-w-sm
            bg-white
            shadow-2xl
            p-6
        "
    >

        <div
            class="
                flex
                items-center
                justify-between
                mb-8
            "
        >

            <strong class="text-xl">
                Menu
            </strong>

            <button
                id="mobileMenuClose"
                class="
                    w-10
                    h-10
                    rounded-full
                    bg-slate-100
                "
            >
                <i class="fa-solid fa-xmark"></i>
            </button>

        </div>

        <div class="space-y-2">

            <button
                onclick="mobileNavigate('ofertas')"
                class="
                    w-full
                    text-left
                    px-4
                    py-4
                    rounded-xl
                    hover:bg-sky-50
                    font-semibold
                "
            >
                <i class="fa-solid fa-fire mr-3 text-sky-600"></i>
                Ofertas
            </button>

            <button
                onclick="mobileNavigate('destaques')"
                class="
                    w-full
                    text-left
                    px-4
                    py-4
                    rounded-xl
                    hover:bg-sky-50
                    font-semibold
                "
            >
                <i class="fa-solid fa-star mr-3 text-sky-600"></i>
                Destaques
            </button>

            <button
                onclick="mobileNavigate('todos')"
                class="
                    w-full
                    text-left
                    px-4
                    py-4
                    rounded-xl
                    hover:bg-sky-50
                    font-semibold
                "
            >
                <i class="fa-solid fa-store mr-3 text-sky-600"></i>
                Produtos para você
            </button>

        </div>

    </div>


    <div
        id="mobileOverlay"
        class="
            hidden
            fixed
            inset-0
            bg-slate-950/40
            z-40
            backdrop-blur-sm
        "
    ></div>


    <!-- ====================================================== -->
    <!-- MAIN                                                   -->
    <!-- ====================================================== -->

    <main>



        <!-- ================================================== -->
        <!-- TRUST                                              -->
        <!-- ================================================== -->

        <section class="container-main py-7">

            <div
                class="
                    grid
                    grid-cols-1
                    sm:grid-cols-3
                    gap-3
                "
            >

                <div
                    class="
                        bg-white
                        border
                        border-slate-100
                        rounded-2xl
                        p-4
                        flex
                        items-center
                        gap-3
                    "
                >
                    <div
                        class="
                            w-10
                            h-10
                            rounded-xl
                            bg-sky-50
                            text-sky-600
                            flex
                            items-center
                            justify-center
                        "
                    >
                        <i class="fa-solid fa-tags"></i>
                    </div>

                    <div>
                        <strong class="block text-sm">
                            Boas ofertas
                        </strong>

                        <span class="text-xs text-slate-500">
                            Seleção da vitrine
                        </span>
                    </div>
                </div>


                <div
                    class="
                        bg-white
                        border
                        border-slate-100
                        rounded-2xl
                        p-4
                        flex
                        items-center
                        gap-3
                    "
                >
                    <div
                        class="
                            w-10
                            h-10
                            rounded-xl
                            bg-sky-50
                            text-sky-600
                            flex
                            items-center
                            justify-center
                        "
                    >
                        <i class="fa-solid fa-lock"></i>
                    </div>

                    <div>
                        <strong class="block text-sm">
                            Compra segura
                        </strong>

                        <span class="text-xs text-slate-500">
                            Finalizada na Shopee
                        </span>
                    </div>
                </div>


                <div
                    class="
                        bg-white
                        border
                        border-slate-100
                        rounded-2xl
                        p-4
                        flex
                        items-center
                        gap-3
                    "
                >
                    <div
                        class="
                            w-10
                            h-10
                            rounded-xl
                            bg-sky-50
                            text-sky-600
                            flex
                            items-center
                            justify-center
                        "
                    >
                        <i class="fa-solid fa-star"></i>
                    </div>

                    <div>
                        <strong class="block text-sm">
                            Destaques
                        </strong>

                        <span class="text-xs text-slate-500">
                            Produtos selecionados
                        </span>
                    </div>
                </div>

            </div>

        </section>


        <!-- ================================================== -->
        <!-- CATEGORIES                                         -->
        <!-- ================================================== -->

        <section class="container-main">

            <div
                class="
                    flex
                    items-center
                    justify-between
                    gap-4
                    mb-4
                "
            >

                <div>

                    <h2
                        class="
                            text-xl
                            md:text-2xl
                            font-extrabold
                            tracking-tight
                        "
                    >
                        Explore por categoria
                    </h2>

                    <p
                        class="
                            text-sm
                            text-slate-500
                            mt-1
                        "
                    >
                        Encontre o que combina com você
                    </p>

                </div>

            </div>


            <div
                id="categoryChips"
                class="
                    flex
                    gap-2
                    overflow-x-auto
                    hide-scrollbar
                    pb-3
                "
            >

                <button
                    data-category=""
                    class="
                        category-chip
                        active
                        whitespace-nowrap
                        px-5
                        py-2.5
                        rounded-full
                        border
                        border-slate-200
                        bg-white
                        text-sm
                        font-semibold
                    "
                >
                    Todos
                </button>

            </div>

        </section>


        <!-- ================================================== -->
        <!-- PROMOTIONS                                         -->
        <!-- ================================================== -->

        <section
            id="ofertas"
            class="hidden container-main py-10"
        >

            <div
                class="
                    flex
                    items-end
                    justify-between
                    gap-4
                    mb-6
                "
            >

                <div>

                    <div class="flex items-center">

                        <h2
                            class="
                                section-title
                                flex
                                items-center
                                text-2xl
                                md:text-3xl
                                font-extrabold
                                tracking-tight
                            "
                        >
                            Ofertas e Promoções
                        </h2>

                    </div>

                    <p
                        class="
                            text-sm
                            md:text-base
                            text-slate-500
                            mt-2
                        "
                    >
                        Achadinhos que merecem sua atenção
                    </p>

                </div>

            </div>


            <div
                id="promotionProducts"
                class="
                    flex
                    gap-4
                    overflow-x-auto
                    hide-scrollbar
                    pb-5
                "
            ></div>

        </section>


        <!-- ================================================== -->
        <!-- FEATURED                                           -->
        <!-- ================================================== -->

        <section
            id="destaques"
            class="
                hidden
                bg-slate-50
                border-y
                border-slate-100
                py-12
            "
        >

            <div class="container-main">

                <div class="mb-7">

                    <div class="flex items-center">

                        <h2
                            class="
                                section-title
                                flex
                                items-center
                                text-2xl
                                md:text-3xl
                                font-extrabold
                                tracking-tight
                            "
                        >
                            Escolhas da Vitrine
                        </h2>

                    </div>

                    <p
                        class="
                            text-slate-500
                            mt-2
                        "
                    >
                        Produtos que selecionamos para ficar em destaque
                    </p>

                </div>


                <div
                    id="featuredProducts"
                    class="
                        grid
                        grid-cols-2
                        md:grid-cols-3
                        lg:grid-cols-4
                        xl:grid-cols-5
                        gap-3
                        md:gap-5
                    "
                ></div>

            </div>

        </section>


        <!-- ================================================== -->
        <!-- ALL PRODUCTS                                       -->
        <!-- ================================================== -->

        <section
            id="todos"
            class="container-main pt-5 pb-8"
        >

            <div
                class="
                    flex
                    flex-col
                    sm:flex-row
                    sm:items-end
                    sm:justify-between
                    gap-4
                    mb-7
                "
            >

                <div>

                    <div class="flex items-center">

                        <h2
                            class="
                                section-title
                                flex
                                items-center
                                text-2xl
                                md:text-3xl
                                font-extrabold
                                tracking-tight
                            "
                        >
                            Produtos para você
                        </h2>

                    </div>

                    <p
                        id="productCounter"
                        class="
                            text-slate-500
                            mt-2
                        "
                    >
                        Carregando achadinhos...
                    </p>

                </div>


                <select
                    id="sortProducts"
                    class="
                        bg-white
                        border
                        border-slate-200
                        rounded-xl
                        px-4
                        py-3
                        text-sm
                        font-medium
                        outline-none
                        focus:border-sky-300
                    "
                >
                    <option value="position">
                        Recomendados
                    </option>

                    <option value="price-asc">
                        Menor preço
                    </option>

                    <option value="price-desc">
                        Maior preço
                    </option>

                    <option value="name">
                        Nome A-Z
                    </option>

                </select>

            </div>


            <!-- ERROR -->

            <div
                id="errorState"
                class="
                    hidden
                    bg-red-50
                    border
                    border-red-100
                    rounded-3xl
                    p-8
                    text-center
                    mb-8
                "
            >

                <div
                    class="
                        w-14
                        h-14
                        mx-auto
                        rounded-full
                        bg-red-100
                        text-red-500
                        flex
                        items-center
                        justify-center
                        mb-4
                    "
                >
                    <i class="fa-solid fa-triangle-exclamation text-xl"></i>
                </div>

                <h3 class="font-bold text-lg">
                    Não conseguimos carregar os produtos
                </h3>

                <p
                    class="
                        text-slate-500
                        text-sm
                        mt-2
                    "
                >
                    Tente atualizar a página daqui a pouco.
                </p>

            </div>


            <!-- EMPTY -->

            <div
                id="emptyState"
                class="
                    hidden
                    bg-slate-50
                    border
                    border-slate-100
                    rounded-3xl
                    p-10
                    text-center
                "
            >

                <div
                    class="
                        w-16
                        h-16
                        mx-auto
                        rounded-full
                        bg-white
                        text-slate-400
                        flex
                        items-center
                        justify-center
                        shadow-sm
                        mb-4
                    "
                >
                    <i class="fa-solid fa-magnifying-glass text-xl"></i>
                </div>

                <h3
                    class="
                        text-lg
                        font-bold
                    "
                >
                    Nenhum produto encontrado
                </h3>

                <p
                    class="
                        text-sm
                        text-slate-500
                        mt-2
                    "
                >
                    Tente outra busca ou selecione outra categoria.
                </p>

            </div>


            <!-- PRODUCTS -->

            <div
                id="allProducts"
                class="
                    grid
                    grid-cols-2
                    md:grid-cols-3
                    lg:grid-cols-4
                    xl:grid-cols-5
                    gap-2.5
                    md:gap-4
                "
            ></div>

        </section>




        <!-- ================================================== -->
        <!-- WHATSAPP                                           -->
        <!-- ================================================== -->

        <section class="container-main pb-10">

            <div
                class="
                    rounded-[24px]
                    border
                    border-emerald-100
                    bg-emerald-50
                    p-5
                    sm:p-6
                    flex
                    flex-col
                    sm:flex-row
                    sm:items-center
                    sm:justify-between
                    gap-4
                "
            >

                <div class="flex items-start gap-3">

                    <div
                        class="
                            w-11
                            h-11
                            rounded-2xl
                            bg-emerald-500
                            text-white
                            flex
                            items-center
                            justify-center
                            shrink-0
                        "
                    >
                        <i class="fa-brands fa-whatsapp text-xl"></i>
                    </div>

                    <div>
                        <h2 class="font-extrabold text-lg text-slate-900">
                            Grupo de ofertas no WhatsApp
                        </h2>

                        <p class="text-sm text-slate-600 mt-1 max-w-xl">
                            Uma forma rápida de receber novidades e achadinhos
                            sem precisar procurar toda hora.
                        </p>
                    </div>

                </div>

                <a
                    id="whatsappGroupButton"
                    href="#"
                    class="
                        inline-flex
                        items-center
                        justify-center
                        gap-2
                        rounded-full
                        px-5
                        py-3
                        bg-slate-200
                        text-slate-500
                        font-bold
                        text-sm
                        cursor-not-allowed
                        shrink-0
                    "
                    aria-disabled="true"
                >
                    <i class="fa-brands fa-whatsapp"></i>
                    Grupo em breve
                </a>

            </div>

        </section>


    </main>



    <!-- ====================================================== -->
    <!-- CONFIRMAÇÃO DE REDIRECIONAMENTO PARA SHOPEE            -->
    <!-- ====================================================== -->

    <div
        id="shopeeConfirmModal"
        class="
            hidden
            fixed
            inset-0
            z-[100]
            items-center
            justify-center
            bg-slate-950/55
            backdrop-blur-sm
            p-4
        "
        role="dialog"
        aria-modal="true"
        aria-labelledby="shopeeConfirmTitle"
    >

        <div
            class="
                w-full
                max-w-md
                rounded-3xl
                bg-white
                p-6
                shadow-2xl
                sm:p-7
            "
        >

            <div
                class="
                    mx-auto
                    mb-4
                    flex
                    h-14
                    w-14
                    items-center
                    justify-center
                    rounded-2xl
                    bg-blue-50
                    text-blue-600
                "
            >
                <i class="fa-solid fa-arrow-up-right-from-square text-xl"></i>
            </div>

            <h2
                id="shopeeConfirmTitle"
                class="
                    text-center
                    text-xl
                    font-extrabold
                    tracking-tight
                    text-slate-900
                "
            >
                Você será direcionado para a Shopee
            </h2>

            <p
                class="
                    mt-3
                    text-center
                    text-sm
                    leading-6
                    text-slate-600
                "
            >
                A compra será concluída no site da Shopee.
                Lá você poderá conferir o preço atualizado,
