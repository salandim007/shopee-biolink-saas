                    : 0;

            document.documentElement.style.setProperty(
                '--sticky-topbar-height',
                `${topbarHeight}px`
            );

            document.documentElement.style.setProperty(
                '--sticky-header-height',
                `${headerHeight}px`
            );

            document.documentElement.style.setProperty(
                '--sticky-hub-height',
                `${hubHeight}px`
