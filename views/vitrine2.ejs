                        'sandalia',
                        'chinelo'
                    ]
                },
                {
                    name: 'Eletrônicos',
                    words: [
                        'fone',
                        'bluetooth',
                        'celular',
                        'smartphone',
                        'carregador',
                        'cabo',
                        'headset',
