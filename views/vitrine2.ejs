                        px-5
                        py-3
                        text-sm
                        font-bold
                        text-white
                        transition
                        hover:bg-blue-600
                        active:scale-[.99]
                    "
                >
                    Continuar para a Shopee
                    <i class="fa-solid fa-arrow-right"></i>
                </button>

                <button
