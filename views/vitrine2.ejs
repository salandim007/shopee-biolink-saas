                'Toque em uma categoria para explorar';

            categoryChipsElement.innerHTML =
                '';


            const allButton =
                createCategoryMenuButton(
                    'Todos os produtos',
                    {
                        icon:
                            'fa-border-all'
                    }
                );

            allButton.addEventListener(
                'click',
                () => {
                    applyCategoryFilter(
                        '',
                        ''
                    );
                }
            );

            categoryChipsElement.appendChild(
                allButton
            );


            const categories =
                new Set();


            catalogProducts.forEach(
                entry => {

                    const category =
                        getPrimaryCategory(
                            entry.product || {}
                        );

                    if (category) {
                        categories.add(
                            category
                        );
                    }
                }
            );


            const categoryPriority = [
                'Moda',
                'Eletrônicos',
                'Casa e Cozinha',
                'Beleza e Cuidados',
                'Acessórios',
                'Infantil',
                'Esporte e Lazer',
                'Automotivo',
                'Ferramentas',
                'Pet',
                'Outros achadinhos'
            ];


            const priorityIndex =
                value => {

                    const normalized =
                        normalizeText(
                            value
                        );

                    const index =
                        categoryPriority
                            .findIndex(
                                item =>
                                    normalizeText(
                                        item
                                    ) ===
                                    normalized
                            );

                    return index === -1
                        ? 999
                        : index;
                };


            const sorted =
                [...categories]
                    .sort(
                        (a, b) => {

                            const priorityDifference =
                                priorityIndex(a) -
                                priorityIndex(b);

                            if (
                                priorityDifference !== 0
                            ) {
                                return priorityDifference;
                            }

                            return a.localeCompare(
                                b,
                                'pt-BR'
                            );
                        }
                    );


            sorted.forEach(
                category => {

                    const button =
                        createCategoryMenuButton(
                            category
                        );

                    button.addEventListener(
                        'click',
                        () => {
                            renderSubcategories(
                                category
                            );
                        }
                    );

                    categoryChipsElement.appendChild(
                        button
                    );
                }
            );
        }


