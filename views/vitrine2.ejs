        function getFilteredProducts() {

            let items =
                [...catalogProducts];


            if (currentCategory) {

                const category =
                    normalizeText(
                        currentCategory
                    );

                items =
                    items.filter(
                        entry => {

                            const product =
                                entry.product || {};

                            const productCategory =
                                normalizeText(
                                    getPrimaryCategory(
                                        product
                                    )
                                );

                            if (
                                productCategory !==
                                category
                            ) {
                                return false;
                            }


                            if (!currentSubcategory) {
                                return true;
                            }


                            const productSubcategory =
                                normalizeText(
                                    getProductSubcategory(
                                        product,
                                        getPrimaryCategory(
                                            product
                                        )
                                    )
                                );

                            return (
                                productSubcategory ===
                                normalizeText(
                                    currentSubcategory
                                )
                            );
                        }
                    );
            }


            switch (currentSort) {

                case 'price-asc':

                    items.sort(
                        (a, b) =>
                            Number(
                                a.product?.price ?? 0
                            ) -
                            Number(
                                b.product?.price ?? 0
                            )
                    );

                    break;


                case 'price-desc':

                    items.sort(
                        (a, b) =>
                            Number(
                                b.product?.price ?? 0
                            ) -
                            Number(
                                a.product?.price ?? 0
                            )
                    );

                    break;


                case 'name':

                    items.sort(
                        (a, b) =>
                            String(
                                a.product?.title ?? ''
                            ).localeCompare(
                                String(
                                    b.product?.title ?? ''
                                ),
                                'pt-BR'
                            )
                    );

                    break;


                default:

                    items.sort(
                        (a, b) => {

                            const positionA =
                                a.visibility?.position ??
                                Number.MAX_SAFE_INTEGER;

                            const positionB =
                                b.visibility?.position ??
                                Number.MAX_SAFE_INTEGER;

                            return (
                                positionA -
                                positionB
                            );
                        }
                    );
            }


            return items;
        }


