    <!-- ====================================================== -->
    <!-- JAVASCRIPT                                             -->
    <!-- ====================================================== -->

    <script>

        /*
         * =====================================================
         * ESTADO DA VITRINE
         * =====================================================
         */

        const WHATSAPP_GROUP_URL = '';

        function setupWhatsAppGroup() {

            const button =
                document.getElementById(
                    'whatsappGroupButton'
                );

            if (!button) {
                return;
            }

            if (!WHATSAPP_GROUP_URL) {
                return;
            }

            button.href =
                WHATSAPP_GROUP_URL;

            button.target =
                '_blank';

            button.rel =
                'noopener noreferrer';

            button.removeAttribute(
                'aria-disabled'
            );

            button.classList.remove(
                'bg-slate-200',
                'text-slate-500',
                'cursor-not-allowed'
            );

            button.classList.add(
                'bg-emerald-500',
                'hover:bg-emerald-600',
                'text-white',
                'transition'
            );

            button.innerHTML =
                '<i class="fa-brands fa-whatsapp"></i> Entrar no grupo';
        }


        let catalogProducts = [];

        let currentSearch = '';

        let currentCategory = '';

        let currentSort = 'position';


        /*
         * =====================================================
         * ELEMENTOS
         * =====================================================
         */

        const allProductsElement =
            document.getElementById('allProducts');

        const featuredProductsElement =
            document.getElementById('featuredProducts');

        const promotionProductsElement =
            document.getElementById('promotionProducts');

        const categoryChipsElement =
            document.getElementById('categoryChips');

        const productCounterElement =
            document.getElementById('productCounter');

        const emptyStateElement =
            document.getElementById('emptyState');

        const errorStateElement =
            document.getElementById('errorState');

        const desktopSearch =
            document.getElementById('desktopSearch');

        const mobileSearch =
            document.getElementById('mobileSearch');

        const sortProducts =
            document.getElementById('sortProducts');


        /*
         * =====================================================
         * FORMATAÇÃO
         * =====================================================
         */

        function formatCurrency(value) {

            const number =
                Number(value);

            if (!Number.isFinite(number)) {
                return 'Consulte';
            }

            return new Intl.NumberFormat(
                'pt-BR',
                {
                    style: 'currency',
                    currency: 'BRL'
                }
            ).format(number);
        }


        function escapeHtml(value) {

            const text =
                String(
                    value ?? ''
                );

            return text
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
        }


        function normalizeText(value) {

            return String(
                value ?? ''
            )
                .normalize('NFD')
                .replace(
                    /[\u0300-\u036f]/g,
                    ''
                )
                .toLowerCase();
        }


        /*
         * =====================================================
         * DESCONTO
         * =====================================================
         */

        function getDiscountPercent(product) {

            const current =
                Number(
                    product.price
                );

            const original =
                Number(
                    product.originalPrice
                );

            if (
                !Number.isFinite(current) ||
                !Number.isFinite(original) ||
                original <= current ||
                original <= 0
            ) {
                return null;
            }

            return Math.round(
                (
                    (
                        original -
                        current
                    ) /
                    original
                ) * 100
            );
        }


        /*
         * =====================================================
         * CARD DO PRODUTO
         * =====================================================
         */

        function createProductCard(
            entry,
            horizontal = false
        ) {

            const product =
                entry.product || {};

            const discount =
                getDiscountPercent(
                    product
                );

            const originalPrice =
                Number(
                    product.originalPrice
                );

            const showOriginalPrice =
                Number.isFinite(
                    originalPrice
                ) &&
                originalPrice >
                Number(product.price);


            const widthClass =
                horizontal
                    ? 'min-w-[220px] sm:min-w-[250px] lg:min-w-[270px]'
                    : '';


            return `
                <article
                    class="
                        product-card
                        ${widthClass}
                        bg-white
                        border
                        border-slate-100
                        rounded-xl
                        md:rounded-2xl
                        overflow-hidden
                        flex
                        flex-col
                    "
                >

                    <div
                        class="
                            relative
                            aspect-square
                            bg-slate-50
                            overflow-hidden
                        "
                    >

                        ${
                            discount
                                ? `
                                    <div
                                        class="
                                            absolute
                                            top-3
                                            left-3
                                            z-10
                                            bg-red-500
                                            text-white
                                            text-xs
                                            font-bold
                                            px-2.5
                                            py-1.5
                                            rounded-full
                                            shadow-sm
                                        "
                                    >
                                        -${discount}%
                                    </div>
                                `
                                : ''
                        }

                        ${
                            entry.visibility?.featured
                                ? `
                                    <div
                                        class="
                                            absolute
                                            top-3
                                            right-3
                                            z-10
                                            w-8
                                            h-8
                                            rounded-full
                                            bg-white/95
                                            shadow-sm
                                            text-sky-600
                                            flex
                                            items-center
                                            justify-center
                                        "
                                        title="Destaque"
                                    >
                                        <i class="fa-solid fa-star"></i>
                                    </div>
                                `
                                : ''
                        }

                        <img
                            src="${escapeHtml(product.image)}"
                            alt="${escapeHtml(product.title)}"
                            loading="lazy"
                            class="
                                product-image
                                w-full
                                h-full
                                object-cover
                            "
                            onerror="
                                this.style.display='none';
                                this.parentElement.classList.add(
                                    'flex',
                                    'items-center',
                                    'justify-center'
                                );
                            "
                        >

                    </div>


                    <div
                        class="
                            p-3
                            md:p-4
                            flex
                            flex-col
                            flex-1
                        "
                    >


                        <h3
                            class="
                                text-sm
                                md:text-[15px]
                                font-semibold
                                text-slate-800
                                leading-snug
                                line-clamp-2
                                min-h-[40px]
                                md:min-h-[44px]
                            "
                            title="${escapeHtml(product.title)}"
                        >
                            ${escapeHtml(product.title)}
                        </h3>


                        <div class="mt-3">

                            ${
                                showOriginalPrice
                                    ? `
                                        <div
                                            class="
                                                text-xs
                                                text-slate-400
                                                line-through
                                            "
                                        >
                                            ${formatCurrency(product.originalPrice)}
                                        </div>
                                    `
                                    : `
                                        <div class="h-[16px]"></div>
                                    `
                            }


                            <div
                                class="
                                    text-lg
                                    md:text-xl
                                    font-extrabold
                                    text-slate-950
                                    leading-tight
                                "
                            >
                                ${formatCurrency(product.price)}
                            </div>

                        </div>


                        <div class="mt-auto pt-4">

                            <a
                                href="#"
                                data-offer-link="${escapeHtml(product.affiliateLink)}"
                                onclick="openShopeeConfirm(event, this.dataset.offerLink)"
                                class="
                                    w-full
                                    bg-sky-400
                                    hover:bg-sky-600
                                    active:scale-[.98]
                                    transition
                                    text-white
                                    rounded-xl
                                    md:rounded-2xl
                                    py-2.5
                                    md:py-3
                                    text-xs
                                    md:text-sm
                                    font-bold
                                    flex
                                    items-center
                                    justify-center
                                    gap-2
                                "
                            >
                                Ver oferta

                                <i
                                    class="
                                        fa-solid
                                        fa-arrow-up-right-from-square
                                        text-[11px]
                                    "
                                ></i>
                            </a>

                        </div>

                    </div>

                </article>
            `;
        }


        /*
         * =====================================================
         * CATEGORIAS
         * =====================================================
         */

        function getProductCategories(
            product
        ) {

            return [
                product.category1,
                product.category2,
                product.category3
            ]
                .filter(Boolean)
                .map(
                    item =>
                        String(item).trim()
                )
                .filter(Boolean);
        }


        function renderCategories() {

            const categories =
                new Set();


            catalogProducts.forEach(
                entry => {

                    getProductCategories(
                        entry.product || {}
                    ).forEach(
                        category =>
                            categories.add(
                                category
                            )
                    );
                }
            );


            const sorted =
                [...categories]
                    .sort(
                        (a, b) =>
                            a.localeCompare(
                                b,
                                'pt-BR'
                            )
                    );


            categoryChipsElement
                .querySelectorAll(
                    '[data-generated="true"]'
                )
                .forEach(
                    element =>
                        element.remove()
                );


            sorted.forEach(
                category => {

                    const button =
                        document.createElement(
                            'button'
                        );

                    button.dataset.category =
                        category;

                    button.dataset.generated =
                        'true';

                    button.className =
                        `
                            category-chip
                            whitespace-nowrap
                            px-5
                            py-2.5
                            rounded-full
                            border
                            border-slate-200
                            bg-white
                            text-sm
                            font-semibold
                            text-slate-600
                        `;

                    button.textContent =
                        category;

                    categoryChipsElement.appendChild(
                        button
                    );
                }
            );


            categoryChipsElement
                .querySelectorAll(
                    '[data-category]'
                )
                .forEach(
                    button => {

                        button.addEventListener(
                            'click',
                            () => {

                                currentCategory =
                                    button.dataset.category ||
                                    '';

                                categoryChipsElement
                                    .querySelectorAll(
                                        '[data-category]'
                                    )
                                    .forEach(
                                        item =>
                                            item.classList.remove(
                                                'active'
                                            )
                                    );

                                button.classList.add(
                                    'active'
                                );

                                renderAllProducts();
                            }
                        );
                    }
                );
        }


        /*
         * =====================================================
         * FILTROS
         * =====================================================
         */

        function getFilteredProducts() {

            let items =
                [...catalogProducts];


            if (currentSearch) {

                const search =
                    normalizeText(
                        currentSearch
                    );

                items =
                    items.filter(
                        entry => {

                            const product =
                                entry.product || {};

                            const searchable =
                                normalizeText(
                                    [
                                        product.title,
                                        product.category1,
                                        product.category2,
                                        product.category3
                                    ]
                                        .filter(Boolean)
                                        .join(' ')
                                );

                            return searchable.includes(
                                search
                            );
                        }
                    );
            }


            if (currentCategory) {

                const category =
                    normalizeText(
                        currentCategory
                    );

                items =
                    items.filter(
                        entry => {

                            const categories =
                                getProductCategories(
                                    entry.product || {}
                                )
                                    .map(
                                        normalizeText
                                    );

                            return categories.includes(
                                category
                            );
                        }
                    );
            }


            switch (currentSort) {

                case 'price-asc':

                    items.sort(
                        (a, b) =>
                            Number(
                                a.product?.price ?? 0
                            ) -
                            Number(
                                b.product?.price ?? 0
                            )
                    );

                    break;


                case 'price-desc':

                    items.sort(
                        (a, b) =>
                            Number(
                                b.product?.price ?? 0
                            ) -
                            Number(
                                a.product?.price ?? 0
                            )
                    );

                    break;


                case 'name':

                    items.sort(
                        (a, b) =>
                            String(
                                a.product?.title ?? ''
                            ).localeCompare(
                                String(
                                    b.product?.title ?? ''
                                ),
                                'pt-BR'
                            )
                    );

                    break;


                default:

                    items.sort(
                        (a, b) => {

                            const positionA =
                                a.visibility?.position ??
                                Number.MAX_SAFE_INTEGER;

                            const positionB =
                                b.visibility?.position ??
                                Number.MAX_SAFE_INTEGER;

                            return (
                                positionA -
                                positionB
                            );
                        }
                    );
            }


            return items;
        }


        /*
         * =====================================================
         * TODOS OS PRODUTOS
         * =====================================================
         */

        function renderAllProducts() {

            const products =
                getFilteredProducts();


            productCounterElement.textContent =
                products.length === 1
                    ? '1 produto encontrado'
                    : `${products.length} produtos encontrados`;


            if (
                products.length === 0
            ) {

                allProductsElement.innerHTML =
                    '';

                emptyStateElement.classList.remove(
                    'hidden'
                );

                return;
            }


            emptyStateElement.classList.add(
                'hidden'
            );


            allProductsElement.innerHTML =
                products
                    .map(
                        entry =>
                            createProductCard(
                                entry
                            )
                    )
                    .join('');
        }


        /*
         * =====================================================
         * DESTAQUES
         * =====================================================
         */

        function renderFeaturedProducts() {

            const featured =
                catalogProducts.filter(
                    entry =>
                        entry.visibility?.featured
                );


            const products =
                featured.length
                    ? featured
                    : catalogProducts.slice(
                        0,
                        5
                    );


            featuredProductsElement.innerHTML =
                products
                    .slice(0, 10)
                    .map(
                        entry =>
                            createProductCard(
                                entry
                            )
                    )
                    .join('');
        }


        /*
         * =====================================================
         * PROMOÇÕES
         * =====================================================
         */

        function renderPromotions() {

            let promotions =
                catalogProducts.filter(
                    entry =>
                        Array.isArray(
                            entry.collections
                        ) &&
                        entry.collections.some(
                            collection =>
                                normalizeText(
                                    collection
                                ) ===
                                'promocoes'
                        )
                );


            if (
                promotions.length === 0
            ) {

                promotions =
                    catalogProducts.filter(
                        entry =>
                            getDiscountPercent(
                                entry.product || {}
                            )
                    );
            }


            if (
                promotions.length === 0
            ) {

                promotions =
                    catalogProducts.slice(
                        0,
                        8
                    );
            }


            promotionProductsElement.innerHTML =
                promotions
                    .map(
                        entry =>
                            createProductCard(
                                entry,
                                true
                            )
                    )
                    .join('');
        }


        /*
         * =====================================================
         * BUSCA
         * =====================================================
         */

        function updateSearch(
            value
        ) {

            currentSearch =
                String(value || '')
                    .trim();

            desktopSearch.value =
                currentSearch;

            mobileSearch.value =
                currentSearch;

            renderAllProducts();
        }


        desktopSearch.addEventListener(
            'input',
            event => {

                updateSearch(
                    event.target.value
                );
            }
        );


        mobileSearch.addEventListener(
            'input',
            event => {

                updateSearch(
                    event.target.value
                );
            }
        );


        /*
         * =====================================================
         * ORDENAÇÃO
         * =====================================================
         */

        sortProducts.addEventListener(
            'change',
            event => {

                currentSort =
                    event.target.value;

                renderAllProducts();
            }
        );


        /*
         * =====================================================
         * MENU MOBILE
         * =====================================================
         */

        const mobileMenu =
            document.getElementById(
                'mobileMenu'
            );

        const mobileOverlay =
            document.getElementById(
                'mobileOverlay'
            );


        function openMobileMenu() {

            mobileMenu.classList.add(
                'open'
            );

            mobileOverlay.classList.remove(
                'hidden'
            );

            document.body.style.overflow =
                'hidden';
        }


        function closeMobileMenu() {

            mobileMenu.classList.remove(
                'open'
            );

            mobileOverlay.classList.add(
                'hidden'
            );

            document.body.style.overflow =
                '';
        }


        document.getElementById(
            'mobileMenuButton'
        ).addEventListener(
            'click',
            openMobileMenu
        );


        document.getElementById(
            'mobileMenuClose'
        ).addEventListener(
            'click',
            closeMobileMenu
        );


        mobileOverlay.addEventListener(
            'click',
            closeMobileMenu
        );


        function mobileNavigate(
            id
        ) {

            closeMobileMenu();

            scrollToSection(
                id
            );
        }


        /*
         * =====================================================
         * NAVEGAÇÃO
         * =====================================================
         */

        function scrollToSection(
            id
        ) {

            const element =
                document.getElementById(
                    id
                );

            if (!element) {
                return;
            }

            element.scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        }


        /*
         * =====================================================
         * SKELETON
         * =====================================================
         */

        function renderSkeletons() {

            allProductsElement.innerHTML =
                Array.from({
                    length: 10
                })
                    .map(
                        () => `
                            <div
                                class="
                                    bg-white
                                    border
                                    border-slate-100
                                    rounded-3xl
                                    overflow-hidden
                                "
                            >
                                <div
                                    class="
                                        skeleton
                                        aspect-square
                                    "
                                ></div>

                                <div class="p-4">

                                    <div
                                        class="
                                            skeleton
                                            h-3
                                            rounded
                                            w-2/3
                                        "
                                    ></div>

                                    <div
                                        class="
                                            skeleton
                                            h-4
                                            rounded
                                            mt-3
                                        "
                                    ></div>

                                    <div
                                        class="
                                            skeleton
                                            h-4
                                            rounded
                                            mt-2
                                            w-4/5
                                        "
                                    ></div>

                                    <div
                                        class="
                                            skeleton
                                            h-6
                                            rounded
                                            mt-5
                                            w-1/2
                                        "
                                    ></div>

                                    <div
                                        class="
                                            skeleton
                                            h-10
                                            rounded-xl
                                            mt-4
                                        "
                                    ></div>

                                </div>

                            </div>
                        `
                    )
                    .join('');
        }


        /*
         * =====================================================
         * CARREGAMENTO DA API
         * =====================================================
         */

        async function loadProducts() {

            renderSkeletons();


            try {

                const response =
                    await fetch(
                        '/api/vitrine2/products/published',
                        {
                            headers: {
                                'Accept':
                                    'application/json'
                            }
                        }
                    );


                if (!response.ok) {

                    throw new Error(
                        `HTTP ${response.status}`
                    );
                }


                const data =
                    await response.json();


                if (
                    !data ||
                    data.success !== true ||
                    !Array.isArray(
                        data.products
                    )
                ) {

                    throw new Error(
                        'Resposta inválida da API.'
                    );
                }


                catalogProducts =
                    data.products;


                errorStateElement.classList.add(
                    'hidden'
                );



                renderCategories();

                renderPromotions();

                renderFeaturedProducts();

                renderAllProducts();


            } catch (error) {

                console.error(
                    '[VITRINE2] Erro ao carregar produtos:',
                    error
                );


                catalogProducts =
                    [];


                allProductsElement.innerHTML =
                    '';

                featuredProductsElement.innerHTML =
                    '';

                promotionProductsElement.innerHTML =
                    '';


                productCounterElement.textContent =
                    'Produtos indisponíveis';


                errorStateElement.classList.remove(
                    'hidden'
                );
            }
        }



        /*
         * =====================================================
         * CONFIRMAÇÃO ANTES DE IR PARA A SHOPEE
         * =====================================================
         */

        let pendingShopeeUrl = '';


        function openShopeeConfirm(
            event,
            url
        ) {

            if (event) {
                event.preventDefault();
            }

            pendingShopeeUrl =
                String(url || '').trim();

            if (!pendingShopeeUrl) {
                return;
            }

            const modal =
                document.getElementById(
                    'shopeeConfirmModal'
                );

            modal.classList.remove(
                'hidden'
            );

            modal.classList.add(
                'flex'
            );

            document.body.style.overflow =
                'hidden';
        }


        function closeShopeeConfirm() {

            const modal =
                document.getElementById(
                    'shopeeConfirmModal'
                );

            modal.classList.add(
                'hidden'
            );

            modal.classList.remove(
                'flex'
            );

            document.body.style.overflow =
                '';

            pendingShopeeUrl =
                '';
        }


        document.getElementById(
            'cancelShopeeButton'
        ).addEventListener(
            'click',
            closeShopeeConfirm
        );


        document.getElementById(
            'continueToShopeeButton'
        ).addEventListener(
            'click',
            () => {

                const targetUrl =
                    pendingShopeeUrl;

                if (!targetUrl) {
                    closeShopeeConfirm();
                    return;
                }

                window.location.href =
                    targetUrl;
            }
        );


        document.getElementById(
            'shopeeConfirmModal'
        ).addEventListener(
            'click',
            event => {

                if (
                    event.target.id ===
                    'shopeeConfirmModal'
                ) {
                    closeShopeeConfirm();
                }
            }
        );


        document.addEventListener(
            'keydown',
            event => {

                if (
                    event.key === 'Escape'
                ) {
                    closeShopeeConfirm();
                }
            }
        );


        /*
         * =====================================================
         * INICIALIZAÇÃO
         * =====================================================
         */

        document.addEventListener(
            'DOMContentLoaded',
            () => {
                setupWhatsAppGroup();
                loadProducts();
            }
        );

    </script>

</body>
</html>