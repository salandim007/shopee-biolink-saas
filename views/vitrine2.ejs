        function getProductSubcategory(
            product,
            primaryCategory
        ) {

            const candidates = [
                product.metadata?.subcategoryDisplayName,
                product.category2,
                product.category3
            ]
                .map(
                    item =>
                        String(
                            item || ''
                        ).trim()
                )
                .filter(Boolean)
                .filter(
                    item =>
                        normalizeText(item) !==
                        normalizeText(
                            primaryCategory
                        )
                );


            if (candidates.length) {
                return candidates[0];
            }


            return inferSubcategoryFromTitle(
                product,
                primaryCategory
            );
        }


