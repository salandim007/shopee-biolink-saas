        /*
         * =====================================================
         * CARREGAMENTO DA API
         * =====================================================
         */

        async function loadProducts() {

            renderSkeletons();


            try {

                const response =
                    await fetch(
                        '/api/vitrine2/products/published',
                        {
                            headers: {
                                'Accept':
                                    'application/json'
                            }
                        }
                    );


                if (!response.ok) {

                    throw new Error(
                        `HTTP ${response.status}`
                    );
                }


                const data =
                    await response.json();


                if (
                    !data ||
                    data.success !== true ||
                    !Array.isArray(
                        data.products
                    )
                ) {

                    throw new Error(
                        'Resposta inválida da API.'
                    );
                }


                catalogProducts =
                    data.products;


                errorStateElement.classList.add(
                    'hidden'
                );



                updateStickyHeaderHeight();

        window.addEventListener(
            'resize',
            updateStickyHeaderHeight
        );

        renderCategories();
renderAllProducts();


            } catch (error) {

                console.error(
                    '[VITRINE2] Erro ao carregar produtos:',
                    error
                );


                catalogProducts =
                    [];


                allProductsElement.innerHTML =
                    '';

                featuredProductsElement.innerHTML =
                    '';

                promotionProductsElement.innerHTML =
                    '';


                productCounterElement.textContent =
                    'Produtos indisponíveis';


                errorStateElement.classList.remove(
                    'hidden'
                );
            }
        }



        /*
         * =====================================================
         * CONFIRMAÇÃO ANTES DE IR PARA A SHOPEE
         * =====================================================
         */

        let pendingShopeeUrl = '';


        function openShopeeConfirm(
            event,
            url
        ) {

            if (event) {
                event.preventDefault();
            }

            pendingShopeeUrl =
                String(url || '').trim();

            if (!pendingShopeeUrl) {
                return;
            }

            const modal =
                document.getElementById(
                    'shopeeConfirmModal'
                );

            modal.classList.remove(
                'hidden'
            );

            modal.classList.add(
                'flex'
            );

            document.body.style.overflow =
                'hidden';
        }


        function closeShopeeConfirm() {

            const modal =
                document.getElementById(
                    'shopeeConfirmModal'
                );

            modal.classList.add(
                'hidden'
            );

            modal.classList.remove(
                'flex'
            );

            document.body.style.overflow =
                '';

            pendingShopeeUrl =
                '';
        }


        document.getElementById(
            'cancelShopeeButton'
        ).addEventListener(
            'click',
            closeShopeeConfirm
        );


        document.getElementById(
            'continueToShopeeButton'
        ).addEventListener(
            'click',
            () => {

                const targetUrl =
                    pendingShopeeUrl;

                if (!targetUrl) {
                    closeShopeeConfirm();
                    return;
                }

                /*
                 * Fecha o pop-up antes de sair da Vitrine.
                 * O link já está salvo em targetUrl, então
                 * podemos limpar pendingShopeeUrl com segurança.
                 */
                closeShopeeConfirm();

                const isMobileDevice =
                    /Android|iPhone|iPad|iPod/i.test(
                        navigator.userAgent
                    );

                if (isMobileDevice) {
                    /*
                     * No celular, mantemos a navegação normal.
                     * Assim, o Android/iOS pode encaminhar o
                     * link oficial da Shopee para o aplicativo
                     * quando ele estiver instalado e associado.
                     */
                    window.location.href =
                        targetUrl;

                    return;
                }

                /*
                 * No desktop, abrimos a oferta em uma nova aba.
                 *
                 * Não usamos "noopener" no terceiro argumento do
                 * window.open porque alguns navegadores retornam
                 * null mesmo quando a nova aba foi aberta. Isso
                 * fazia o fallback navegar também a aba da Vitrine.
                 */
                const newWindow =
                    window.open(
                        targetUrl,
                        '_blank'
                    );

                if (newWindow) {
                    newWindow.opener =
                        null;

                    return;
                }

                /*
                 * Fallback apenas quando a nova aba realmente
                 * for bloqueada pelo navegador.
                 */
                window.location.href =
                    targetUrl;
            }
        );


        document.getElementById(
            'shopeeConfirmModal'
        ).addEventListener(
            'click',
            event => {

                if (
                    event.target.id ===
                    'shopeeConfirmModal'
                ) {
                    closeShopeeConfirm();
                }
            }
        );


        document.addEventListener(
            'keydown',
            event => {

                if (
                    event.key === 'Escape'
                ) {
                    closeShopeeConfirm();
                }
            }
        );


        /*
         * =====================================================
         * INICIALIZAÇÃO
         * =====================================================
         */

        document.addEventListener(
