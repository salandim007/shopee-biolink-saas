<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="Vitrine de ofertas, achadinhos e produtos selecionados."
    >

    <title>Vitrine 2 | Ofertas e Achadinhos</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <!-- Google Fonts -->
    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <style>
        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            background:
                linear-gradient(
                    180deg,
                    #f7fcff 0,
                    #ffffff 220px
                );
            color: #172033;
        }

        .container-main {
            width: min(1380px, calc(100% - 32px));
            margin-inline: auto;
        }

        .hide-scrollbar {
            scrollbar-width: none;
        }

        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .topbar-gradient {
            background:
                linear-gradient(
                    90deg,
                    #7dd3fc,
                    #bae6fd
                );
        }

        .hero-gradient {
            background:
                radial-gradient(
                    circle at top right,
                    rgba(255, 255, 255, .72),
                    transparent 42%
                ),
                linear-gradient(
                    135deg,
                    #e0f2fe 0%,
                    #bae6fd 52%,
                    #dbeafe 100%
                );
        }

        .product-card {
            transition:
                transform .22s ease,
                box-shadow .22s ease,
                border-color .22s ease;
        }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow:
                0 18px 38px rgba(15, 23, 42, .10);
            border-color: #bfdbfe;
        }

        .product-image {
            transition: transform .35s ease;
        }

        .product-card:hover .product-image {
            transform: scale(1.04);
        }

        .section-title::before {
            content: "";
            width: 6px;
            height: 28px;
            border-radius: 999px;
            background: #38bdf8;
            display: inline-block;
            margin-right: 12px;
        }

        .skeleton {
            background:
                linear-gradient(
                    90deg,
                    #f1f5f9 25%,
                    #e2e8f0 37%,
                    #f1f5f9 63%
                );
            background-size: 400% 100%;
            animation: skeleton-loading 1.3s ease infinite;
        }

        @keyframes skeleton-loading {
            0% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0 50%;
            }
        }

        
        
        .category-chip {
            transition:
                transform .14s ease,
                box-shadow .14s ease,
                border-color .14s ease,
                background-color .14s ease;

            -webkit-tap-highlight-color:
                transparent;

            background: #ffffff;
            color: #334155;
            border-color: #e2e8f0;

            box-shadow:
                0 3px 0 #d1d5db,
                0 7px 14px rgba(15, 23, 42, .06);
        }

        .category-chip:hover {
            background: #ffffff;
            color: #334155;
            border-color: #cbd5e1;

            transform:
                translateY(-2px);

            box-shadow:
                0 5px 0 #c7cdd4,
                0 10px 18px rgba(15, 23, 42, .08);
        }

        .category-chip:active {
            background: #ffffff;
            color: #334155;
            border-color: #cbd5e1;

            transform:
                translateY(2px)
                scale(.975);

            box-shadow:
                0 1px 0 #c7cdd4,
                0 4px 8px rgba(15, 23, 42, .06);
        }

        .category-chip:focus-visible {
            outline:
                2px solid rgba(100, 116, 139, .28);

            outline-offset:
                2px;
        }

        .category-chip.active {
            background: #ffffff;
            color: #334155;
            border-color: #e2e8f0;

            transform: none;

            box-shadow:
                0 3px 0 #d1d5db,
                0 7px 14px rgba(15, 23, 42, .06);
        }

        .category-chip.active span[class*="bg-sky-50"],
        .category-chip:hover span[class*="bg-sky-50"],
        .category-chip:active span[class*="bg-sky-50"] {
            background: #f8fafc;
            color: #475569;
        }



        .hero-product-image {
            filter:
                drop-shadow(
                    0 30px 40px rgba(30, 64, 175, .20)
                );
        }

        .floating-search {
            box-shadow:
                0 12px 35px rgba(15, 23, 42, .08);
        }

        .mobile-menu {
            transform: translateX(100%);
            transition: transform .25s ease;
        }

        .mobile-menu.open {
            transform: translateX(0);
        }
    
        

    
        @media (max-width: 520px) {
            #navigationHub .container-main {
                padding-left: 8px;
                padding-right: 8px;
            }

            #navigationHub select {
                width: 138px;
                max-width: 138px;
            }

            #navigationHub button {
                min-width: 0;
            }

            #navigationHub button strong {
                max-width: none;
                white-space: nowrap;
                font-size: 13px;
            }

            #navigationHub #selectedCategoryLabel {
                max-width: 165px;
                font-size: 11px;
            }
        }

    
        :root {
            --sticky-topbar-height: 38px;
            --sticky-header-height: 72px;
            --sticky-hub-height: 76px;
        }

        #stickyMainHeader {
            box-shadow:
                0 4px 14px rgba(15, 23, 42, .04);
        }

        #navigationHub {
            box-shadow:
                0 5px 12px rgba(15, 23, 42, .035);
        }

        @media (max-width: 768px) {
            #stickyMainHeader {
                box-shadow:
                    0 3px 10px rgba(15, 23, 42, .04);
            }
        }

    
        #stickyTopBar {
            box-shadow: 0 1px 0 rgba(15, 23, 42, .05);
        }

        #categoryMenuPanel {
            border-right: 1px solid #e2e8f0;
        }

        #categorySubmenuPanel {
            width: 82%;
            max-width: 300px;
            left: 0;
            border-right: 1px solid #e2e8f0;
            transform: translateX(-100%);
        }
        #categorySubmenuPanel.open { transform: translateX(0); }
        @media (min-width: 641px) {
            #categorySubmenuPanel {
                width: 78%; max-width: 320px; left: min(78vw, 320px);
                transform: translateX(-20px); opacity: 0; pointer-events: none;
            }
            #categorySubmenuPanel.open { transform: translateX(0); opacity: 1; pointer-events: auto; }
        }

        @media (max-width: 520px) {
            #categoryMenuPanel {
                width: 82%;
                max-width: 300px;
            }
        }

    
        #stickyMainHeader {
            top: var(--sticky-topbar-height);
        }

        #navigationHub {
            top:
                calc(
                    var(--sticky-topbar-height) +
                    var(--sticky-header-height)
                );
        }

        #ofertas,
        #destaques,
        #todos {
            scroll-margin-top:
                calc(
                    var(--sticky-topbar-height) +
                    var(--sticky-header-height) +
                    var(--sticky-hub-height) +
                    18px
                );
        }

        #fixedNavigationSpacer {
            width: 100%;
            pointer-events: none;
        }

    
        @media (max-width: 640px) {
            #stickyTopBar {
                font-size: 11px;
                line-height: 1.15;
            }

            #stickyTopBar > div {
                min-height: 0;
                padding-top: 5px;
                padding-bottom: 5px;
            }

            #stickyTopBar .container-main {
                gap: 6px;
            }
        }

    
        @media (max-width: 640px) {
            #todos {
                padding-top: 18px !important;
            }

            #todos h2 {
                font-size: 1.75rem;
                line-height: 1.05;
            }

            #todos .section-title {
                margin-bottom: 4px;
            }
        }

    
        @media (max-width: 640px) {
            .product-card > div:first-child {
                aspect-ratio: 1 / 0.82;
            }

            .product-card h3 {
                font-size: 12px;
                line-height: 1.25;
                min-height: 30px;
            }

            .product-card .mt-3,
            .product-card .mt-2,
            .product-card .mt-1 {
            margin-top: 2px;
}

            .product-card .mt-auto.pt-4,
            .product-card .mt-auto.pt-3,
            .product-card .mt-auto.pt-2 {
            padding-top: 6px;
}
      }
}


/* Ajuste fino do preco no desktop */
@media (min-width: 1024px) {
    .product-card h3 + div {
        margin-top: 2px !important;
    }
}



        @media (min-width: 768px) {
            #stickyMainHeader .container-main {
                justify-content: flex-start;
            }
        }

        @media (max-width: 640px) {
            #stickyMainHeader {
                min-height: 58px;
            }
        }

    
        #categoryChips button:first-child {
            margin-bottom: 4px;
        }

    </style>
</head>

<body>

    <!-- ====================================================== -->
    <!-- TOP BAR                                                -->
    <!-- ====================================================== -->

    <div id="stickyTopBar" class="fixed top-0 left-0 right-0 z-[90] topbar-gradient text-sky-950">

        <div
            class="
                container-main
                min-h-[38px]
                flex
                items-center
                justify-center
                md:justify-between
                gap-4
                text-xs
                md:text-sm
                font-medium
            "
        >

            <div class="flex items-center gap-2">
                <i class="fa-solid fa-bolt"></i>

                <span>
                    Ao abrir uma oferta, você será direcionado para a Shopee para conferir preço, disponibilidade e finalizar a compra
                </span>
            </div>

            <div
                class="
                    hidden
                    md:flex
                    items-center
                    gap-6
                    opacity-95
                "
            >
                <span>
                    <i class="fa-solid fa-shield-halved mr-1"></i>
                    Compra pela Shopee
                </span>

                <span>
                    <i class="fa-solid fa-tags mr-1"></i>
                    Achadinhos todos os dias
                </span>
            </div>

        </div>

    </div>


    <!-- ====================================================== -->
    <!-- HEADER                                                 -->
    <!-- ====================================================== -->

    <header id="stickyMainHeader"
        class="
            bg-white/95
            backdrop-blur
            fixed
            left-0
            right-0
            top-[var(--sticky-topbar-height)]
            z-[85]
            border-b
            border-slate-100
        "
    >

        <div
            class="
                container-main
                h-[64px]
                flex
                items-center
                gap-5
            "
        >

            <!-- LOGO -->

            <a
                href="/vitrine2"
                class="
                    flex
                    items-center
                    gap-3
                    shrink-0
                "
            >

                <div
                    class="
                        w-11
                        h-11
                        rounded-2xl
                        bg-sky-400
                        text-white
                        flex
                        items-center
                        justify-center
                        shadow-lg
                        shadow-sky-100
                    "
                >
                    <i class="fa-solid fa-bag-shopping text-xl"></i>
                </div>

                <div class="hidden sm:block">

                    <div
                        class="
                            text-lg
                            font-extrabold
                            leading-none
                            tracking-tight
                        "
                    >
                        Minha Vitrine
                    </div>

                    <div
                        class="
                            text-[11px]
                            text-slate-500
                            mt-1
                        "
                    >
                        Achadinhos e Ofertas
                    </div>

                </div>

            </a>


            <!-- SEARCH -->

            


            <!-- DESKTOP NAV -->

            <div
                class="
                    hidden
                    lg:flex
                    items-center
                    gap-5
                    text-sm
                    font-semibold
                    text-slate-600
                    shrink-0
                "
            >

                <button
                    onclick="navigateToCatalogSection('ofertas')"
                    class="hover:text-sky-800 transition"
                >
                    Ofertas
                </button>

                <button
                    onclick="navigateToCatalogSection('destaques')"
                    class="hover:text-sky-800 transition"
                >
                    Destaques
                </button>

                <button
                    onclick="navigateToCatalogSection('todos')"
                    class="hover:text-sky-800 transition"
                >
                    Produtos
                </button>

            </div>


            <!-- MOBILE MENU BUTTON -->

            <button
                id="mobileMenuButton"
                class="
                    lg:hidden
                    ml-auto
                    w-11
                    h-11
                    rounded-xl
                    border
                    border-slate-200
                    flex
                    items-center
                    justify-center
                    text-slate-600
                "
                aria-label="Abrir menu"
            >
                <i class="fa-solid fa-bars text-lg"></i>
            </button>

        </div>


        <!-- MOBILE SEARCH -->

        <div
            class="
                md:hidden
                container-main
                pb-4
            "
        >

            

        </div>

    </header>


    <!-- ====================================================== -->
    <!-- MOBILE MENU                                            -->
    <!-- ====================================================== -->

    <div
        id="mobileMenu"
        class="
            mobile-menu
            fixed
            inset-y-0
            right-0
            z-50
            w-[82%]
            max-w-sm
            bg-white
            shadow-2xl
            p-6
        "
    >

        <div
            class="
                flex
                items-center
                justify-between
                mb-8
            "
        >

            <strong class="text-xl">
                Menu
            </strong>

            <button
                id="mobileMenuClose"
                class="
                    w-10
                    h-10
                    rounded-full
                    bg-slate-100
                "
            >
                <i class="fa-solid fa-xmark"></i>
            </button>

        </div>

        <div class="space-y-2">

            <button
                onclick="mobileNavigate('ofertas')"
                class="
                    w-full
                    text-left
                    px-4
                    py-4
                    rounded-xl
                    hover:bg-sky-50
                    font-semibold
                "
            >
                <i class="fa-solid fa-fire mr-3 text-sky-600"></i>
                Ofertas
            </button>

            <button
                onclick="mobileNavigate('destaques')"
                class="
                    w-full
                    text-left
                    px-4
                    py-4
                    rounded-xl
                    hover:bg-sky-50
                    font-semibold
                "
            >
                <i class="fa-solid fa-star mr-3 text-sky-600"></i>
                Destaques
            </button>

            <button
                onclick="mobileNavigate('todos')"
                
                
                
                class="
                    w-full
                    text-left
                    px-4
                    py-4
                    rounded-xl
                    hover:bg-sky-50
                    font-semibold
                "
            >
                <i class="fa-solid fa-store mr-3 text-sky-600"></i>
                Produtos para você
            </button>

        </div>

    </div>


    <div
        id="mobileOverlay"
        class="
            hidden
            fixed
            inset-0
            bg-slate-950/40
            z-40
            backdrop-blur-sm
        "
    ></div>


    <!-- ====================================================== -->
    <!-- MAIN                                                   -->
    <!-- ====================================================== -->

    <main>



        <!-- ================================================== -->
        <!-- TRUST                                              -->
        <!-- ================================================== -->

        




        <!-- ================================================== -->
        <!-- CATEGORIES                                         -->
        <!-- ================================================== -->

        <section
            id="navigationHub"
            class="
                fixed
                left-0
                right-0
                top-[calc(var(--sticky-topbar-height)+var(--sticky-header-height))]
                z-[75]
                bg-slate-50/95
                backdrop-blur
                pt-2
                pb-2
            "
        >
            <div class="container-main">

                <div
                    class="
                        w-full
                        rounded-[22px]
                        border
                        border-slate-200
                        bg-white
                        px-2.5
                        py-2
                        sm:px-4
                        flex
                        items-center
                        justify-between
                        gap-3
                        shadow-sm
                    "
                >

                    <button
                        id="openCategoryMenu"
                        type="button"
                        class="
                            min-w-0
                            flex
                            items-center
                            gap-2
                            text-left
                            flex-1
                            rounded-xl
                            px-2
                            py-2
                            transition
                            hover:bg-slate-50
                            active:scale-[.985]
                        "
                        aria-haspopup="dialog"
                        aria-controls="categoryMenuOverlay"
                    >
                        <span
                            class="
                                w-8
                                h-8
                                sm:w-9
                                sm:h-9
                                rounded-xl
                                bg-slate-50
                                border
                                border-slate-200
                                text-slate-700
                                flex
                                items-center
                                justify-center
                                shrink-0
                            "
                        >
                            <i class="fa-solid fa-bars"></i>
                        </span>

                        <span class="min-w-0">
                            <strong
                                class="
                                    block
                                    text-sm
                                    sm:text-[15px]
                                    font-extrabold
                                    text-slate-900
                                "
                            >
                                Explore por categoria
                            </strong>

                            <span
                                id="selectedCategoryLabel"
                                class="
                                    block
                                    text-xs
                                    text-slate-500
                                    mt-0
                                    truncate
                                "
                            >
                                Todos os produtos
                            </span>
                        </span>
                    </button>

                    <div
                        class="
                            relative
                            shrink-0
                            flex
                            items-center
                        "
                    >
                        <i
                            class="
                                fa-solid
                                fa-star
                                absolute
                                left-3
                                pointer-events-none
                                text-slate-500
                                text-xs
                                z-10
                            "
                        ></i>

                        <select
                            id="sortProducts"
                            class="
                                appearance-none
                                bg-white
                                border
                                border-slate-200
                                rounded-xl
                                pl-7
                                pr-7
                                py-2
                                text-[11px]
                                sm:text-sm
                                font-bold
                                text-slate-700
                                outline-none
                                cursor-pointer
                                transition
                                hover:border-slate-300
                                focus:border-slate-400
                            "
                            aria-label="Ordenar produtos"
                        >
                            <option value="position">Recomendados</option>
                            <option value="price-asc">Menor preço</option>
                            <option value="price-desc">Maior preço</option>
                            <option value="name">Nome A-Z</option>
                        </select>

                        <i
                            class="
                                fa-solid
                                fa-chevron-down
                                absolute
                                right-3
                                pointer-events-none
                                text-slate-400
                                text-[10px]
                            "
                        ></i>
                    </div>

                </div>

            </div>
        </section>

        <div
            id="fixedNavigationSpacer"
            aria-hidden="true"
        ></div>




        <!-- ================================================== -->
        <!-- CATEGORY DRAWER                                    -->
        <!-- ================================================== -->

        <div
            id="categoryMenuOverlay"
            class="
                hidden
                fixed
                inset-0
                z-[90]
                bg-slate-950/45
                backdrop-blur-[2px]
            "
            aria-hidden="true"
        >

            <aside
                id="categoryMenuPanel"
                class="
                    absolute
                    top-0
                    left-0
                    h-full
                    w-[78%]
                    max-w-[320px]
                    bg-white
                    shadow-2xl
                    -translate-x-full
                    transition-transform
                    duration-300
                    ease-out
                    flex
                    flex-col
                "
                role="dialog"
                aria-modal="true"
                aria-labelledby="categoryMenuTitle"
            >

                <div
                    class="
                        px-5
                        py-5
                        border-b
                        border-slate-100
                        flex
                        items-center
                        justify-between
                        gap-4
                    "
                >

                    <div>

                        <h2
                            id="categoryMenuTitle"
                            class="
                                text-xl
                                font-extrabold
                                tracking-tight
                                text-slate-900
                            "
                        >
                            Categorias
                        </h2>

                        <p
                            id="categoryMenuSubtitle"
                            class="
                                text-sm
                                text-slate-500
                                mt-1
                            "
                        >
                            Toque em uma categoria para explorar
                        </p>

                    </div>

                    <button
                        id="closeCategoryMenu"
                        type="button"
                        class="
                            w-10
                            h-10
                            rounded-full
                            bg-slate-100
                            text-slate-600
                            flex
                            items-center
                            justify-center
                            transition
                            hover:bg-slate-200
                        "
                        aria-label="Fechar categorias"
                    >
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>

                </div>


                <div
                    id="categoryChips"
                    class="
                        flex-1
                        overflow-y-auto
                        px-4
                        py-4
                        space-y-2
                    "
                >

                    <button
                        data-category=""
                        class="
                            category-chip
                            active
                            w-full
                            min-h-[54px]
                            rounded-2xl
                            border
                            border-slate-200
                            bg-white
                            px-4
                            py-3
                            flex
                            items-center
                            justify-between
                            gap-3
                            text-left
                            font-bold
                            text-slate-700
                        "
                    >
                        <span
                            class="
                                flex
                                items-center
                                gap-3
                                min-w-0
                            "
                        >
                            <span
                                class="
                                    w-9
                                    h-9
                                    rounded-xl
                                    bg-sky-50
                                    text-sky-600
                                    flex
                                    items-center
                                    justify-center
                                    shrink-0
                                "
                            >
                                <i class="fa-solid fa-border-all"></i>
                            </span>

                            <span class="truncate">
                                Todos os produtos
                            </span>
                        </span>

                        <i
                            class="
                                fa-solid
                                fa-chevron-right
                                text-xs
                                opacity-50
                                shrink-0
                            "
                        ></i>
                    </button>

                </div>

            </aside>

            <aside id="categorySubmenuPanel" class="absolute top-0 h-full bg-white shadow-2xl transition-all duration-300 ease-out flex flex-col z-[2]" aria-hidden="true">
                <div class="px-5 py-5 border-b border-slate-100 flex items-center justify-between gap-4">
                    <div class="min-w-0">
                        <h2 id="categorySubmenuTitle" class="text-xl font-extrabold tracking-tight text-slate-900 truncate">Categoria</h2>
                        <p class="text-sm text-slate-500 mt-1">Escolha uma subcategoria</p>
                    </div>
                    <button id="closeCategorySubmenu" type="button" class="w-10 h-10 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center transition hover:bg-slate-200 shrink-0" aria-label="Voltar para categorias">
                        <i class="fa-solid fa-arrow-left"></i>
                    </button>
                </div>
                <div id="subcategoryChips" class="flex-1 overflow-y-auto px-4 py-4 space-y-2"></div>
            </aside>

