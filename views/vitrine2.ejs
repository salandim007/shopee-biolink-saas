        function renderSubcategories(category) {
            categorySubmenuTitleElement.textContent = category;
            subcategoryChipsElement.innerHTML = '';

            const backButton = createCategoryMenuButton('Voltar para categorias', { icon: 'fa-arrow-left', noArrow: true });
            backButton.addEventListener('click', closeCategorySubmenu);
            subcategoryChipsElement.appendChild(backButton);

            const allInCategoryButton = createCategoryMenuButton(`Ver todos em ${category}`, { icon: 'fa-border-all' });
            allInCategoryButton.addEventListener('click', () => applyCategoryFilter(category, ''));
            subcategoryChipsElement.appendChild(allInCategoryButton);

            const subcategories = new Set();
            catalogProducts.forEach(entry => {
                const product = entry.product || {};
                const primary = getPrimaryCategory(product);
                if (normalizeText(primary) !== normalizeText(category)) return;
                const subcategory = getProductSubcategory(product, primary);
                if (subcategory) subcategories.add(subcategory);
            });

            [...subcategories]
                .sort((a, b) => {
                    if (a === 'Outros') return 1;
                    if (b === 'Outros') return -1;
                    return a.localeCompare(b, 'pt-BR');
                })
                .forEach(subcategory => {
                    const button = createCategoryMenuButton(subcategory, { icon: 'fa-tag', noArrow: true });
                    button.addEventListener('click', () => applyCategoryFilter(category, subcategory));
                    subcategoryChipsElement.appendChild(button);
                });

            openCategorySubmenu();
        }


