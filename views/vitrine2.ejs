                ) {
                    return group.name;
                }
            }


            return 'Outros achadinhos';
        }


        function getPrimaryCategory(
            product
        ) {

            const candidates = [
                product.category1,
                product.metadata?.categoryDisplayName
            ]
                .map(
                    item =>
                        String(
